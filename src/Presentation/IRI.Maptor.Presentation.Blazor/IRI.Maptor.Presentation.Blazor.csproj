<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />

    <!-- The TOC is built on MudBlazor rather than hand-rolled controls: every consumer of this
         library is already a MudBlazor app, and a second widget vocabulary inside the same page
         is exactly how a "shared" panel starts looking foreign in its host. Host apps must
         include MudBlazor's css/js and providers, as a MudBlazor app already does. -->
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\IRI.Maptor.Core.Spatial\IRI.Maptor.Core.Spatial.csproj" />
    <ProjectReference Include="..\..\Core\IRI.Maptor.Core.SpatialReferenceSystem\IRI.Maptor.Core.SpatialReferenceSystem.csproj" />
    <ProjectReference Include="..\..\Core\IRI.Maptor.Core.Common\IRI.Maptor.Core.Common.csproj" />
    <ProjectReference Include="..\IRI.Maptor.Presentation.Core\IRI.Maptor.Presentation.Core.csproj" />
  </ItemGroup>

</Project>
