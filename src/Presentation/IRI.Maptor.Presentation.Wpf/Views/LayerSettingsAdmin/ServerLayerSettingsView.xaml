<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.LayerSettingsAdmin.ServerLayerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
             xmlns:models="clr-namespace:IRI.Maptor.Presentation.Wpf.Models.LayerSettingsAdmin"
             xmlns:viewModels="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.LayerSettingsAdmin"
             mc:Ignorable="d"
             x:Name="root"
             d:DataContext="{d:DesignInstance Type=viewModels:ServerLayerSettingsViewModel}"
             d:DesignWidth="980" d:DesignHeight="600"
             Background="{DynamicResource MahApps.Brushes.ThemeBackground}">

    <!--The server's layer registry, master–detail: TOC groups and layers on the leading side, the selected
        row's editor (General / Display / Labels / Loading) on the trailing side. Edits stay local until
        the window's Save. Hosted by ServerLayerSettingsWindow.-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource IRI.Maptor.Styles.TabItem.Form}"/>

            <!--a form row: label column + editor column-->
            <Style x:Key="fieldRow" TargetType="Grid" BasedOn="{StaticResource IRI.Maptor.Styles.Grid.FieldRow}"/>

            <!--an editable row: the grey Border.Card strip the open-file and Go To dialogs use, so the borderless
                white input inside it reads as a field you can click into. Read-only rows stay fieldRow.-->
            <Style x:Key="fieldCard" TargetType="Border" BasedOn="{StaticResource IRI.Maptor.Styles.Border.Card}">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Padding" Value="10,0,4,0"/>
            </Style>

            <Style x:Key="formCheckBox" TargetType="CheckBox" BasedOn="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}">
                <Setter Property="Margin" Value="4,6"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <!--zoom levels, label sizes, widths: always Latin digits, left to right-->
            <Style x:Key="numberBox" TargetType="mahApp:NumericUpDown" BasedOn="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}">
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="MinWidth" Value="130"/>
            </Style>

            <Style x:Key="zoomBox" TargetType="mahApp:NumericUpDown" BasedOn="{StaticResource numberBox}">
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="24"/>
                <Setter Property="Interval" Value="1"/>
                <Setter Property="NumericInputMode" Value="Numbers"/>
                <Setter Property="mahApp:TextBoxHelper.Watermark" Value="{Binding [serverLayerSettings_noLimit], Source={StaticResource Localization}}"/>
                <Setter Property="mahApp:TextBoxHelper.ClearTextButton" Value="True"/>
            </Style>

            <Style x:Key="readOnlyLatin" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}">
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>

            <!--the picker shows the colour's name and hex code, which an RTL flow would scramble-->
            <Style x:Key="colorBox" TargetType="mahApp:ColorPicker" BasedOn="{StaticResource IRI.Maptor.Styles.ColorPicker.Normal}">
                <Setter Property="FlowDirection" Value="LeftToRight"/>
            </Style>

            <Style x:Key="menuIcon" TargetType="iconPacks:PackIconMaterial">
                <Setter Property="Width" Value="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"/>
                <Setter Property="Height" Value="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
            </Style>

            <!--one "Move to" entry: a group, or the top level; the current place is checked and disabled-->
            <Style x:Key="moveTargetItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                <Setter Property="Header" Value="{Binding Title}"/>
                <Setter Property="IsCheckable" Value="False"/>
                <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}"/>
                <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.MoveToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Setter Property="CommandParameter" Value="{Binding}"/>
            </Style>

            <Style x:Key="sectionTitle" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}"/>

            <!--segmented switch (as in the statistics tab): buttons, because each choice runs a command
                (switching to Simple asks first); Tag="checked" marks the current one-->
            <Style x:Key="segmentButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="segment" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                           FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"
                                           Style="{StaticResource IRI.Maptor.Styles.TextBlock}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="segment" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="checked">
                                    <Setter TargetName="segment" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="segmentGroup" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!--tab content inherits Foreground from its TabItem, and the selected tab's header text is the
                light on-accent colour: without this, every text style that sets no Foreground turns invisible-->
            <Style x:Key="tabScroll" TargetType="ScrollViewer">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Padding" Value="{StaticResource IRI.Maptor.Styles.Thickness.ViewContent}"/>
            </Style>

            <!--tree rows: one template for groups and layers-->
            <HierarchicalDataTemplate DataType="{x:Type models:ServerLayerSettingItem}" ItemsSource="{Binding Children}">
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconMaterial x:Name="icon" Grid.Column="0" Kind="LayersOutline"
                                                Width="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                                Height="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                                Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <TextBlock x:Name="title" Grid.Column="1"
                               Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                               Text="{Binding Title}" ToolTip="{Binding Title}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <!--Live layers carry a small marker so the admin sees the mode at a glance-->
                    <iconPacks:PackIconMaterial Grid.Column="2" Kind="AccessPointNetwork"
                                                Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.Indicator}"
                                                Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                                Margin="6,0,0,0"
                                                ToolTip="{Binding [serverLayerSettings_badge_live], Source={StaticResource Localization}}"
                                                Visibility="{Binding IsLiveMode, Converter={StaticResource boolToVisibilityConverter}}"/>

                    <iconPacks:PackIconMaterial Grid.Column="3" Kind="AlertCircle"
                                                Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.Indicator}"
                                                Foreground="{DynamicResource IRI.Maptor.Brushes.Invalid}"
                                                Margin="6,0,0,0"
                                                Visibility="{Binding HasErrors, Converter={StaticResource boolToVisibilityConverter}}"/>

                    <iconPacks:PackIconMaterial Grid.Column="4" Kind="Pencil"
                                                Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.Indicator}"
                                                Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                Margin="6,0,0,0"
                                                ToolTip="{Binding [serverLayerSettings_badge_unsaved], Source={StaticResource Localization}}"
                                                Visibility="{Binding IsDirty, Converter={StaticResource boolToVisibilityConverter}}"/>
                </Grid>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                        <Setter TargetName="icon" Property="Kind" Value="FolderOutline"/>
                        <Setter TargetName="title" Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                        <Setter TargetName="title" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                        <Setter TargetName="title" Property="FontStyle" Value="Italic"/>
                        <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.ViewContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <mahApp:MetroProgressBar Grid.Row="0" IsIndeterminate="{Binding IsBusy}" Height="3" Margin="0,0,0,4"
                                 Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource boolToVisibilityConverter}}"/>

        <!--outcome of the last save-->
        <Border Grid.Row="1" Visibility="{Binding HasResultMessage, Converter={StaticResource boolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource IRI.Maptor.Styles.Border.Banner}">
                    <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Valid.Fill}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Invalid.Fill}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <iconPacks:PackIconMaterial DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                    <iconPacks:PackIconMaterial.Style>
                        <Style TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.Indicator}">
                            <Setter Property="Kind" Value="CheckCircle"/>
                            <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Valid}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                    <Setter Property="Kind" Value="AlertCircle"/>
                                    <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Invalid}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </iconPacks:PackIconMaterial.Style>
                </iconPacks:PackIconMaterial>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" Text="{Binding ResultMessage}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!--the list could not be read-->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasLoadError, Converter={StaticResource boolToVisibilityConverter}}">
            <iconPacks:PackIconMaterial Kind="CloudAlertOutline" Width="40" Height="40" HorizontalAlignment="Center"
                                        Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}" Text="{Binding LoadError}"
                       TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"/>
            <Button Style="{StaticResource IRI.Maptor.Styles.Button.Secondary}" Command="{Binding ReloadCommand}"
                    HorizontalAlignment="Center" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Refresh" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}" Text="{Binding [serverLayerSettings_retry], Source={StaticResource Localization}}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!--master / detail-->
        <Grid Grid.Row="2" Visibility="{Binding IsLoaded, Converter={StaticResource boolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!--master: search + reload, then the tree-->
            <Border Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}" Padding="4,2">
                        <DockPanel>
                            <!--the data model as the file the import tool reads-->
                            <Button DockPanel.Dock="Right" Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                    Command="{Binding ExportImportModelCommand}"
                                    ToolTip="{Binding [serverLayerSettings_importModel_exportTip], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [serverLayerSettings_importModel_export], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="DatabaseExportOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                    Command="{Binding ReloadCommand}"
                                    ToolTip="{Binding [serverLayerSettings_reload], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [serverLayerSettings_reload], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="Refresh" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                            <TextBox x:Name="filterBox"
                                     Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                     mahApp:TextBoxHelper.Watermark="{Binding [serverLayerSettings_searchPlaceholder], Source={StaticResource Localization}}"
                                     mahApp:TextBoxHelper.ClearTextButton="True"/>
                        </DockPanel>
                    </Border>

                    <TreeView x:Name="tree" Grid.Row="1"
                              Style="{StaticResource IRI.Maptor.Styles.TreeView}"
                              ItemsSource="{Binding Roots}"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnTreePreviewMouseMove"
                              PreviewMouseRightButtonDown="OnTreePreviewMouseRightButtonDown"
                              PreviewKeyDown="OnTreePreviewKeyDown"
                              DragOver="OnTreeDragOver"
                              DragLeave="OnTreeDragLeave"
                              Drop="OnTreeDrop">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource IRI.Maptor.Styles.TreeViewItem}">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource boolToVisibilityConverter}}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <!--on the tree, not per row: its DataContext is then the window's view model; a right click selects the row first-->
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [serverLayerSettings_cmd_moveUp], Source={StaticResource Localization}}" Command="{Binding MoveUpCommand}" InputGestureText="Alt+Up">
                                    <MenuItem.Icon><iconPacks:PackIconMaterial Kind="ArrowUp" Style="{StaticResource menuIcon}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding [serverLayerSettings_cmd_moveDown], Source={StaticResource Localization}}" Command="{Binding MoveDownCommand}" InputGestureText="Alt+Down">
                                    <MenuItem.Icon><iconPacks:PackIconMaterial Kind="ArrowDown" Style="{StaticResource menuIcon}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding [serverLayerSettings_cmd_moveTo], Source={StaticResource Localization}}"
                                          ItemsSource="{Binding MoveTargets}" ItemContainerStyle="{StaticResource moveTargetItem}"
                                          IsEnabled="{Binding SelectedItem.IsLayer, FallbackValue=False}">
                                    <MenuItem.Icon><iconPacks:PackIconMaterial Kind="FolderMoveOutline" Style="{StaticResource menuIcon}"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{Binding [serverLayerSettings_cmd_rename], Source={StaticResource Localization}}" Command="{Binding RenameCommand}" InputGestureText="F2">
                                    <MenuItem.Icon><iconPacks:PackIconMaterial Kind="RenameBox" Style="{StaticResource menuIcon}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding [serverLayerSettings_cmd_newGroup], Source={StaticResource Localization}}" Command="{Binding NewGroupCommand}">
                                    <MenuItem.Icon><iconPacks:PackIconMaterial Kind="FolderPlusOutline" Style="{StaticResource menuIcon}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding [serverLayerSettings_cmd_deleteGroup], Source={StaticResource Localization}}" Command="{Binding DeleteGroupCommand}" InputGestureText="Del"
                                          Visibility="{Binding SelectedItem.IsGroup, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <MenuItem.Icon><iconPacks:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource menuIcon}"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <TextBlock Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}"
                               Text="{Binding [serverLayerSettings_noMatch], Source={StaticResource Localization}}"
                               Visibility="{Binding HasVisibleItems, Converter={StaticResource boolToInverseVisibilityConverter}}"/>

                    <TextBlock Grid.Row="2" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" Margin="8,4" TextWrapping="Wrap"
                               Text="{Binding [serverLayerSettings_hint_dragDrop], Source={StaticResource Localization}}"/>

                    <!--structure actions; the same ones are on the right-click menu-->
                    <Border Grid.Row="3" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}" Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Command="{Binding NewGroupCommand}"
                                    ToolTip="{Binding [serverLayerSettings_cmd_newGroup], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [serverLayerSettings_cmd_newGroup], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="FolderPlusOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                            <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Vertical}" Margin="4,6"/>
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Command="{Binding MoveUpCommand}"
                                    ToolTip="{Binding [serverLayerSettings_cmd_moveUp], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [serverLayerSettings_cmd_moveUp], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="ArrowUp" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Command="{Binding MoveDownCommand}"
                                    ToolTip="{Binding [serverLayerSettings_cmd_moveDown], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [serverLayerSettings_cmd_moveDown], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="ArrowDown" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                            <Button x:Name="moveToButton" Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Click="OnMoveToButtonClick"
                                    IsEnabled="{Binding SelectedItem.IsLayer, FallbackValue=False}"
                                    ToolTip="{Binding [serverLayerSettings_cmd_moveTo], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [serverLayerSettings_cmd_moveTo], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="FolderMoveOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding MoveTargets}" ItemContainerStyle="{StaticResource moveTargetItem}"/>
                                </Button.ContextMenu>
                            </Button>
                            <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Vertical}" Margin="4,6"/>
                            <!--a refused delete says why in its tooltip-->
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Command="{Binding DeleteGroupCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="{Binding [serverLayerSettings_cmd_deleteGroup], Source={StaticResource Localization}}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel MaxWidth="280">
                                            <TextBlock Text="{Binding [serverLayerSettings_cmd_deleteGroup], Source={StaticResource Localization}}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DeleteGroupHint}" TextWrapping="Wrap"
                                                       Visibility="{Binding DeleteGroupHint, Converter={StaticResource stringNotNullOrEmptyToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <iconPacks:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.GridSplitter.Vertical}"/>

            <!--detail-->
            <Border Grid.Column="2" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}">
                <Grid>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}"
                               Text="{Binding [serverLayerSettings_noSelection], Source={StaticResource Localization}}"
                               Visibility="{Binding HasSelection, Converter={StaticResource boolToInverseVisibilityConverter}}"/>

                    <Grid DataContext="{Binding SelectedItem}"
                          Visibility="{Binding DataContext.HasSelection, ElementName=root, Converter={StaticResource boolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!--header: what is being edited, and its state-->
                        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}">
                            <DockPanel LastChildFill="True" Margin="4,2">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource IRI.Maptor.Styles.Pill.Accent}" Margin="4,0,0,0"
                                            Visibility="{Binding IsDirty, Converter={StaticResource boolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text.Accent}" Text="{Binding [serverLayerSettings_badge_unsaved], Source={StaticResource Localization}}"/>
                                    </Border>
                                    <Border Style="{StaticResource IRI.Maptor.Styles.Pill.Warning}" Margin="4,0,0,0"
                                            Visibility="{Binding IsActive, Converter={StaticResource boolToInverseVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text.Warning}" Text="{Binding [serverLayerSettings_badge_inactive], Source={StaticResource Localization}}"/>
                                    </Border>
                                    <Border Style="{StaticResource IRI.Maptor.Styles.Pill}" Margin="4,0,0,0"
                                            Visibility="{Binding IsGroup, Converter={StaticResource boolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text}" Text="{Binding [serverLayerSettings_badge_group], Source={StaticResource Localization}}"/>
                                    </Border>
                                    <Border Style="{StaticResource IRI.Maptor.Styles.Pill}" Margin="4,0,0,0"
                                            Visibility="{Binding IsLiveMode, Converter={StaticResource boolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text}" Text="{Binding [serverLayerSettings_badge_live], Source={StaticResource Localization}}"/>
                                    </Border>
                                </StackPanel>

                                <iconPacks:PackIconMaterial DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Width="{StaticResource IRI.Maptor.Styles.Size.Icon.Field}"
                                                            Height="{StaticResource IRI.Maptor.Styles.Size.Icon.Field}"
                                                            Foreground="{DynamicResource MahApps.Brushes.Accent}">
                                    <iconPacks:PackIconMaterial.Style>
                                        <Style TargetType="iconPacks:PackIconMaterial">
                                            <Setter Property="Kind" Value="LayersOutline"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                    <Setter Property="Kind" Value="FolderOutline"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconMaterial.Style>
                                </iconPacks:PackIconMaterial>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}" Margin="0"
                                               Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" Text="{Binding Caption}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!--the server refused the last save of this row-->
                        <Border Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.Border.Banner.Invalid}" Margin="6,6,6,0"
                                Visibility="{Binding HasServerMessage, Converter={StaticResource boolToVisibilityConverter}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                                        Command="{Binding DataContext.ReloadCommand, ElementName=root}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [serverLayerSettings_reload], Source={StaticResource Localization}}"/>
                                </Button>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" Text="{Binding ServerMessage}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>

                        <!--broken rules, all of them, so nothing hides on another tab-->
                        <Border Grid.Row="2" Style="{StaticResource IRI.Maptor.Styles.Border.Banner.Invalid}" Margin="6,6,6,0"
                                Visibility="{Binding HasErrors, Converter={StaticResource boolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding ErrorMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.Indicator}"
                                                                        Foreground="{DynamicResource IRI.Maptor.Brushes.Invalid}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" Text="{Binding}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TabControl x:Name="tabs" Grid.Row="3" Style="{StaticResource IRI.Maptor.Styles.TabControl.Form}" Margin="1,4,1,1">

                            <!--General: name, where it is, who sees it-->
                            <TabItem x:Name="generalTab" Header="{Binding [serverLayerSettings_tab_general], Source={StaticResource Localization}}">
                                <ScrollViewer Style="{StaticResource tabScroll}">
                                    <StackPanel>
                                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}">
                                            <StackPanel>
                                                <Border Style="{StaticResource fieldCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_title], Source={StaticResource Localization}}"/>
                                                        <TextBox x:Name="titleBox" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                                                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </Border>

                                                <Grid Style="{StaticResource fieldRow}" Visibility="{Binding IsLayer, Converter={StaticResource boolToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_group], Source={StaticResource Localization}}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" Text="{Binding GroupTitle}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource sectionTitle}" Text="{Binding [serverLayerSettings_section_visibility], Source={StaticResource Localization}}"/>
                                                <CheckBox Style="{StaticResource formCheckBox}" IsChecked="{Binding IsActive}"
                                                          Content="{Binding [serverLayerSettings_field_active], Source={StaticResource Localization}}"/>
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" Margin="32,0,4,4" TextWrapping="Wrap"
                                                           Text="{Binding [serverLayerSettings_hint_active], Source={StaticResource Localization}}"/>
                                                <CheckBox Style="{StaticResource formCheckBox}" IsChecked="{Binding IsLayerOn}"
                                                          Content="{Binding [serverLayerSettings_field_onByDefault], Source={StaticResource Localization}}"/>
                                                <CheckBox Style="{StaticResource formCheckBox}" IsChecked="{Binding IsExpandedInToc}"
                                                          Content="{Binding [serverLayerSettings_field_expanded], Source={StaticResource Localization}}"
                                                          Visibility="{Binding IsGroup, Converter={StaticResource boolToVisibilityConverter}}"/>
                                                <CheckBox Style="{StaticResource formCheckBox}" IsChecked="{Binding IsSearchable}"
                                                          Content="{Binding [serverLayerSettings_field_searchable], Source={StaticResource Localization}}"
                                                          Visibility="{Binding IsLayer, Converter={StaticResource boolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>

                                        <!--where the data comes from: fixed by the system, shown for reference-->
                                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}"
                                                Visibility="{Binding IsLayer, Converter={StaticResource boolToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource sectionTitle}" Text="{Binding [serverLayerSettings_section_source], Source={StaticResource Localization}}"/>
                                                <Grid Style="{StaticResource fieldRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_table], Source={StaticResource Localization}}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource readOnlyLatin}" Text="{Binding TableName}"/>
                                                </Grid>
                                                <Grid Style="{StaticResource fieldRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_serviceUrl], Source={StaticResource Localization}}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource readOnlyLatin}" Text="{Binding ServiceUrl}"/>
                                                </Grid>
                                                <Grid Style="{StaticResource fieldRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_id], Source={StaticResource Localization}}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource readOnlyLatin}" Text="{Binding Id}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!--Display: zoom range and symbology-->
                            <TabItem Header="{Binding [serverLayerSettings_tab_display], Source={StaticResource Localization}}"
                                     Visibility="{Binding IsLayer, Converter={StaticResource boolToVisibilityConverter}}">
                                <ScrollViewer Style="{StaticResource tabScroll}">
                                    <StackPanel>
                                        <!--Whole layer: what applies whatever the symbology (simple colours or SLD styles)-->
                                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource sectionTitle}" Text="{Binding [layerStyles_wholeLayer], Source={StaticResource Localization}}"/>
                                                <Border Style="{StaticResource fieldCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_zoomFrom], Source={StaticResource Localization}}"/>
                                                        <mahApp:NumericUpDown Grid.Column="1" Style="{StaticResource zoomBox}" Value="{Binding MinLayerZoomLevel}"/>
                                                        <TextBlock Grid.Column="2" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Margin="12,0,8,0"
                                                                   Text="{Binding [serverLayerSettings_field_zoomTo], Source={StaticResource Localization}}"/>
                                                        <mahApp:NumericUpDown Grid.Column="3" Style="{StaticResource zoomBox}" Value="{Binding MaxLayerZoomLevel}"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" TextWrapping="Wrap" Margin="4,0,4,4"
                                                           Text="{Binding [serverLayerSettings_hint_zoom], Source={StaticResource Localization}}"/>
                                                <Border Style="{StaticResource fieldCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                            <ColumnDefinition Width="*" MaxWidth="320"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_opacity], Source={StaticResource Localization}}"/>
                                                        <Slider Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Slider.Normal}" Minimum="0" Maximum="1"
                                                                SmallChange="0.05" LargeChange="0.1" Value="{Binding Opacity}"/>
                                                        <TextBlock Grid.Column="2" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" MinWidth="44"
                                                                   FlowDirection="LeftToRight" TextAlignment="Right" Text="{Binding OpacityPercentText}"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" TextWrapping="Wrap" Margin="4,0,4,4"
                                                           Text="{Binding [layerStyles_wholeLayerHint], Source={StaticResource Localization}}"/>
                                            </StackPanel>
                                        </Border>

                                        <!--Symbology: Simple (the colours below) or Styles (named SLD styles); only the chosen one is shown-->
                                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource segmentGroup}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Command="{Binding DataContext.SwitchToSimpleCommand, ElementName=root}"
                                                                    Content="{Binding [layerStyles_modeSimple], Source={StaticResource Localization}}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource segmentButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSimpleMode}" Value="True">
                                                                                <Setter Property="Tag" Value="checked"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.SwitchToStylesCommand, ElementName=root}"
                                                                    Content="{Binding [layerStyles_modeStyles], Source={StaticResource Localization}}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource segmentButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasSld}" Value="True">
                                                                                <Setter Property="Tag" Value="checked"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Style="{StaticResource sectionTitle}" Margin="0" VerticalAlignment="Center"
                                                               Text="{Binding [layerSettings_symbology_title], Source={StaticResource Localization}}"/>
                                                </DockPanel>

                                                <!--Simple: one style from the colours, with its sample-->
                                                <StackPanel Visibility="{Binding IsSimpleMode, Converter={StaticResource boolToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" TextWrapping="Wrap" Margin="4,0,4,6"
                                                               Text="{Binding [layerStyles_simpleHint], Source={StaticResource Localization}}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <Border Style="{StaticResource fieldCard}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Style="{StaticResource formCheckBox}" IsChecked="{Binding HasFill}"
                                                                              Content="{Binding [serverLayerSettings_field_fill], Source={StaticResource Localization}}"/>
                                                                    <mahApp:ColorPicker Grid.Column="1" Style="{StaticResource colorBox}"
                                                                                        SelectedColor="{Binding FillColor, Mode=TwoWay}" IsEnabled="{Binding HasFill}"/>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource fieldCard}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Style="{StaticResource formCheckBox}" IsChecked="{Binding HasStroke}"
                                                                              Content="{Binding [serverLayerSettings_field_stroke], Source={StaticResource Localization}}"/>
                                                                    <mahApp:ColorPicker Grid.Column="1" Style="{StaticResource colorBox}"
                                                                                        SelectedColor="{Binding StrokeColor, Mode=TwoWay}" IsEnabled="{Binding HasStroke}"/>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource fieldCard}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_strokeWidth], Source={StaticResource Localization}}"/>
                                                                    <mahApp:NumericUpDown Grid.Column="1" Style="{StaticResource numberBox}" Minimum="0" Maximum="50" Interval="0.5"
                                                                                          StringFormat="{}{0:0.#}" Value="{Binding StrokeThickness}"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>

                                                        <!--a sample of the simple style, with the layer's opacity-->
                                                        <StackPanel Grid.Column="1" Margin="16,4,4,4" VerticalAlignment="Top">
                                                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" HorizontalAlignment="Center"
                                                                       Text="{Binding [serverLayerSettings_field_preview], Source={StaticResource Localization}}"/>
                                                            <Border Width="104" Height="104" Margin="0,4,0,0" CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}"
                                                                    Background="{DynamicResource MahApps.Brushes.Gray10}">
                                                                <Rectangle Width="64" Height="64" RadiusX="6" RadiusY="6"
                                                                           Opacity="{Binding Opacity}"
                                                                           StrokeThickness="{Binding StrokeThickness}">
                                                                    <Rectangle.Style>
                                                                        <Style TargetType="Rectangle">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasFill}" Value="True">
                                                                                    <Setter Property="Fill">
                                                                                        <Setter.Value>
                                                                                            <SolidColorBrush Color="{Binding FillColor}"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding HasStroke}" Value="True">
                                                                                    <Setter Property="Stroke">
                                                                                        <Setter.Value>
                                                                                            <SolidColorBrush Color="{Binding StrokeColor}"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Rectangle.Style>
                                                                </Rectangle>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!--Styles: the named SLD styles (users switch between them, starting on the default)
                                                    beside the legend of the selected one. The admin edits titles only: names are generated.-->
                                                <StackPanel Visibility="{Binding HasSld, Converter={StaticResource boolToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" TextWrapping="Wrap" Margin="4,0,4,6"
                                                               Text="{Binding [layerStyles_adminBanner], Source={StaticResource Localization}}"/>

                                                    <Grid Margin="4,0,4,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="240"/>
                                                        </Grid.ColumnDefinitions>

                                                        <DockPanel Grid.Column="0">
                                                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                                                <WrapPanel.Resources>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}">
                                                                        <Setter Property="Margin" Value="0,0,4,4"/>
                                                                    </Style>
                                                                </WrapPanel.Resources>
                                                                <Button Command="{Binding DataContext.AddStyleCommand, ElementName=root}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <iconPacks:PackIconMaterial Kind="Plus" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [layerStyles_add], Source={StaticResource Localization}}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.CopyStyleCommand, ElementName=root}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <iconPacks:PackIconMaterial Kind="ContentCopy" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [layerStyles_copy], Source={StaticResource Localization}}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.EditSldCommand, ElementName=root}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <iconPacks:PackIconMaterial Kind="Palette" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [layerStyles_edit], Source={StaticResource Localization}}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.SetDefaultStyleCommand, ElementName=root}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <iconPacks:PackIconMaterial Kind="Star" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [layerStyles_setDefault], Source={StaticResource Localization}}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.MoveStyleUpCommand, ElementName=root}"
                                                                        ToolTip="{Binding [layerStyles_moveUp], Source={StaticResource Localization}}">
                                                                    <iconPacks:PackIconMaterial Kind="ArrowUp" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.MoveStyleDownCommand, ElementName=root}"
                                                                        ToolTip="{Binding [layerStyles_moveDown], Source={StaticResource Localization}}">
                                                                    <iconPacks:PackIconMaterial Kind="ArrowDown" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.RemoveStyleCommand, ElementName=root}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <iconPacks:PackIconMaterial Kind="Delete" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [layerStyles_delete], Source={StaticResource Localization}}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </WrapPanel>

                                                            <ListBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"
                                                                     MinHeight="120" MaxHeight="260" BorderThickness="1"
                                                                     BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                                                                     Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                                <ListBox.ItemContainerStyle>
                                                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
                                                                        <Setter Property="Padding" Value="6,3"/>
                                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                        <!--clicking or typing in a row's title selects that row, and it stays selected
                                                                            when the focus moves on to the buttons below (a focus trigger would not)-->
                                                                        <EventSetter Event="PreviewGotKeyboardFocus" Handler="OnStyleItemPreviewGotKeyboardFocus"/>
                                                                    </Style>
                                                                </ListBox.ItemContainerStyle>
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <DockPanel>
                                                                            <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Swatches}" VerticalAlignment="Center"
                                                                                          Width="72" Margin="0,0,8,0" FlowDirection="LeftToRight" ClipToBounds="True">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal"/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Image Source="{Binding}" Width="22" Height="16" Margin="0,0,2,0" Stretch="None"/>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding RuleCountText}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}">
                                                                                        <Style.Triggers>
                                                                                            <!--grey on the selection's accent fill is unreadable-->
                                                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                    Background="{DynamicResource MahApps.Brushes.Accent3}"
                                                                                    Visibility="{Binding IsDefault, Converter={StaticResource boolToVisibilityConverter}}">
                                                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" Margin="0"
                                                                                           Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"
                                                                                           Text="{Binding [layerStyles_defaultBadge], Source={StaticResource Localization}}"/>
                                                                            </Border>
                                                                            <TextBox Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}" VerticalAlignment="Center"
                                                                                     Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                                                                     mahApp:TextBoxHelper.Watermark="{Binding [layerStyles_titleWatermark], Source={StaticResource Localization}}"/>
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </DockPanel>

                                                        <!--the selected style's rules, as the map legend draws them-->
                                                        <Border Grid.Column="2" VerticalAlignment="Stretch" Padding="10,8"
                                                                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                                                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1"
                                                                CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                                                                           Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource MahApps.Brushes.Text}"
                                                                           Text="{Binding SelectedStyleLegendTitle}"/>
                                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="260">
                                                                    <ItemsControl ItemsSource="{Binding SelectedStyleLegendRows}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <DockPanel Margin="0,2">
                                                                                    <Image DockPanel.Dock="Left" Source="{Binding SwatchImage}" Width="32" Height="24" Margin="0,0,8,0"
                                                                                           Stretch="None" VerticalAlignment="Top"/>
                                                                                    <StackPanel VerticalAlignment="Center">
                                                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" Foreground="{DynamicResource MahApps.Brushes.Text}"
                                                                                                   Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="None"/>
                                                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" Text="{Binding FieldText}" TextWrapping="Wrap"
                                                                                                   Visibility="{Binding FieldText, Converter={StaticResource stringNotNullOrEmptyToVisibilityConverter}}"/>
                                                                                    </StackPanel>
                                                                                </DockPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </DockPanel>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!--Labels-->
                            <TabItem Header="{Binding [serverLayerSettings_tab_labels], Source={StaticResource Localization}}"
                                     Visibility="{Binding IsLayer, Converter={StaticResource boolToVisibilityConverter}}">
                                <ScrollViewer Style="{StaticResource tabScroll}">
                                    <StackPanel>
                                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}">
                                            <StackPanel>
                                                <CheckBox Style="{StaticResource formCheckBox}" IsChecked="{Binding IsLabeled}"
                                                          Content="{Binding [serverLayerSettings_field_hasLabels], Source={StaticResource Localization}}"/>
                                                <!--with SLD styles this label is not part of any style: it is drawn beside whichever is active-->
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" TextWrapping="Wrap" Margin="4,0,4,4"
                                                           Text="{Binding [layerStyles_labelsNote], Source={StaticResource Localization}}"
                                                           Visibility="{Binding HasSld, Converter={StaticResource boolToVisibilityConverter}}"/>
                                                <CheckBox Style="{StaticResource formCheckBox}" IsChecked="{Binding IsLabelOn}" IsEnabled="{Binding IsLabeled}"
                                                          Content="{Binding [serverLayerSettings_field_labelsOn], Source={StaticResource Localization}}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}" IsEnabled="{Binding IsLabeled}">
                                            <StackPanel>
                                                <Border Style="{StaticResource fieldCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_labelColumn], Source={StaticResource Localization}}"/>
                                                        <!--a list when the server knows the layer's fields, free text otherwise-->
                                                        <ComboBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}"
                                                                  ItemsSource="{Binding FieldNames}"
                                                                  SelectedItem="{Binding LabelColumn}"
                                                                  Visibility="{Binding HasFieldList, Converter={StaticResource boolToVisibilityConverter}}"/>
                                                        <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal.En}"
                                                                 Text="{Binding LabelColumn, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding HasFieldList, Converter={StaticResource boolToInverseVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource fieldCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_labelSize], Source={StaticResource Localization}}"/>
                                                        <mahApp:NumericUpDown Grid.Column="1" Style="{StaticResource numberBox}" Minimum="1" Maximum="72" Interval="1"
                                                                              Value="{Binding LabelSize}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource fieldCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_labelColor], Source={StaticResource Localization}}"/>
                                                        <mahApp:ColorPicker Grid.Column="1" Style="{StaticResource colorBox}"
                                                                            SelectedColor="{Binding LabelColor, Mode=TwoWay}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource fieldCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Text="{Binding [serverLayerSettings_field_zoomFrom], Source={StaticResource Localization}}"/>
                                                        <mahApp:NumericUpDown Grid.Column="1" Style="{StaticResource zoomBox}" Value="{Binding MinLabelZoomLevel}"/>
                                                        <TextBlock Grid.Column="2" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Margin="12,0,8,0"
                                                                   Text="{Binding [serverLayerSettings_field_zoomTo], Source={StaticResource Localization}}"/>
                                                        <mahApp:NumericUpDown Grid.Column="3" Style="{StaticResource zoomBox}" Value="{Binding MaxLabelZoomLevel}"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!--Loading: Cache or Live-->
                            <TabItem Header="{Binding [serverLayerSettings_tab_loading], Source={StaticResource Localization}}"
                                     Visibility="{Binding IsLayer, Converter={StaticResource boolToVisibilityConverter}}">
                                <ScrollViewer Style="{StaticResource tabScroll}">
                                    <StackPanel>
                                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}">
                                            <StackPanel>
                                                <RadioButton Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form}" GroupName="loadMode" IsChecked="{Binding IsCacheMode}" VerticalContentAlignment="Top">
                                                    <StackPanel Margin="0,2">
                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal.Bold}" Text="{Binding [serverLayerSettings_mode_cache], Source={StaticResource Localization}}"/>
                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                                                                   Text="{Binding [serverLayerSettings_mode_cacheDescription], Source={StaticResource Localization}}"/>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form}" GroupName="loadMode" IsChecked="{Binding IsLiveMode}" VerticalContentAlignment="Top" Margin="4,10,4,4">
                                                    <StackPanel Margin="0,2">
                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal.Bold}" Text="{Binding [serverLayerSettings_mode_live], Source={StaticResource Localization}}"/>
                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                                                                   Text="{Binding [serverLayerSettings_mode_liveDescription], Source={StaticResource Localization}}"/>
                                                    </StackPanel>
                                                </RadioButton>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" TextWrapping="Wrap" Margin="4,0"
                                                   Text="{Binding [serverLayerSettings_hint_appliesNext], Source={StaticResource Localization}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
