<maptor:NotifiableUserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.MapSidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="root"
             d:DesignHeight="600" d:DesignWidth="400">
    <maptor:NotifiableUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </maptor:NotifiableUserControl.Resources>

    <!--Docked beside the map, never over it: the map's extent ends where this panel starts.
        DockPanel mirrors with the flow direction, so Dock="Left" puts the resize edge on the side
        that faces the map in both layouts (the panel sits after the map: left of it in RTL).

        The panel is a card like the legend and the attribute table (Expander.Card): same surface,
        same 40 px header row, same 14 px semibold title. The resize edge sits in the gap between
        the map and the card and looks like the window's splitters (Thumb.PanelEdge).-->
    <DockPanel>

        <!--resize edge: drag to resize, double-click for PreferredWidth again-->
        <Thumb x:Name="resizeThumb" DockPanel.Dock="Left"
               Style="{StaticResource IRI.Maptor.Styles.Thumb.PanelEdge}"
               DragDelta="ResizeThumb_DragDelta"
               MouseDoubleClick="ResizeThumb_MouseDoubleClick"/>

        <!--Content area tinted neutral (Surface.Subtle), so the white step cards of the hosted views
            stand out; the header band is the accent tint, as on the legend and attribute table cards.-->
        <Border Background="{DynamicResource IRI.Maptor.Brushes.Surface.Subtle}"
                BorderBrush="{DynamicResource IRI.Maptor.Brushes.Surface.Border}"
                BorderThickness="{StaticResource IRI.Maptor.Styles.Thickness.Border}"
                CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"
                SnapsToDevicePixels="True">
            <DockPanel>
                <!--header row: icon, title, close, on the same accent-tinted band as the card headers,
                    compact like them (32 px, 13 px title; radius 5: the inner curve of the 6 px card's 1 px border)-->
                <Border DockPanel.Dock="Top" Background="{DynamicResource IRI.Maptor.Brushes.Accent.Tint}" CornerRadius="5,5,0,0">
                <DockPanel MinHeight="{StaticResource IRI.Maptor.Styles.Size.Control.Default}"
                           Margin="10,0,4,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                            Style="{StaticResource IRI.Maptor.Styles.Button.PanelClose}"
                            Click="CloseButton_Click"/>
                    <!--shown only when IconKind is set (code-behind)-->
                    <iconPacks:PackIconMaterial x:Name="headerIcon" DockPanel.Dock="Left" Visibility="Collapsed"
                                                Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CardHeader}"/>
                    <TextBlock Text="{Binding Title, ElementName=root}"
                               Style="{StaticResource IRI.Maptor.Styles.TextBlock}"
                               FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Body}" FontWeight="SemiBold"
                               Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource IRI.Maptor.Brushes.Accent.Tint.Border}"/>

                <!--the hosted view; PanelContent, not this control's own Content (that is the tree above).
                    No horizontal scrolling, as in the flyouts this replaces: the view takes the panel's width,
                    and wide tables scroll inside their own grids.-->
                <ScrollViewer x:Name="scrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Padding="8,6">
                    <ContentPresenter Content="{Binding PanelContent, ElementName=root}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</maptor:NotifiableUserControl>
