<maptor:NotifiableUserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.MapViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls" 
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Border>
        <Grid>
            <Canvas x:Name="mapView" Margin="0" ClipToBounds="True" FlowDirection="LeftToRight" Background="Transparent" />
            <!--screen-space marks above the map that take no mouse input (the snap marker); kept out of mapView,
                whose children the viewer adds, moves and clears with the layers-->
            <Canvas x:Name="mapOverlay" Margin="0" ClipToBounds="True" FlowDirection="LeftToRight" IsHitTestVisible="False" />
        </Grid>
    </Border>
</maptor:NotifiableUserControl>
