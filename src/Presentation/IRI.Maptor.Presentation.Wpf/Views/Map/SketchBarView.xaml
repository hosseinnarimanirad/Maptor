<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.SketchBarView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"        
            xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls" 
            xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
            xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
            xmlns:behaviors="clr-namespace:IRI.Maptor.Presentation.Wpf.Behaviors"
            xmlns:controls="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls"
            xmlns:models="clr-namespace:IRI.Maptor.Presentation.Wpf.Models"
            x:Name="root" FlowDirection="{Binding Path=CurrentFlowDirection, Source={x:Static localization:LocalizationManager.Instance}}"
            Visibility="{Binding ShowMapInfoPanel, Converter={StaticResource boolToVisibilityConverter}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <Style  TargetType="{x:Type ToggleButton}" x:Key="simpleToggle">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource IRI.Maptor.Brushes.Surface.Border}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Small}" MinHeight="28">
                                <ContentPresenter Margin="4,1" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Surface.Hover}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Accent.Tint}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource IRI.Maptor.Brushes.Accent.Tint.Border}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="{x:Type iconPacks:PackIconMaterial}" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
            <Style TargetType="{x:Type iconPacks:PackIconPhosphorIcons}" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.CircleLightButtonContent}"/>
            <Style TargetType="{x:Type Path}" BasedOn="{StaticResource circleButtonPath}"/>

            <!--the Persian font comes from the shared style's IsPersian trigger-->
            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource IRI.Maptor.Styles.TabItem}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--a card of the Maptor screen grammar floating over the map: white body, 1 px edge, 6 px corners, a shadow because
        it is over the map. Its place is the top centre; the header is its handle, so it can be dragged anywhere on the map
        (barOffset, in the code-behind), and put back with the header's button or a double click.-->
    <Border x:Name="bar" CornerRadius="6" BorderThickness="1" MinWidth="420" VerticalAlignment="Top" HorizontalAlignment="Center"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            BorderBrush="{DynamicResource IRI.Maptor.Brushes.Surface.Border}"
            Effect="{StaticResource IRI.Maptor.Effects.Elevation2}"
            Margin="0,8,0,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="barOffset"/>
        </Border.RenderTransform>
        <StackPanel >
            <!--the header: grip, what is being done, a note (how to finish, or the measure); details and back-to-its-place at the end-->
            <Border x:Name="header" Height="32" CornerRadius="5,5,0,0" Background="{DynamicResource IRI.Maptor.Brushes.Accent.Tint}"
                    BorderBrush="{DynamicResource IRI.Maptor.Brushes.Accent.Tint.Border}" BorderThickness="0,0,0,1"
                    Cursor="SizeAll" ToolTip="{Binding [sketchBar_move_tip], Source={StaticResource Localization}}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseMove="Header_MouseMove"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp" LostMouseCapture="Header_LostMouseCapture">
                <DockPanel Margin="2,0,6,0">
                    <!--details: point, part, coordinate system, measures-->
                    <Button DockPanel.Dock="Right" Style="{StaticResource IRI.Maptor.Styles.Button.PanelGhost}" Width="24" Height="24" Margin="2,0,0,0"
                            Cursor="Hand" Command="{Binding SketchBar.ToggleAdvancedVisibilityCommand}"
                            ToolTip="{Binding [sketchBar_details], Source={StaticResource Localization}}"
                            Visibility="{Binding SketchBar.Options.ShowAdvancedOptions, Converter={StaticResource boolToVisibilityConverter}}">
                        <Grid>
                            <iconPacks:PackIconMaterial Kind="ChevronDown" Width="12" Height="12" Margin="0" Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                                        Visibility="{Binding SketchBar.IsDetailsNotVisible, Converter={StaticResource boolToVisibilityConverter}}"/>
                            <iconPacks:PackIconMaterial Kind="ChevronUp" Width="12" Height="12" Margin="0" Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                                        Visibility="{Binding SketchBar.IsDetailsVisible, Converter={StaticResource boolToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!--the guide of drawing, snapping and editing (Guides/Drawing*.xaml)-->
                    <controls:GuideButton DockPanel.Dock="Right" Margin="2,0,0,0" Cursor="Hand"
                                          Source="/IRI.Maptor.Presentation.Wpf;component/Guides/Drawing"
                                          Title="{Binding [guide_drawing_title], Source={StaticResource Localization}}"/>
                    <!--shown only once the bar has been moved-->
                    <Button x:Name="resetPositionButton" DockPanel.Dock="Right" Style="{StaticResource IRI.Maptor.Styles.Button.PanelGhost}"
                            Width="24" Height="24" Margin="2,0,0,0" Cursor="Hand" Visibility="Collapsed" Click="ResetPosition_Click"
                            ToolTip="{Binding [sketchBar_move_reset], Source={StaticResource Localization}}">
                        <iconPacks:PackIconMaterial Kind="ArrowCollapseUp" Width="12" Height="12" Margin="0" Foreground="{DynamicResource MahApps.Brushes.Gray2}"/>
                    </Button>

                    <iconPacks:PackIconMaterial Kind="DragVertical" Width="14" Height="14" Margin="2,0" VerticalAlignment="Center"
                                                Foreground="{DynamicResource MahApps.Brushes.Gray5}"/>
                    <iconPacks:PackIconMaterial>
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CardHeader}">
                                <Setter Property="Kind" Value="VectorSquareEdit"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDrawMode}" Value="True">
                                        <Setter Property="Kind" Value="Draw"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SketchBar.Options.IsMeasureMode}" Value="True">
                                        <Setter Property="Kind" Value="Ruler"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                    <TextBlock Text="{Binding SketchBar.Title}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderTitle}"/>

                    <!--the note: how to finish a drawing; the length or area of a measure-->
                    <Grid Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [map_draw_newDrawing], Source={StaticResource Localization}}" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" Margin="0"
                                   Visibility="{Binding IsDrawMode, Converter={StaticResource boolToVisibilityConverter}}"/>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding CurrentEditingLayer}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.SketchBar.Options.IsMeasureMode, ElementName=root}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasArea, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False, FallbackValue=Collapsed}">
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" Margin="0"
                                           Text="{Binding GroundLength, Converter={StaticResource localizedNumberConverter}, ConverterParameter=N2}"/>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" Margin="4,0,0,0"
                                           Text="{Binding [common_meter], Source={StaticResource Localization}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasArea, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" Margin="0"
                                           Text="{Binding GroundArea, Converter={StaticResource localizedNumberConverter}, ConverterParameter=N1}"/>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" Margin="4,0,0,0"
                                           Text="{Binding [common_squareMeter], Source={StaticResource Localization}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <DockPanel Margin="6,4" >


                <!--snapping: on/off and the layers to snap to (the choice lives on SketchBar, so it holds across modes).
                    Shown while drawing (new points snap) and while editing (dragged vertices snap).-->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDrawMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SketchBar.Options.IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ToggleButton Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}" Margin="2"
                                  IsChecked="{Binding SketchBar.Snapping.IsEnabled, Mode=TwoWay}"
                                  ToolTip="{Binding [sketchBar_snapping_toggle], Source={StaticResource Localization}}">
                        <iconPacks:PackIconMaterial>
                            <iconPacks:PackIconMaterial.Style>
                                <Style TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}">
                                    <Setter Property="Kind" Value="MagnetOn"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                            <Setter Property="Kind" Value="Magnet"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconMaterial.Style>
                        </iconPacks:PackIconMaterial>
                    </ToggleButton>

                    <ToggleButton x:Name="snapLayersToggle" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}" Margin="0,2,2,2"
                                  IsEnabled="{Binding SketchBar.Snapping.IsEnabled}"
                                  ToolTip="{Binding [sketchBar_snapping_layers], Source={StaticResource Localization}}">
                        <iconPacks:Material Kind="ChevronDown"/>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=snapLayersToggle}"
                           PlacementTarget="{Binding ElementName=snapLayersToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Slide"
                           behaviors:PopupMenuBehavior.IsMenu="True"
                           behaviors:PopupMenuBehavior.CloseOnClick="False">
                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Popup}" MinWidth="200" MaxWidth="320"
                                DataContext="{Binding SketchBar.Snapping}"
                                FlowDirection="{Binding Path=CurrentFlowDirection, Source={x:Static localization:LocalizationManager.Instance}}">
                            <Border.Effect>
                                <StaticResource ResourceKey="IRI.Maptor.Effects.Elevation2"/>
                            </Border.Effect>
                            <StackPanel Margin="2">
                                <StackPanel.Resources>
                                    <!--the shared check box (body size, the Persian font). The captions are plain content,
                                        so the sketch bar's own accent-coloured TextBlock style does not reach them.-->
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource IRI.Maptor.Styles.CheckBox.Small}">
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                                    </Style>
                                    <Style x:Key="snapGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}">
                                        <Setter Property="Margin" Value="2,0,2,2"/>
                                    </Style>
                                    <!--a kind's caption: the marker the map shows for it, then its name-->
                                    <Style x:Key="snapKindName" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}">
                                        <Setter Property="Margin" Value="8,0,0,0"/>
                                    </Style>
                                    <Style x:Key="snapGlyph" TargetType="Shape">
                                        <Setter Property="Width" Value="10"/>
                                        <Setter Property="Height" Value="10"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Fill" Value="{DynamicResource IRI.Maptor.Brushes.OnMap.HandleFill}"/>
                                        <Setter Property="Stroke" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                        <Setter Property="StrokeThickness" Value="2"/>
                                    </Style>
                                    <Style x:Key="snapNote" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Margin" Value="2"/>
                                    </Style>
                                </StackPanel.Resources>

                                <!--the header and the tip: how snapping works and the keys that go with it. The tip is the
                                    place to teach (InfoTip), the tooltips stay short labels.-->
                                <DockPanel Margin="0,0,0,2">
                                    <controls:InfoTip DockPanel.Dock="Right" VerticalAlignment="Center"
                                                      Title="{Binding [sketchBar_snapping_tipTitle], Source={StaticResource Localization}}"
                                                      Text="{Binding [sketchBar_snapping_tipText], Source={StaticResource Localization}}"
                                                      Footer="{Binding [sketchBar_snapping_tipFooter], Source={StaticResource Localization}}">
                                        <controls:InfoTip.Examples>
                                            <models:InfoTipExampleCollection>
                                                <models:InfoTipExample Label="{Binding [sketchBar_snapping_tipPause], Source={StaticResource Localization}}" Value="Ctrl"/>
                                                <models:InfoTipExample Label="{Binding [sketchBar_snapping_tipSteps], Source={StaticResource Localization}}" Value="Shift"/>
                                                <models:InfoTipExample Label="{Binding [sketchBar_snapping_tipType], Source={StaticResource Localization}}" Value="L · A · B, Tab, Esc"/>
                                                <models:InfoTipExample Label="{Binding [sketchBar_snapping_tipFinish], Source={StaticResource Localization}}" Value="Enter · Backspace"/>
                                                <models:InfoTipExample Label="{Binding [sketchBar_snapping_tipUndo], Source={StaticResource Localization}}" Value="Ctrl+Z · Ctrl+Y"/>
                                            </models:InfoTipExampleCollection>
                                        </controls:InfoTip.Examples>
                                    </controls:InfoTip>
                                    <TextBlock Style="{StaticResource snapGroupHeader}" VerticalAlignment="Center"
                                               Text="{Binding [sketchBar_snapping_kinds], Source={StaticResource Localization}}"/>
                                </DockPanel>

                                <!--what to snap to: map settings (kept between sessions), reached through the sketch bar's
                                    own DataContext since this border's is the layer choice-->
                                <!--the kinds, in the order they win: a line end over a vertex over an intersection over a
                                    midpoint over an edge-->
                                <CheckBox IsChecked="{Binding DataContext.MapSettings.Snapping_ToEnds, ElementName=root, Mode=TwoWay}"
>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Style="{StaticResource snapGlyph}" Fill="{DynamicResource MahApps.Brushes.Highlight}" Stroke="{DynamicResource IRI.Maptor.Brushes.OnMap.HandleFill}" StrokeThickness="1.5"/>
                                        <TextBlock Style="{StaticResource snapKindName}" Text="{Binding [sketchBar_snapping_toEnds], Source={StaticResource Localization}}"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding DataContext.MapSettings.Snapping_ToVertices, ElementName=root, Mode=TwoWay}"
>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Style="{StaticResource snapGlyph}"/>
                                        <TextBlock Style="{StaticResource snapKindName}" Text="{Binding [sketchBar_snapping_toVertices], Source={StaticResource Localization}}"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding DataContext.MapSettings.Snapping_ToIntersections, ElementName=root, Mode=TwoWay}"
>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{x:Null}" Width="10" Height="10" VerticalAlignment="Center" Data="M 1,1 L 9,9 M 9,1 L 1,9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource MahApps.Brushes.Highlight}"/>
                                        <TextBlock Style="{StaticResource snapKindName}" Text="{Binding [sketchBar_snapping_toIntersections], Source={StaticResource Localization}}"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding DataContext.MapSettings.Snapping_ToMidpoints, ElementName=root, Mode=TwoWay}"
>
                                    <StackPanel Orientation="Horizontal">
                                        <Polygon Style="{StaticResource snapGlyph}" Points="5,1 9,9 1,9" StrokeLineJoin="Round"/>
                                        <TextBlock Style="{StaticResource snapKindName}" Text="{Binding [sketchBar_snapping_toMidpoints], Source={StaticResource Localization}}"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding DataContext.MapSettings.Snapping_ToEdges, ElementName=root, Mode=TwoWay}"
>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource snapGlyph}"/>
                                        <TextBlock Style="{StaticResource snapKindName}" Text="{Binding [sketchBar_snapping_toEdges], Source={StaticResource Localization}}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Horizontal}"/>

                                <!--the drawing aids on top of snapping: map settings too-->
                                <TextBlock Style="{StaticResource snapGroupHeader}"
                                           Text="{Binding [sketchBar_aids_header], Source={StaticResource Localization}}"/>

                                <CheckBox IsChecked="{Binding DataContext.MapSettings.Snapping_ShowGuides, ElementName=root, Mode=TwoWay}"
                                          ToolTip="{Binding [sketchBar_aids_guides_tip], Source={StaticResource Localization}}"
                                          Content="{Binding [sketchBar_aids_guides], Source={StaticResource Localization}}"/>
                                <CheckBox IsChecked="{Binding DataContext.MapSettings.Snapping_ShowCursorBox, ElementName=root, Mode=TwoWay}"
                                          ToolTip="{Binding [sketchBar_aids_cursorBox_tip], Source={StaticResource Localization}}"
                                          Content="{Binding [sketchBar_aids_cursorBox], Source={StaticResource Localization}}"/>

                                <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Horizontal}"/>

                                <TextBlock Style="{StaticResource snapGroupHeader}"
                                           Text="{Binding [sketchBar_snapping_layers], Source={StaticResource Localization}}"/>

                                <!--the user's drawings: one entry for all of them, above the layers-->
                                <CheckBox IsChecked="{Binding IsDrawingsChecked, Mode=TwoWay}"
                                          Content="{Binding [ui_header_drawingLegend], Source={StaticResource Localization}}"/>

                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsControl ItemsSource="{Binding Layers}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" Text="{Binding Name}"/>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Style="{StaticResource snapNote}"
                                           Text="{Binding [sketchBar_snapping_noLayers], Source={StaticResource Localization}}"
                                           Visibility="{Binding HasNoLayers, Converter={StaticResource boolToVisibilityConverter}}"/>

                                <TextBlock Style="{StaticResource snapNote}"
                                           Text="{Binding [sketchBar_snapping_tooMany], Source={StaticResource Localization}}"
                                           Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                           Visibility="{Binding IsOverLimit, Converter={StaticResource boolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>


                <!--link current point toggle-->
                <ToggleButton Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}" DockPanel.Dock="Left" HorizontalAlignment="Right" Margin="2" 
                                IsChecked="{Binding SketchBar.Options.IsLinkedToMouseMove, Mode=TwoWay}" 
                                Visibility="{Binding IsDrawMode, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}"
                                ToolTip="{Binding [mapPanel_currentPoint_linkToMouseMove], Source={StaticResource Localization}}">
                    <iconPacks:PackIconPhosphorIcons>
                        <iconPacks:PackIconPhosphorIcons.Style>
                            <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                <Setter Property="Kind" Value="LinkBreakBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                        <Setter Property="Kind" Value="LinkBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconPhosphorIcons.Style>
                    </iconPacks:PackIconPhosphorIcons>
                </ToggleButton>


                <!--input X-->
                <TextBlock DockPanel.Dock="Left" Text="X" Margin="8,0,4,0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" VerticalAlignment="Center"
                           Visibility="{Binding SketchBar.Options.IsManualInputAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                <TextBox DockPanel.Dock="Left"
                         MaxWidth="100"
                         MinWidth="100"
                         BorderThickness="1.5" 
                         Visibility="{Binding SketchBar.Options.IsManualInputAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource IRI.Maptor.Styles.TextBox.Normal.En}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=SketchBar.IsGeodeticWgs84EditingMode}" Value="True">
                                    <Setter Property="Text" Value="{Binding Path=SketchBar.CurrentEditingPoint.X, Mode=TwoWay, StringFormat={}{0:N6}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=SketchBar.IsGeodeticWgs84EditingMode}" Value="False">
                                    <Setter Property="Text" Value="{Binding Path=SketchBar.CurrentEditingPoint.X, Mode=TwoWay, StringFormat={}{0:N2}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                
                <!--input Y-->
                <TextBlock DockPanel.Dock="Left" Text="Y" Margin="8,0,4,0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" VerticalAlignment="Center"
                           Visibility="{Binding SketchBar.Options.IsManualInputAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                <TextBox DockPanel.Dock="Left" 
                         MaxWidth="100" 
                         MinWidth="100"
                         BorderThickness="1.5"
                         Visibility="{Binding SketchBar.Options.IsManualInputAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource IRI.Maptor.Styles.TextBox.Normal.En}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=SketchBar.IsGeodeticWgs84EditingMode}" Value="True">
                                    <Setter Property="Text" Value="{Binding Path=SketchBar.CurrentEditingPoint.Y, Mode=TwoWay, StringFormat={}{0:N6}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=SketchBar.IsGeodeticWgs84EditingMode}" Value="False">
                                    <Setter Property="Text" Value="{Binding Path=SketchBar.CurrentEditingPoint.Y, Mode=TwoWay, StringFormat={}{0:N2}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
  

                <!--Drawing-->
                <DockPanel DockPanel.Dock="Right" LastChildFill="False"
                            Visibility="{Binding IsDrawMode, Converter={StaticResource boolToVisibilityConverter}}">

                    <!--Add Point-->
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" DockPanel.Dock="Left" Margin="2" 
                            ToolTip="{Binding [map_draw_addPoint], Source={StaticResource Localization}}"
                            Command="{Binding AddPointToNewDrawingCommand}"
                            Visibility="{Binding SketchBar.Options.IsManualInputAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Material Kind="Plus"/>
                    </Button>

                    <!--Finish Drawing Part-->
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" DockPanel.Dock="Left" Margin="2,0,10,0" 
                            ToolTip="{Binding [map_draw_finishDrawingPart], Source={StaticResource Localization}}"
                            Command="{Binding FinishNewDrawingPartCommand}"
                            Visibility="{Binding SketchBar.Options.IsMultiPartSupportAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <!--same CirclesThreePlusFill as the map right-click "finish part"-->
                        <iconPacks:PhosphorIcons Kind="CirclesThreePlusFill"/>
                    </Button>

                    <!--Finish New Drawing-->
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" DockPanel.Dock="Right" Margin="2" 
                            ToolTip="{Binding [map_draw_finishDrawing], Source={StaticResource Localization}}"
                            Command="{Binding FinishNewDrawingCommand}" >
                        <iconPacks:Material Kind="CheckBold"/>
                    </Button>

                    <!--Cancel New Drawing-->
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" DockPanel.Dock="Right" Margin="2" 
                            ToolTip="{Binding [map_draw_cancelDrawing], Source={StaticResource Localization}}"
                            Command="{Binding CancelNewDrawingCommand}" >
                        <iconPacks:Material Kind="CloseThick"/>
                    </Button>
                </DockPanel>

                <TextBlock Text="{Binding SketchBar.Options.Status, FallbackValue=Error}" Foreground="Red" MinWidth="100"
                           Background="Yellow" Visibility="Collapsed" />

                <!--Editing. Groups: info (edge labels, ruler, details) | measure mode: to drawing | delete,
                    or edit mode: cancel, finish. Delete (measure mode) and cancel/finish (edit mode) are
                    never shown together, so delete is always the last button of the row.-->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding SketchBar.Options.IsEditing, Converter={StaticResource boolToVisibilityConverter}}">

                    <ToggleButton Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}" Margin="2"
                                    ToolTip="{Binding [mapPanel_edit_showEdgeLabels], Source={StaticResource Localization}}"
                                    IsChecked="{Binding SketchBar.Options.IsEdgeLabelVisible, Mode=TwoWay}"
                                    Visibility="{Binding SketchBar.Options.IsMeasureVisible, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Material Kind="MapMarkerDistance"/>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}" Margin="2"
                                    ToolTip="{Binding [mapPanel_measure_title], Source={StaticResource Localization}}"
                                    IsChecked="{Binding SketchBar.Options.IsMeasureVisible, Mode=TwoWay}" >
                        <iconPacks:Material Kind="Ruler"/>
                    </ToggleButton>

                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Margin="2"
                            Command="{Binding CurrentEditingLayer.ShowGeometryDetailsCommand}"
                            ToolTip="{Binding [mapPanel_edit_showGeometryDetails], Source={StaticResource Localization}}"
                            Visibility="{Binding SketchBar.Options.IsGeometryDetailsAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Material Kind="InformationOutline"/>
                    </Button>

                    <!--one of the two groups below always follows, so this divider is always needed-->
                    <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Vertical}" Margin="4,6"/>

                    <!--measure mode-->
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Margin="2"
                            Command="{Binding CurrentEditingLayer.ConvertToDrawingItemCommand}"
                            ToolTip="{Binding [mapPanel_edit_convertToDrawing], Source={StaticResource Localization}}"
                            Visibility="{Binding SketchBar.Options.IsMeasureMode, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <!--MapPinPlusFill is the drawing items symbol (legend title and every "to drawings" command)-->
                        <iconPacks:PhosphorIcons Kind="MapPinPlusFill"/>
                    </Button>

                    <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Vertical}" Margin="4,6"
                               Visibility="{Binding SketchBar.Options.IsMeasureMode, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}"/>

                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleDanger}" Margin="2"
                            Command="{Binding CurrentEditingLayer.DeleteCommand}"
                            ToolTip="{Binding [mapPanel_edit_delete], Source={StaticResource Localization}}"
                            Visibility="{Binding SketchBar.Options.IsMeasureMode, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Material Kind="TrashCanOutline"/>
                    </Button>

                    <!--edit mode-->
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Margin="2"
                            Command="{Binding CurrentEditingLayer.CancelEditingCommand}"
                            ToolTip="{Binding [mapPanel_edit_cancel], Source={StaticResource Localization}}"
                            Visibility="{Binding SketchBar.Options.IsMeasureMode, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False, FallbackValue=Collapsed}">
                        <iconPacks:Material Kind="CloseThick"/>
                    </Button>
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Margin="2"
                            Command="{Binding CurrentEditingLayer.FinishEditingCommand}"
                            ToolTip="{Binding [mapPanel_edit_finish], Source={StaticResource Localization}}"
                            Visibility="{Binding SketchBar.Options.IsMeasureMode, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False, FallbackValue=Collapsed}">
                        <iconPacks:Material Kind="CheckBold"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Border Height="1" Margin="0,0,0,4" Background="{DynamicResource IRI.Maptor.Brushes.Surface.Border}">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                        <Binding Path="SketchBar.Options.ShowAdvancedOptions"/>
                        <Binding Path="SketchBar.IsDetailsVisible"/>
                    </MultiBinding>
                </Border.Visibility>
            </Border>

            <!--tabs-->
            <!--centred track: this panel floats over the map rather than filling a dialog-->
            <TabControl SelectedIndex="2" Margin="6,0,6,6" Style="{StaticResource IRI.Maptor.Styles.TabControl.Centered}">
                <TabControl.Visibility>
                    <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                        <Binding Path="SketchBar.Options.ShowAdvancedOptions"/>
                        <Binding Path="SketchBar.IsDetailsVisible"/>
                    </MultiBinding>
                </TabControl.Visibility>
                <TabControl.Items>

                    <!--current point-->
                    <TabItem Header="{Binding [mapPanel_currentPoint_title], Source={StaticResource Localization}}"
                                Visibility="{Binding IsEditMode, Converter={StaticResource boolToVisibilityConverter}}" >
                        <StackPanel DataContext="{Binding CurrentEditingLayer}"
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource boolToVisibilityConverter}}">
                            <!--navigation | view, copy | delete-->
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                        ToolTip="{Binding [mapPanel_currentPoint_goToPreviousPoint], Source={StaticResource Localization}}"
                                        Command="{Binding GoToPreviousPointCommand}" >
                                <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ChevronPrevious}"/>
                            </Button>
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                        ToolTip="{Binding [mapPanel_currentPoint_goToNextPoint], Source={StaticResource Localization}}"
                                        Command="{Binding GoToNextPointCommand}" >
                                <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ChevronNext}"/>
                            </Button>

                            <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Vertical}" Margin="4,6"/>

                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                        ToolTip="{Binding [mapPanel_currentPoint_zoom], Source={StaticResource Localization}}"
                                        Command="{Binding ZoomToCurrentPointCommand}" >
                                <iconPacks:Material Kind="MagnifyExpand"/>
                            </Button>
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                        ToolTip="{Binding [geometryDetails_currentPoint_zoom], Source={StaticResource Localization}}"
                                        Command="{Binding PanToCurrentPointCommand}" >
                                <iconPacks:Material Kind="HandBackRight"/>
                            </Button>
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                        ToolTip="{Binding [mapPanel_currentPoint_copyCoordinate], Source={StaticResource Localization}}"
                                        Command="{Binding CopyCurrentPointCommand}"
                                        CommandParameter="{Binding DataContext.SketchBar.SpatialReference, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}">
                                <iconPacks:Material Kind="ContentCopy"/>
                            </Button>

                            <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Vertical}" Margin="4,6"/>

                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleDanger}"
                                        ToolTip="{Binding [mapPanel_currentPoint_delete], Source={StaticResource Localization}}"
                                        Command="{Binding DeleteCurrentPointCommand}" >
                                <iconPacks:Material Kind="TrashCanOutline"/>
                            </Button>
                        </StackPanel>
                    </TabItem>

                    <!--multi part-->
                    <TabItem Header="{Binding [mapPanel_currentPart_title], Source={StaticResource Localization}}">
                        <TabItem.Visibility>
                            <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                                <Binding Path="SketchBar.Options.IsMultiPartSupportAvailable"/>
                                <Binding Path="IsEditMode"/>
                            </MultiBinding>
                        </TabItem.Visibility>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    DataContext="{Binding CurrentEditingLayer}"
                                    Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource boolToVisibilityConverter}}">
                            <!--navigation | view, add | delete-->
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                    ToolTip="{Binding [mapPanel_currentPart_goToPreviousPart], Source={StaticResource Localization}}"
                                    Command="{Binding GoToPreviousPartCommand}"
                                    IsEnabled="{Binding IsPreviousPartAvailable}">
                                <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ChevronPrevious}"/>
                            </Button>
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                    ToolTip="{Binding [mapPanel_currentPart_goToNextPart], Source={StaticResource Localization}}"
                                    Command="{Binding GoToNextPartCommand}"
                                    IsEnabled="{Binding IsNextPartAvailable}">
                                <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ChevronNext}"/>
                            </Button>

                            <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Vertical}" Margin="4,6"/>

                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                    ToolTip="{Binding [mapPanel_currentPart_zoom], Source={StaticResource Localization}}"
                                    Command="{Binding ZoomToCurrentPartCommand}" >
                                <iconPacks:Material Kind="MagnifyExpand"/>
                            </Button>
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                    ToolTip="{Binding [mapPanel_currentPart_pan], Source={StaticResource Localization}}"
                                    Command="{Binding PanToCurrentPartCommand}" >
                                <iconPacks:Material Kind="HandBackRight"/>
                            </Button>
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" IsEnabled="False"
                                    ToolTip="{Binding [mapPanel_currentPart_add], Source={StaticResource Localization}}"
                                    Command="{Binding AddNewPartCommand}" Visibility="Collapsed">
                                <iconPacks:Material Kind="VectorSquarePlus"/>
                            </Button>

                            <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Vertical}" Margin="4,6"/>

                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleDanger}"
                                    ToolTip="{Binding [mapPanel_currentPart_delete], Source={StaticResource Localization}}"
                                    Command="{Binding DeleteCurrentPartCommand}" >
                                <iconPacks:Material Kind="TrashCanOutline"/>
                            </Button>
                        </StackPanel>
                    </TabItem>

                    <!--spatial reference system-->
                    <TabItem Header="{Binding [mapPanel_srs_title], Source={StaticResource Localization}}">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton GroupName="A" Style="{StaticResource simpleToggle}"
                                        ToolTip="{Binding [srs_geodeticWgs84Title], Source={StaticResource Localization}}" 
                                        IsChecked="{Binding SketchBar.IsGeodeticWgs84EditingMode, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <iconPacks:PackIconMaterial Kind="Earth" Width="14" Height="14" Margin="0 0 6 0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                                    <TextBlock Text="WGS84" Margin="2" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="A" Style="{StaticResource simpleToggle}"
                                        ToolTip="{Binding [srs_utmTitle], Source={StaticResource Localization}}"
                                        IsChecked="{Binding SketchBar.IsUTMEditingMode, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <iconPacks:PackIconMaterial Kind="EarthBox" Width="14" Height="14" Margin="0 0 6 0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                                    <TextBlock Text="UTM" Margin="2" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                                </StackPanel>
                            </RadioButton>
                            <TextBlock DockPanel.Dock="Left" Margin="4"
                                        Visibility="{Binding SketchBar.IsUTMEditingMode, Converter={StaticResource boolToVisibilityConverter}}"
                                        Text="{Binding [srs_utmZone], Source={StaticResource Localization}}"/>
                            <TextBox DockPanel.Dock="Left" BorderThickness="1" FlowDirection="LeftToRight" MinWidth="30" Margin="2" VerticalAlignment="Center"
                                        Text="{Binding SketchBar.CurrentEditingZone, Mode=TwoWay}" MaxWidth="40"
                                        mahApp:ControlsHelper.CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Small}"
                                        Style="{StaticResource IRI.Maptor.Styles.TextBox.Small.En}"
                                        Visibility="{Binding SketchBar.IsUTMEditingMode, Converter={StaticResource boolToVisibilityConverter}}">
                            </TextBox>
                        </StackPanel>
                    </TabItem>

                    <!--measure-->
                    <TabItem Header="{Binding [mapPanel_measure_title], Source={StaticResource Localization}}"
                             Visibility="{Binding IsEditMode, Converter={StaticResource boolToVisibilityConverter}}">
                        <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource boolToVisibilityConverter}}">
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="headerTitle" TargetType="TextBlock" BasedOn="{StaticResource MahApps.Styles.TextBlock}">
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                                    <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Body}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="headerBorder" TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Accent.Tint}"/>
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Small}"/>
                                </Style>
                            </StackPanel.Resources>
                            <!--general group-->
                            <GroupBox Header="{Binding [mapPanel_measure_generalTitle], Source={StaticResource Localization}}"
                                      Visibility="{Binding IsEditMode, Converter={StaticResource boolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapPanel_measure_scaleFactor], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentEditingLayer.ScaleFactor, Converter={StaticResource localizedNumberConverter}, ConverterParameter=N5}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2"  FontWeight="Bold" Text="{Binding [mapPanel_measure_meanHeight], Source={StaticResource Localization}}"/>
                                    <DockPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" LastChildFill="True">
                                        <TextBlock Text="(m)" DockPanel.Dock="Right"/>
                                        <TextBox Text="{Binding CurrentEditingLayer.Height, StringFormat={}{0:N0}}"
                                                 DockPanel.Dock="Right" Margin="4" Width="50" VerticalAlignment="Center"
                                                 Style="{StaticResource IRI.Maptor.Styles.TextBox.Small.En}" BorderThickness="1"/>
                                        <Slider Margin="2" Minimum="0" Maximum="5000" Value="{Binding CurrentEditingLayer.Height, UpdateSourceTrigger=PropertyChanged}" MinWidth="70"/>
                                    </DockPanel>
                                </Grid>
                            </GroupBox>
                            <!--length-->
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [mapPanel_measure_lengthTitle], Source={StaticResource Localization}}"
                                                   Style="{StaticResource headerTitle}"/>
                                        <TextBlock Text=":" Style="{StaticResource headerTitle}"/>
                                        <Border Style="{StaticResource headerBorder}">
                                            <TextBlock Text="{Binding CurrentEditingLayer.GroundLength, Converter={StaticResource localizedNumberConverter}, FallbackValue=صفر}"
                                                        Style="{StaticResource headerTitle}"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource headerTitle}"
                                                   Text="{Binding [common_meter], Source={StaticResource Localization}}"/>
                                    </StackPanel>
                                </Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapPanel_measure_euclideanLengthUtm], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Normal" Text="{Binding CurrentEditingLayer.EuclideanLengthInUtm, Converter={StaticResource localizedNumberConverter}}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" FontWeight="Bold" Text="{Binding [mapPanel_measure_ellipsoidalLength], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" FontWeight="Normal" Text="{Binding CurrentEditingLayer.EllipsoidalLength, Converter={StaticResource localizedNumberConverter}}"
                                               HorizontalAlignment="Right"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapPanel_measure_euclideanLengthUtmRefined], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="Normal" Text="{Binding CurrentEditingLayer.EuclideanLengthInUtm_Refined, Converter={StaticResource localizedNumberConverter}}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" FontWeight="Bold" Text="{Binding [mapPanel_measure_sphericalLength], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" FontWeight="Normal" Text="{Binding CurrentEditingLayer.SphericalLength, Converter={StaticResource localizedNumberConverter}}"
                                               HorizontalAlignment="Right"/>

                                </Grid>
                            </Expander>
                            <!--area-->
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [mapPanel_measure_areaTitle], Source={StaticResource Localization}}"
                                                    Style="{StaticResource headerTitle}"/>
                                        <TextBlock Text=":" Style="{StaticResource headerTitle}"/>
                                        <Border Style="{StaticResource headerBorder}">
                                            <TextBlock Style="{StaticResource headerTitle}"
                                                       Text="{Binding CurrentEditingLayer.GroundArea, Converter={StaticResource localizedNumberConverter}, ConverterParameter=N1, FallbackValue='صفر'}"
                                                       Background="Transparent"
                                                       ToolTip="{Binding [mapPanel_measure_groundArea], Source={StaticResource Localization}}"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource headerTitle}"
                                                    Text="{Binding [common_squareMeter], Source={StaticResource Localization}}"/>
                                    </StackPanel>
                                </Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapPanel_measure_euclideanAreaUtm], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Normal" Text="{Binding CurrentEditingLayer.EuclideanArea, Converter={StaticResource localizedNumberConverter}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" FontWeight="Bold" Text="{Binding [mapPanel_measure_ellipsoidalArea], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" FontWeight="Normal" Text="{Binding CurrentEditingLayer.EllipsoidalArea, Converter={StaticResource localizedNumberConverter}}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapPanel_measure_authalicSphereArea], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="Normal" Text="{Binding CurrentEditingLayer.AuthalicSphereArea, Converter={StaticResource localizedNumberConverter}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" FontWeight="Bold" Text="{Binding [mapPanel_measure_karneyArea], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" FontWeight="Normal" Text="{Binding CurrentEditingLayer.KarneyArea, Converter={StaticResource localizedNumberConverter}}"/>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </TabItem>

                </TabControl.Items>
            </TabControl>

        </StackPanel>
    </Border>
</UserControl>
