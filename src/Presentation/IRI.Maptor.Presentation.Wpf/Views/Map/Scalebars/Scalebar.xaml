<maptor:NotifiableUserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Scalebar" x:Name="layoutRoot"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls" 
                                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                                    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
                                    xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls"
                                    Background="Transparent"
                                    Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                    Width="auto" Height="auto" >
    <maptor:NotifiableUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Fonts.xaml"/>
                <!--<ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.Button.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.ToggleButton.xaml"/>-->
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </maptor:NotifiableUserControl.Resources>
    <Border BorderThickness="1" CornerRadius="3" >
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>

                <Setter Property="Opacity" Value="0.8"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
           
            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Center" 
                        Visibility="{Binding ElementName=layoutRoot, Path=ShowScaleValue, Converter={StaticResource boolToVisibilityConverter}}">
                <TextBlock Text="{Binding [map_scalebar_content], Source={StaticResource Localization}, StringFormat={}{0}:}"/>
                <TextBlock HorizontalAlignment="Center" Text="{Binding ElementName=layoutRoot, Path=CurrentScaleText, FallbackValue=1:~}" Margin="2,0,0,0"/>
                <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Center" Margin="4,0"
                            Visibility="{Binding ElementName=layoutRoot, Path=ShowZoomLevel, Converter={StaticResource boolToVisibilityConverter}}">
                    <TextBlock Text="("/>
                    <TextBlock Text="{Binding [map_scalebar_zoomLevel], Source={StaticResource Localization}, StringFormat={}{0}}"/>
                    <TextBlock Text="{Binding ElementName=layoutRoot, Path=ZoomLevel, StringFormat={}{0}, Converter={StaticResource localizedNumberConverter}, ConverterParameter=N0, FallbackValue=-1}" Margin="4,0,0,0"/>
                    <TextBlock Text=")"/>
                </StackPanel>
            </StackPanel>

            <!--scalebar sample length-->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" >
                <StackPanel VerticalAlignment="Center">
                    <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="2,0,2,2" Height="8" Margin="0" CornerRadius="1" 
                            Width="{Binding ElementName=layoutRoot, Path=ScaleBarLength, FallbackValue=120}" 
                            Visibility="{Binding ElementName=layoutRoot, Path=IsGoogleStyle, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=true}"/>
                    <Border BorderBrush="{DynamicResource MahApps.Brushes.Highlight}" BorderThickness="0.5" VerticalAlignment="Center"
                            Visibility="{Binding ElementName=layoutRoot, Path=IsGoogleStyle, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=false}">
                        <Grid Width="{Binding ElementName=layoutRoot, Path=ScaleBarLength, FallbackValue=120}" Height="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource MahApps.Brushes.Highlight}" Grid.Row="0" Grid.Column="0"/>
                            <Border Background="{DynamicResource MahApps.Brushes.Highlight}" Grid.Row="1" Grid.Column="1"/>
                            <Border Background="{DynamicResource MahApps.Brushes.Highlight}" Grid.Row="0" Grid.Column="2"/>
                            <Border Background="{DynamicResource MahApps.Brushes.Highlight}" Grid.Row="1" Grid.Column="3"/>

                            <Border Background="{DynamicResource MahApps.Brushes.Highlight}" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="4"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding ElementName=layoutRoot, Path=GroundLength, FallbackValue=0, Converter={StaticResource localizedNumberConverter}}"
                           FlowDirection="LeftToRight" Margin="2,0" />
            </StackPanel>

            <!--settings-->
            <ToggleButton Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Bottom" 
                          Height="18" Width="18"
                          Visibility="{Binding ElementName=layoutRoot, Path=IsMouseOver, Converter={StaticResource boolToVisibilityConverter}}"
                          IsChecked="{Binding ElementName=layoutRoot, Path=ShowOptions, Mode=TwoWay}"
                          Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}">
                <Viewbox>
                    <iconPacks:PackIconMaterial Kind="Cog" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                </Viewbox>
            </ToggleButton>
        </Grid>
    </Border>
</maptor:NotifiableUserControl>
