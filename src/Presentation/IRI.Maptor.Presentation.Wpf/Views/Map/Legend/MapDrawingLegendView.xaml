<maptor:NotifiableUserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.MapDrawingLegendView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls" 
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" 
                xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
                mc:Ignorable="d" x:Name="root"
                Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
                </ResourceDictionary.MergedDictionaries>
                <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

                <Style TargetType="{x:Type iconPacks:PackIconMaterial}" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>

                <!--The selector behind each drawing item in the list below. Keyed rather than implicit:
                    as an implicit style it also reached every unstyled ToggleButton inside MapLegendItemView,
                    which sits in the ItemTemplate and so resolves resources through this dictionary.-->
                <Style x:Key="drawingItemSelector" TargetType="ToggleButton">
                    <Setter Property="BorderThickness" Value="4,0,0,0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                                    
                                    <ContentPresenter
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsChecked" Value="True">

                            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="LightGray"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="Expander" x:Key="toggleHorizontalExpander">
                    <Setter Property="ExpandDirection" Value="Right"/>
                    <Setter Property="Margin" Value="8,0,0,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Expander">
                                <!--Height 38 = 1px border + 36 content + 1px border. The content buttons are
                                    32x32 with Margin=2, so they need exactly 36; anything less clips them.
                                    Padding is left-only because the trailing button's own 2px margin already
                                    supplies the right inset, which keeps the collapsed pill a true 38x38 circle.-->
                                <Border x:Name="expanderBorder"
                                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource MahApps.Brushes.Accent2}"
                                    Margin="0" Height="38" Padding="2,0,0,0" CornerRadius="19">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.18" Color="Black"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" Margin="0">
                                        <ToggleButton x:Name="HeaderSite"
                                                      Margin="0,0,2,0" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleDark}"                                   
                                                      Width="32" Height="32"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <!--<ToggleButton.Style >
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource MahApps.Styles.ToggleButton.Circle}">
                                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Width" Value="32"/>
                                                    <Setter Property="Height" Value="32"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Opacity" Value="0.9"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>-->
                                            <ContentPresenter ContentSource="Header"/>
                                        </ToggleButton>
                                        <!--<iconPacks:PackIconMaterial Kind="ChevronDoubleLeft" Width="8" Height="8" HorizontalAlignment="Center" Margin="4,0,8,0"
                                                                    Foreground="{DynamicResource MahApps.Brushes.Highlight}" Opacity="1"
                                                                    Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource boolToVisibilityConverter}}"/>
                                        <iconPacks:PackIconMaterial Kind="ChevronDoubleRight" Width="8" Height="8" HorizontalAlignment="Center" Margin="4,0,8,0"
                                                                    Foreground="{DynamicResource MahApps.Brushes.Highlight}" Opacity="1"
                                                                    Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False}"/>-->

                                        <!--The separator lives inside this host rather than beside it so that it
                                            scales and fades with the content instead of occupying 1px while collapsed.
                                            LayoutTransform (not RenderTransform) so the outer StackPanel/DockPanel
                                            reflow as ScaleX grows: no reserved gap, no clipping needed.
                                            ScaleX is animated 0<->1 by the IsExpanded trigger below.-->
                                        <StackPanel x:Name="ExpandHost"
                                              Orientation="Horizontal"
                                              Opacity="0"
                                              Visibility="Collapsed">
                                            <StackPanel.LayoutTransform>
                                                <ScaleTransform ScaleX="0"/>
                                            </StackPanel.LayoutTransform>

                                            <Border Width="1" Margin="0,7"
                                                    Background="{DynamicResource MahApps.Brushes.Accent2}"/>

                                            <ContentPresenter x:Name="ExpandSite"
                                                  ContentSource="Content"
                                                  Margin="0"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!--Visibility is driven by the storyboards below, not by a Setter: a Setter
                                        would snap the content away at the start of the collapse. It still has to
                                        be set, though - a zero-scaled ExpandHost has no size but stays tab-focusable.
                                        Collapse is deliberately faster than expand so that swapping between the two
                                        expanders shrinks before it grows, which keeps the centred DockPanel steady.-->
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="HeaderSite" Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight }"/>

                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandHost"
                                                                                   Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <DoubleAnimation Storyboard.TargetName="ExpandHost"
                                                                     Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
                                                                     To="1" Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ExpandHost"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.22"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>

                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <!--The 0:0:0 Visible frame is required: with only the closing
                                                        frame, the animation reports the base value (Collapsed) for
                                                        the whole run and the content vanishes instantly.-->
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandHost"
                                                                                   Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <DoubleAnimation Storyboard.TargetName="ExpandHost"
                                                                     Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
                                                                     To="0" Duration="0:0:0.14">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ExpandHost"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.14"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!--<Style TargetType="Path" x:Key="buttonPath">
                    <Setter Property="Stretch" Value="Uniform"/>
                    <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                    <Setter Property="Width" Value="18"/>
                    <Setter Property="Height" Value="18"/>
                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                </Style>-->


                <!--<Style x:Key="circleButtonDarkOverride" TargetType="{x:Type Button}" BasedOn="{StaticResource IRI.Maptor.Styles.Button.CircleDark}" >
                    <Setter Property="Margin" Value="1"/>
                </Style>-->


                <CollectionViewSource x:Key="drawingItemsViewSource" Source="{Binding DrawingItems}" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding ElementName=root, Path=ShowTools, Converter={StaticResource boolToVisibilityConverter}}">
            <Border Background="{DynamicResource MahApps.Brushes.Accent3}"
                    Margin="2" CornerRadius="4">
                <DockPanel Margin="4" HorizontalAlignment="Left" >
                    <!--<Button Command="{Binding MoveDrawingItemUpCommand}"
                            Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                            ToolTip="{Binding [cmd_drawingLegend_moveUp], Source={StaticResource Localization}}" 
                            IsEnabled="{Binding CanMoveDrawingItemUp}">
                        <iconPacks:PackIconMaterial Kind="ArrangeBringForward" />
                    </Button>
                    <Button Command="{Binding MoveDrawingItemDownCommand}"
                            Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                            ToolTip="{Binding [cmd_drawingLegend_moveDown], Source={StaticResource Localization}}"                  
                            IsEnabled="{Binding CanMoveDrawingItemDown}">
                        <iconPacks:PackIconMaterial Kind="ArrangeSendBackward" />
                    </Button>-->
                    <Button Command="{Binding SaveDrawingItemFileCommand}"
                            Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"  
                            ToolTip="{Binding [cmd_drawingLegend_saveAll], Source={StaticResource Localization}}">
                        <iconPacks:PackIconMaterial Kind="ContentSaveAll"/>
                    </Button>
                    <Button Command="{Binding OpenDrawingItemFileCommand}"
                                Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"  
                                ToolTip="{Binding [cmd_drawingLegend_openAll], Source={StaticResource Localization}}">
                        <iconPacks:PackIconMaterial Kind="FileMultiple" />
                    </Button>
                    
                    <Expander Style="{StaticResource toggleHorizontalExpander}"
                            IsExpanded="{Binding ElementName=root, Path=SelectedExpanderIndex, Converter={StaticResource indexToBoolConverter}, ConverterParameter=1}">
                        <Expander.Header>
                            <iconPacks:PackIconMaterial Kind="FilePlusOutline" Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                        </Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="0" VerticalAlignment="Center" >
 
                            <Button Command="{Binding AddGeoJsonToDrawingItemsCommand}"
                                Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"                                
                                ToolTip="{Binding [cmd_general_addGeoJson], Source={StaticResource Localization}}">
                                <Path Style="{StaticResource IRI.Maptor.Styles.Path.ButtonContent}" Data="{StaticResource json}"/>
                            </Button>
                            <Button Command="{Binding AddLongLatTxtToDrawingItemsCommand}"
                                Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"                                
                                ToolTip="{Binding [cmd_drawingLegend_addLatLongTxt], Source={StaticResource Localization}}">
                                <Path Style="{StaticResource IRI.Maptor.Styles.Path.ButtonContent}" Data="{StaticResource txt}"/>
                            </Button>
                            <Button Command="{Binding AddShapefileToDrawingItemsCommand}"
                                Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"                                
                                ToolTip="{Binding [cmd_general_addShapefile], Source={StaticResource Localization}}">
                                <Path Style="{StaticResource IRI.Maptor.Styles.Path.ButtonContent}" Data="{StaticResource shp}" />
                            </Button>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource toggleHorizontalExpander}"  
                            IsExpanded="{Binding ElementName=root, Path=SelectedExpanderIndex, Converter={StaticResource indexToBoolConverter}, ConverterParameter=2}">
                        <Expander.Header>
                            <iconPacks:PackIconMaterial Kind="PencilPlus" Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                        </Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                IsChecked="{Binding IsDrawPointMode, Mode=TwoWay}"
                                ToolTip="{Binding [cmd_general_drawPoint], Source={StaticResource Localization}}"  >
                                <iconPacks:PackIconMaterial Kind="VectorPointPlus" Width="14"/>
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                IsChecked="{Binding IsDrawPolylineMode, Mode=TwoWay}"
                                ToolTip="{Binding [cmd_general_drawPolyline], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="VectorPolylinePlus"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                IsChecked="{Binding IsDrawRectangleMode, Mode=TwoWay}"
                                ToolTip="{Binding [cmd_general_drawRectangle], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="ShapeRectanglePlus"/>
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                IsChecked="{Binding IsDrawPolygonMode, Mode=TwoWay}"
                                ToolTip="{Binding [cmd_general_drawPolygon], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="ShapePolygonPlus"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                IsChecked="{Binding IsDrawTextMode, Mode=TwoWay}"
                                ToolTip="{Binding [cmd_general_addTextToMap], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="FormatAnnotationPlus"/>
                            </ToggleButton>
                        </StackPanel>
                    </Expander>

                </DockPanel>
            </Border>
        </ScrollViewer>

        <Line Grid.Row="1" X1="0" X2="100" Stretch="Fill" Opacity="1" Margin="0,4" 
              StrokeThickness="1"
              StrokeDashArray="8 2"
              Stroke="{DynamicResource MahApps.Brushes.Highlight}" 
              Visibility="{Binding ElementName=root, Path=ShowTools, Converter={StaticResource boolToVisibilityConverter}}"/>

        <ListBox Grid.Row="2" ItemsSource="{Binding Source={StaticResource drawingItemsViewSource}}" SelectionMode="Single" SelectedItem="{Binding SelectedDrawingItem, Mode=TwoWay}">
            <ListBox.ItemContainerStyle>
                <!-- Style to get rid of the selection visual -->
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="IsSelected" Value="{Binding IsSelectedInToc, Mode=TwoWay}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <!--<ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>-->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--GroupName="{Binding ElementName=root, Path=GroupName}"-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--<TextBlock Grid.Column="0" Text="{Binding ZIndex}" Margin="4"/>-->
                        <RadioButton Grid.Column="1" Style="{StaticResource drawingItemSelector}"
                                 DataContext="{Binding }"
                                 IsChecked="{Binding IsSelectedInToc, Mode=TwoWay}">
                            <maptor:MapLegendItemView ShowReloadData="False" ShowMoreOptions="False"                                                 
                                                Symbology="{Binding DefaultSymbology}"  
                                                IsEditable="True" Commands="{Binding Commands}" 
                                                IsChecked="{Binding IsSelectedInToc}"
                                                TitleFontSize="{Binding RelativeSource={RelativeSource AncestorType=maptor:MapDrawingLegendView}, Path=TitleFontSize}"/>
                        </RadioButton>

                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</maptor:NotifiableUserControl>
