<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.DottedBusyIndicatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             
             xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
             Name="root">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--for the IRI.Maptor.Styles.Size.Text.* type scale used below. A StaticResource
                resolves only within its own scope chain, so declaring the merge here means this
                view does not depend on the host having merged Maptor.All.xaml.-->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center" >
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Rectangle.Loaded">
                    <BeginStoryboard>
                        <Storyboard Name="waitingAnimation" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="Dot1" BeginTime="0:0:0.1" Storyboard.TargetProperty="Opacity" From="0" To="1" AutoReverse="True" Duration="0:0:0.6"/>
                            <DoubleAnimation Storyboard.TargetName="Dot2" BeginTime="0:0:0.2" Storyboard.TargetProperty="Opacity" From="0" To="1" AutoReverse="True" Duration="0:0:0.6"/>
                            <DoubleAnimation Storyboard.TargetName="Dot3" BeginTime="0:0:0.3" Storyboard.TargetProperty="Opacity" From="0" To="1" AutoReverse="True" Duration="0:0:0.6"/>
                            <DoubleAnimation Storyboard.TargetName="Dot4" BeginTime="0:0:0.4" Storyboard.TargetProperty="Opacity" From="0" To="1" AutoReverse="True" Duration="0:0:0.6"/>
                            <DoubleAnimation Storyboard.TargetName="Dot5" BeginTime="0:0:0.5" Storyboard.TargetProperty="Opacity" From="0" To="1" AutoReverse="True" Duration="0:0:0.6"/>
                            <DoubleAnimation Storyboard.TargetName="Dot6" BeginTime="0:0:0.6" Storyboard.TargetProperty="Opacity" From="0" To="1" AutoReverse="True" Duration="0:0:0.6"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>

            <Ellipse Name="Dot1" Opacity="0"
                     Fill="{Binding ElementName=root, Path=DotBrush}"
                     Width="{Binding ElementName=root, Path=DotSize}"
                     Height="{Binding ElementName=root, Path=DotSize}"/>

            <Ellipse Name="Dot2" Opacity="0" Margin="4,0,0,0"
                     Fill="{Binding ElementName=root, Path=DotBrush}"
                     Width="{Binding ElementName=root, Path=DotSize}"
                     Height="{Binding ElementName=root, Path=DotSize}"/>

            <Ellipse Name="Dot3" Opacity="0" Margin="4,0,0,0"
                     Fill="{Binding ElementName=root, Path=DotBrush}"
                     Width="{Binding ElementName=root, Path=DotSize}"
                     Height="{Binding ElementName=root, Path=DotSize}"/>

            <Ellipse Name="Dot4" Opacity="0" Margin="4,0,0,0"
                     Fill="{Binding ElementName=root, Path=DotBrush}"
                     Width="{Binding ElementName=root, Path=DotSize}"
                     Height="{Binding ElementName=root, Path=DotSize}"/>

            <Ellipse Name="Dot5" Opacity="0" Margin="4,0,0,0"
                     Fill="{Binding ElementName=root, Path=DotBrush}"
                     Width="{Binding ElementName=root, Path=DotSize}"
                     Height="{Binding ElementName=root, Path=DotSize}" />

            <Ellipse Name="Dot6" Opacity="0" Margin="4,0,0,0"
                     Fill="{Binding ElementName=root, Path=DotBrush}"
                     Width="{Binding ElementName=root, Path=DotSize}"
                     Height="{Binding ElementName=root, Path=DotSize}" />
        </StackPanel>
        <TextBlock Text="{Binding [common_loadingText], Source={StaticResource Localization}}"
                Foreground="White"
                FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.BodyLarge}"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"                
                Visibility="{Binding ElementName=root, Path=ShowLoadingText, Converter={StaticResource boolToVisibilityConverter}}"/>
    </StackPanel>
</UserControl>
