<mahApp:MetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.GuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"

    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Localized}"
    Width="1000" Height="720" MinWidth="620" MinHeight="360"
    SizeToContent="Manual" ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False" ShowMinButton="False" ShowMaxRestoreButton="True"
    GlowBrush="{DynamicResource MahApps.Brushes.Highlight}"
    WindowStartupLocation="CenterOwner">

    <!--Modeless reader for a guide page (a FlowDocument). Not MetroWindow.Dialog: that style pins MaxWidth 550 and
        SizeToContent, and a guide is read beside the tool it explains. See GuideWindow.xaml.cs.

        A page with two or more main headings gets a contents list on the reading-start side (left in English,
        right in Persian, through the window's flow direction) and shows one section at a time, with previous/next
        buttons under it; "Show all" brings back the whole page, and the list then jumps to a heading.-->

    <mahApp:MetroWindow.Resources>
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
    </mahApp:MetroWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="contentsColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--contents-->
        <DockPanel x:Name="contentsPane" Grid.Column="0" Background="{DynamicResource MahApps.Brushes.Gray10}">
            <TextBlock DockPanel.Dock="Top" Margin="16,18,16,8"
                       FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                       Text="{Binding [guide_contents], Source={StaticResource Localization}}"/>

            <CheckBox x:Name="showAllCheck" DockPanel.Dock="Bottom" Margin="16,8,16,14"
                      Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}"
                      Content="{Binding [guide_showAll], Source={StaticResource Localization}}"
                      Checked="ShowAll_Changed" Unchecked="ShowAll_Changed"/>

            <ListBox x:Name="contentsList" Margin="8,0"
                     Style="{StaticResource IRI.Maptor.Styles.ListBox.Plain}"
                     ItemContainerStyle="{StaticResource IRI.Maptor.Styles.ListBoxItem.Row}"
                     SelectionChanged="ContentsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!--page-->
        <DockPanel Grid.Column="1">
            <Grid x:Name="footer" DockPanel.Dock="Bottom" Margin="36,6,36,14">
                <Button x:Name="previousButton" HorizontalAlignment="Left" MaxWidth="320"
                        Style="{StaticResource IRI.Maptor.Styles.Button.Secondary}"
                        ToolTip="{Binding [guide_previous], Source={StaticResource Localization}}"
                        Click="PreviousButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                                    Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ChevronPrevious.Plain}"/>
                        <TextBlock x:Name="previousText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="nextButton" HorizontalAlignment="Right" MaxWidth="320"
                        Style="{StaticResource IRI.Maptor.Styles.Button.Secondary}"
                        ToolTip="{Binding [guide_next], Source={StaticResource Localization}}"
                        Click="NextButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="nextText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <iconPacks:PackIconMaterial Width="10" Height="10" VerticalAlignment="Center" Margin="8,0,0,0"
                                                    Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ChevronNext.Plain}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!--no toolbar: text selection, copy and Ctrl + mouse wheel zoom still work; the built-in find/zoom bar does
                not follow the dark theme-->
            <FlowDocumentScrollViewer x:Name="viewer"
                                      IsToolBarVisible="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Focusable="True"
                                      Background="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
        </DockPanel>
    </Grid>
</mahApp:MetroWindow>
