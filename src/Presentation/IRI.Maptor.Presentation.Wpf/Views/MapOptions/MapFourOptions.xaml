<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.MapOptions.MapFourOptions"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                Width="150" Height="130" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/MapOptionStyles.xaml"/>
    </UserControl.Resources>
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform/>
        </TransformGroup>
    </UserControl.RenderTransform>

    <Grid Margin="0">

        <Ellipse Width="8" Height="8" Opacity=".6" Fill="{DynamicResource MahApps.Brushes.Highlight}"  Margin="0" Stroke="White" StrokeThickness="2"/>

        <Button Name="rightButton" Style="{StaticResource IRI.Maptor.Styles.Button.MapOption}" Command="{Binding RightCommand}" ToolTip="{Binding RightToolTip}" >
            <Path Style="{StaticResource IRI.Maptor.Styles.Path.MapOption}" Data="{Binding RightSymbol}"/>
        </Button>

        <Button Name="upperRightButton" Style="{StaticResource IRI.Maptor.Styles.Button.MapOption}" Command="{Binding UpperRightCommand}" ToolTip="{Binding UpperRightToolTip}"  >
            <Path Style="{StaticResource IRI.Maptor.Styles.Path.MapOption}" Data="{Binding UpperRightSymbol}"/>
        </Button>

        <Button Name="upperLeftButton" Style="{StaticResource IRI.Maptor.Styles.Button.MapOption}" Command="{Binding UpperLeftCommand}" ToolTip="{Binding UpperLeftToolTip}"  >
            <Path Style="{StaticResource IRI.Maptor.Styles.Path.MapOption}" Data="{Binding UpperLeftSymbol}"/>
        </Button>

        <Button Name="leftButton" Style="{StaticResource IRI.Maptor.Styles.Button.MapOption}" Command="{Binding LeftCommand}" ToolTip="{Binding LeftToolTip}"  >
            <Path Style="{StaticResource IRI.Maptor.Styles.Path.MapOption}" Data="{Binding LeftSymbol}"/>
        </Button>
    </Grid>
</UserControl>
