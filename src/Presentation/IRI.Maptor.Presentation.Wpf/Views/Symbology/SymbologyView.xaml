<maptor:LocalizedMetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.SymbologyView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:dialogs="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Dialogs"
                    xmlns:vm="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.Symbology"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance Type=vm:SymbologyViewModel}"
                    x:Name="root"
                    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
                    WindowTransitionsEnabled="False"
                    ShowIconOnTitleBar="False"
                    Width="500"
                    SizeToContent="Height"
                    ResizeMode="NoResize"
                    FocusManager.FocusedElement="{Binding ElementName=strokeColorPicker}"
                    Title="{Binding [dialog_symbology_title], Source={StaticResource Localization}}">

    <!--The quick style of a layer from its legend swatch: fill, outline and outline width, with a live
        sample in the layer's own geometry. "Advanced (SLD)" hands over to the full SLD editor. The
        colours are the layer's symbology (data), bound straight to the brushes being edited.-->

    <maptor:LocalizedMetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Views/Symbology/Sld/SldEditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </maptor:LocalizedMetroWindow.Resources>

    <Grid Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource IRI.Maptor.Styles.Thickness.DialogContent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--which layer-->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10"
                        Visibility="{Binding LayerName, Converter={StaticResource stringNotNullOrEmptyToVisibilityConverter}}">
                <iconPacks:PackIconMaterial Kind="LayersOutline" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Width="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                            Height="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}" Margin="0" VerticalAlignment="Center"
                           Text="{Binding LayerName}" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
            </StackPanel>

            <!--live sample: a shape, a line or a marker, as the layer draws-->
            <Border Grid.Row="1" Grid.Column="0" Width="104" Height="104" Margin="0,0,16,0" VerticalAlignment="Top"
                    Background="{StaticResource sld.CheckerBrush}" FlowDirection="LeftToRight"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1"
                    CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}">
                <Grid>
                    <Path Data="M22,26 L64,14 L88,36 L82,80 L44,90 L16,66 Z" Stretch="None" StrokeLineJoin="Round"
                          Fill="{Binding Symbology.Fill}" Stroke="{Binding Symbology.Stroke}" StrokeThickness="{Binding Symbology.StrokeThickness}">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLineLayer}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPointLayer}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Polyline Points="12,74 34,32 56,64 76,28 92,50" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Symbology.Stroke}" StrokeThickness="{Binding Symbology.StrokeThickness}"
                              Visibility="{Binding IsLineLayer, Converter={StaticResource boolToVisibilityConverter}}"/>
                    <Canvas Visibility="{Binding IsPointLayer, Converter={StaticResource boolToVisibilityConverter}}">
                        <Ellipse Canvas.Left="20" Canvas.Top="52" Width="18" Height="18"
                                 Fill="{Binding Symbology.Fill}" Stroke="{Binding Symbology.Stroke}" StrokeThickness="{Binding Symbology.StrokeThickness}"/>
                        <Ellipse Canvas.Left="43" Canvas.Top="24" Width="18" Height="18"
                                 Fill="{Binding Symbology.Fill}" Stroke="{Binding Symbology.Stroke}" StrokeThickness="{Binding Symbology.StrokeThickness}"/>
                        <Ellipse Canvas.Left="66" Canvas.Top="54" Width="18" Height="18"
                                 Fill="{Binding Symbology.Fill}" Stroke="{Binding Symbology.Stroke}" StrokeThickness="{Binding Symbology.StrokeThickness}"/>
                    </Canvas>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="1">
                <!--each field on the grey Border.Card strip (sld.FieldCard), so the white input reads as clickable;
                    line layers have no fill-->
                <Border Style="{StaticResource sld.FieldCard}" Visibility="{Binding HasFill, Converter={StaticResource boolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                                   Text="{Binding [dialog_symbology_fill], Source={StaticResource Localization}}"/>
                        <!--clearing the colour removes the fill-->
                        <mahApp:ColorPicker x:Name="fillColorPicker" Grid.Column="1" Style="{StaticResource sld.ColorBox}"
                                            mahApp:TextBoxHelper.ClearTextButton="True"
                                            mahApp:TextBoxHelper.Watermark="{Binding [dialog_symbology_noFill], Source={StaticResource Localization}}"
                                            SelectedColor="{Binding Symbology.Fill, Mode=TwoWay, Converter={StaticResource solidColorBrushToColorConverter}}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource sld.FieldCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                                   Text="{Binding [dialog_symbology_stroke], Source={StaticResource Localization}}"/>
                        <mahApp:ColorPicker x:Name="strokeColorPicker" Grid.Column="1" Style="{StaticResource sld.ColorBox}"
                                            mahApp:TextBoxHelper.ClearTextButton="True"
                                            mahApp:TextBoxHelper.Watermark="{Binding [dialog_symbology_noStroke], Source={StaticResource Localization}}"
                                            SelectedColor="{Binding Symbology.Stroke, Mode=TwoWay, Converter={StaticResource solidColorBrushToColorConverter}}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource sld.FieldCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="84"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                                   Text="{Binding [dialog_symbology_strokeWidth], Source={StaticResource Localization}}"/>
                        <mahApp:NumericUpDown Grid.Column="1" Style="{StaticResource sld.NumberBox}" Minimum="0" Maximum="50" Interval="0.5"
                                              mahApp:TextBoxHelper.SelectAllOnFocus="True"
                                              Value="{Binding Symbology.StrokeThickness, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource sld.Unit}" Text="px"/>
                    </Grid>
                </Border>

                <!--the user's own change, kept in the project-->
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" Margin="4,8,4,0" TextWrapping="Wrap" MaxWidth="300"
                           HorizontalAlignment="Left" Foreground="{DynamicResource MahApps.Brushes.Accent}"
                           Text="{Binding [dialog_symbology_userChanged], Source={StaticResource Localization}}"
                           Visibility="{Binding IsUserModified, Converter={StaticResource boolToVisibilityConverter}}"/>

                <!--restore the layer's captured default symbology (server style); shown only when the host
                    wired RequestResetAction-->
                <Button Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding ResetCommand}"
                        Visibility="{Binding ShowResetOption, Converter={StaticResource boolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Restore" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                   Text="{Binding [dialog_symbology_restoreAdmin], Source={StaticResource Localization}}"/>
                    </StackPanel>
                </Button>

                <!--the SLD editor is a one-way door until Restore: say so before the user goes through it-->
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" Margin="4,10,4,0" TextWrapping="Wrap" MaxWidth="300"
                           HorizontalAlignment="Left"
                           Text="{Binding [dialog_symbology_advancedHint], Source={StaticResource Localization}}"
                           Visibility="{Binding ShowAdvancedOption, Converter={StaticResource boolToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <dialogs:DialogFooterView Grid.Row="1"
                                  ShowTertiary="{Binding ShowAdvancedOption}"
                                  TertiaryText="{Binding [dialog_symbology_editInSld], Source={StaticResource Localization}}"
                                  TertiaryIconKind="Tune"
                                  TertiaryCommand="{Binding ShowAdvancedCommand}"
                                  SecondaryText="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"
                                  SecondaryCommand="{Binding CloseCommand}"
                                  PrimaryText="{Binding [dialog_common_save], Source={StaticResource Localization}}"
                                  PrimaryIconKind="CheckBold"
                                  PrimaryCommand="{Binding ApplyCommand}"/>
    </Grid>
</maptor:LocalizedMetroWindow>
