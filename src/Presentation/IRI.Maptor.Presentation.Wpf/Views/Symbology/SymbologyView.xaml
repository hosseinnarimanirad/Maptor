<maptor:LocalizedMetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.SymbologyView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls" 
                    xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls" 
                    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:dialogs="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Dialogs"
                    x:Name="root"

                    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
                    WindowTransitionsEnabled="False"
                    ShowIconOnTitleBar="False"
                    FocusManager.FocusedElement="{Binding ElementName=fillColorPicker}"
                    Title="{Binding [dialog_symbology_title], Source={StaticResource Localization}}">
    <maptor:LocalizedMetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </maptor:LocalizedMetroWindow.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="30"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="Auto" MinWidth="30"/>
            <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>
        <mahApp:ColorPicker Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" x:Name="fillColorPicker" Margin="4" FlowDirection="LeftToRight" Width="230"
                            SelectedColor="{Binding Symbology.Fill, Mode=TwoWay, Converter={StaticResource solidColorBrushToColorConverter}}"
                            mahApp:TextBoxHelper.ClearTextButton="True"
                            mahApp:TextBoxHelper.Watermark="{Binding [dialog_symbology_fill], Source={StaticResource Localization}}"
                            mahApp:TextBoxHelper.UseFloatingWatermark="True"                            
                            mahApp:TextBoxHelper.WatermarkAlignment="Center"/>

        <mahApp:ColorPicker Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="0" Margin="4" FlowDirection="LeftToRight" Width="230"
                            SelectedColor="{Binding Symbology.Stroke, Mode=TwoWay, Converter={StaticResource solidColorBrushToColorConverter}}"
                            mahApp:TextBoxHelper.Watermark="{Binding [dialog_symbology_stroke], Source={StaticResource Localization}}"
                            mahApp:TextBoxHelper.ClearTextButton="True" 
                            mahApp:TextBoxHelper.UseFloatingWatermark="True" 
                            mahApp:TextBoxHelper.WatermarkAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="4"
                   Text="{Binding [dialog_symbology_strokeWidth], Source={StaticResource Localization}}"/>

        <mahApp:NumericUpDown Grid.Row="1" Grid.Column="1" HideUpDownButtons="True" Width="80" Margin="4" Minimum="0"
                                mahApp:TextBoxHelper.SelectAllOnFocus="True" Value="{Binding Symbology.StrokeThickness, Mode=TwoWay}"/>

        <!--restore the layer's captured default symbology (server style); shown only
            when the host wired RequestResetAction-->
        <Button Grid.Row="2" Grid.ColumnSpan="4" HorizontalAlignment="Left" Margin="4,2" Cursor="Hand"
                Background="Transparent" BorderThickness="0" Padding="2"
                Command="{Binding ResetCommand}"
                Visibility="{Binding ShowResetOption, Converter={StaticResource boolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Restore" Width="14" Height="14" VerticalAlignment="Center"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MahApps.Brushes.Accent}"
                           Text="{Binding [dialog_symbology_resetToDefault], Source={StaticResource Localization}}"/>
            </StackPanel>
        </Button>

        <dialogs:DialogFooterView Grid.Row="3" Grid.ColumnSpan="4"
                                  ShowTertiary="{Binding ShowAdvancedOption}"
                                  TertiaryText="{Binding [dialog_symbology_advanced], Source={StaticResource Localization}}"
                                  TertiaryIconKind="Tune"
                                  TertiaryCommand="{Binding ShowAdvancedCommand}"
                                  SecondaryText="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"
                                  SecondaryCommand="{Binding CloseCommand}"
                                  PrimaryText="{Binding [dialog_common_save], Source={StaticResource Localization}}"
                                  PrimaryIconKind="CheckBold"
                                  PrimaryCommand="{Binding ApplyCommand}"/>
    </Grid>
</maptor:LocalizedMetroWindow>
