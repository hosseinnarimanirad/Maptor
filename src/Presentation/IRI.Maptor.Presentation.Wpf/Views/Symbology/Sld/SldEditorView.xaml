<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld.SldEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld"
             xmlns:vm="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.Symbology"
             mc:Ignorable="d"
             x:Name="root"
             d:DataContext="{d:DesignInstance Type=vm:SldEditorViewModel}"
             d:DesignHeight="720" d:DesignWidth="1160"
             Background="{DynamicResource MahApps.Brushes.ThemeBackground}">

    <!--The SLD editor in three panes: the style's rules on the leading side, the selected rule's editor in
        the middle (Symbology / Filter and scale / Details), and a live preview on the trailing side. The
        style's own name and the SLD as XML sit in a bottom panel that opens on demand. Hosted by
        SldEditorWindow, and by ServerLayerSettingsWindow for a server layer's SLD.-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Views/Symbology/Sld/SldEditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource IRI.Maptor.Styles.TabItem.Form}"/>

            <DataTemplate x:Key="PointSymbolizerTemplate">
                <maptor:PointSymbolizerView/>
            </DataTemplate>
            <DataTemplate x:Key="LineSymbolizerTemplate">
                <maptor:LineSymbolizerView/>
            </DataTemplate>
            <DataTemplate x:Key="PolygonSymbolizerTemplate">
                <maptor:PolygonSymbolizerView/>
            </DataTemplate>
            <DataTemplate x:Key="TextSymbolizerTemplate">
                <maptor:TextSymbolizerView/>
            </DataTemplate>
            <DataTemplate x:Key="RasterSymbolizerTemplate">
                <maptor:RasterSymbolizerView/>
            </DataTemplate>

            <maptor:SymbolizerDataTemplateSelector x:Key="SymbolizerTemplateSelector"
                PointTemplate="{StaticResource PointSymbolizerTemplate}"
                LineTemplate="{StaticResource LineSymbolizerTemplate}"
                PolygonTemplate="{StaticResource PolygonSymbolizerTemplate}"
                TextTemplate="{StaticResource TextSymbolizerTemplate}"
                RasterTemplate="{StaticResource RasterSymbolizerTemplate}"/>

            <!--small round actions in a pane's bottom bar and in a card's header-->
            <Style x:Key="paneButton" TargetType="Button" BasedOn="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"/>

            <Style x:Key="cardButton" TargetType="Button" BasedOn="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
            </Style>

            <Style x:Key="cardIcon" TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
            </Style>

            <!--"Add …" under the symbol cards-->
            <Style x:Key="addButton" TargetType="Button" BasedOn="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}">
                <Setter Property="Margin" Value="0,0,6,6"/>
            </Style>

            <!--a small marker on a rule row: has a scale range, has a filter-->
            <Style x:Key="ruleMarker" TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.Indicator}">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
            </Style>

            <!--the bottom-panel switches: a flat tab with a chevron-->
            <Style x:Key="drawerToggle" TargetType="ToggleButton" BasedOn="{StaticResource sld.SegmentToggle}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <!--a label inside the preview summary-->
            <Style x:Key="summaryLabel" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}">
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <!--bold and italic of the preview's sample label-->
            <Style x:Key="previewLabel" TargetType="maptor:HaloTextBlock">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PreviewLabel.IsBold}" Value="True">
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PreviewLabel.IsItalic}" Value="True">
                        <Setter Property="FontStyle" Value="Italic"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.ViewContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--the loaded document holds styles or layers beyond the one edited here; they are saved unchanged-->
        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Banner.Accent}" Margin="0,0,0,6"
                Visibility="{Binding HasPreservedContent, Converter={StaticResource boolToVisibilityConverter}}">
            <DockPanel>
                <iconPacks:PackIconMaterial DockPanel.Dock="Left" Kind="InformationOutline" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Width="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                            Height="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" TextWrapping="Wrap"
                           Text="{Binding [sldEditor_common_preservedContentNotice], Source={StaticResource Localization}}"/>
            </DockPanel>
        </Border>

        <!--rules | editor | preview-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="270" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!--RULES-->
            <Border Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}">
                        <DockPanel Margin="4,2">
                            <Border DockPanel.Dock="Right" Style="{StaticResource IRI.Maptor.Styles.Pill}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text}" Text="{Binding Rules.Count}"/>
                            </Border>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}" Margin="0" VerticalAlignment="Center"
                                       Text="{Binding [sldEditor_common_rules], Source={StaticResource Localization}}"/>
                        </DockPanel>
                    </Border>

                    <ListBox x:Name="rulesList" Grid.Row="1"
                             Style="{StaticResource IRI.Maptor.Styles.ListBox.Plain}"
                             ItemContainerStyle="{StaticResource IRI.Maptor.Styles.ListBoxItem.Row}"
                             ItemsSource="{Binding Rules}"
                             SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding RemoveRuleCommand}"/>
                            <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateRuleCommand}"/>
                            <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveRuleUpCommand}"/>
                            <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveRuleDownCommand}"/>
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RuleViewModel}">
                                <Grid MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!--live swatch (regenerates as the rule's symbolizers change)-->
                                    <Border Style="{StaticResource sld.SwatchFrame}" Margin="0,0,8,0">
                                        <Image Source="{Binding SwatchImage}" Width="32" Height="24" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}" Text="{Binding DisplayTitle}"
                                                   ToolTip="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <iconPacks:PackIconMaterial Kind="MagnifyScan" Style="{StaticResource ruleMarker}"
                                                                        ToolTip="{Binding ScaleRangeText}"
                                                                        Visibility="{Binding HasScaleRange, Converter={StaticResource boolToVisibilityConverter}}"/>
                                            <iconPacks:PackIconMaterial Kind="FilterOutline" Style="{StaticResource ruleMarker}"
                                                                        ToolTip="{Binding FilterDescription}"
                                                                        Visibility="{Binding HasFilter, Converter={StaticResource boolToVisibilityConverter}}"/>
                                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Style="{StaticResource ruleMarker}"
                                                                        Foreground="{DynamicResource IRI.Maptor.Brushes.Invalid}"
                                                                        ToolTip="{Binding [sldEditor_scale_inverted], Source={StaticResource Localization}}"
                                                                        Visibility="{Binding HasScaleRangeError, Converter={StaticResource boolToVisibilityConverter}}"/>
                                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" Text="{Binding [sldEditor_rules_empty], Source={StaticResource Localization}}"
                                                       Visibility="{Binding HasSymbolizers, Converter={StaticResource boolToInverseVisibilityConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--no rules yet-->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                                Visibility="{Binding HasRules, Converter={StaticResource boolToInverseVisibilityConverter}}">
                        <iconPacks:PackIconMaterial Kind="LayersPlus" Width="32" Height="32" HorizontalAlignment="Center"
                                                    Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="{Binding [sldEditor_rules_none], Source={StaticResource Localization}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" Margin="8,4" TextWrapping="Wrap"
                               Text="{Binding [sldEditor_rules_hint], Source={StaticResource Localization}}"/>

                    <Border Grid.Row="3" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}" Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource paneButton}" Command="{Binding AddRuleCommand}"
                                    ToolTip="{Binding [sldEditor_common_addRule], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [sldEditor_common_addRule], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="Plus" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                            <Button Style="{StaticResource paneButton}" Command="{Binding GenerateRulesCommand}"
                                    ToolTip="{Binding [sldGenerator_title], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [sldGenerator_title], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="AutoFix" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                            <Button Style="{StaticResource paneButton}" Command="{Binding DuplicateRuleCommand}"
                                    ToolTip="{Binding [sldEditor_rules_duplicate], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [sldEditor_rules_duplicate], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="ContentCopy" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                            <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Vertical}" Margin="4,6"/>
                            <Button Style="{StaticResource paneButton}" Command="{Binding MoveRuleUpCommand}"
                                    ToolTip="{Binding [sldEditor_rules_moveUp], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [sldEditor_rules_moveUp], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="ArrowUp" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                            <Button Style="{StaticResource paneButton}" Command="{Binding MoveRuleDownCommand}"
                                    ToolTip="{Binding [sldEditor_rules_moveDown], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [sldEditor_rules_moveDown], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="ArrowDown" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                            <Separator Style="{StaticResource IRI.Maptor.Styles.Separator.Vertical}" Margin="4,6"/>
                            <Button Style="{StaticResource paneButton}" Command="{Binding RemoveRuleCommand}"
                                    ToolTip="{Binding [sldEditor_rules_delete], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [sldEditor_rules_delete], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.GridSplitter.Vertical}"/>

            <!--EDITOR-->
            <Border Grid.Column="2" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}">
                <Grid>
                    <!--nothing selected-->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                Visibility="{Binding HasSelectedRule, Converter={StaticResource boolToInverseVisibilityConverter}}">
                        <iconPacks:PackIconMaterial Kind="GestureTapButton" Width="36" Height="36" HorizontalAlignment="Center"
                                                    Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                                   Text="{Binding [sldEditor_rules_noSelection], Source={StaticResource Localization}}"/>
                        <Button Style="{StaticResource IRI.Maptor.Styles.Button.Secondary}" Command="{Binding AddRuleCommand}"
                                HorizontalAlignment="Center" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Plus" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                           Text="{Binding [sldEditor_common_addRule], Source={StaticResource Localization}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid DataContext="{Binding SelectedRule}"
                          Visibility="{Binding DataContext.HasSelectedRule, ElementName=root, Converter={StaticResource boolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!--header: the rule's swatch and its legend text, editable in place-->
                        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}">
                            <DockPanel Margin="4,2" LastChildFill="True">
                                <Border DockPanel.Dock="Left" Style="{StaticResource sld.SwatchFrame}" Margin="0,0,8,0">
                                    <Image Source="{Binding SwatchImage}" Width="32" Height="24" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource IRI.Maptor.Styles.Pill}" Margin="6,0,0,0"
                                            Visibility="{Binding HasScaleRange, Converter={StaticResource boolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text}" Text="{Binding [sldEditor_badge_scale], Source={StaticResource Localization}}"/>
                                    </Border>
                                    <Border Style="{StaticResource IRI.Maptor.Styles.Pill}" Margin="6,0,0,0"
                                            Visibility="{Binding HasFilter, Converter={StaticResource boolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text}" Text="{Binding [sldEditor_badge_filter], Source={StaticResource Localization}}"/>
                                    </Border>
                                </StackPanel>
                                <TextBox x:Name="ruleTitleBox" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}" VerticalAlignment="Center"
                                         mahApp:TextBoxHelper.Watermark="{Binding [sldEditor_rule_titleWatermark], Source={StaticResource Localization}}"
                                         ToolTip="{Binding [sldEditor_rule_titleHint], Source={StaticResource Localization}}"
                                         Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </Border>

                        <TabControl x:Name="ruleTabs" Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.TabControl.Form}" Margin="1,4,1,1">

                            <!--SYMBOLOGY: one card per symbolizer, drawn in list order-->
                            <TabItem Header="{Binding [sldEditor_tab_symbology], Source={StaticResource Localization}}">
                                <ScrollViewer Style="{StaticResource sld.TabScroll}">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Symbolizers}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SymbolizerViewModelBase}">
                                                    <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}" Padding="0">
                                                        <StackPanel>
                                                            <!--card header: click to open or close; order and remove on the far side-->
                                                            <DockPanel Margin="6,4">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <Button Style="{StaticResource cardButton}"
                                                                            Command="{Binding DataContext.SelectedRule.MoveSymbolizerUpCommand, ElementName=root}" CommandParameter="{Binding}"
                                                                            ToolTip="{Binding [sldEditor_symbolizer_moveUp], Source={StaticResource Localization}}"
                                                                            AutomationProperties.Name="{Binding [sldEditor_symbolizer_moveUp], Source={StaticResource Localization}}">
                                                                        <iconPacks:PackIconMaterial Kind="ArrowUp" Style="{StaticResource cardIcon}"/>
                                                                    </Button>
                                                                    <Button Style="{StaticResource cardButton}"
                                                                            Command="{Binding DataContext.SelectedRule.MoveSymbolizerDownCommand, ElementName=root}" CommandParameter="{Binding}"
                                                                            ToolTip="{Binding [sldEditor_symbolizer_moveDown], Source={StaticResource Localization}}"
                                                                            AutomationProperties.Name="{Binding [sldEditor_symbolizer_moveDown], Source={StaticResource Localization}}">
                                                                        <iconPacks:PackIconMaterial Kind="ArrowDown" Style="{StaticResource cardIcon}"/>
                                                                    </Button>
                                                                    <Button Style="{StaticResource cardButton}"
                                                                            Command="{Binding DataContext.SelectedRule.RemoveSymbolizerCommand, ElementName=root}" CommandParameter="{Binding}"
                                                                            ToolTip="{Binding [sldEditor_symbolizer_remove], Source={StaticResource Localization}}"
                                                                            AutomationProperties.Name="{Binding [sldEditor_symbolizer_remove], Source={StaticResource Localization}}">
                                                                        <iconPacks:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource cardIcon}"/>
                                                                    </Button>
                                                                </StackPanel>
                                                                <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" Focusable="True"
                                                                              Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                                                              AutomationProperties.Name="{Binding DisplayName}">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent" Padding="2,3">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <iconPacks:PackIconMaterial x:Name="chevron" Kind="ChevronDown" Width="10" Height="10" Margin="2,0,8,0"
                                                                                                    VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                                                                        <iconPacks:PackIconMaterial Kind="{Binding SymbolizerType, Converter={StaticResource sld.SymbolizerIconConverter}}"
                                                                                                    Width="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                                                                                    Height="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                                                                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                                                                                    Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                                                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}" Margin="0"
                                                                                   VerticalAlignment="Center" Text="{Binding DisplayName}"/>
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                            </DockPanel>
                                                            <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray9}" BorderThickness="0,1,0,0" Padding="12,4,12,10"
                                                                    Visibility="{Binding IsExpanded, Converter={StaticResource boolToVisibilityConverter}}">
                                                                <ContentControl Content="{Binding}" Focusable="False"
                                                                                ContentTemplateSelector="{StaticResource SymbolizerTemplateSelector}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                            <Setter TargetName="chevron" Property="Kind" Value="ChevronRight"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--a rule without symbols draws nothing-->
                                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Banner}" Margin="0,0,0,8"
                                                Visibility="{Binding HasSymbolizers, Converter={StaticResource boolToInverseVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" TextWrapping="Wrap"
                                                       Text="{Binding [sldEditor_symbolizer_none], Source={StaticResource Localization}}"/>
                                        </Border>

                                        <!--add: only the kinds that draw on this layer's geometry-->
                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" Margin="0,4,0,4"
                                                   Text="{Binding [sldEditor_symbolizer_add], Source={StaticResource Localization}}"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource addButton}" Command="{Binding AddPolygonSymbolizerCommand}"
                                                    Visibility="{Binding DataContext.CanAddPolygonSymbolizer, ElementName=root, Converter={StaticResource boolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Kind="FormatColorFill" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [sldEditor_symbolizer_polygon], Source={StaticResource Localization}}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource addButton}" Command="{Binding AddLineSymbolizerCommand}"
                                                    Visibility="{Binding DataContext.CanAddLineSymbolizer, ElementName=root, Converter={StaticResource boolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Kind="VectorPolyline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [sldEditor_symbolizer_line], Source={StaticResource Localization}}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource addButton}" Command="{Binding AddPointSymbolizerCommand}"
                                                    Visibility="{Binding DataContext.CanAddPointSymbolizer, ElementName=root, Converter={StaticResource boolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Kind="MapMarkerOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [sldEditor_symbolizer_point], Source={StaticResource Localization}}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource addButton}" Command="{Binding AddTextSymbolizerCommand}"
                                                    Visibility="{Binding DataContext.CanAddTextSymbolizer, ElementName=root, Converter={StaticResource boolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Kind="FormatText" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [sldEditor_symbolizer_text], Source={StaticResource Localization}}"/>
                                                </StackPanel>
                                            </Button>
                                            <!--hidden for vector layers: the runtime renderer skips raster symbolizers there-->
                                            <Button Style="{StaticResource addButton}" Command="{Binding AddRasterSymbolizerCommand}"
                                                    Visibility="{Binding DataContext.CanAddRasterSymbolizer, ElementName=root, Converter={StaticResource boolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Kind="ImageOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [sldEditor_symbolizer_raster], Source={StaticResource Localization}}"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>

                                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding [sldEditor_symbolizer_orderHint], Source={StaticResource Localization}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!--FILTER AND SCALE-->
                            <TabItem Header="{Binding [sldEditor_tab_filterScale], Source={StaticResource Localization}}">
                                <ScrollViewer Style="{StaticResource sld.TabScroll}">
                                    <StackPanel>
                                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}"
                                                           Text="{Binding [sldEditor_common_scaleRange], Source={StaticResource Localization}}"/>
                                                <maptor:ScaleRangeEditorView/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}"
                                                           Text="{Binding [sldEditor_common_filter], Source={StaticResource Localization}}"/>
                                                <maptor:SimpleFilterEditorView/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!--DETAILS: the rule's identifier and description-->
                            <TabItem Header="{Binding [sldEditor_tab_details], Source={StaticResource Localization}}">
                                <ScrollViewer Style="{StaticResource sld.TabScroll}">
                                    <Border Style="{StaticResource IRI.Maptor.Styles.Border.Section}">
                                        <StackPanel>
                                            <Border Style="{StaticResource sld.FieldCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                                                               Text="{Binding [sldEditor_common_title], Source={StaticResource Localization}}"/>
                                                    <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                                                             Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource sld.FieldCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                                                               Text="{Binding [sldEditor_common_name], Source={StaticResource Localization}}"/>
                                                    <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource sld.FieldCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" VerticalAlignment="Top"
                                                               Text="{Binding [sldEditor_common_abstract], Source={StaticResource Localization}}"/>
                                                    <!--TextBox.Normal fixes Height at 32 for single-line fields; a multi-line box sets its own-->
                                                    <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                                                             Height="72" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Text="{Binding Abstract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Text="{Binding [sldEditor_rule_detailsHint], Source={StaticResource Localization}}"/>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Style="{StaticResource IRI.Maptor.Styles.GridSplitter.Vertical}"/>

            <!--PREVIEW-->
            <Border Grid.Column="4" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}">
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}" Margin="4,2" VerticalAlignment="Center"
                                   Text="{Binding [sldEditor_preview_title], Source={StaticResource Localization}}"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10">
                            <!--the selected rule, large: its geometry symbols with a sample label over them-->
                            <Border Height="160" Background="{StaticResource sld.CheckerBrush}"
                                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1"
                                    CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"
                                    FlowDirection="LeftToRight" ClipToBounds="True">
                                <Grid>
                                    <Grid DataContext="{Binding SelectedRule}"
                                          Visibility="{Binding DataContext.HasSelectedRule, ElementName=root, Converter={StaticResource boolToVisibilityConverter}}">
                                        <Image Source="{Binding PreviewImage}" Width="240" Height="150" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <!--the label is SLD data, drawn with its own font, colour and halo-->
                                        <maptor:HaloTextBlock Style="{StaticResource previewLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Text="{Binding [sldEditor_preview_labelSample], Source={StaticResource Localization}}"
                                                              FontFamily="{Binding PreviewLabel.FontFamily}" FontSize="{Binding PreviewLabel.FontSize}"
                                                              HaloWidth="{Binding PreviewLabel.PreviewHaloWidth}"
                                                              Visibility="{Binding HasPreviewLabel, Converter={StaticResource boolToVisibilityConverter}}">
                                            <maptor:HaloTextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding PreviewLabel.FontColor}"/>
                                            </maptor:HaloTextBlock.Foreground>
                                            <maptor:HaloTextBlock.HaloBrush>
                                                <SolidColorBrush Color="{Binding PreviewLabel.HaloColor}" Opacity="{Binding PreviewLabel.HaloOpacity}"/>
                                            </maptor:HaloTextBlock.HaloBrush>
                                        </maptor:HaloTextBlock>
                                    </Grid>
                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}" TextWrapping="Wrap" TextAlignment="Center"
                                               Text="{Binding [sldEditor_preview_none], Source={StaticResource Localization}}"
                                               Visibility="{Binding HasSelectedRule, Converter={StaticResource boolToInverseVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!--when and where the rule draws-->
                            <StackPanel DataContext="{Binding SelectedRule}" Margin="0,4,0,0"
                                        Visibility="{Binding DataContext.HasSelectedRule, ElementName=root, Converter={StaticResource boolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource summaryLabel}" Text="{Binding [sldEditor_common_scaleRange], Source={StaticResource Localization}}"/>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" TextWrapping="Wrap" Text="{Binding ScaleRangeText}"/>
                                <TextBlock Style="{StaticResource summaryLabel}" Text="{Binding [sldEditor_common_filter], Source={StaticResource Localization}}"/>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" TextWrapping="Wrap" Text="{Binding FilterDescription}"/>
                            </StackPanel>

                            <Border Style="{StaticResource IRI.Maptor.Styles.Border.Divider}" Margin="0,12,0,8"/>

                            <!--the whole style as the map legend will list it; a row selects its rule-->
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}"
                                       Text="{Binding [sldEditor_preview_legend], Source={StaticResource Localization}}"/>
                            <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RuleViewModel}">
                                        <!--FontWeight: the implicit MahApps button style is bold-->
                                        <Button Command="{Binding DataContext.SelectRuleCommand, ElementName=root}" CommandParameter="{Binding}"
                                                Cursor="Hand" Focusable="False" HorizontalContentAlignment="Stretch" FontWeight="Normal">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="row" Background="Transparent" Padding="2,3" CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <DockPanel>
                                                <Image DockPanel.Dock="Left" Source="{Binding SwatchImage}" Width="32" Height="24" Margin="0,0,8,0"
                                                       FlowDirection="LeftToRight" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" VerticalAlignment="Center"
                                                           Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--bottom panel switches: the style's own fields, the SLD as XML-->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
            <ToggleButton Style="{StaticResource drawerToggle}" IsChecked="{Binding IsStylePanelOpen}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="TagTextOutline" Style="{StaticResource sld.ToggleIcon}" Margin="0,0,6,0"/>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}" VerticalAlignment="Center"
                               Text="{Binding [sldEditor_style_panel], Source={StaticResource Localization}}"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource drawerToggle}" IsChecked="{Binding IsXmlPanelOpen}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CodeTags" Style="{StaticResource sld.ToggleIcon}" Margin="0,0,6,0"/>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}" VerticalAlignment="Center"
                               Text="{Binding [sldEditor_common_xmlPreview], Source={StaticResource Localization}}"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!--the style's name, title and abstract-->
        <Border Grid.Row="3" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}" Margin="0,6,0,0" Height="210"
                Visibility="{Binding IsStylePanelOpen, Converter={StaticResource boolToVisibilityConverter}}">
            <ScrollViewer Style="{StaticResource sld.TabScroll}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource sld.FieldCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                                           Text="{Binding [sldEditor_common_layerName], Source={StaticResource Localization}}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                                         Text="{Binding LayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource sld.FieldCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                                           Text="{Binding [sldEditor_common_styleName], Source={StaticResource Localization}}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                                         Text="{Binding StyleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource sld.FieldCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                                           Text="{Binding [sldEditor_common_styleTitle], Source={StaticResource Localization}}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                                         Text="{Binding StyleTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource sld.FieldCard}" Padding="10,4,4,4" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}" Margin="0,4,0,0"
                                       Text="{Binding [sldEditor_common_abstract], Source={StaticResource Localization}}"/>
                            <TextBox Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                                     Height="100" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding StyleAbstract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!--the SLD as it will be saved, kept current while open-->
        <Border Grid.Row="3" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}" Margin="0,6,0,0" Height="240"
                Visibility="{Binding IsXmlPanelOpen, Converter={StaticResource boolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}">
                    <DockPanel Margin="4,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}" Command="{Binding CopyXmlCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentCopy" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                           Text="{Binding [sldEditor_xml_copy], Source={StaticResource Localization}}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" VerticalAlignment="Center"
                                   Text="{Binding [sldEditor_xml_live], Source={StaticResource Localization}}"/>
                    </DockPanel>
                </Border>
                <!--XML is inherently LTR; without the explicit FlowDirection the RTL (Persian) window mirrors the
                    markup into unreadable text. Height="Auto" overrides TextBox.Normal's fixed 32 so the box fills
                    its row; Consolas stays because there is no monospace token yet.-->
                <TextBox Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                         Height="Auto" VerticalContentAlignment="Top" Margin="6"
                         IsReadOnly="True" TextWrapping="NoWrap" FlowDirection="LeftToRight"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         Text="{Binding XmlPreview, Mode=OneWay}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
