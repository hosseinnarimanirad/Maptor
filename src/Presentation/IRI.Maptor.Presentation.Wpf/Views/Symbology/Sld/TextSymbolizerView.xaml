<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld.TextSymbolizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.Symbology"
             xmlns:sldViews="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TextSymbolizerViewModel}"
             d:DesignHeight="480" d:DesignWidth="420">

    <!--A label: Text (field, font, size, style, colour), Halo, geometry property. Row grammar as in
        PolygonSymbolizerView.

        CAREFUL: FontFamily, FontSize, FontStyle and FontWeight are bound to the SLD model — they are the
        label's rendered appearance that the user is editing, NOT this view's own typography. Never fold
        them into a TextBlock style. The font list draws each family in itself for the same reason.-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Views/Symbology/Sld/SldEditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!--editable combo: suggests the layer's field names when the editor has layer context
            (SldEditorViewModel.FieldNames), still accepts free text-->
        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_labelField], Source={StaticResource Localization}}"/>
                <ComboBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}" IsEditable="True"
                          ItemsSource="{Binding DataContext.FieldNames, RelativeSource={RelativeSource AncestorType=sldViews:SldEditorView}}"
                          mahApp:TextBoxHelper.Watermark="{Binding [sldEditor_field_labelFieldWatermark], Source={StaticResource Localization}}"
                          Text="{Binding LabelPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <!--the installed fonts, each drawn in itself; a font that is not installed can still be typed-->
        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_font], Source={StaticResource Localization}}"/>
                <ComboBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}" IsEditable="True" FlowDirection="LeftToRight"
                          ItemsSource="{x:Static vm:SldEditorOptions.FontFamilies}"
                          ItemTemplate="{StaticResource sld.FontOptionTemplate}"
                          ItemsPanel="{StaticResource sld.VirtualizingPanel}"
                          VirtualizingPanel.IsVirtualizing="True"
                          MaxDropDownHeight="320"
                          Text="{Binding FontFamily, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_size], Source={StaticResource Localization}}"/>
                <mahApp:NumericUpDown Grid.Column="1" Style="{StaticResource sld.NumberBox}" Value="{Binding FontSize, Mode=TwoWay}"
                                      Minimum="1" Maximum="100" Interval="1"/>
                <TextBlock Grid.Column="2" Style="{StaticResource sld.Unit}" Text="px"/>
                <!--bold / italic as toggles, the way every text editor shows them-->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource sld.SegmentToggle}" IsChecked="{Binding IsBold}"
                                  ToolTip="{Binding [sldEditor_field_bold], Source={StaticResource Localization}}"
                                  AutomationProperties.Name="{Binding [sldEditor_field_bold], Source={StaticResource Localization}}">
                        <iconPacks:PackIconMaterial Kind="FormatBold" Style="{StaticResource sld.ToggleIcon}"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource sld.SegmentToggle}" IsChecked="{Binding IsItalic}"
                                  ToolTip="{Binding [sldEditor_field_italic], Source={StaticResource Localization}}"
                                  AutomationProperties.Name="{Binding [sldEditor_field_italic], Source={StaticResource Localization}}">
                        <iconPacks:PackIconMaterial Kind="FormatItalic" Style="{StaticResource sld.ToggleIcon}"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_color], Source={StaticResource Localization}}"/>
                <mahApp:ColorPicker Grid.Column="1" Style="{StaticResource sld.ColorBox}" SelectedColor="{Binding FontColor, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource sld.GroupHeader}"
                   Text="{Binding [sldEditor_section_halo], Source={StaticResource Localization}}"/>

        <CheckBox Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}" HorizontalAlignment="Left" Margin="0,2,0,4"
                  Content="{Binding [sldEditor_field_haloOn], Source={StaticResource Localization}}"
                  IsChecked="{Binding EnableHalo, Mode=TwoWay}"/>

        <!--one IsEnabled for the three halo rows-->
        <StackPanel IsEnabled="{Binding EnableHalo}">
            <Border Style="{StaticResource sld.FieldCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                               Text="{Binding [sldEditor_field_width], Source={StaticResource Localization}}"/>
                    <mahApp:NumericUpDown Grid.Column="1" Style="{StaticResource sld.NumberBox}" Value="{Binding HaloRadius, Mode=TwoWay}"
                                          Minimum="0" Maximum="10" Interval="0.5"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource sld.Unit}" Text="px"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource sld.FieldCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                               Text="{Binding [sldEditor_field_color], Source={StaticResource Localization}}"/>
                    <mahApp:ColorPicker Grid.Column="1" Style="{StaticResource sld.ColorBox}" SelectedColor="{Binding HaloColor, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource sld.FieldCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                               Text="{Binding [sldEditor_field_opacity], Source={StaticResource Localization}}"/>
                    <Slider Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Slider.Normal}" Value="{Binding HaloOpacity, Mode=TwoWay}"
                            Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource sld.PercentText}" Text="{Binding HaloOpacity, Converter={StaticResource sld.PercentConverter}}"/>
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock Style="{StaticResource sld.GroupHeader}"
                   Text="{Binding [sldEditor_section_geometry], Source={StaticResource Localization}}"/>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_common_geometryProperty], Source={StaticResource Localization}}"/>
                <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                         mahApp:TextBoxHelper.Watermark="{Binding [sldEditor_field_geometryDefault], Source={StaticResource Localization}}"
                         Text="{Binding GeometryPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
