<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld.TextSymbolizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:sld="clr-namespace:IRI.Maptor.Core.Ogc.SLD;assembly=IRI.Maptor.Core.Ogc"
             xmlns:sldViews="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="350">

    <!--Same row pattern as PointSymbolizerView.

        CAREFUL: FontFamily, FontSize, FontStyle and FontWeight here are bound to the SLD model —
        they are the label's rendered appearance that the user is editing, NOT this view's own
        typography. Never fold them into a TextBlock style.

        No ScrollViewer: SldEditorView already wraps the symbolizer host in one, and the other
        four symbolizer views rely on that. Having its own produced nested scrollers.-->

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.ViewContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_textSymbolizer_labelProperty], Source={StaticResource Localization}}"/>
        <!--editable combo: suggests the layer's field names when the editor has layer
            context (SldEditorViewModel.FieldNames), still accepts free text-->
        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}" IsEditable="True"
                  ItemsSource="{Binding DataContext.FieldNames, RelativeSource={RelativeSource AncestorType=sldViews:SldEditorView}}"
                  Text="{Binding LabelPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_textSymbolizer_fontFamily], Source={StaticResource Localization}}"/>
        <!--Text binds the SLD model's FontFamily; this is data being edited-->
        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}"
                  IsEditable="True"
                  Text="{Binding FontFamily, Mode=TwoWay}">
            <ComboBoxItem>Arial</ComboBoxItem>
            <ComboBoxItem>Times New Roman</ComboBoxItem>
            <ComboBoxItem>Courier New</ComboBoxItem>
            <ComboBoxItem>Verdana</ComboBoxItem>
            <ComboBoxItem>Georgia</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_textSymbolizer_fontSize], Source={StaticResource Localization}}"/>
        <mahApp:NumericUpDown Grid.Row="2" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}"
                              Value="{Binding FontSize, Mode=TwoWay}"
                              Minimum="1" Maximum="100" Interval="1"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_textSymbolizer_fontStyle], Source={StaticResource Localization}}"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}"
                  SelectedItem="{Binding FontStyle}">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sld:Sld_FontStyle}">
                    <sld:Sld_FontStyle>Normal</sld:Sld_FontStyle>
                    <sld:Sld_FontStyle>Italic</sld:Sld_FontStyle>
                    <sld:Sld_FontStyle>Oblique</sld:Sld_FontStyle>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_textSymbolizer_fontWeight], Source={StaticResource Localization}}"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}"
                  SelectedItem="{Binding FontWeight}">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sld:Sld_FontWeight}">
                    <sld:Sld_FontWeight>Normal</sld:Sld_FontWeight>
                    <sld:Sld_FontWeight>Bold</sld:Sld_FontWeight>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_textSymbolizer_fontColor], Source={StaticResource Localization}}"/>
        <mahApp:ColorPicker Grid.Row="5" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ColorPicker.Normal}"
                            SelectedColor="{Binding FontColor, Mode=TwoWay}"/>

        <Separator Grid.Row="6" Grid.ColumnSpan="2" Style="{StaticResource IRI.Maptor.Styles.Separator.Horizontal}"/>

        <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}"
                  Content="{Binding [sldEditor_textSymbolizer_enableHalo], Source={StaticResource Localization}}"
                  IsChecked="{Binding EnableHalo, Mode=TwoWay}"/>

        <!--The halo fields were each carrying their own IsEnabled="{Binding EnableHalo}" —
            eight copies of one condition. Grouping them puts it in a single place. The inner
            grid reuses the same label-column token, so its labels stay aligned with the rows
            above it.-->
        <Grid Grid.Row="8" Grid.ColumnSpan="2" IsEnabled="{Binding EnableHalo}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                       Text="{Binding [sldEditor_textSymbolizer_haloRadius], Source={StaticResource Localization}}"/>
            <mahApp:NumericUpDown Grid.Row="0" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}"
                                  Value="{Binding HaloRadius, Mode=TwoWay}"
                                  Minimum="0" Maximum="10" Interval="0.5"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                       Text="{Binding [sldEditor_textSymbolizer_haloColor], Source={StaticResource Localization}}"/>
            <mahApp:ColorPicker Grid.Row="1" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ColorPicker.Normal}"
                                SelectedColor="{Binding HaloColor, Mode=TwoWay}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                       Text="{Binding [sldEditor_textSymbolizer_haloOpacity], Source={StaticResource Localization}}"/>
            <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Slider.Normal}"
                    Value="{Binding HaloOpacity, Mode=TwoWay}"
                    Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
        </Grid>

        <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_common_geometryProperty], Source={StaticResource Localization}}"/>
        <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                 Text="{Binding GeometryPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>
