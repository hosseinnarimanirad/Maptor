<maptor:LocalizedMetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld.SldRuleGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls"
        xmlns:dialogs="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Dialogs"
        xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:sld="clr-namespace:IRI.Maptor.Core.Ogc.SLD;assembly=IRI.Maptor.Core.Ogc"
        xmlns:vm="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.Symbology"
        xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SldRuleGeneratorViewModel}"
        Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Localized}"
        WindowTransitionsEnabled="False"
        ShowIconOnTitleBar="False"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Title="{Binding [sldGenerator_title], Source={StaticResource Localization}}"
        Height="600" Width="560" MinHeight="460" MinWidth="480">

    <maptor:LocalizedMetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <Style TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"/>

            <Style x:Key="Generator.Label" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}">
                <Setter Property="MinWidth" Value="110"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="Generator.Choice" TargetType="RadioButton" BasedOn="{StaticResource IRI.Maptor.Styles.RadioButton.Form}">
                <Setter Property="Margin" Value="0,0,16,0"/>
            </Style>
        </ResourceDictionary>
    </maptor:LocalizedMetroWindow.Resources>

    <Grid Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--choices-->
        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Card}" Padding="12,10" Margin="8,8,8,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Generator.Label}"
                           Text="{Binding [sldGenerator_field], Source={StaticResource Localization}}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}"
                          ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SldRuleFieldOption}">
                            <DockPanel>
                                <!--a field with a domain: the natural choice-->
                                <iconPacks:PackIconMaterial DockPanel.Dock="Left" Kind="FormatListBulleted" Width="12" Height="12" Margin="0,0,6,0"
                                                            VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                            Visibility="{Binding HasDomain, Converter={StaticResource boolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding DisplayName}" Margin="0"/>
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!--geometry, only when the layer's is not known-->
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,8,0" Style="{StaticResource Generator.Label}"
                           Text="{Binding [sldGenerator_geometry], Source={StaticResource Localization}}"
                           Visibility="{Binding IsGeometryKnown, Converter={StaticResource boolToInverseVisibilityConverter}}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding IsGeometryKnown, Converter={StaticResource boolToInverseVisibilityConverter}}">
                    <RadioButton GroupName="Geometry" Style="{StaticResource Generator.Choice}"
                                 IsChecked="{Binding Geometry, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static sld:SldGeometryKind.Point}}"
                                 Content="{Binding [sldGenerator_geometryPoint], Source={StaticResource Localization}}"/>
                    <RadioButton GroupName="Geometry" Style="{StaticResource Generator.Choice}"
                                 IsChecked="{Binding Geometry, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static sld:SldGeometryKind.Line}}"
                                 Content="{Binding [sldGenerator_geometryLine], Source={StaticResource Localization}}"/>
                    <RadioButton GroupName="Geometry" Style="{StaticResource Generator.Choice}"
                                 IsChecked="{Binding Geometry, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static sld:SldGeometryKind.Polygon}}"
                                 Content="{Binding [sldGenerator_geometryPolygon], Source={StaticResource Localization}}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,8,0" Style="{StaticResource Generator.Label}"
                           Text="{Binding [sldGenerator_values], Source={StaticResource Localization}}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton GroupName="Values" Style="{StaticResource Generator.Choice}" IsEnabled="{Binding CanUseDataValues}"
                                 IsChecked="{Binding ValueSource, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static vm:SldRuleValueSource.Data}}"
                                 Content="{Binding [sldGenerator_valuesData], Source={StaticResource Localization}}"/>
                    <RadioButton GroupName="Values" Style="{StaticResource Generator.Choice}" IsEnabled="{Binding CanUseDomainValues}"
                                 IsChecked="{Binding ValueSource, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static vm:SldRuleValueSource.Domain}}"
                                 Content="{Binding [sldGenerator_valuesDomain], Source={StaticResource Localization}}"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,8,0" Style="{StaticResource Generator.Label}"
                           Text="{Binding [sldGenerator_colors], Source={StaticResource Localization}}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton GroupName="Colors" Style="{StaticResource Generator.Choice}"
                                 IsChecked="{Binding ColorSource, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static vm:SldRuleColorSource.Palette}}"
                                 Content="{Binding [sldGenerator_colorsPalette], Source={StaticResource Localization}}"/>
                    <RadioButton GroupName="Colors" Style="{StaticResource Generator.Choice}" IsEnabled="{Binding CanUseDomainColors}"
                                 IsChecked="{Binding ColorSource, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static vm:SldRuleColorSource.Domain}}"
                                 Content="{Binding [sldGenerator_colorsDomain], Source={StaticResource Localization}}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0">
                    <CheckBox Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}" IsChecked="{Binding IncludeOtherValues}"
                              Content="{Binding [sldGenerator_includeOther], Source={StaticResource Localization}}"/>
                    <CheckBox Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}" IsChecked="{Binding ReplaceExisting}" Margin="0,6,0,0"
                              Content="{Binding [sldGenerator_replaceExisting], Source={StaticResource Localization}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--preview: the values and their colours-->
        <Border Grid.Row="1" Margin="8,4,8,8" Padding="10,8"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1"
                CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <mahApp:ProgressRing DockPanel.Dock="Right" IsActive="{Binding IsBusy}" Style="{StaticResource IRI.Maptor.Styles.ProgressRing.Inline}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource boolToVisibilityConverter}}"/>
                    <TextBlock FontWeight="SemiBold" Text="{Binding [sldGenerator_preview], Source={StaticResource Localization}}"/>
                    <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource MahApps.Brushes.Gray3}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding PreviewItems}"
                              VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SldRulePreviewItem}">
                            <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray9}" BorderThickness="0,0,0,1" Padding="0,5">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="22" Height="14" CornerRadius="3" Margin="2,0,10,0"
                                            Background="{Binding Swatch}" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" BorderThickness="1"/>
                                    <TextBlock DockPanel.Dock="Right" Margin="8,0" FlowDirection="LeftToRight"
                                               Foreground="{DynamicResource MahApps.Brushes.Gray3}" Text="{Binding Count}"/>
                                    <TextBlock Margin="0" Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <dialogs:DialogFooterView Grid.Row="2"
                                  PrimaryText="{Binding [sldGenerator_generate], Source={StaticResource Localization}}"
                                  PrimaryIconKind="AutoFix"
                                  PrimaryCommand="{Binding GenerateCommand}"
                                  SecondaryText="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"
                                  SecondaryCommand="{Binding CancelCommand}"/>
    </Grid>
</maptor:LocalizedMetroWindow>
