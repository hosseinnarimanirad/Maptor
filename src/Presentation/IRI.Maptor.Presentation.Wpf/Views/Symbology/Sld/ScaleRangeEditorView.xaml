<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld.ScaleRangeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.Symbology"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RuleViewModel}"
             d:DesignHeight="160" d:DesignWidth="420">

    <!--A rule's scale range (SLD Min/MaxScaleDenominator) in map terms: the zoomed-in limit and the
        zoomed-out limit, each a "1 : n" scale or empty for none. An inverted pair is shown, not refused,
        so a half-typed range never blocks the user.-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Views/Symbology/Sld/SldEditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="scaleBox" TargetType="mahApp:NumericUpDown" BasedOn="{StaticResource sld.NumberBox}">
                <Setter Property="MinWidth" Value="160"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="HideUpDownButtons" Value="True"/>
                <Setter Property="TextAlignment" Value="Left"/>
                <Setter Property="StringFormat" Value="#,0"/>
                <Setter Property="mahApp:TextBoxHelper.ClearTextButton" Value="True"/>
                <Setter Property="mahApp:TextBoxHelper.Watermark" Value="{Binding [sldEditor_scale_noLimit], Source={StaticResource Localization}}"/>
            </Style>

            <!--"1 :" before the denominator, as the scale is written on a map-->
            <Style x:Key="scalePrefix" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Text" Value="1 :"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_scale_minLabel], Source={StaticResource Localization}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource scalePrefix}"/>
                    <mahApp:NumericUpDown Style="{StaticResource scaleBox}" Value="{Binding MinScale, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_scale_maxLabel], Source={StaticResource Localization}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource scalePrefix}"/>
                    <mahApp:NumericUpDown Style="{StaticResource scaleBox}" Value="{Binding MaxScale, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Margin="0,4,0,0" Visibility="{Binding HasScaleRangeError, Converter={StaticResource boolToVisibilityConverter}}">
            <iconPacks:PackIconMaterial DockPanel.Dock="Left" Kind="AlertCircleOutline" Margin="0,0,6,0" VerticalAlignment="Top"
                                        Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.Indicator}"
                                        Foreground="{DynamicResource IRI.Maptor.Brushes.Invalid}"/>
            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Error}" TextWrapping="Wrap"
                       Text="{Binding [sldEditor_scale_inverted], Source={StaticResource Localization}}"/>
        </DockPanel>

        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="{Binding [sldEditor_scale_hint], Source={StaticResource Localization}}"/>
    </StackPanel>
</UserControl>
