<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld.RasterSymbolizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="420">

    <!--A raster: opacity, then the colour map grid with its own add/remove bar. Row grammar as in
        PolygonSymbolizerView. The per-entry Color is SLD model data, not chrome.-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Views/Symbology/Sld/SldEditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_opacity], Source={StaticResource Localization}}"/>
                <Slider Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Slider.Normal}" Value="{Binding Opacity, Mode=TwoWay}"
                        Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                <TextBlock Grid.Column="2" Style="{StaticResource sld.PercentText}" Text="{Binding Opacity, Converter={StaticResource sld.PercentConverter}}"/>
            </Grid>
        </Border>

        <DockPanel Margin="0,8,0,2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding AddEntryCommand}" Style="{StaticResource IRI.Maptor.Styles.Button.IconSquare}"
                        ToolTip="{Binding [sldEditor_raster_addEntry], Source={StaticResource Localization}}"
                        AutomationProperties.Name="{Binding [sldEditor_raster_addEntry], Source={StaticResource Localization}}">
                    <iconPacks:PackIconMaterial Kind="Plus" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                </Button>
                <Button Command="{Binding RemoveEntryCommand}" Style="{StaticResource IRI.Maptor.Styles.Button.IconSquare}"
                        ToolTip="{Binding [sldEditor_raster_removeEntry], Source={StaticResource Localization}}"
                        AutomationProperties.Name="{Binding [sldEditor_raster_removeEntry], Source={StaticResource Localization}}">
                    <iconPacks:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource sld.GroupHeader}" Margin="0" VerticalAlignment="Center"
                       Text="{Binding [sldEditor_raster_colorMap], Source={StaticResource Localization}}"/>
        </DockPanel>

        <DataGrid Style="{StaticResource IRI.Maptor.Styles.DataGrid}" MinHeight="140" MaxHeight="260"
                  ItemsSource="{Binding ColorMap}"
                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{Binding [sldEditor_raster_color], Source={StaticResource Localization}}" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <mahApp:ColorPicker Style="{StaticResource IRI.Maptor.Styles.ColorPicker.Small}" FlowDirection="LeftToRight"
                                                SelectedColor="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{Binding [sldEditor_raster_quantity], Source={StaticResource Localization}}"
                                    Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="70"/>
                <DataGridTextColumn Header="{Binding [sldEditor_raster_label], Source={StaticResource Localization}}"
                                    Binding="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*"/>
                <DataGridTextColumn Header="{Binding [sldEditor_raster_entryOpacity], Source={StaticResource Localization}}"
                                    Binding="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Note}" TextWrapping="Wrap"
                   Text="{Binding [sldEditor_raster_note], Source={StaticResource Localization}}"/>
    </StackPanel>
</UserControl>
