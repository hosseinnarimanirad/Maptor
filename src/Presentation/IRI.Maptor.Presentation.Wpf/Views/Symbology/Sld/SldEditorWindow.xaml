<maptor:LocalizedMetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld.SldEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls"
        xmlns:sldViews="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld"
        xmlns:dialogs="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Dialogs"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.Symbology"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SldEditorViewModel}"
        Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Localized}"
        WindowTransitionsEnabled="False"
        ShowIconOnTitleBar="False"
        ShowInTaskbar="False"
        Title="{Binding [sldEditor_common_editorTitle], Source={StaticResource Localization}}"
        Height="780" Width="1180" MinHeight="560" MinWidth="960">

    <!--Header (what is being styled + file actions), the editor, and the footer. Keys: F2 edits the selected
        rule's legend text; the rule list takes Del, Ctrl+D and Alt+↑/↓.-->

    <maptor:LocalizedMetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Views/Symbology/Sld/SldEditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="headerButton" TargetType="Button" BasedOn="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}">
                <Setter Property="Margin" Value="6,0,0,0"/>
            </Style>
        </ResourceDictionary>
    </maptor:LocalizedMetroWindow.Resources>

    <Grid Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--header: the layer and its rule count; import, export and reset on the far side-->
        <!--Border.Toolbar rather than a stock ToolBar: ToolBar coerces its children into its own chrome, so
            the Maptor button styles would never reach these buttons.-->
        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}">
            <DockPanel Margin="10,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource headerButton}" Command="{Binding ImportSldCommand}"
                            ToolTip="{Binding [sldEditor_common_importTooltip], Source={StaticResource Localization}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                       Text="{Binding [sldEditor_common_import], Source={StaticResource Localization}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource headerButton}" Command="{Binding ExportSldCommand}"
                            ToolTip="{Binding [sldEditor_common_exportTooltip], Source={StaticResource Localization}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSaveOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                       Text="{Binding [sldEditor_common_export], Source={StaticResource Localization}}"/>
                        </StackPanel>
                    </Button>
                    <!--restore the layer's captured default symbology (server style); shown only when the host
                        wired RequestResetToDefaultAction-->
                    <Button Style="{StaticResource headerButton}" Command="{Binding ResetToDefaultCommand}"
                            Visibility="{Binding ShowResetOption, Converter={StaticResource boolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Restore" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                       Text="{Binding [dialog_symbology_resetToDefault], Source={StaticResource Localization}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <iconPacks:PackIconMaterial DockPanel.Dock="Left" Kind="PaletteOutline" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Width="{StaticResource IRI.Maptor.Styles.Size.Icon.Field}"
                                            Height="{StaticResource IRI.Maptor.Styles.Size.Icon.Field}"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}" Margin="0"
                               Text="{Binding LayerName}" ToolTip="{Binding LayerName}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" Text="{Binding RulesCaption}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <sldViews:SldEditorView x:Name="editor" Grid.Row="1"/>

        <!--footer: [Apply][Cancel][OK]-->
        <dialogs:DialogFooterView Grid.Row="2"
                                  ShowTertiary="True"
                                  TertiaryText="{Binding [dialog_common_apply], Source={StaticResource Localization}}"
                                  TertiaryIconKind="Check"
                                  TertiaryCommand="{Binding ApplyCommand}"
                                  SecondaryText="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"
                                  SecondaryCommand="{Binding CancelCommand}"
                                  PrimaryText="{Binding [dialog_common_ok], Source={StaticResource Localization}}"
                                  PrimaryIconKind="CheckBold"
                                  PrimaryCommand="{Binding OkCommand}"/>
    </Grid>
</maptor:LocalizedMetroWindow>
