<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld.SimpleFilterEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:vm="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.Symbology"
             xmlns:sldViews="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="400">

    <!--The inner GroupBox became a SectionHeader rather than another Border.Section: this view is
        hosted inside the editor's "Filter" card, and a card within a card reads as a box in a box.
        Label column uses the shared token (was 90, while the symbolizers used 120).-->

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.ViewContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CheckBox Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}"
                  Content="{Binding [sldEditor_filter_enableFilter], Source={StaticResource Localization}}"
                  IsChecked="{Binding HasFilter, Mode=TwoWay}"/>

        <StackPanel Grid.Row="1" IsEnabled="{Binding HasFilter}">
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}"
                           Text="{Binding [sldEditor_filter_filterSettings], Source={StaticResource Localization}}"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                               Text="{Binding [sldEditor_filter_property], Source={StaticResource Localization}}"/>
                    <!--editable combo: suggests the layer's field names when the editor has layer
                        context (SldEditorViewModel.FieldNames), still accepts free text-->
                    <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}" IsEditable="True"
                              ItemsSource="{Binding DataContext.FieldNames, RelativeSource={RelativeSource AncestorType=sldViews:SldEditorView}}"
                              Text="{Binding FilterPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                               Text="{Binding [sldEditor_filter_operator], Source={StaticResource Localization}}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}"
                              SelectedItem="{Binding FilterOperator, Mode=TwoWay}">
                        <ComboBox.ItemsSource>
                            <x:Array Type="{x:Type vm:FilterComparisonOperator}">
                                <vm:FilterComparisonOperator>Equal</vm:FilterComparisonOperator>
                                <vm:FilterComparisonOperator>NotEqual</vm:FilterComparisonOperator>
                                <vm:FilterComparisonOperator>LessThan</vm:FilterComparisonOperator>
                                <vm:FilterComparisonOperator>GreaterThan</vm:FilterComparisonOperator>
                                <vm:FilterComparisonOperator>LessThanOrEqual</vm:FilterComparisonOperator>
                                <vm:FilterComparisonOperator>GreaterThanOrEqual</vm:FilterComparisonOperator>
                            </x:Array>
                        </ComboBox.ItemsSource>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                               Text="{Binding [sldEditor_filter_value], Source={StaticResource Localization}}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                             Text="{Binding FilterValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                               Style="{StaticResource IRI.Maptor.Styles.TextBlock.Note}"
                               Text="{Binding FilterDescription}"/>
                </Grid>
        </StackPanel>
    </Grid>
</UserControl>
