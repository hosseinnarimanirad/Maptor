<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld.PointSymbolizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:vm="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.Symbology"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PointSymbolizerViewModel}"
             d:DesignHeight="460" d:DesignWidth="420">

    <!--A point marker: Marker (shape, size, rotation), Fill, Outline, geometry property. Row grammar as in
        PolygonSymbolizerView. The colours are SLD data, not chrome.-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Views/Symbology/Sld/SldEditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!--each shape is drawn in the list, not only named-->
        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_shape], Source={StaticResource Localization}}"/>
                <ComboBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}"
                          ItemsSource="{x:Static vm:SldEditorOptions.Marks}"
                          ItemTemplate="{StaticResource sld.MarkOptionTemplate}"
                          SelectedValuePath="Value" SelectedValue="{Binding WellKnownMarkType}"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_size], Source={StaticResource Localization}}"/>
                <mahApp:NumericUpDown Grid.Column="1" Style="{StaticResource sld.NumberBox}" Value="{Binding Size, Mode=TwoWay}"
                                      Minimum="1" Maximum="100" Interval="1" NumericInputMode="Numbers"/>
                <TextBlock Grid.Column="2" Style="{StaticResource sld.Unit}" Text="px"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_rotation], Source={StaticResource Localization}}"/>
                <mahApp:NumericUpDown Grid.Column="1" Style="{StaticResource sld.NumberBox}" Value="{Binding Rotation, Mode=TwoWay}"
                                      Minimum="0" Maximum="360" Interval="15"/>
                <TextBlock Grid.Column="2" Style="{StaticResource sld.Unit}" Text="°"/>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource sld.GroupHeader}"
                   Text="{Binding [sldEditor_section_fill], Source={StaticResource Localization}}"/>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_color], Source={StaticResource Localization}}"/>
                <mahApp:ColorPicker Grid.Column="1" Style="{StaticResource sld.ColorBox}" SelectedColor="{Binding FillColor, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_opacity], Source={StaticResource Localization}}"/>
                <Slider Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Slider.Normal}" Value="{Binding FillOpacity, Mode=TwoWay}"
                        Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                <TextBlock Grid.Column="2" Style="{StaticResource sld.PercentText}" Text="{Binding FillOpacity, Converter={StaticResource sld.PercentConverter}}"/>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource sld.GroupHeader}"
                   Text="{Binding [sldEditor_section_outline], Source={StaticResource Localization}}"/>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_color], Source={StaticResource Localization}}"/>
                <mahApp:ColorPicker Grid.Column="1" Style="{StaticResource sld.ColorBox}" SelectedColor="{Binding StrokeColor, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_width], Source={StaticResource Localization}}"/>
                <mahApp:NumericUpDown Grid.Column="1" Style="{StaticResource sld.NumberBox}" Value="{Binding StrokeWidth, Mode=TwoWay}"
                                      Minimum="0" Maximum="20" Interval="0.5"/>
                <TextBlock Grid.Column="2" Style="{StaticResource sld.Unit}" Text="px"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_field_opacity], Source={StaticResource Localization}}"/>
                <Slider Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Slider.Normal}" Value="{Binding StrokeOpacity, Mode=TwoWay}"
                        Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                <TextBlock Grid.Column="2" Style="{StaticResource sld.PercentText}" Text="{Binding StrokeOpacity, Converter={StaticResource sld.PercentConverter}}"/>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource sld.GroupHeader}"
                   Text="{Binding [sldEditor_section_geometry], Source={StaticResource Localization}}"/>

        <Border Style="{StaticResource sld.FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [sldEditor_common_geometryProperty], Source={StaticResource Localization}}"/>
                <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                         mahApp:TextBoxHelper.Watermark="{Binding [sldEditor_field_geometryDefault], Source={StaticResource Localization}}"
                         Text="{Binding GeometryPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
