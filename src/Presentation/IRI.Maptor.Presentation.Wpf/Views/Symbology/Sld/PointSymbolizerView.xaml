<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Symbology.Sld.PointSymbolizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:sld="clr-namespace:IRI.Maptor.Core.Ogc.SLD;assembly=IRI.Maptor.Core.Ogc"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="350">

    <!--Reference layout for the five symbolizer editors: one label column at the shared width
        token so labels stay aligned as the user moves between symbolizer types, and every editor
        on its keyed style so heights match down the column. The ColorPicker and Slider styles are
        new; before them this view was entirely unstyled and the rows were visibly uneven.

        The colours here are the symbol's own appearance, bound to the SLD model. They are data,
        not chrome, and must never be swapped for theme brushes.-->

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.ViewContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_pointSymbolizer_markType], Source={StaticResource Localization}}"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}"
                  SelectedItem="{Binding WellKnownMarkType}">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sld:WellKnownMark}">
                    <sld:WellKnownMark>circle</sld:WellKnownMark>
                    <sld:WellKnownMark>square</sld:WellKnownMark>
                    <sld:WellKnownMark>triangle</sld:WellKnownMark>
                    <sld:WellKnownMark>star</sld:WellKnownMark>
                    <sld:WellKnownMark>cross</sld:WellKnownMark>
                    <sld:WellKnownMark>x</sld:WellKnownMark>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_pointSymbolizer_size], Source={StaticResource Localization}}"/>
        <mahApp:NumericUpDown Grid.Row="1" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}"
                              Value="{Binding Size, Mode=TwoWay}"
                              Minimum="1" Maximum="100" Interval="1"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_pointSymbolizer_rotation], Source={StaticResource Localization}}"/>
        <mahApp:NumericUpDown Grid.Row="2" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}"
                              Value="{Binding Rotation, Mode=TwoWay}"
                              Minimum="0" Maximum="360" Interval="1"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_common_fillColor], Source={StaticResource Localization}}"/>
        <mahApp:ColorPicker Grid.Row="3" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ColorPicker.Normal}"
                            SelectedColor="{Binding FillColor, Mode=TwoWay}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_common_fillOpacity], Source={StaticResource Localization}}"/>
        <Slider Grid.Row="4" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Slider.Normal}"
                Value="{Binding FillOpacity, Mode=TwoWay}"
                Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_common_strokeColor], Source={StaticResource Localization}}"/>
        <mahApp:ColorPicker Grid.Row="5" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.ColorPicker.Normal}"
                            SelectedColor="{Binding StrokeColor, Mode=TwoWay}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_common_strokeWidth], Source={StaticResource Localization}}"/>
        <mahApp:NumericUpDown Grid.Row="6" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}"
                              Value="{Binding StrokeWidth, Mode=TwoWay}"
                              Minimum="0" Maximum="20" Interval="0.5"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_common_strokeOpacity], Source={StaticResource Localization}}"/>
        <Slider Grid.Row="7" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Slider.Normal}"
                Value="{Binding StrokeOpacity, Mode=TwoWay}"
                Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_common_geometryProperty], Source={StaticResource Localization}}"/>
        <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                 Text="{Binding GeometryPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>
