<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Identify.IdentifyResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
             xmlns:attributes="clr-namespace:IRI.Maptor.Core.Common.Attributes;assembly=IRI.Maptor.Core.Common"
             xmlns:identify="clr-namespace:IRI.Maptor.Presentation.Wpf.Models.Identify"
             xmlns:viewModels="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.Identify"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:IdentifyResultsViewModel}"
             d:DesignWidth="760" d:DesignHeight="460"
             Background="{DynamicResource MahApps.Brushes.ThemeBackground}">

    <!--Master–detail view of an identify click: layer → feature tree on the leading side,
        the selected node's attributes on the trailing side. Hosted by IdentifyResultsWindow,
        but self-contained so an app can dock it in a side panel instead.-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <!--tree rows-->
            <HierarchicalDataTemplate DataType="{x:Type identify:IdentifyLayerNode}" ItemsSource="{Binding VisibleFeatures}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconMaterial Grid.Column="0"
                                                Kind="{Binding GeometryType, Converter={StaticResource geometryTypeToMaterialIconConverter}}"
                                                Width="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                                Height="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                                Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0"/>

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal.Bold}"
                               Text="{Binding LayerName}"
                               ToolTip="{Binding LayerName}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <Border Grid.Column="2" Style="{StaticResource IRI.Maptor.Styles.Pill.Small}" Margin="6,0,0,0">
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text.Small}" Text="{Binding VisibleCount}"/>
                    </Border>
                </Grid>
            </HierarchicalDataTemplate>

            <DataTemplate DataType="{x:Type identify:IdentifyFeatureNode}">
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                           Text="{Binding Title}"
                           ToolTip="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </DataTemplate>

            <!--value cell: numbers right-aligned, nulls muted, per-field text direction-->
            <Style x:Key="valueCellText" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,2"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsNumeric}" Value="True">
                        <Setter Property="TextAlignment" Value="Right"/>
                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDateTime}" Value="True">
                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsNull}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Muted}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TextDirection}" Value="{x:Static attributes:FieldTextDirection.LeftToRight}">
                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TextDirection}" Value="{x:Static attributes:FieldTextDirection.RightToLeft}">
                        <Setter Property="FlowDirection" Value="RightToLeft"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="nameCellText" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,2"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Style.Triggers>
                    <!--an attribute the layer schema does not declare: shown, but visibly secondary-->
                    <DataTrigger Binding="{Binding IsInSchema}" Value="False">
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="FontStyle" Value="Italic"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="toolbarIcon" TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.ViewContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--header: summary + clicked location (the empty state below speaks for itself)-->
        <Grid Grid.Row="0" Margin="0,0,0,8"
              Visibility="{Binding HasResults, Converter={StaticResource boolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}"
                           Text="{Binding SummaryText}"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasResults, Converter={StaticResource boolToVisibilityConverter}}">
                    <iconPacks:PackIconMaterial Kind="MapMarkerOutline"
                                                Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.Indicator}"
                                                Margin="0,0,4,0"/>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}"
                               Text="{Binding [identify_location], Source={StaticResource Localization}, StringFormat='{}{0}:'}"
                               Margin="0,0,4,0"/>
                    <!--coordinates are always Latin digits, so they keep LTR inside an RTL window-->
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}"
                               Text="{Binding LocationText}"
                               FlowDirection="LeftToRight"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--no results at all-->
        <TextBlock Grid.Row="1"
                   Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}"
                   Text="{Binding [identify_noResults], Source={StaticResource Localization}}"
                   Visibility="{Binding HasResults, Converter={StaticResource boolToInverseVisibilityConverter}}"/>

        <!--master / detail-->
        <Grid Grid.Row="1" Visibility="{Binding HasResults, Converter={StaticResource boolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!--master: filter strip + layer → feature tree-->
            <Border Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--the filter sits on the toolbar surface so the borderless TextBox.Normal stays visible-->
                    <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}" Padding="4,2">
                        <TextBox x:Name="filterBox"
                                 Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 mahApp:TextBoxHelper.Watermark="{Binding [identify_filterPlaceholder], Source={StaticResource Localization}}"
                                 mahApp:TextBoxHelper.ClearTextButton="True"/>
                    </Border>

                    <TreeView x:Name="tree"
                              Grid.Row="1"
                              Style="{StaticResource IRI.Maptor.Styles.TreeView}"
                              ItemsSource="{Binding Layers}"
                              MouseDoubleClick="OnTreeMouseDoubleClick">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource IRI.Maptor.Styles.TreeViewItem}">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}"
                               Text="{Binding [identify_noMatch], Source={StaticResource Localization}}"
                               Visibility="{Binding HasVisibleResults, Converter={StaticResource boolToInverseVisibilityConverter}}"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.GridSplitter.Vertical}"/>

            <!--detail-->
            <Border Grid.Column="2" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}">
                <Grid>

                    <!--a feature: toolbar, title, attribute table-->
                    <Grid Visibility="{Binding IsFeatureSelected, Converter={StaticResource boolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                            Command="{Binding ZoomToCommand}"
                                            ToolTip="{Binding [identify_zoomTo], Source={StaticResource Localization}}"
                                            AutomationProperties.Name="{Binding [identify_zoomTo], Source={StaticResource Localization}}">
                                        <iconPacks:PackIconMaterial Kind="MagnifyExpand" Style="{StaticResource toolbarIcon}"/>
                                    </Button>
                                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                            Command="{Binding FlashCommand}"
                                            ToolTip="{Binding [identify_flash], Source={StaticResource Localization}}"
                                            AutomationProperties.Name="{Binding [identify_flash], Source={StaticResource Localization}}">
                                        <iconPacks:PackIconMaterial Kind="Flash" Style="{StaticResource toolbarIcon}"/>
                                    </Button>
                                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                            Command="{Binding CopyAttributesCommand}"
                                            ToolTip="{Binding [identify_copyAttributes], Source={StaticResource Localization}}"
                                            AutomationProperties.Name="{Binding [identify_copyAttributes], Source={StaticResource Localization}}">
                                        <iconPacks:PackIconMaterial Kind="ContentCopy" Style="{StaticResource toolbarIcon}"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center" Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}"
                                               Text="{Binding SelectedFeature.Title}"
                                               ToolTip="{Binding SelectedFeature.Title}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0"/>
                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}"
                                               Text="{Binding SelectedLayer.LayerName}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  Style="{StaticResource IRI.Maptor.Styles.DataGrid.ReadOnly}"
                                  ItemsSource="{Binding SelectedAttributes}"
                                  SelectionMode="Single"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False"
                                  HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [identify_attribute], Source={StaticResource Localization}}"
                                                    Binding="{Binding DisplayName}"
                                                    Width="Auto" MinWidth="110" MaxWidth="260"
                                                    ElementStyle="{StaticResource nameCellText}"/>
                                <DataGridTextColumn Header="{Binding [identify_value], Source={StaticResource Localization}}"
                                                    Binding="{Binding DisplayText}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource valueCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!--a layer: toolbar, name, what was found, its fields-->
                    <Grid Visibility="{Binding IsLayerSelected, Converter={StaticResource boolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                            Command="{Binding ZoomToCommand}"
                                            ToolTip="{Binding [identify_zoomTo], Source={StaticResource Localization}}"
                                            AutomationProperties.Name="{Binding [identify_zoomTo], Source={StaticResource Localization}}">
                                        <iconPacks:PackIconMaterial Kind="MagnifyExpand" Style="{StaticResource toolbarIcon}"/>
                                    </Button>
                                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                            Command="{Binding FlashCommand}"
                                            ToolTip="{Binding [identify_flash], Source={StaticResource Localization}}"
                                            AutomationProperties.Name="{Binding [identify_flash], Source={StaticResource Localization}}">
                                        <iconPacks:PackIconMaterial Kind="Flash" Style="{StaticResource toolbarIcon}"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                                    <iconPacks:PackIconMaterial Kind="{Binding SelectedLayer.GeometryType, Converter={StaticResource geometryTypeToMaterialIconConverter}}"
                                                                Width="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                                                Height="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                                                Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0"/>
                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}"
                                               Text="{Binding SelectedLayer.LayerName}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="{StaticResource IRI.Maptor.Styles.Thickness.ViewContent}">
                            <Grid Style="{StaticResource IRI.Maptor.Styles.Grid.FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                                           Text="{Binding [identify_featuresFound], Source={StaticResource Localization}}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}"
                                           Text="{Binding SelectedLayer.Count}"/>
                            </Grid>

                            <Grid Style="{StaticResource IRI.Maptor.Styles.Grid.FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                                           Text="{Binding [identify_fields], Source={StaticResource Localization}}"
                                           VerticalAlignment="Top"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedLayer.FieldNames}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource IRI.Maptor.Styles.Pill.Small}" Margin="0,0,4,4">
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text.Small}" Text="{Binding}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
