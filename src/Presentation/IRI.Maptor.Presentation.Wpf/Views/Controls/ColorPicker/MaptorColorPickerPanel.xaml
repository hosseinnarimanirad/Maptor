<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.MaptorColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
             Width="240" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"
             Foreground="{DynamicResource MahApps.Brushes.Text}">
    <!--The pop-up of MaptorColorPicker. All state and wiring is in the code-behind: this is the
        inside of a control, not a view with a view model. 240 px wide; the tab area is 200 px high on
        every tab so the pop-up never changes size.-->
    <UserControl.Resources>
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

        <!--segmented tab bar: a rounded track, the selected segment raised on it-->
        <Style x:Key="segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="face" CornerRadius="6" Margin="2" Padding="2,4" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                                <Setter TargetName="face" Property="Effect" Value="{StaticResource IRI.Maptor.Effects.Elevation1}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                <Setter TargetName="face" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--grid cell: square, seamless; the selected one gets a white frame with a dark hairline-->
        <Style x:Key="gridSwatch" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{Binding Brush}" ToolTip="{Binding Hex}">
                            <Border x:Name="outer" BorderBrush="{StaticResource IRI.Maptor.Brushes.Swatch.SelectionOuter}" BorderThickness="1" CornerRadius="3" Visibility="Collapsed"/>
                            <Border x:Name="inner" BorderBrush="{StaticResource IRI.Maptor.Brushes.Swatch.SelectionInner}" BorderThickness="2" CornerRadius="2" Margin="1" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="outer" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="inner" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--brand swatch: rounded, with gaps; the selected one gets an accent ring-->
        <Style x:Key="brandSwatch" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="33"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" ToolTip="{Binding Hex}">
                            <Border x:Name="ring" Width="30" Height="30" CornerRadius="8" BorderThickness="2"
                                    BorderBrush="{DynamicResource MahApps.Brushes.Accent}" Visibility="Collapsed"/>
                            <Border Width="24" Height="24" CornerRadius="6" Background="{Binding Brush}"
                                    BorderBrush="{StaticResource IRI.Maptor.Brushes.Swatch.Edge}" BorderThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--small boxed number/hex input-->
        <Style x:Key="valueBox" TargetType="TextBox">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"/>
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="frame" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border.MouseOver}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--recent colour: round, checkerboard behind so a translucent one reads as such-->
        <Style x:Key="recentSwatch" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid ToolTip="{Binding Hex}">
                            <Ellipse Fill="{StaticResource IRI.Maptor.Brushes.Checkerboard}"/>
                            <Ellipse Fill="{Binding Brush}" Stroke="{StaticResource IRI.Maptor.Brushes.Swatch.Edge}" StrokeThickness="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--round outline button ("+") and square toggle (eyedropper) for the value rows-->
        <Style x:Key="iconButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" CornerRadius="12" BorderThickness="1" Background="Transparent"
                                BorderBrush="{DynamicResource MahApps.Brushes.TextBox.Border}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="iconToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="face" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource MahApps.Brushes.Gray10}"
                                BorderBrush="{DynamicResource MahApps.Brushes.TextBox.Border}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.OnAccent.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="channelLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!--tabs-->
        <Border CornerRadius="8" Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="1">
            <UniformGrid Rows="1">
                <RadioButton x:Name="tabGrid" Style="{StaticResource segment}"
                             Content="{Binding [colorPicker_tab_grid], Source={StaticResource Localization}}" Checked="Tab_Checked"/>
                <RadioButton x:Name="tabSpectrum" Style="{StaticResource segment}"
                             Content="{Binding [colorPicker_tab_spectrum], Source={StaticResource Localization}}" Checked="Tab_Checked"/>
                <RadioButton x:Name="tabSliders" Style="{StaticResource segment}"
                             Content="{Binding [colorPicker_tab_sliders], Source={StaticResource Localization}}" Checked="Tab_Checked"/>
                <RadioButton x:Name="tabBrand" Style="{StaticResource segment}"
                             Content="{Binding [colorPicker_tab_brand], Source={StaticResource Localization}}" Checked="Tab_Checked"/>
            </UniformGrid>
        </Border>

        <Grid Height="200" Margin="0,10,0,0">
            <!--Grid: 12 x 10 seamless cells, rounded outer corners-->
            <Grid x:Name="gridPage" FlowDirection="LeftToRight">
                <ItemsControl x:Name="gridSwatches">
                    <ItemsControl.Clip>
                        <RectangleGeometry Rect="0,0,240,200" RadiusX="8" RadiusY="8"/>
                    </ItemsControl.Clip>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource gridSwatch}" Click="Swatch_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border CornerRadius="8" BorderBrush="{StaticResource IRI.Maptor.Brushes.Swatch.Edge}" BorderThickness="1" IsHitTestVisible="False"/>
            </Grid>

            <!--Spectrum: saturation x brightness square + hue-->
            <StackPanel x:Name="spectrumPage" Visibility="Collapsed">
                <local:ColorSpectrumBox x:Name="spectrum" Height="172"/>
                <local:ColorChannelSlider x:Name="hueSlider" Margin="0,10,0,0"
                                          ToolTip="{Binding [colorPicker_channel_hue], Source={StaticResource Localization}}"/>
            </StackPanel>

            <!--Sliders: three channels, RGB or HSB-->
            <Grid x:Name="slidersPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border HorizontalAlignment="Right" CornerRadius="6" Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="1"
                        FlowDirection="LeftToRight">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="modeRgb" Style="{StaticResource segment}" Content="RGB"
                                     Width="46" IsChecked="True" Checked="SliderMode_Checked"/>
                        <RadioButton x:Name="modeHsb" Style="{StaticResource segment}" Content="HSB"
                                     Width="46" Checked="SliderMode_Checked"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="channel1Label" Style="{StaticResource channelLabel}"/>
                        <local:ColorChannelSlider x:Name="channel1"/>
                    </StackPanel>
                    <TextBox x:Name="channel1Box" Grid.Column="1" Width="46" Style="{StaticResource valueBox}" VerticalAlignment="Bottom"
                             TextAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="channel2Label" Style="{StaticResource channelLabel}"/>
                        <local:ColorChannelSlider x:Name="channel2"/>
                    </StackPanel>
                    <TextBox x:Name="channel2Box" Grid.Column="1" Width="46" Style="{StaticResource valueBox}" VerticalAlignment="Bottom"
                             TextAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="3" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="channel3Label" Style="{StaticResource channelLabel}"/>
                        <local:ColorChannelSlider x:Name="channel3"/>
                    </StackPanel>
                    <TextBox x:Name="channel3Box" Grid.Column="1" Width="46" Style="{StaticResource valueBox}" VerticalAlignment="Bottom"
                             TextAlignment="Center"/>
                </Grid>
            </Grid>

            <!--Brand: 6 x 8 rounded swatches-->
            <ItemsControl x:Name="brandSwatches" Visibility="Collapsed" FlowDirection="LeftToRight" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource brandSwatch}" Click="Swatch_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--shared: opacity, then preview + hex + opacity percent + eyedropper, then recent colours-->
        <local:ColorChannelSlider x:Name="alphaSlider" Margin="0,12,0,0" ShowCheckerboard="True"
                                  ToolTip="{Binding [colorPicker_opacity], Source={StaticResource Localization}}"/>

        <Grid Margin="0,10,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="eyedropperButton" Grid.Column="3" Width="28" Height="28" Margin="8,0,0,0"
                          Style="{StaticResource iconToggle}" Click="Eyedropper_Click"
                          ToolTip="{Binding [colorPicker_eyedropper], Source={StaticResource Localization}}">
                <iconPacks:PackIconMaterial Kind="Eyedropper" Width="14" Height="14"/>
            </ToggleButton>
            <Grid Width="28" Height="28">
                <Border CornerRadius="6" Background="{StaticResource IRI.Maptor.Brushes.Checkerboard}"/>
                <Border x:Name="preview" CornerRadius="6" BorderBrush="{StaticResource IRI.Maptor.Brushes.Swatch.Edge}" BorderThickness="1"/>
            </Grid>
            <Grid Grid.Column="1" Margin="8,0">
                <TextBox x:Name="hexBox" Style="{StaticResource valueBox}" Padding="13,0,4,0" MaxLength="9"
                         CharacterCasing="Upper"
                         ToolTip="{Binding [colorPicker_hex], Source={StaticResource Localization}}"/>
                <TextBlock Text="#" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
            </Grid>
            <Grid Grid.Column="2" Width="68">
                <TextBox x:Name="opacityBox" Style="{StaticResource valueBox}" Padding="2,0,16,0" TextAlignment="Right"
                         ToolTip="{Binding [colorPicker_opacity], Source={StaticResource Localization}}"/>
                <TextBlock Text="%" Margin="0,0,7,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
            </Grid>
        </Grid>

        <!--recent colours (shared by all pickers this session) and "+" to save the current one-->
        <Grid Margin="0,10,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ItemsControl x:Name="recentSwatches">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource recentSwatch}" Click="Recent_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="addRecentButton" Grid.Column="1" Style="{StaticResource iconButton}" Click="AddRecent_Click"
                    ToolTip="{Binding [colorPicker_addRecent], Source={StaticResource Localization}}">
                <iconPacks:PackIconMaterial Kind="Plus" Width="12" Height="12"/>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
