<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.MgrsGoToView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
             x:Name="root"
             NumberSubstitution.Substitution="European">

    <!--The MGRS panel body: one box and one status line. A reference may stop at any level, and
        the shorter it is the larger the region it names, so the status line reports a region
        rather than a position and the only action is "zoom to".-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [dialog_mgrs_reference], Source={StaticResource Localization}}"/>

        <!--Latin and left-to-right whatever the UI language: a grid reference is an identifier
            with letters and digits interleaved, written the same way everywhere.-->
        <Grid Margin="0,2,0,4" FlowDirection="LeftToRight">
            <TextBox x:Name="referenceBox"
                     Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal.En}"
                     Margin="0" Padding="34,4,8,4"
                     BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                     Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     mahApp:TextBoxHelper.ClearTextButton="True"
                     mahApp:TextBoxHelper.Watermark="{Binding [dialog_mgrs_watermark], Source={StaticResource Localization}}"
                     mahApp:TextBoxHelper.WatermarkTrimming="CharacterEllipsis"
                     mahApp:TextBoxHelper.WatermarkAlignment="Left"
                     AutomationProperties.Name="{Binding [dialog_mgrs_reference], Source={StaticResource Localization}}"
                     ToolTip="{Binding [dialog_mgrs_tooltip], Source={StaticResource Localization}}"/>
            <!--leading glyph, drawn over the box's left padding. The FieldAdornment style centres
                its icon, so the alignment and margin have to be pinned here or the glyph sits on
                top of the text.-->
            <iconPacks:PackIconMaterial Kind="Grid" FlowDirection="LeftToRight"
                                        Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.FieldAdornment}"
                                        Width="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                        Height="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                        IsHitTestVisible="False"/>
        </Grid>

        <!--What the reference resolved to, or why it did not. Degrees stay Latin for the same
            reason the reference does.-->
        <TextBlock FlowDirection="LeftToRight" TextWrapping="Wrap" MinHeight="32" Text="{Binding Status}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}">
                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ValidationSummary2}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!--Where the pointer is, in full. The grid on the map labels its lines with principal
            digits only, so this is where those digits get their whole reference — and it keeps
            updating while the reference box above is being typed into.-->
        <Separator Margin="0,6,0,6" Opacity="0.4"/>

        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource IRI.Maptor.Styles.Button.IconSquare}"
                    Command="{Binding CopyCurrentPositionCommand}"
                    ToolTip="{Binding [dialog_mgrs_copyCurrentPosition], Source={StaticResource Localization}}"
                    AutomationProperties.Name="{Binding [dialog_mgrs_copyCurrentPosition], Source={StaticResource Localization}}">
                <iconPacks:PackIconMaterial Kind="ContentCopy" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}" Margin="0"/>
            </Button>

            <StackPanel>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                           Text="{Binding [dialog_mgrs_currentPosition], Source={StaticResource Localization}}"/>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}"
                           FlowDirection="LeftToRight" Margin="0,2,0,0"
                           Text="{Binding CurrentPosition}"/>
            </StackPanel>
        </DockPanel>

    </StackPanel>
</UserControl>
