<Window x:Class="IRI.Maptor.Presentation.Wpf.Controls.Dialogs.NotificationToastView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        WindowStartupLocation="Manual"
        MaxWidth="520">

    <!--A short, non-blocking message at the bottom of the owner window (IDialogService.ShowNotification):
        it takes no focus, closes itself after a few seconds, and closes on click.-->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </Window.Resources>

    <!--margin leaves room for the shadow, which AllowsTransparency would otherwise clip-->
    <Border Margin="12" Padding="12,8"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1"
            CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <DockPanel LastChildFill="True">
            <iconPacks:PackIconMaterial DockPanel.Dock="Left" Kind="InformationOutline" Width="18" Height="18"
                                        Margin="0,0,10,0" VerticalAlignment="Center"
                                        Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
            <Button x:Name="closeButton" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                    Style="{StaticResource IRI.Maptor.Styles.Button.IconSquare}" Focusable="False"
                    ToolTip="{Binding [dialog_common_close], Source={StaticResource Localization}}"
                    AutomationProperties.Name="{Binding [dialog_common_close], Source={StaticResource Localization}}"
                    Click="OnCloseClick">
                <iconPacks:PackIconMaterial Kind="Close" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}" Margin="0"/>
            </Button>
            <!--drawn as given (European digits): callers localize digits themselves, and text such as an IP
                address must not be turned into Persian digits (see MessageBoxView)-->
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="titleText" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                           NumberSubstitution.Substitution="European" Visibility="Collapsed"/>
                <TextBlock x:Name="messageText" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                           TextWrapping="Wrap" NumberSubstitution.Substitution="European"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
