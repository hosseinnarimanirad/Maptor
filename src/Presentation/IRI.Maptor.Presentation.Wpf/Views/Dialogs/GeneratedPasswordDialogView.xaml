<mahApp:MetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.Dialogs.GeneratedPasswordDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
    xmlns:viewModel="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.Dialogs"
    d:DataContext="{d:DesignInstance Type=viewModel:GeneratedPasswordDialogViewModel, IsDesignTimeCreatable=False}"
    mc:Ignorable="d"
    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
    Title="{Binding [dialog_generatedPassword_title], Source={StaticResource Localization}}"
    WindowStartupLocation="CenterOwner">

    <!--A password the server generated for an account (password reset), handed to the administrator once:
        selectable, left-to-right in a fixed-width font so l/1 and O/0 can be told apart, and a Copy button.-->
    <mahApp:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </mahApp:MetroWindow.Resources>
    <!--Esc closes through the view model, the dialog service's only close path (OnSetResult)-->
    <mahApp:MetroWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </mahApp:MetroWindow.InputBindings>
    <mahApp:MetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.WindowTitle}"/>
        </DataTemplate>
    </mahApp:MetroWindow.TitleTemplate>

    <Grid Margin="12" MaxWidth="460">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,12,0"
                    Height="40" Width="40" BorderThickness="4" CornerRadius="20" VerticalAlignment="Top">
                <iconPacks:PackIconMaterial Kind="LockReset" Width="18" Height="18"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
            </Border>
            <!--European digits: an e-mail address must read as typed under a Persian culture (see MessageBoxView)-->
            <TextBlock Text="{Binding Message}" NumberSubstitution.Substitution="European"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" Padding="4"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1"
                CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}">
            <DockPanel LastChildFill="True">
                <Button x:Name="copyButton" DockPanel.Dock="Right"
                        Style="{StaticResource IRI.Maptor.Styles.Button.IconSquare}"
                        Command="{Binding CopyCommand}"
                        ToolTip="{Binding [dialog_generatedPassword_copy], Source={StaticResource Localization}}"
                        AutomationProperties.Name="{Binding [dialog_generatedPassword_copy], Source={StaticResource Localization}}">
                    <iconPacks:PackIconMaterial Margin="0">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}">
                                <Setter Property="Kind" Value="ContentCopy"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                        <Setter Property="Kind" Value="Check"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                </Button>

                <!--read-only but selectable, so it can also be copied by hand; Latin digits whatever the culture-->
                <TextBox x:Name="passwordText"
                         Text="{Binding Password, Mode=OneWay}"
                         IsReadOnly="True"
                         IsUndoEnabled="False"
                         FlowDirection="LeftToRight"
                         NumberSubstitution.Substitution="European"
                         FontFamily="Consolas"
                         FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Title}"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         BorderThickness="0"
                         Background="Transparent"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource IRI.Maptor.Brushes.Valid}"
                       Text="{Binding [dialog_generatedPassword_copied], Source={StaticResource Localization}}"
                       Visibility="{Binding IsCopied, Converter={StaticResource boolToVisibilityConverter}}"/>
            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource IRI.Maptor.Brushes.Invalid}"
                       Text="{Binding [dialog_generatedPassword_copyFailed], Source={StaticResource Localization}}"
                       Visibility="{Binding CopyFailed, Converter={StaticResource boolToVisibilityConverter}}"/>
            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" TextWrapping="Wrap"
                       Text="{Binding [dialog_generatedPassword_note], Source={StaticResource Localization}}"/>
        </StackPanel>

        <Button Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right"
                Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Primary}"
                Command="{Binding CloseCommand}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="CheckBold" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                           Text="{Binding [dialog_common_ok], Source={StaticResource Localization}}"/>
            </StackPanel>
        </Button>
    </Grid>
</mahApp:MetroWindow>
