<mahApp:MetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.Dialogs.CsvTsvOpenDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
    xmlns:dialogs="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Dialogs"
    xmlns:maptorEnums="clr-namespace:IRI.Maptor.Core.Common.Enums;assembly=IRI.Maptor.Core.Common"

    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
    Title="{Binding [dialog_csvTsvOpen_title], Source={StaticResource Localization}}"
    SizeToContent="Manual" ResizeMode="CanResizeWithGrip"
    Width="560" Height="640" MinWidth="500" MinHeight="480" MaxWidth="900"
    FocusManager.FocusedElement="{Binding ElementName=browseButton}"
    WindowStartupLocation="CenterOwner">
    <mahApp:MetroWindow.Resources>
        <ResourceDictionary>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </mahApp:MetroWindow.Resources>
    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}"
                   Text="{Binding [dialog_common_fileWatermark], Source={StaticResource Localization}}"/>

        <!-- File -->
        <Border Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconMaterial Kind="File" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.FieldAdornment}"/>
                <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal.En}"
                         mahApp:TextBoxHelper.Watermark="{Binding [dialog_common_fileWatermark], Source={StaticResource Localization}}"
                         Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True"/>
                <Button Grid.Column="2" x:Name="browseButton"
                        ToolTip="{Binding [dialog_common_browse], Source={StaticResource Localization}}"
                        AutomationProperties.Name="{Binding [dialog_common_browse], Source={StaticResource Localization}}"
                        Command="{Binding BrowseCommand}"
                        Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                    <iconPacks:PackIconMaterial Kind="FileSearchOutline"/>
                </Button>
                <Button Grid.Column="3"
                         ToolTip="{Binding [dialog_common_removeFile], Source={StaticResource Localization}}"
                         AutomationProperties.Name="{Binding [dialog_common_removeFile], Source={StaticResource Localization}}"
                         Command="{Binding RemoveFileCommand}"
                         Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                         >
                    <iconPacks:PackIconMaterial Kind="FileRemoveOutline"/>
                </Button>

            </Grid>
        </Border>

        <!-- Format: (CSV / TSV) | Geometry Type: (POINT/LINE/POLYGON) -->
        <Border Grid.Row="2" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconPhosphorIcons Kind="FileText" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4">
                    <RadioButton Content="{Binding [dialog_csvTsvOpen_formatCsv], Source={StaticResource Localization}}"
                                 IsChecked="{Binding IsCsv, Mode=TwoWay}"
                                 Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form.Latin}" />
                    <RadioButton Content="{Binding [dialog_csvTsvOpen_formatTsv], Source={StaticResource Localization}}"
                                 IsChecked="{Binding IsCsv, Mode=TwoWay, Converter={StaticResource notConverter}}"
                                 Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form.Latin}" />
                </StackPanel>
                <iconPacks:PackIconPhosphorIcons Kind="ShapesLight" Grid.Column="3" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}"
                                                 ToolTip="{Binding [dialog_csvTsvOpen_geometryType],Source={StaticResource Localization}}"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" >
                    <RadioButton GroupName="T" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                IsChecked="{Binding SelectedGeometryMode, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorEnums:GeometryType.Polygon}}"
                                ToolTip="{Binding [common_geometryType_polygon], Source={StaticResource Localization}}"
                                AutomationProperties.Name="{Binding [common_geometryType_polygon], Source={StaticResource Localization}}">
                        <iconPacks:PackIconPhosphorIcons Kind="Polygon"/>
                    </RadioButton>
                    <RadioButton GroupName="T" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                 IsChecked="{Binding SelectedGeometryMode, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorEnums:GeometryType.LineString}}"
                                 ToolTip="{Binding [common_geometryType_polyline], Source={StaticResource Localization}}"
                                 AutomationProperties.Name="{Binding [common_geometryType_polyline], Source={StaticResource Localization}}">
                        <iconPacks:PackIconPhosphorIcons Kind="LineSegments"/>
                    </RadioButton>
                    <RadioButton GroupName="T" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                 IsChecked="{Binding SelectedGeometryMode, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorEnums:GeometryType.Point}}"
                                 ToolTip="{Binding [common_geometryType_point], Source={StaticResource Localization}}"
                                 AutomationProperties.Name="{Binding [common_geometryType_point], Source={StaticResource Localization}}">
                        <Viewbox>
                            <iconPacks:PackIconPhosphorIcons Kind="DotOutlineThin" Margin="20" Padding="0"/>
                        </Viewbox>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}"
                   Text="{Binding [dialog_common_sectionCoordinateSystem], Source={StaticResource Localization}}"/>

        <!-- Spatial Reference -->
        <Border Grid.Row="4" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconPhosphorIcons Kind="Globe" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableSrsOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedSrsOption, Mode=TwoWay}"
                          Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}"/>
            </Grid>
        </Border>

        <!-- UTM Zone (visible when UTM selected) -->
        <Border Grid.Row="5" Style="{StaticResource IRI.Maptor.Styles.Border.Card}"
                Visibility="{Binding IsUtmSelected, Converter={StaticResource boolToVisibilityConverter}}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconPhosphorIcons Kind="MapTrifoldFill" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}"/>
                <mahApp:NumericUpDown Grid.Column="1" Minimum="1" Maximum="60"
                                        mahApp:ControlsHelper.CornerRadius="4"
                                        Value="{Binding UtmZone, Mode=TwoWay}"
                                        Style="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,2,4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Default (northern hemisphere) -->
                            <Setter Property="Text"
                     Value="{Binding [srs_northernHemisphere], Source={StaticResource Localization}}"/>
                            <Style.Triggers>
                                <!-- Southern hemisphere (IsChecked = False) -->
                                <DataTrigger Binding="{Binding IsNorthHemisphere}" Value="False">
                                    <Setter Property="Text"
                             Value="{Binding [srs_southernHemisphere], Source={StaticResource Localization}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ToggleButton Grid.Column="3" IsChecked="{Binding IsNorthHemisphere, Mode=TwoWay}"
                              Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}" FlowDirection="LeftToRight"
                              ToolTip="{Binding [dialog_dxfOpen_hemisphereTooltip], Source={StaticResource Localization}}"
                              AutomationProperties.Name="{Binding [dialog_dxfOpen_hemisphereTooltip], Source={StaticResource Localization}}">
                    <iconPacks:PackIconPhosphorIcons Kind="CircleHalfFill" RenderTransformOrigin="0.5,0.5"
                                                    Margin="0" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons.Style>
                            <Style TargetType="iconPacks:PackIconPhosphorIcons" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNorthHemisphere}" Value="False">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="90"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconPhosphorIcons.Style>
                    </iconPacks:PackIconPhosphorIcons>
                </ToggleButton>

            </Grid>
        </Border>

        <TextBlock Grid.Row="6" Style="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}"
                   Text="{Binding [dialog_common_sectionOptions], Source={StaticResource Localization}}"/>

        <!-- Options: X,Y vs Y,X -->
        <Border Grid.Row="7" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconPhosphorIcons Kind="ListNumbers" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}"/>
                <TextBlock Text="{Binding [dialog_common_xyOrder], Source={StaticResource Localization}}"
                            VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold"/>
                <CheckBox Content="{Binding [dialog_common_eastingFirst], Source={StaticResource Localization}}"
                            IsChecked="{Binding IsLongitudeFirst, Mode=TwoWay}"
                          Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="8" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <CheckBox Content="{Binding [dialog_csvTsvOpen_useFirstLineAsHeader], Source={StaticResource Localization}}"
                      Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}"
                        IsChecked="{Binding UseFirstLineAsHeader, Mode=TwoWay}" />
        </Border>

        <TextBlock Grid.Row="9" Style="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}"
                   Text="{Binding [dialog_common_sectionData], Source={StaticResource Localization}}"/>

        <!-- Data: paste or preview (top 50 lines) -->
        <TextBox x:Name="previewTextbox" Grid.Row="10" Margin="4,0" HorizontalAlignment="Stretch"
                Background="Transparent"
                Style="{StaticResource IRI.Maptor.Styles.TextBox}"
                mahApp:TextBoxHelper.Watermark="{Binding [dialog_csvTsvOpen_pasteWatermark], Source={StaticResource Localization}}"
                Text="{Binding RawText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"
                Padding="4" FlowDirection="LeftToRight"
                IsReadOnly="{Binding IsRawTextReadOnly}"/>

        <!-- Buttons -->
        <dialogs:DialogFooterView Grid.Row="11"
                                  StatusText="{Binding ValidationMessage}"
                                  SecondaryText="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"
                                  SecondaryCommand="{Binding CancelCommand}"
                                  PrimaryText="{Binding [common_open], Source={StaticResource Localization}}"
                                  PrimaryIconKind="FolderOpen"
                                  PrimaryCommand="{Binding OpenCommand}"/>
    </Grid>
</mahApp:MetroWindow>
