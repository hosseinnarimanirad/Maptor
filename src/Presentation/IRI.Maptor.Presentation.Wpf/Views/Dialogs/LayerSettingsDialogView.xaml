<mahApp:MetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.Dialogs.LayerSettingsDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.LayerSettings"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
    xmlns:dialogs="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Dialogs"

    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
    Title="{Binding [dialog_layerSettings_title], Source={StaticResource Localization}}" 
    SizeToContent="Height"
    MaxWidth="700"
    MinWidth="400"
    Height="450" Width="650"
    FocusManager.FocusedElement="{Binding ElementName=settingsTabControl}"
    WindowStartupLocation="CenterOwner">

    <!--custom title bar: the standard one from the shared style plus the layer name-->
    <mahApp:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{TemplateBinding Content}"
                           Style="{StaticResource IRI.Maptor.Styles.TextBlock.WindowTitle}"/>
                <TextBlock Margin="0" FontWeight="Normal"
                    Style="{StaticResource IRI.Maptor.Styles.TextBlock.WindowTitle}"
                    Text="{Binding DataContext.Layer.LayerName, RelativeSource={RelativeSource AncestorType=mahApp:MetroWindow},StringFormat={}({0})}"/>
            </StackPanel>
        </DataTemplate>
    </mahApp:MetroWindow.TitleTemplate>


    <mahApp:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            
            <!--the Persian font now comes from the shared style's IsPersian trigger-->
            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource IRI.Maptor.Styles.TabItem.Form}"/>
             
        </ResourceDictionary>
    </mahApp:MetroWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" x:Name="settingsTabControl" Margin="1"
                    Style="{StaticResource IRI.Maptor.Styles.TabControl.Form}">
            <TabControl.Items>
                <TabItem Header="{Binding [layerSettings_general_title], Source={StaticResource Localization}}">
                    <maptor:LayerSettings_GeneralView DataContext="{Binding Layer}"/>
                </TabItem>
                <TabItem Header="{Binding [layerSettings_export_title], Source={StaticResource Localization}}">
                    <maptor:LayerSettings_ExportView DataContext="{Binding Export}"/>
                </TabItem>
                <!--planned, not yet built. Shown rather than collapsed so the dialog advertises
                    what is coming; the muted disabled state plus the tooltip is what keeps them
                    from reading as broken. The header strip wraps to further rows as needed.-->
                <TabItem IsEnabled="False" Header="{Binding [layerSettings_symbology_title], Source={StaticResource Localization}}"
                         ToolTip="{Binding [layerSettings_notYetAvailable], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Header="{Binding [layerSettings_trackChanges_title], Source={StaticResource Localization}}"
                         ToolTip="{Binding [layerSettings_notYetAvailable], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Header="{Binding [layerSettings_labeling], Source={StaticResource Localization}}"
                         ToolTip="{Binding [layerSettings_notYetAvailable], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Header="{Binding [layerSettings_fields_title], Source={StaticResource Localization}}"
                         ToolTip="{Binding [layerSettings_notYetAvailable], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Header="{Binding [layerSettings_filters_title], Source={StaticResource Localization}}"
                         ToolTip="{Binding [layerSettings_notYetAvailable], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Header="{Binding [layerSettings_statistics_title], Source={StaticResource Localization}}"
                         ToolTip="{Binding [layerSettings_notYetAvailable], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Header="{Binding [layerSettings_analysis_title], Source={StaticResource Localization}}"
                         ToolTip="{Binding [layerSettings_notYetAvailable], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Header="{Binding [layerSettings_security_title], Source={StaticResource Localization}}"
                         ToolTip="{Binding [layerSettings_notYetAvailable], Source={StaticResource Localization}}"/>
            </TabControl.Items>
        </TabControl>

        <!--settings apply live, so Close is the only action-->
        <dialogs:DialogFooterView Grid.Row="1" ShowSecondary="False"
                                  PrimaryText="{Binding [dialog_common_close], Source={StaticResource Localization}}"
                                  PrimaryIconKind="Close"/>
    </Grid>
</mahApp:MetroWindow>
