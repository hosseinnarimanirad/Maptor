<mahApp:MetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.Dialogs.FileGdbDatasetPickerDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
    xmlns:dialogs="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Dialogs"

    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
    Title="{Binding Title}"
    SizeToContent="Manual" ResizeMode="CanResizeWithGrip"
    Width="600" Height="640" MinWidth="480" MinHeight="420" MaxWidth="1000"
    WindowStartupLocation="CenterOwner">

    <!--The file geodatabase picker (FileGdbDatasetPickerViewModel): the datasets grouped by feature dataset, a tick each,
        the reason for those that cannot be added, and one CRS choice for the ticked ones the geodatabase gives none for.-->
    <mahApp:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </mahApp:MetroWindow.Resources>

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Source: the geodatabase, the select-all tick and how many are ticked -->
        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.FieldAdornment}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}"
                           Text="{Binding GeodatabaseName}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                <CheckBox Grid.Column="2" VerticalAlignment="Center" IsThreeState="False"
                          Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}"
                          Content="{Binding [dialog_fileGdbPicker_selectAll], Source={StaticResource Localization}}"
                          IsChecked="{Binding AreAllSelected, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- The datasets, grouped by feature dataset -->
        <ScrollViewer Grid.Row="1" Margin="4,4,4,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding View}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>

                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,6,0"
                                      Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding IsAvailable}"
                                      AutomationProperties.Name="{Binding Title}"/>

                            <!-- geometry type and row count -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,2,0,0">
                                <TextBlock Text="{Binding GeometryTypeText}" Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                           FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"/>
                                <TextBlock Text="{Binding RowCountText}" Margin="12,0,0,0" Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                           FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}"/>
                                <TextBlock Text="{Binding Name}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"
                                           Visibility="{Binding ShowsName, Converter={StaticResource boolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding UnavailableReason}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource IRI.Maptor.Brushes.Warning}" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"
                                           Visibility="{Binding UnavailableReason, Converter={StaticResource stringNotNullOrEmptyToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding [dialog_fileGdbPicker_needsSrs], Source={StaticResource Localization}}"
                                           Foreground="{DynamicResource MahApps.Brushes.Accent}" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"
                                           Visibility="{Binding NeedsSrs, Converter={StaticResource boolToVisibilityConverter}}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- One CRS for the ticked datasets the geodatabase gives none for -->
        <StackPanel Grid.Row="2" Visibility="{Binding ShowsSrsChoice, Converter={StaticResource boolToVisibilityConverter}}">
            <TextBlock Margin="4,0,4,4" TextWrapping="Wrap" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}"
                       Text="{Binding [dialog_fileGdbPicker_srsHint], Source={StaticResource Localization}}"/>
            <dialogs:SrsChoiceView DataContext="{Binding SrsChoice}"/>
        </StackPanel>

        <dialogs:DialogFooterView Grid.Row="3"
                                  StatusText="{Binding StatusText}"
                                  SecondaryText="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"
                                  SecondaryCommand="{Binding CancelCommand}"
                                  PrimaryText="{Binding [dialog_fileGdbPicker_add], Source={StaticResource Localization}}"
                                  PrimaryIconKind="Plus"
                                  PrimaryCommand="{Binding AddCommand}"/>
    </Grid>
</mahApp:MetroWindow>
