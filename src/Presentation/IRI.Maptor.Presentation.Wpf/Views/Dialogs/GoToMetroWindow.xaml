<maptor:LocalizedMetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.GoToMetroWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls"
                    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
                    xmlns:dialogs="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Dialogs"
                    x:Name="root"
                    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
                    Title="{Binding [dialog_goto_title], Source={StaticResource Localization}}"
                    WindowStartupLocation="CenterOwner"
                    Width="520" SizeToContent="Height">
    <maptor:LocalizedMetroWindow.Resources>
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
    </maptor:LocalizedMetroWindow.Resources>

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Fixed width, height from content: the width is otherwise driven by the longest
            text on screen (the English quick-entry watermark, a Persian projection name) and
            would jump as the user types or switches system.-->
        <maptor:GoToView x:Name="mainView" Grid.Row="0"/>

        <!--Every action on one row. The window is modeless and stays open while the map moves,
            so the footer carries the map actions rather than OK/Cancel: Zoom to is the default
            (Enter), Pan to sits beside it; Copy and Add to drawing are icon buttons at the start
            edge. Close lives in the title bar and on Esc. All four commands carry CanExecute,
            so they grey out while the input does not resolve.-->
        <dialogs:DialogFooterView Grid.Row="1"
                                  ShowSecondary="False"
                                  ShowTertiary="True"
                                  TertiaryText="{Binding [dialog_goto_panTo], Source={StaticResource Localization}}"
                                  TertiaryIconKind="HandBackRight"
                                  TertiaryCommand="{Binding PanToCommand}"
                                  PrimaryText="{Binding [dialog_goto_zoomTo], Source={StaticResource Localization}}"
                                  PrimaryIconKind="MagnifyExpand"
                                  PrimaryCommand="{Binding ZoomToCommand}">
            <dialogs:DialogFooterView.LeadingContent>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.IconSquare}"
                            Command="{Binding CopyCommand}"
                            ToolTip="{Binding [dialog_goto_copy], Source={StaticResource Localization}}"
                            AutomationProperties.Name="{Binding [dialog_goto_copy], Source={StaticResource Localization}}">
                        <iconPacks:PackIconMaterial Kind="ContentCopy" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}" Margin="0"/>
                    </Button>
                    <!--same VectorPointPlus the drawing legend uses for "add an item"-->
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.IconSquare}"
                            Command="{Binding AddToDrawingCommand}"
                            ToolTip="{Binding [dialog_goto_addToDrawing], Source={StaticResource Localization}}"
                            AutomationProperties.Name="{Binding [dialog_goto_addToDrawing], Source={StaticResource Localization}}">
                        <iconPacks:PackIconMaterial Kind="VectorPointPlus" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}" Margin="0"/>
                    </Button>
                </StackPanel>
            </dialogs:DialogFooterView.LeadingContent>
        </dialogs:DialogFooterView>
    </Grid>
</maptor:LocalizedMetroWindow>
