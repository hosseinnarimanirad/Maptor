<mahApp:MetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.Dialogs.GeometryDetailsDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
    xmlns:dialogs="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Dialogs"
    xmlns:presenters="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.CoordinateEditor"

    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
    Title="{Binding [dialog_geometryDetails_title], Source={StaticResource Localization}}"
    SizeToContent="Manual" ResizeMode="CanResizeWithGrip"
    Width="780" Height="640" MinWidth="620" MinHeight="440" MaxWidth="1200"
    ShowMaxRestoreButton="True"
    WindowStartupLocation="CenterOwner" >
    <mahApp:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <Style TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>

            <!--A metric tile. The five figures used to sit in one 10-column row of
                "label: value" pairs, which crowded badly once the labels were translated.-->
            <Style x:Key="GeometryStatCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="GeometryStatLabel" TargetType="TextBlock"
                   BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="GeometryStatValue" TargetType="TextBlock"
                   BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

        </ResourceDictionary>
    </mahApp:MetroWindow.Resources>

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}"
                           Margin="2,0,2,6"
                           Text="{Binding [dialog_geometryDetails_basicInfo], Source={StaticResource Localization}}"/>

                <!-- Summary: one tile per figure -->
                <UniformGrid Columns="5" Margin="0,0,0,12">
                    <Border Style="{StaticResource GeometryStatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GeometryStatLabel}"
                                       Text="{Binding [dialog_geometryDetails_geometryType], Source={StaticResource Localization}}"/>
                            <TextBlock Style="{StaticResource GeometryStatValue}"
                                       Text="{Binding GeometryType}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GeometryStatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GeometryStatLabel}"
                                       Text="{Binding [dialog_geometryDetails_dimension], Source={StaticResource Localization}}"/>
                            <TextBlock Style="{StaticResource GeometryStatValue}"
                                       Text="{Binding Dimension}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GeometryStatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GeometryStatLabel}"
                                       Text="{Binding [dialog_geometryDetails_numberOfPoints], Source={StaticResource Localization}}"/>
                            <TextBlock Style="{StaticResource GeometryStatValue}"
                                       Text="{Binding NumberOfPoints, Converter={StaticResource localizedNumberConverter}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GeometryStatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GeometryStatLabel}"
                                       Text="{Binding [dialog_geometryDetails_numberOfGeometries], Source={StaticResource Localization}}"/>
                            <TextBlock Style="{StaticResource GeometryStatValue}"
                                       Text="{Binding NumberOfGeometries, Converter={StaticResource localizedNumberConverter}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GeometryStatCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GeometryStatLabel}"
                                       Text="{Binding [srs_utmZone_full], Source={StaticResource Localization}}"/>
                            <TextBlock Style="{StaticResource GeometryStatValue}"
                                       Text="{Binding UtmZone, TargetNullValue='N/A'}"/>
                            <!-- the other zones this geometry crosses -->
                            <TextBlock FontSize="11" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                       Visibility="{Binding SpansMultipleUtmZones, Converter={StaticResource boolToVisibilityConverter}}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource localizedFormatConverter}">
                                        <Binding Path="UtmZones" Converter="{StaticResource collectionToStringConverter}"/>
                                        <Binding Path="[dialog_geometryDetails_alsoZones]" Source="{StaticResource Localization}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Geometry Editor Section -->
                <Expander Style="{StaticResource IRI.Maptor.Styles.Expander.Section}" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="{Binding [dialog_geometryDetails_editCoordinates], Source={StaticResource Localization}}"
                                   Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal.Bold}" Margin="0"/>
                    </Expander.Header>
                    <ContentControl Content="{Binding GeometryEditor}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type presenters:GeometryEditorViewModel}">
                                <maptor:GeometryEditorView/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Expander>

                <!-- Format Display Section -->
                <Expander Style="{StaticResource IRI.Maptor.Styles.Expander.Section}" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Text="{Binding [dialog_geometryDetails_format], Source={StaticResource Localization}}"
                                   Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal.Bold}" Margin="0"/>
                    </Expander.Header>
                    <StackPanel>
                        <!-- toolbar: which representation, and copy it -->
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Command="{Binding CopySelectedFormat}"
                                    ToolTip="{Binding [dialog_geometryDetails_copy], Source={StaticResource Localization}}"
                                    AutomationProperties.Name="{Binding [dialog_geometryDetails_copy], Source={StaticResource Localization}}"
                                    Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                                <iconPacks:PackIconMaterial Kind="ContentCopy"/>
                            </Button>

                            <TextBlock DockPanel.Dock="Left"
                                       Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                                       VerticalAlignment="Center"
                                       Text="{Binding [dialog_geometryDetails_format], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>

                            <ComboBox ItemsSource="{Binding AvailableFormats}"
                                      Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}"
                                      VerticalAlignment="Center" Margin="4,0"
                                      SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"/>
                        </DockPanel>

                        <!-- the representation itself: read-only but selectable, so it can be
                             copied by hand as well as with the button -->
                        <Border CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                                Background="{DynamicResource MahApps.Brushes.Gray9}"
                                MaxHeight="170">
                            <TextBox Text="{Binding StringRepresentation, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FlowDirection="LeftToRight"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Padding="8,6"
                                     FontFamily="Consolas" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <dialogs:DialogFooterView Grid.Row="1"
                                  SecondaryText="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"
                                  SecondaryCommand="{Binding CancelEditingCommand}"
                                  PrimaryText="{Binding [dialog_common_save], Source={StaticResource Localization}}"
                                  PrimaryIconKind="CheckBold"
                                  PrimaryCommand="{Binding SaveGeometryCommand}"/>

    </Grid>

</mahApp:MetroWindow>
