<maptor:LocalizedMetroWindow x:Class="IRI.Maptor.Presentation.Wpf.Controls.MgrsGoToMetroWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls"
                    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
                    xmlns:dialogs="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls.Dialogs"
                    x:Name="root"
                    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
                    Title="{Binding [dialog_mgrs_title], Source={StaticResource Localization}}"
                    WindowStartupLocation="CenterOwner"
                    Width="520" SizeToContent="Height">
    <maptor:LocalizedMetroWindow.Resources>
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
    </maptor:LocalizedMetroWindow.Resources>

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <maptor:MgrsGoToView x:Name="mainView" Grid.Row="0"/>

        <!--Modeless like the Go To window, so the footer carries the map actions rather than
            OK/Cancel. Zoom to is the default; Copy is an icon button at the start edge, and puts
            the reference on the clipboard in its conventional spacing rather than as typed. There
            is nothing to pan to: a reference names a region, not a point.-->
        <dialogs:DialogFooterView Grid.Row="1"
                                  ShowSecondary="False"
                                  ShowTertiary="False"
                                  PrimaryText="{Binding [dialog_mgrs_zoomTo], Source={StaticResource Localization}}"
                                  PrimaryIconKind="MagnifyExpand"
                                  PrimaryCommand="{Binding ZoomToCommand}">
            <dialogs:DialogFooterView.LeadingContent>
                <Button Style="{StaticResource IRI.Maptor.Styles.Button.IconSquare}"
                        Command="{Binding CopyCommand}"
                        ToolTip="{Binding [dialog_mgrs_copy], Source={StaticResource Localization}}"
                        AutomationProperties.Name="{Binding [dialog_mgrs_copy], Source={StaticResource Localization}}">
                    <iconPacks:PackIconMaterial Kind="ContentCopy" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}" Margin="0"/>
                </Button>
            </dialogs:DialogFooterView.LeadingContent>
        </dialogs:DialogFooterView>
    </Grid>
</maptor:LocalizedMetroWindow>
