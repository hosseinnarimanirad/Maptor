<maptor:MapMarker x:Class="IRI.Maptor.Presentation.Wpf.Controls.MapMarkers.TextboxMarker"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
                  xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls"
                     xmlns:local="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.Map"
                     xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
                     xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:converters="clr-namespace:IRI.Maptor.Presentation.Wpf.Converters"
                    x:Name="root" Background="Transparent" Canvas.ZIndex="1000000" FlowDirection="LeftToRight"
                    MouseUp="root_MouseUp" >
    <maptor:MapMarker.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Animations.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Colors.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <!--<helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.Button.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.ToggleButton.xaml"/>-->
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <converters:ColorToContrastBrushConverter x:Key="colorToContrastBrushConverter"/>
            <converters:LocalizationKeyConverter x:Key="localizationKeyConverter"/>
            <converters:HaloColorConverter x:Key="haloColorConverter"/>
        </ResourceDictionary>
    </maptor:MapMarker.Resources>
    <maptor:MapMarker.RenderTransform>
        <TransformGroup>
            <ScaleTransform />
        </TransformGroup>
    </maptor:MapMarker.RenderTransform>
    <!-- Setters below are the Box frame (the original look); the "Formatting_Frame is not Box"
         triggers (Plain, Halo) drop the frame, the white field and the fixed minimum width -->
    <Border x:Name="mainBorder" CornerRadius="5"  BorderBrush="White" BorderThickness="0"
            MouseEnter="OnMarkerMouseEnter" MouseLeave="OnMarkerMouseLeave">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{Binding BackgroundColor}"/>
                <Setter Property="MinWidth" Value="150"/>
                <!-- long lines wrap instead of growing the label without limit -->
                <Setter Property="MaxWidth" Value="600"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedBackgroundChoice.IsTheme}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                    </DataTrigger>
                    <!-- after the IsTheme trigger, so it wins over it -->
                    <DataTrigger Binding="{Binding Formatting_Frame, Converter={StaticResource enumToBoolConverter}, ConverterParameter=Box}" Value="False">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="MinWidth" Value="40"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <!-- drag handle; without a frame it shows only while the label is hovered or being
                 edited (Opacity, not Visibility, so the label never changes size and the hidden
                 handle can still be hovered and grabbed); left out of printed labels -->
            <Border x:Name="dragHandle" Height="12" Background="Transparent" Cursor="ScrollAll" >
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Formatting_Frame, Converter={StaticResource enumToBoolConverter}, ConverterParameter=Box}" Value="False"/>
                                    <Condition Binding="{Binding IsMouseOver, ElementName=root}" Value="False"/>
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=root}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="0"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border HorizontalAlignment="Center" CornerRadius="6" Padding="10,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <!-- no frame behind it: give the handle its own pill so it shows on any map -->
                                <DataTrigger Binding="{Binding Formatting_Frame, Converter={StaticResource enumToBoolConverter}, ConverterParameter=Box}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <iconPacks:PackIconMaterial Kind="DotsHorizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                                <!-- contrasts with the Box frame colour; theme highlight (null) gets white -->
                                <Setter Property="Foreground" Value="{Binding SelectedBackgroundChoice.ColorValue, Converter={StaticResource colorToContrastBrushConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Formatting_Frame, Converter={StaticResource enumToBoolConverter}, ConverterParameter=Box}" Value="False">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                </Border>
            </Border>
            <!-- Halo second pass: a glow around the TextBox's own glow (one Effect per element)
                 makes the outline dense enough to read; no background, so it never takes clicks -->
            <Border x:Name="haloHost">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Formatting_Frame}" Value="Halo">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="1" RenderingBias="Quality">
                                            <DropShadowEffect.Color>
                                                <!-- a stored halo colour, else the contrast of the text colour -->
                                                <MultiBinding Converter="{StaticResource haloColorConverter}">
                                                    <Binding Path="Formatting_HaloColor"/>
                                                    <Binding Path="Formatting_TextColor"/>
                                                </MultiBinding>
                                            </DropShadowEffect.Color>
                                        </DropShadowEffect>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- FlowDirection is TwoWay: the TextBox's own Ctrl+Shift shortcut calls SetValue on it,
                     which would replace a OneWay binding and leave the box out of sync with the toolbar -->
                <TextBox x:Name="labelBox"
                        TextAlignment="{Binding Formatting_Alignment}" Height="Auto"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Text="{Binding LabelValue, UpdateSourceTrigger=PropertyChanged}"
                        Foreground="{Binding Formatting_TextColor, Converter={StaticResource colorToBrushConverter}}"
                        CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        FlowDirection="{Binding Formatting_FlowDirection, Mode=TwoWay}"
                        FontSize="{Binding Formatting_FontSize}"
                        FontFamily="{Binding Formatting_FontFamily}"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        mahApp:TextBoxHelper.SelectAllOnFocus="True" Focusable="True"
                        PreviewKeyDown="OnLabelBoxPreviewKeyDown" >
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource IRI.Maptor.Styles.TextBox}">
                            <Setter Property="Margin" Value="2,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                            <ScrollViewer x:Name="PART_ContentHost" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Formatting_IsBold}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Formatting_IsItalic}" Value="True">
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Formatting_IsUnderline}" Value="True">
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                </DataTrigger>
                                <!-- no frame: no white field, border or rim, and no MahApps minimum height -->
                                <DataTrigger Binding="{Binding Formatting_Frame, Converter={StaticResource enumToBoolConverter}, ConverterParameter=Box}" Value="False">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </DataTrigger>
                                <!-- Halo: a zero-depth shadow in the colour contrasting with the text works
                                     as an outline, so the label reads on any map; only here, since an
                                     effect costs a render pass and turns off ClearType -->
                                <DataTrigger Binding="{Binding Formatting_Frame}" Value="Halo">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="1" RenderingBias="Quality">
                                                <DropShadowEffect.Color>
                                                    <!-- a stored halo colour, else the contrast of the text colour -->
                                                    <MultiBinding Converter="{StaticResource haloColorConverter}">
                                                        <Binding Path="Formatting_HaloColor"/>
                                                        <Binding Path="Formatting_TextColor"/>
                                                    </MultiBinding>
                                                </DropShadowEffect.Color>
                                            </DropShadowEffect>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>
            <Popup x:Name="formatPopup" StaysOpen="True" Placement="Top" 
                   PlacementTarget="{Binding ElementName=root}" HorizontalOffset="0" VerticalOffset="-5"
                   AllowsTransparency="True">
                <Border x:Name="popupBorder" Background="White" FlowDirection="LeftToRight" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1,1,2,1" 
                        CornerRadius="5" Padding="4"
                        MouseEnter="OnPopupContentMouseEnter" MouseLeave="OnPopupContentMouseLeave">
                    <StackPanel x:Name="popupContentPanel" Orientation="Vertical">
                        <!-- Top line: Font family, Font size with increase/decrease buttons and combobox -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <ComboBox MinWidth="100" VerticalAlignment="Center" Margin="0,0,2,0" DropDownClosed="OnPopupComboDropDownClosed"
                                ToolTip="{Binding [textMarker_tooltip_fontFamily], Source={StaticResource Localization}}"
                                ItemsSource="{x:Static local:TextboxMarkerViewModel.FontFamilyOptions}"
                                Style="{StaticResource IRI.Maptor.Styles.ComboBox.Small.Latin}"
                                SelectedItem="{Binding Formatting_FontFamilyName, Mode=TwoWay}"/>
                            <ComboBox MinWidth="50" VerticalAlignment="Center" Margin="2,0" DropDownClosed="OnPopupComboDropDownClosed"
                                ToolTip="{Binding [textMarker_tooltip_fontSize], Source={StaticResource Localization}}"
                                ItemsSource="{x:Static local:TextboxMarkerViewModel.FontSizeOptions}"
                                Style="{StaticResource IRI.Maptor.Styles.ComboBox.Small.Latin}"
                                SelectedItem="{Binding Formatting_FontSize, Mode=TwoWay}"/>
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Margin="0,0,2,0" Command="{Binding IncreaseFontSizeCommand}" ToolTip="{Binding [textMarker_tooltip_increaseFontSize], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="FormatFontSizeIncrease" Width="12" Height="12"/>
                            </Button>
                            <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Margin="0,0,2,0" Command="{Binding DecreaseFontSizeCommand}" ToolTip="{Binding [textMarker_tooltip_decreaseFontSize], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="FormatFontSizeDecrease" Width="12" Height="12"/>
                            </Button>
                            <Separator Margin="4,0" VerticalAlignment="Stretch"/>

                            <ComboBox x:Name="textColorCombo" MinWidth="100" VerticalAlignment="Center" Margin="2,0" DropDownClosed="OnPopupComboDropDownClosed"
                                      ToolTip="{Binding [textMarker_tooltip_textColor], Source={StaticResource Localization}}"
                                      ItemsSource="{x:Static local:TextboxMarkerViewModel.TextColorChoices}"
                                      SelectedValuePath="ColorValue"
                                      SelectedValue="{Binding Formatting_TextColor, Mode=TwoWay}"
                                      Style="{StaticResource IRI.Maptor.Styles.ComboBox.Small.Latin}" >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FormatColorText" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                        Foreground="{Binding ColorValue, Converter={StaticResource colorToBrushConverter}}"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource localizationKeyConverter}">
                                                        <Binding Path="NameKey"/>
                                                        <Binding Path="CurrentCulture" Source="{StaticResource Localization}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- the frame fill exists only in Box mode -->
                            <ComboBox x:Name="backgroundCombo" MinWidth="120" VerticalAlignment="Center" Margin="2,0" DropDownClosed="OnPopupComboDropDownClosed"
                                      ToolTip="{Binding [textMarker_tooltip_background], Source={StaticResource Localization}}"
                                      IsEnabled="{Binding Formatting_IsBoxFrame}"
                                      ItemsSource="{x:Static local:TextboxMarkerViewModel.BackgroundChoices}"
                                      SelectedItem="{Binding SelectedBackgroundChoice, Mode=TwoWay}"
                                      Style="{StaticResource IRI.Maptor.Styles.ComboBox.Small.Latin}" >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="16" CornerRadius="1" Margin="0,0,4,0"
                                                    BorderBrush="Gray" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="{Binding ColorValue, Converter={StaticResource colorToBrushConverter}}"/>
                                                        <Style.Triggers>
                                                            <!-- For theme entry, use the actual theme highlight brush -->
                                                            <DataTrigger Binding="{Binding IsTheme}" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource localizationKeyConverter}">
                                                        <Binding Path="NameKey"/>
                                                        <Binding Path="CurrentCulture" Source="{StaticResource Localization}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Bottom line: Bold/Italic/Underline, Alignment, RTL/LTR, and text actions -->
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <!-- Text style -->
                            <ToggleButton Margin="0,0,2,0" ToolTip="{Binding [textMarker_tooltip_bold], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                          IsChecked="{Binding Formatting_IsBold, Mode=TwoWay}">
                                <iconPacks:PackIconMaterial Kind="FormatBold"/>
                            </ToggleButton>
                            <ToggleButton Margin="0,0,2,0" ToolTip="{Binding [textMarker_tooltip_italic], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                          IsChecked="{Binding Formatting_IsItalic, Mode=TwoWay}">
                                <iconPacks:PackIconMaterial Kind="FormatItalic"/>
                            </ToggleButton>
                            <ToggleButton Margin="0,0,2,0" ToolTip="{Binding [textMarker_tooltip_underline], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                          IsChecked="{Binding Formatting_IsUnderline, Mode=TwoWay}">
                                <iconPacks:PackIconMaterial Kind="FormatUnderline"/>
                            </ToggleButton>

                            <!-- Alignment -->
                            <Separator Margin="4,0" VerticalAlignment="Stretch"/>
                            <!-- on-screen alignment: the view model maps it onto TextAlignment, which WPF mirrors under RTL -->
                            <ToggleButton x:Name="alignLeftButton" Margin="2,0,2,0" ToolTip="{Binding [textMarker_tooltip_alignLeft], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                          IsChecked="{Binding Formatting_LeftAligned, Mode=TwoWay}">
                                <iconPacks:PackIconMaterial Kind="FormatAlignLeft"/>
                            </ToggleButton>
                            <ToggleButton x:Name="alignCenterButton" Margin="0,0,2,0" ToolTip="{Binding [textMarker_tooltip_alignCenter], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                          IsChecked="{Binding Formatting_CenterAligned, Mode=TwoWay}">
                                <iconPacks:PackIconMaterial Kind="FormatAlignCenter"/>
                            </ToggleButton>
                            <ToggleButton x:Name="alignRightButton" Margin="0,0,2,0" ToolTip="{Binding [textMarker_tooltip_alignRight], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                          IsChecked="{Binding Formatting_RightAligned, Mode=TwoWay}">
                                <iconPacks:PackIconMaterial Kind="FormatAlignRight"/>
                            </ToggleButton>

                            <!-- RTL / LTR -->
                            <Separator Margin="4,0" VerticalAlignment="Stretch"/>
                            <ToggleButton x:Name="ltrButton" Margin="0,0,2,0" ToolTip="{Binding [textMarker_tooltip_leftToRight], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                          IsChecked="{Binding Formatting_IsLeftToRight, Mode=TwoWay}">
                                <iconPacks:PackIconMaterial Kind="FormatPilcrowArrowRight" FlowDirection="LeftToRight"/>
                            </ToggleButton>
                            <ToggleButton x:Name="rtlButton" Margin="2,0,2,0" ToolTip="{Binding [textMarker_tooltip_rightToLeft], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                          IsChecked="{Binding Formatting_IsRightToLeft, Mode=TwoWay}">
                                <iconPacks:PackIconMaterial Kind="FormatPilcrowArrowLeft" FlowDirection="LeftToRight"/>
                            </ToggleButton>

                            <!-- Frame: Box / Plain / Halo -->
                            <Separator Margin="4,0" VerticalAlignment="Stretch"/>
                            <ToggleButton x:Name="boxFrameButton" Margin="0,0,2,0" ToolTip="{Binding [textMarker_tooltip_frameBox], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                          IsChecked="{Binding Formatting_IsBoxFrame, Mode=TwoWay}">
                                <iconPacks:PackIconMaterial Kind="TextBoxOutline"/>
                            </ToggleButton>
                            <ToggleButton x:Name="plainFrameButton" Margin="0,0,2,0" ToolTip="{Binding [textMarker_tooltip_framePlain], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                          IsChecked="{Binding Formatting_IsPlainFrame, Mode=TwoWay}">
                                <iconPacks:PackIconMaterial Kind="FormatText"/>
                            </ToggleButton>
                            <ToggleButton x:Name="haloFrameButton" Margin="0,0,2,0" ToolTip="{Binding [textMarker_tooltip_frameHalo], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                                          IsChecked="{Binding Formatting_IsHaloFrame, Mode=TwoWay}">
                                <iconPacks:PackIconMaterial Kind="TextShadow"/>
                            </ToggleButton>

                            <!-- Text actions: copy & delete -->
                            <Separator Margin="4,0" VerticalAlignment="Stretch"/>
                            <Button Margin="0,0,2,0" ToolTip="{Binding [textMarker_tooltip_erase], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Command="{Binding ClearTextCommand}">
                                <iconPacks:PackIconMaterial Kind="Eraser"/>
                            </Button>
                            <Button Margin="0,0,2,0" ToolTip="{Binding [textMarker_tooltip_copyText], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Command="{Binding CopyTextCommand}">
                                <iconPacks:PackIconMaterial Kind="ContentCopy"/>
                            </Button>
                            <Button Margin="0,0,0,0" ToolTip="{Binding [textMarker_tooltip_delete], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Command="{Binding DeleteCommand}">
                                <iconPacks:PackIconMaterial Kind="Delete"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

        </StackPanel>
    </Border>
</maptor:MapMarker>