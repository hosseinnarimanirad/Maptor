<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.LayerSettings.LayerSettings_GeometryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:viewModels="clr-namespace:IRI.Maptor.Presentation.Wpf.ViewModels.LayerSettings"
             xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
             d:DataContext="{d:DesignInstance Type=viewModels:LayerSettings_GeometryViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d">

    <!--Layer Settings › Geometry (LayerSettings_GeometryViewModel): check, list, show on map, fix/delete, save.-->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <!--every text sets its Foreground: the tab content otherwise inherits the selected tab header's white-->
            <Style TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"/>

            <Style x:Key="Geometry.Note" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="Geometry.Panel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="10,8"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--what the tab does, and the check button-->
        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Card}" Padding="10,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <mahApp:ProgressRing IsActive="{Binding IsBusy}" Margin="0,0,8,0"
                                         Style="{StaticResource IRI.Maptor.Styles.ProgressRing.Inline}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource boolToVisibilityConverter}}"/>
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Secondary}" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource boolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Close" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                       Text="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Primary}" Margin="0"
                            Command="{Binding CheckCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ShapePolygonPlus" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                       Text="{Binding [layerSettings_geometry_check], Source={StaticResource Localization}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Style="{StaticResource Geometry.Note}"
                           Text="{Binding [layerSettings_geometry_intro], Source={StaticResource Localization}}"/>
            </DockPanel>
        </Border>

        <!--limits: live layer (loaded features only), no editing-->
        <StackPanel Grid.Row="1" Margin="8,2">
            <DockPanel Margin="0,2" Visibility="{Binding IsLiveLayer, Converter={StaticResource boolToVisibilityConverter}}">
                <iconPacks:PackIconMaterial DockPanel.Dock="Left" Kind="CloudOutline" Width="14" Height="14" Margin="0,0,6,0"
                                            VerticalAlignment="Center" Foreground="{DynamicResource IRI.Maptor.Brushes.Warning}"/>
                <TextBlock Style="{StaticResource Geometry.Note}"
                           Text="{Binding [layerSettings_geometry_liveNote], Source={StaticResource Localization}}"/>
            </DockPanel>
            <DockPanel Margin="0,2" Visibility="{Binding HasNotEditableReason, Converter={StaticResource boolToVisibilityConverter}}">
                <iconPacks:PackIconMaterial DockPanel.Dock="Left" Kind="PencilOff" Width="14" Height="14" Margin="0,0,6,0"
                                            VerticalAlignment="Center" Foreground="{DynamicResource IRI.Maptor.Brushes.Muted}"/>
                <TextBlock Style="{StaticResource Geometry.Note}" Text="{Binding NotEditableReason}"/>
            </DockPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="8,4" TextWrapping="Wrap"
                   Style="{StaticResource IRI.Maptor.Styles.TextBlock.Error}"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource stringNotNullOrEmptyToVisibilityConverter}}"/>

        <!--summary: counts per kind of problem-->
        <Border Grid.Row="3" Style="{StaticResource Geometry.Panel}"
                Visibility="{Binding HasResult, Converter={StaticResource boolToVisibilityConverter}}">
            <StackPanel>
                <DockPanel>
                    <iconPacks:PackIconMaterial DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                                <Setter Property="Kind" Value="AlertOutline"/>
                                <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Warning}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClean}" Value="True">
                                        <Setter Property="Kind" Value="CheckCircleOutline"/>
                                        <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Valid}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Groups}" Margin="24,4,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:GeometryIssueGroupRow}">
                            <Border Margin="0,2,6,2" Padding="8,2" CornerRadius="10"
                                    Background="{DynamicResource MahApps.Brushes.Gray9}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}"/>
                                    <TextBlock Margin="6,0,0,0" FontWeight="SemiBold" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}"
                                               Text="{Binding Count, Converter={StaticResource localizedNumberConverter}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="24,4,0,0" Style="{StaticResource Geometry.Note}" Text="{Binding OrientationNote}"
                           Visibility="{Binding OrientationNote, Converter={StaticResource stringNotNullOrEmptyToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!--the features with problems: selecting one shows it on the map-->
        <DataGrid Grid.Row="4" Margin="4" MinHeight="120" MaxHeight="280"
                  ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem, Mode=TwoWay}"
                  Style="{StaticResource IRI.Maptor.Styles.DataGrid.ReadOnly}"
                  AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" BorderThickness="1"
                  FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"
                  VirtualizingPanel.IsVirtualizing="True"
                  Visibility="{Binding HasProblems, Converter={StaticResource boolToVisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding FeatureLabel}" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding [layerSettings_geometry_columnFeature], Source={StaticResource Localization}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Problems}" Width="2*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding [layerSettings_geometry_columnProblem], Source={StaticResource Localization}}"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding OutcomeText}" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding [layerSettings_geometry_columnFix], Source={StaticResource Localization}}"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanRepair}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Invalid}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--nothing checked yet-->
        <StackPanel Grid.Row="4" Margin="16,24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Visibility>
                <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                    <Binding Path="HasResult" Converter="{StaticResource notConverter}"/>
                    <Binding Path="IsBusy" Converter="{StaticResource notConverter}"/>
                </MultiBinding>
            </StackPanel.Visibility>
            <iconPacks:PackIconMaterial Kind="ShapePolygonPlus" Width="40" Height="40" HorizontalAlignment="Center"
                                        Foreground="{DynamicResource MahApps.Brushes.Gray7}"/>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}"
                       Text="{Binding [layerSettings_geometry_empty], Source={StaticResource Localization}}"/>
        </StackPanel>

        <!--actions: fix/delete the selected feature, fix all, save; and the result of the last one-->
        <DockPanel Grid.Row="5" Margin="4,4,4,0" LastChildFill="True"
                   Visibility="{Binding HasResult, Converter={StaticResource boolToVisibilityConverter}}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Secondary}" Margin="0,0,8,0"
                        Command="{Binding DeleteSelectedCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                   Text="{Binding [layerSettings_geometry_delete], Source={StaticResource Localization}}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Secondary}" Margin="0,0,8,0"
                        Command="{Binding FixSelectedCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AutoFix" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                   Text="{Binding [layerSettings_geometry_fix], Source={StaticResource Localization}}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Secondary}" Margin="0,0,8,0"
                        Command="{Binding FixAllCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AutoFix" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                   Text="{Binding [layerSettings_geometry_fixAll], Source={StaticResource Localization}}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Primary}" Margin="0"
                        Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSave" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                   Text="{Binding [dialog_common_save], Source={StaticResource Localization}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource Geometry.Note}" Margin="0,0,8,0" Text="{Binding StatusMessage}"/>
        </DockPanel>
    </Grid>
</UserControl>
