<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.LayerSettings.LayerSettings_ExportView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                xmlns:maptorDsKind="clr-namespace:IRI.Maptor.Core.Common.Enums;assembly=IRI.Maptor.Core.Common"
                xmlns:maptorCore="clr-namespace:IRI.Maptor.Presentation.Core;assembly=IRI.Maptor.Presentation.Core" 
                xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <Style TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--export format type-->
        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="File" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.FieldAdornment}"/>
                <TextBlock Text="{Binding [dialog_export_outputFileFormat], Source={StaticResource Localization}}" FontWeight="Bold" VerticalAlignment="Center" Margin="4"/>
                <RadioButton GroupName="A" Content="SHP" Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form.Latin}"
                             IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.Shapefile}}" />
                <RadioButton GroupName="A" Content="DXF" Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form.Latin}"
                             IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.Dxf}}"/>
                <RadioButton GroupName="A" Content="KML" Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form.Latin}"
                             IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.Kml}}" />
                <RadioButton GroupName="A" Content="KMZ" Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form.Latin}"
                             IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.Kmz}}" />
                <RadioButton GroupName="A" Content="GeoJson" Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form.Latin}"
                             IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.GeoJson}}" />
                <RadioButton GroupName="A" Content="EsriJson" Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form.Latin}"
                             IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.EsriJson}}" />
                <RadioButton GroupName="A" Content="TopoJson" Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form.Latin}"
                            IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.TopoJson}}" />
                <!--<RadioButton GroupName="A" IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.TopoJson}}" Content="TopoJson"/>-->
            </StackPanel>
        </Border>

        <!--what to export-->
        <Border Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="SelectMarker" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.FieldAdornment}"/>
                <TextBlock Text="{Binding [dialog_export_exportModeTitle], Source={StaticResource Localization}}" FontWeight="Bold" VerticalAlignment="Center" Margin="4"/>
                <RadioButton GroupName="B"
                             Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form}"
                             IsChecked="{Binding SelectedExportMode, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorCore:ExportFeatureMode.All}}"
                             Content="{Binding [dialog_export_exportModeAll], Source={StaticResource Localization}}"/>
                <RadioButton GroupName="B" IsEnabled="False"
                             Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form}"
                             IsChecked="{Binding SelectedExportMode, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorCore:ExportFeatureMode.Selected}}"
                             Content="{Binding [dialog_export_exportModeSelected], Source={StaticResource Localization}}"/>
                <RadioButton GroupName="B" IsEnabled="False"
                             Style="{StaticResource IRI.Maptor.Styles.RadioButton.Form}"
                             IsChecked="{Binding SelectedExportMode, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorCore:ExportFeatureMode.Highlighted}}"
                             Content="{Binding [dialog_export_exportModeHighlighted], Source={StaticResource Localization}}"/>
            </StackPanel>
        </Border>


        <!-- Spatial Reference Switch -->
        <Border Grid.Row="2" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <StackPanel Orientation="Horizontal">

                <iconPacks:PackIconPhosphorIcons DockPanel.Dock="Left" Kind="Globe" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}"/>
                <TextBlock Text="{Binding [dialog_export_sourceSrs], Source={StaticResource Localization}, StringFormat={}{0}:}" FontWeight="Bold" VerticalAlignment="Center" Margin="4"/>

                <TextBlock Text="{Binding SourceLayerSrs.DisplayName}"
                           FontFamily="Segoe UI"
                           FlowDirection="LeftToRight" FontWeight="Normal" VerticalAlignment="Center" Margin="4"/>
            </StackPanel>
        </Border>

        <!--Spatial Reference Combobox-->
        <Border Grid.Row="3" Style="{StaticResource IRI.Maptor.Styles.Border.Card}"
                Visibility="{Binding ShowSrsOptions, Converter={StaticResource boolToVisibilityConverter}}">
            <DockPanel>
                <iconPacks:PackIconPhosphorIcons DockPanel.Dock="Left" Kind="Globe" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}"/>
                <TextBlock Text="{Binding [dialog_export_targetSrs], Source={StaticResource Localization}, StringFormat={}{0}:}" FontWeight="Bold" VerticalAlignment="Center" Margin="4"/>

                <mahApp:ToggleSwitch DockPanel.Dock="Left" Style="{StaticResource IRI.Maptor.Styles.ToggleSwitch.Normal}"
                      OnContent="{Binding [dialog_export_enabledProjection], Source={StaticResource Localization}}"
                      OffContent="{Binding [dialog_export_disabledProjection], Source={StaticResource Localization}}"
                      IsOn="{Binding IsProjectionEnabled}" />
                <ComboBox Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}"
                            DisplayMemberPath="DisplayName"                            
                            ItemsSource="{Binding AvailableSrsOptions}"
                            SelectedItem="{Binding SelectedSrsOption, Mode=TwoWay}"
                            IsEnabled="{Binding IsProjectionEnabled}"
                            Visibility="{Binding IsProjectionEnabled, Converter={StaticResource boolToVisibilityConverter}}"/>
            </DockPanel>
        </Border>

        <!-- UTM Zone (visible when UTM selected) -->
        <Border Grid.Row="4" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <Border.Visibility>
                <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                    <Binding Path="ShowSrsOptions"/>
                    <Binding Path="IsProjectionEnabled"/>
                    <Binding Path="IsUtmSelected"/>
                </MultiBinding>
            </Border.Visibility>
            <DockPanel>
                <iconPacks:PackIconPhosphorIcons DockPanel.Dock="Left" Kind="MapTrifoldFill" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding [srs_utmZone_full], Source={StaticResource Localization}, StringFormat='{}{0}:'}"
                           />

                <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsNorthHemisphere, Mode=TwoWay}"
                            Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}" FlowDirection="LeftToRight"
                            ToolTip="{Binding [dialog_dxfOpen_hemisphereTooltip], Source={StaticResource Localization}}">
                    <iconPacks:PackIconPhosphorIcons Kind="CircleHalfFill" RenderTransformOrigin="0.5,0.5"
                                                  Margin="0" Width="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons.Style>
                            <Style TargetType="iconPacks:PackIconPhosphorIcons" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNorthHemisphere}" Value="False">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="90"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconPhosphorIcons.Style>
                    </iconPacks:PackIconPhosphorIcons>
                </ToggleButton>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,2,0"
                           Foreground="Black">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
                            <!--<Setter Property="FontFamily" Value="{StaticResource iranSans}"/>-->
                            <!-- Default (northern hemisphere) -->
                            <Setter Property="Text" Value="{Binding [srs_northernHemisphere], Source={StaticResource Localization}}"/>
                            <Style.Triggers>
                                <!-- Southern hemisphere (IsChecked = False) -->
                                <DataTrigger Binding="{Binding IsNorthHemisphere}" Value="False">
                                    <Setter Property="Text" Value="{Binding [srs_southernHemisphere], Source={StaticResource Localization}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <mahApp:NumericUpDown Grid.Column="1" Minimum="1" Maximum="60"  
                                      Style="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}"
                                      Value="{Binding UtmZone, Mode=TwoWay}" />

            </DockPanel>
        </Border>

        <!-- Options: X,Y vs Y,X -->
        <Border Grid.Row="5" Style="{StaticResource IRI.Maptor.Styles.Border.Card}"
                Visibility="{Binding ShowXYOrderOptions, Converter={StaticResource boolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconPhosphorIcons Kind="ListNumbers" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}"/>
                <TextBlock Text="{Binding [dialog_common_xyOrder], Source={StaticResource Localization}}"
                         VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold"/>
                <CheckBox Content="{Binding [dialog_common_eastingFirst], Source={StaticResource Localization}}"
                          Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}"
                          IsChecked="{Binding IsLongitudeFirst, Mode=TwoWay}" />
                <!--<RadioButton Content="X,Y" IsChecked="{Binding IsLongitudeFirst, Mode=TwoWay}" Margin="4,0" VerticalAlignment="Center"
                       ToolTip="{Binding [dialog_geoJsonTopoJsonOpen_orderXY], Source={StaticResource Localization}}"/>
              <RadioButton Content="Y,X" IsChecked="{Binding IsLongitudeFirst, Mode=TwoWay, Converter={StaticResource notConverter}}" Margin="4,0" VerticalAlignment="Center"
                       ToolTip="{Binding [dialog_geoJsonTopoJsonOpen_orderYX], Source={StaticResource Localization}}"/>-->
            </StackPanel>
        </Border>

        <Button Margin="4" Grid.Row="6" HorizontalAlignment="Right" 
                ToolTip="{Binding [dialog_common_export], Source={StaticResource Localization}}" 
                Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Primary}"
                Command="{Binding ExportCommand}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="FileExport" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}" />
                <TextBlock Text="{Binding [dialog_common_export], Source={StaticResource Localization}}"
                           Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"/>
            </StackPanel>
        </Button>

    </Grid>
</UserControl>
