<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.LayerSettings.LayerSettings_SymbologyView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
                xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <!--every text sets its Foreground: the tab content otherwise inherits the selected tab header's white-->
            <Style TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"/>

            <Style x:Key="Symbology.Panel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="10,8"/>
            </Style>

            <Style x:Key="Symbology.PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Body}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="Symbology.Hint" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}">
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="2">
        <!--a layer that cannot be styled-->
        <TextBlock Margin="12" Style="{StaticResource Symbology.Hint}"
                   Text="{Binding [layerStyles_tab_notAvailable], Source={StaticResource Localization}}"
                   Visibility="{Binding IsAvailable, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False}"/>

        <DockPanel Visibility="{Binding IsAvailable, Converter={StaticResource boolToVisibilityConverter}}">

            <!--the user's own changes on top of the active style-->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
                <DockPanel>
                    <iconPacks:PackIconMaterial Kind="Brush" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.FieldAdornment}"/>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}">
                                <Setter Property="Margin" Value="4,2,0,2"/>
                            </Style>
                        </WrapPanel.Resources>
                        <Button Command="{Binding QuickEditCommand}"
                                Visibility="{Binding CanQuickEdit, Converter={StaticResource boolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Palette" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [layerStyles_tab_quickEdit], Source={StaticResource Localization}}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AdvancedEditCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CodeTags" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}" Text="{Binding [layerStyles_tab_editInSld], Source={StaticResource Localization}}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ResetCommand}" ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding [layerStyles_tab_restoreTip], Source={StaticResource Localization}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Restore" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}">
                                            <Setter Property="Text" Value="{Binding [layerStyles_tab_restore], Source={StaticResource Localization}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSimple}" Value="True">
                                                    <Setter Property="Text" Value="{Binding [dialog_symbology_restoreAdmin], Source={StaticResource Localization}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}" Foreground="{DynamicResource MahApps.Brushes.Text}"
                                   Text="{Binding [layerStyles_tab_myChanges], Source={StaticResource Localization}}"/>
                        <TextBlock Text="{Binding ChangesText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Symbology.Hint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUserModified}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel>
                <!--the styles the admin defined; choosing one switches the layer. Only when there is a choice:
                    otherwise the legend takes the whole width-->
                <Border DockPanel.Dock="Left" Width="260" Style="{StaticResource Symbology.Panel}"
                        Visibility="{Binding HasMultipleStyles, Converter={StaticResource boolToVisibilityConverter}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Symbology.PanelTitle}"
                                   Text="{Binding [layerStyles_tab_styles], Source={StaticResource Localization}}"/>

                        <ListBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
                                    <Setter Property="Padding" Value="6,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <iconPacks:PackIconMaterial DockPanel.Dock="Left" Kind="CheckCircle" Width="14" Height="14" Margin="0,0,6,0"
                                                                    VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}">
                                            <iconPacks:PackIconMaterial.Style>
                                                <Style TargetType="iconPacks:PackIconMaterial">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconMaterial.Style>
                                        </iconPacks:PackIconMaterial>
                                        <StackPanel>
                                            <DockPanel>
                                                <!--changed by this user (kept in the project)-->
                                                <iconPacks:PackIconMaterial DockPanel.Dock="Right" Kind="Pencil" Width="12" Height="12" Margin="6,0,0,0"
                                                                            VerticalAlignment="Center" Background="Transparent"
                                                                            ToolTip="{Binding [layerStyles_tab_changedMark], Source={StaticResource Localization}}"
                                                                            Visibility="{Binding IsUserChanged, Converter={StaticResource boolToVisibilityConverter}}">
                                                    <iconPacks:PackIconMaterial.Style>
                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconMaterial.Style>
                                                </iconPacks:PackIconMaterial>
                                                <!--the style users start on (as in the admin window)-->
                                                <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource MahApps.Brushes.Accent3}"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource boolToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" Margin="0"
                                                               Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"
                                                               Text="{Binding [layerStyles_defaultBadge], Source={StaticResource Localization}}"/>
                                                </Border>
                                                <TextBlock Margin="0" Foreground="{DynamicResource MahApps.Brushes.Text}" Text="{Binding DisplayTitle}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0" Text="{Binding RuleCountText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}">
                                                            <Style.Triggers>
                                                                <!--grey on the selection's accent fill is unreadable-->
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding Swatches}" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Source="{Binding}" Width="22" Height="16" Margin="0,0,2,0" Stretch="None"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!--the active style's rules-->
                <Border Style="{StaticResource Symbology.Panel}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}" Margin="4,0,0,6"
                                    Command="{Binding ExportLegendCommand}"
                                    ToolTip="{Binding [layerStyles_tab_exportLegend], Source={StaticResource Localization}}">
                                <iconPacks:PackIconMaterial Kind="ImageOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}"/>
                            </Button>
                            <TextBlock Style="{StaticResource Symbology.PanelTitle}" Text="{Binding LegendTitle}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <!--no SLD: the simple colours, changed with Quick edit-->
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Symbology.Hint}" Margin="0,0,0,6"
                                   Text="{Binding [layerStyles_tab_simpleHint], Source={StaticResource Localization}}"
                                   Visibility="{Binding IsSimple, Converter={StaticResource boolToVisibilityConverter}}"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding LegendRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Image DockPanel.Dock="Left" Source="{Binding SwatchImage}" Width="32" Height="24" Margin="0,0,8,0"
                                                   Stretch="None" VerticalAlignment="Top"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Margin="0" Foreground="{DynamicResource MahApps.Brushes.Text}" Text="{Binding Title}" TextWrapping="Wrap"/>
                                                <TextBlock Margin="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}" Text="{Binding FieldText}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding FieldText, Converter={StaticResource stringNotNullOrEmptyToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DockPanel>
    </Grid>
</UserControl>
