<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.LayerSettings.LayerSettings_GeneralView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                xmlns:maptorJab="clr-namespace:IRI.Maptor.Presentation.Wpf"
                xmlns:maptorJabCore="clr-namespace:IRI.Maptor.Presentation.Core;assembly=IRI.Maptor.Presentation.Core"
                xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries> 
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--labels size to their text (a fixed 50 cut "Layer Name" to "Layer Nar"); the minimum
                keeps the values of the short labels roughly lined up-->
            <Style TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}">
                <Setter Property="MinWidth" Value="90"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--layer name-->
        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Card}"  >
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Layers" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.FieldAdornment}"/>
                <TextBlock Text="{Binding [layerSettings_general_layerName], Source={StaticResource Localization}}"/>
                <TextBox Grid.Column="1" BorderThickness="0" MinWidth="150"
                         Text="{Binding LayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding LayerNameCanBeChanged}"
                         Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"/>
            </StackPanel>
        </Border>

        <!--source address-->
        <Border Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.Border.Card}" >
            <DockPanel LastChildFill="True">
                <iconPacks:PackIconMaterial Kind="Layers" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.FieldAdornment}"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding [layerSettings_general_sourceAddress], Source={StaticResource Localization}}" Width="Auto"/>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Primary}"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FolderOpen" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"  />
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                   Text="{Binding [dialog_common_browseFolder], Source={StaticResource Localization}}"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding DataSource.SourceAddress}" HorizontalAlignment="Stretch" Width="auto"
                           FlowDirection="LeftToRight" FontFamily="Segoe UI "/>
            </DockPanel>
        </Border>

        <!--source type-->
        <Border Grid.Row="2" Style="{StaticResource IRI.Maptor.Styles.Border.Card}" >
            <DockPanel LastChildFill="True">
                <iconPacks:PackIconMaterial Kind="Layers" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.FieldAdornment}"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding [layerSettings_general_sourceType], Source={StaticResource Localization}}" />
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Primary}"
                        Command="{Binding ReloadDataCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"  />
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                   Text="{Binding [legendItem_reloadData], Source={StaticResource Localization}}"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding DataSource.DataSourceKind}" HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>
  
        <!--feature type-->
        <Border Grid.Row="3" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <DockPanel LastChildFill="False">
                <iconPacks:PackIconPhosphorIcons Kind="ShapesLight" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}"
                                  ToolTip="{Binding [dialog_csvTsvOpen_geometryType],Source={StaticResource Localization}}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [layerSettings_general_featureType], Source={StaticResource Localization}}"/>
                <!--<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SpatialModelMode, Mode=OneWay}"/>-->
                <!--<iconPacks:PackIconPhosphorIcons Kind="ShapesLight" Grid.Column="3" VerticalAlignment="Center"
                                                    ToolTip="{Binding [dialog_csvTsvOpen_geometryType],Source={StaticResource Localization}}"/>-->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <StackPanel.Resources>
                        <Style TargetType="Ellipse" x:Key="ModeHighlightEllipse">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="StrokeThickness" Value="1"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <StaticResource ResourceKey="IRI.Maptor.Effects.Elevation1"/>
                                </Setter.Value>
                            </Setter>
                            <!-- Default fill (deselected) -->
                            <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.SystemControlDisabledBaseLow}"/>
                            <Setter Property="Stroke" Value="{DynamicResource MahApps.Brushes.Gray6}"/>

                            <Style.Triggers>
                                <!-- Trigger that activates when current mode == ellipse's Tag -->
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource enumMatchConverter}">
                                            <Binding Path="SpatialModelMode"/>
                                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
                                    <Setter Property="Stroke" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

                        <!--The glyph sits on top of ModeHighlightEllipse, so it has to follow the
                            same selected/deselected swap. It was a flat Foreground="White", which
                            on the pale deselected fill was all but invisible in light theme.
                            Same Tag and same trigger, so the two can never disagree.-->
                        <Style TargetType="iconPacks:PackIconPhosphorIcons" x:Key="ModeGlyph">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource enumMatchConverter}">
                                            <Binding Path="SpatialModelMode"/>
                                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <!-- Polygon -->
                    <Grid>
                        <Ellipse Style="{StaticResource ModeHighlightEllipse}"
                                    Tag="{x:Static maptorJabCore:SpatialModelMode.Polygon}"/>
                        <iconPacks:PackIconPhosphorIcons Kind="Polygon" Style="{StaticResource ModeGlyph}"
                                          Tag="{x:Static maptorJabCore:SpatialModelMode.Polygon}"/>
                    </Grid>

                    <!-- Polyline -->
                    <Grid>
                        <Ellipse Style="{StaticResource ModeHighlightEllipse}"
                                    Tag="{x:Static maptorJabCore:SpatialModelMode.Polyline}"/>
                        <iconPacks:PackIconPhosphorIcons Kind="LineSegments" Style="{StaticResource ModeGlyph}"
                                          Tag="{x:Static maptorJabCore:SpatialModelMode.Polyline}"/>
                    </Grid>

                    <!-- Point -->
                    <Grid>
                        <Ellipse Style="{StaticResource ModeHighlightEllipse}"
                                    Tag="{x:Static maptorJabCore:SpatialModelMode.Point}"/>
                        <Viewbox>
                            <iconPacks:PackIconPhosphorIcons Kind="DotOutlineThin" Style="{StaticResource ModeGlyph}"
                                          Tag="{x:Static maptorJabCore:SpatialModelMode.Point}"
                                          Margin="20" Padding="0"/>
                        </Viewbox>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>


        <!--opacity-->
        <Border Grid.Row="4" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <DockPanel >
                <iconPacks:PackIconMaterial Kind="SquareOpacity" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.FieldAdornment}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding [layerSettings_general_opacity], Source={StaticResource Localization}}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Opacity, StringFormat=P0}" Width="40"/>
                <Slider Margin="10,4" Cursor="Hand"
                        Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.01" Value="{Binding Opacity}"
                        TickPlacement="Both" TickFrequency="0.05"  
                        Style="{StaticResource MahApps.Styles.Slider}"/>
            </DockPanel>
        </Border>

        <!--layer summary: read-only facts (pending edits are on their own tab)-->
        <Border Grid.Row="5" Style="{StaticResource IRI.Maptor.Styles.Border.Card}"
                DataContext="{Binding DataContext.Summary, RelativeSource={RelativeSource AncestorType=mahApp:MetroWindow}}">
            <Border.Resources>
                <!--every TextBlock sets its own Foreground: tab content inherits the selected header's white-->
                <Style x:Key="SummaryLabel" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Margin" Value="0,3,12,3"/>
                </Style>
                <!--numbers and codes stay left-to-right inside the RTL page; auto width keeps them on the start side-->
                <Style x:Key="SummaryValue" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Margin" Value="0,3"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
                </Style>
                <!--a localized value (mode, "not available"): follows the page direction and font-->
                <Style x:Key="SummaryText" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.FieldValue}">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Margin" Value="0,3"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
                </Style>
            </Border.Resources>
            <DockPanel>
                <iconPacks:PackIconMaterial Kind="InformationOutline" VerticalAlignment="Top"
                                            Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.FieldAdornment}"/>
                <StackPanel>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardTitle}" Width="Auto"
                               Foreground="{DynamicResource MahApps.Brushes.Text}"
                               Text="{Binding [layerSettings_general_summary], Source={StaticResource Localization}}"/>
                    <!--two label/value columns of short facts, then the two extents side by side.
                        Optional rows (load mode, source SRS) sit in the right column so a missing
                        one leaves a blank on the end side, not a hole on the start side.-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--feature count | field count-->
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SummaryLabel}"
                                   Text="{Binding [layerSettings_general_featureCount], Source={StaticResource Localization}}"
                                   Visibility="{Binding IsVector, Converter={StaticResource boolToVisibilityConverter}}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    Visibility="{Binding IsVector, Converter={StaticResource boolToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource SummaryValue}" Text="{Binding FeatureCountText}"/>
                            <!--Live: counted by the server, over all the features-->
                            <TextBlock Style="{StaticResource SummaryText}" Text="{Binding LiveFeatureCountText}" TextWrapping="Wrap"
                                       Visibility="{Binding IsLive, Converter={StaticResource boolToVisibilityConverter}}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SummaryLabel}" Margin="16,3,12,3"
                                   Text="{Binding [layerSettings_general_fieldCount], Source={StaticResource Localization}}"
                                   Visibility="{Binding IsVector, Converter={StaticResource boolToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource SummaryValue}" Text="{Binding FieldCountText}"
                                   Visibility="{Binding IsVector, Converter={StaticResource boolToVisibilityConverter}}"/>

                        <!--geometry type | load mode (Web API layers only)-->
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SummaryLabel}"
                                   Text="{Binding [layerSettings_general_geometryType], Source={StaticResource Localization}}"
                                   Visibility="{Binding IsVector, Converter={StaticResource boolToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SummaryValue}" Text="{Binding GeometryTypeText}"
                                   Visibility="{Binding IsVector, Converter={StaticResource boolToVisibilityConverter}}"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SummaryLabel}" Margin="16,3,12,3"
                                   Text="{Binding [layerSettings_general_loadMode], Source={StaticResource Localization}}"
                                   Visibility="{Binding HasLoadMode, Converter={StaticResource boolToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource SummaryText}" Text="{Binding LoadModeText}"
                                   Visibility="{Binding HasLoadMode, Converter={StaticResource boolToVisibilityConverter}}"/>

                        <!--SRS | source SRS (when it differs)-->
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SummaryLabel}"
                                   Text="{Binding [layerSettings_general_srs], Source={StaticResource Localization}}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SummaryValue}" Text="{Binding SrsText}"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SummaryLabel}" Margin="16,3,12,3"
                                   Text="{Binding [layerSettings_general_originalSrs], Source={StaticResource Localization}}"
                                   Visibility="{Binding HasOriginalSrs, Converter={StaticResource boolToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource SummaryValue}" Text="{Binding OriginalSrsText}"
                                   Visibility="{Binding HasOriginalSrs, Converter={StaticResource boolToVisibilityConverter}}"/>

                        <!--extents: WGS84 (longitude, latitude) | UTM zone of the extent centre (easting, northing)-->
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                    Visibility="{Binding HasExtent, Converter={StaticResource boolToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource SummaryLabel}"
                                       Text="{Binding [layerSettings_general_extentWgs84], Source={StaticResource Localization}}"/>
                            <TextBlock Style="{StaticResource SummaryValue}">
                                <Run Text="λ "/><Run Text="{Binding Wgs84LongitudeRange, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SummaryValue}">
                                <Run Text="φ "/><Run Text="{Binding Wgs84LatitudeRange, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="16,8,0,0"
                                    Visibility="{Binding HasExtent, Converter={StaticResource boolToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource SummaryLabel}" Text="{Binding UtmExtentLabel}"/>
                            <TextBlock Style="{StaticResource SummaryValue}">
                                <Run Text="E "/><Run Text="{Binding UtmXRange, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SummaryValue}">
                                <Run Text="N "/><Run Text="{Binding UtmYRange, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--visible range -->
        <!--<TextBlock Grid.Row="3" Grid.Column="0" Text="Visible scale range:"/>
        <mahApp:RangeSlider Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="26" MinRange="1" LowerValue="2" UpperValue="4" />
        <TextBlock Grid.Row="3" Grid.Column="2" Text="1-10"/>-->

        <!--spatial reference-->
        <!--layer address (file, api)-->

    </Grid>
</UserControl>
