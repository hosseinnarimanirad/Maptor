<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Versioning.ApprovalQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
             mc:Ignorable="d"
             FontFamily="{StaticResource iranSans}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- toolbar -->
                <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}" CornerRadius="4,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                                Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" Kind="Refresh"/>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                           Text="{Binding [versioning_review_refresh], Source={StaticResource Localization}}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" Margin="12,0,4,0"
                                   Text="{Binding [versioning_review_lastRefresh], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}"
                                   Text="{Binding LastRefreshedAt, StringFormat='{}{0:HH:mm:ss}', TargetNullValue='—'}"/>

                        <mah:ProgressRing Width="16" Height="16" Margin="12,0,0,0" IsActive="{Binding IsBusy}"/>
                    </StackPanel>
                </Border>

                <!-- queue -->
                <Grid Grid.Row="1">
                    <DataGrid Style="{StaticResource IRI.Maptor.Styles.DataGrid}"
                              ItemsSource="{Binding Rows}" SelectionMode="Single"
                              Visibility="{Binding IsEmpty, Converter={StaticResource boolToInverseVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource IRI.Maptor.Styles.CheckBox.Small}"
                                                  HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{Binding [versioning_review_colLayer], Source={StaticResource Localization}}" Binding="{Binding Item.EntityName}" Width="Auto" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{Binding [versioning_review_colFeature], Source={StaticResource Localization}}" Binding="{Binding TargetLabel}" Width="Auto" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{Binding [versioning_approval_colWinner], Source={StaticResource Localization}}" Binding="{Binding Item.WinnerEditorDisplayName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{Binding [versioning_approval_colType], Source={StaticResource Localization}}" Binding="{Binding ChangeTypeLabel}" Width="Auto" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{Binding [versioning_approval_colReviewer], Source={StaticResource Localization}}" Binding="{Binding Item.ReviewerDisplayName}" Width="Auto" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{Binding [versioning_approval_colResolved], Source={StaticResource Localization}}" Binding="{Binding ResolvedAtLabel}" Width="Auto" IsReadOnly="True"/>

                            <!-- badges -->
                            <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IRI.Maptor.Styles.Pill.Warning}"
                                                    Visibility="{Binding Item.IsStale, Converter={StaticResource boolToVisibilityConverter}}">
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text.Warning}"
                                                           Text="{Binding [versioning_review_badgeStale], Source={StaticResource Localization}}"/>
                                            </Border>
                                            <Border Style="{StaticResource IRI.Maptor.Styles.Pill}"
                                                    Visibility="{Binding Item.IsOrphaned, Converter={StaticResource boolToVisibilityConverter}}">
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text}"
                                                           Text="{Binding [versioning_review_badgeOrphaned], Source={StaticResource Localization}}"/>
                                            </Border>
                                            <Border Style="{StaticResource IRI.Maptor.Styles.Pill.Invalid}"
                                                    Visibility="{Binding IsDelete, Converter={StaticResource boolToVisibilityConverter}}">
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text.Invalid}"
                                                           Text="{Binding [versioning_review_badgeDelete], Source={StaticResource Localization}}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                                                Command="{Binding DataContext.ReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" Kind="UndoVariant"/>
                                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                                           Text="{Binding [versioning_approval_return], Source={StaticResource Localization}}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}"
                               Text="{Binding [versioning_approval_empty], Source={StaticResource Localization}}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource boolToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- decision footer -->
        <Border Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.Border.DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--the card's grey fill is what makes the (borderless) input read as a field-->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                                   Text="{Binding [versioning_approval_returnReason], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                        <TextBox Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}"
                                 Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </Border>

                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Button.Primary}"
                        Margin="4" Command="{Binding CommitSelectedCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}" Kind="CheckDecagram"/>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                   Text="{Binding [versioning_approval_commitSelected], Source={StaticResource Localization}}"/>
                    </StackPanel>
                </Button>

                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="4"
                          Style="{StaticResource IRI.Maptor.Styles.CheckBox.Normal}"
                          IsChecked="{Binding StaleOverride}"
                          Content="{Binding [versioning_compare_staleOverride], Source={StaticResource Localization}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
