<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.Versioning.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
             mc:Ignorable="d"
             FontFamily="{StaticResource iranSans}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource IRI.Maptor.Styles.Border.Panel}" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}" CornerRadius="4,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                                Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" Kind="Refresh"/>
                                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                           Text="{Binding [versioning_review_refresh], Source={StaticResource Localization}}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" Margin="12,0,4,0"
                                   Text="{Binding [versioning_review_lastRefresh], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}"
                                   Text="{Binding LastRefreshedAt, StringFormat='{}{0:HH:mm:ss}', TargetNullValue='—'}"/>

                        <Border Style="{StaticResource IRI.Maptor.Styles.Pill.Warning}" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text.Warning}" Text="{Binding UnreadLabel}"/>
                        </Border>

                        <mah:ProgressRing Width="16" Height="16" Margin="12,0,0,0" IsActive="{Binding IsBusy}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                            Command="{Binding MarkAllReadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" Kind="EmailOpenOutline"/>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                       Text="{Binding [versioning_inbox_markAllRead], Source={StaticResource Localization}}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <DataGrid Style="{StaticResource IRI.Maptor.Styles.DataGrid.ReadOnly}"
                          ItemsSource="{Binding Rows}" SelectionMode="Single"
                          Visibility="{Binding IsEmpty, Converter={StaticResource boolToInverseVisibilityConverter}}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource IRI.Maptor.Styles.DataGrid.Row}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <iconPacks:PackIconMaterial Kind="CircleMedium" Width="14" Height="14" VerticalAlignment="Center"
                                                                Foreground="{DynamicResource IRI.Maptor.Brushes.Warning}"
                                                                Visibility="{Binding IsUnread, Converter={StaticResource boolToVisibilityConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{Binding [versioning_inbox_colWhen], Source={StaticResource Localization}}" Binding="{Binding WhenLabel}" Width="Auto"/>
                        <DataGridTextColumn Header="{Binding [versioning_inbox_colEvent], Source={StaticResource Localization}}" Binding="{Binding TypeLabel}" Width="Auto"/>
                        <DataGridTextColumn Header="{Binding [versioning_inbox_colDetails], Source={StaticResource Localization}}" Binding="{Binding DetailLabel}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}"
                           Text="{Binding [versioning_inbox_empty], Source={StaticResource Localization}}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource boolToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
