<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.LanguageSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
             xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
             xmlns:jabloc="clr-namespace:IRI.Maptor.Presentation.Wpf.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--for the IRI.Maptor.Styles.Size.Text.* type scale used below. A StaticResource
                resolves only within its own scope chain, so declaring the merge here means this
                view does not depend on the host having merged Maptor.All.xaml.-->
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" Padding="8" FlowDirection="LeftToRight"  
            Effect="{DynamicResource MahApps.Effects.DropShadow}"> 
        <StackPanel>
            <TextBlock Text="{Binding [languageSelector_title], Source={StaticResource Localization}}" FontWeight="SemiBold" Margin="0,0,0,8"
                       FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.BodyLarge}"/>
            <!--Buttons, not a ListBox: a ListBox selects on mouse-down and keeps selecting while the button is held,
                so when the new language mirrors the window (and moves this pop-up) the item that lands under the
                pointer was picked instead. A button acts only on a completed click.-->
            <ItemsControl x:Name="languageList" ItemsSource="{Binding AvailableLanguages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type jabloc:LanguageItem}">
                        <Button Command="{Binding DataContext.SelectLanguageCommand, ElementName=languageList}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsEnabled}"
                                Click="LanguageButton_Click"
                                Margin="0,2" Padding="8,6" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="background" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="background" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="background" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding FlagUri}" Stretch="Uniform" Width="24" Height="18"
                                   VerticalAlignment="Top" Margin="4,0,4,0"/>
                            <!--the language in its own script first (people look for their own language), its English
                                name under it; left-aligned so a right-to-left name stays next to its flag-->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LanguageName}" FontWeight="SemiBold" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"
                                           FlowDirection="{Binding TextFlowDirection}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding EnglishLanguageName}" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}" Foreground="{DynamicResource IRI.Maptor.Brushes.Muted}"
                                           FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
