<UserControl x:Class="IRI.Maptor.Presentation.Wpf.Controls.TopologyIssuesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">
    <!--Topology › Issues (doc 05 §4). DataContext: TopologyIssuesPanelViewModel. The list is grouped by rule and
        virtualized (a check of a large layer may give many thousands of rows).-->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Views/Topology/TopologyStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="chip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="MinHeight" Value="24"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--what the results are, and filters-->
        <Border Style="{StaticResource topologyCard}">
            <StackPanel>
                <TextBlock Text="{Binding Header}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding [topology_issues_settingsChanged], Source={StaticResource Localization}}" Style="{StaticResource topologyWarning}"
                           Visibility="{Binding SettingsChanged, Converter={StaticResource topologyVisible}}"/>
                <TextBlock Text="{Binding SkippedText}" Style="{StaticResource topologyNote}"
                           Visibility="{Binding HasSkipped, Converter={StaticResource topologyVisible}}"/>

                <WrapPanel Margin="0,6,0,0">
                    <ToggleButton Style="{StaticResource chip}" IsChecked="{Binding ShowErrors}" Content="{Binding ErrorChip}"/>
                    <ToggleButton Style="{StaticResource chip}" IsChecked="{Binding ShowWarnings}" Content="{Binding WarningChip}"/>
                    <ToggleButton Style="{StaticResource chip}" IsChecked="{Binding ShowInfos}" Content="{Binding InfoChip}"/>
                </WrapPanel>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding RuleOptions}" SelectedItem="{Binding SelectedRule}" DisplayMemberPath="Text" Margin="0,0,4,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ChangeOptions}" SelectedItem="{Binding SelectedChange}" DisplayMemberPath="Text"
                              IsEnabled="{Binding HasComparison}" Margin="4,0,0,0"
                              ToolTip="{Binding [topology_issues_changeTooltip], Source={StaticResource Localization}}"/>
                </Grid>
                <TextBox Margin="0,6,0,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         ToolTip="{Binding [topology_issues_searchTooltip], Source={StaticResource Localization}}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Margin="12,4" TextWrapping="Wrap" FontWeight="SemiBold"
                   Visibility="{Binding IsEmpty, Converter={StaticResource topologyVisible}}"/>

        <!--the list-->
        <ListView Grid.Row="2" Margin="6,0"
                  ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,2"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <Path DockPanel.Dock="Left" Style="{StaticResource topologySeverityDot}" ToolTip="{Binding SeverityText}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding [topology_issues_new], Source={StaticResource Localization}}"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="6,0,0,0"
                                   Visibility="{Binding IsNew, Converter={StaticResource topologyVisible}}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding [topology_fix_pending], Source={StaticResource Localization}}"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="6,0,0,0"
                                   Visibility="{Binding IsFixPending, Converter={StaticResource topologyVisible}}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGone}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray5}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding FeaturesText}"
                                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--the selected issue-->
        <Border Grid.Row="3" Style="{StaticResource topologyCard}" Visibility="{Binding HasSelection, Converter={StaticResource topologyVisible}}">
            <StackPanel>
                <TextBlock Text="{Binding Selected.Sentence}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedRuleText}" Style="{StaticResource topologyNote}"/>
                <ItemsControl ItemsSource="{Binding SelectedFeatures}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Command="{Binding ShowInTableCommand}"
                                        ToolTip="{Binding [topology_issues_showInTable], Source={StaticResource Localization}}"
                                        Style="{StaticResource IRI.Maptor.Styles.Button.CircleDark.Flat}">
                                    <iconPacks:PackIconMaterial Kind="Table"/>
                                </Button>
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--the fix (doc 05 §7): Preview draws it on the map; Apply makes pending edits; nothing is saved here-->
                <StackPanel DataContext="{Binding Fix}" Margin="0,8,0,0"
                            Visibility="{Binding IsVisible, Converter={StaticResource topologyVisible}, FallbackValue=Collapsed}">
                    <Separator Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding [topology_fix_title], Source={StaticResource Localization}}" Style="{StaticResource topologyLabel}"/>
                    <TextBlock Text="{Binding FixText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HasFixText, Converter={StaticResource topologyVisible}}"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource topologyNote}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource topologyVisible}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="{Binding [topology_fix_preview], Source={StaticResource Localization}}"
                                Command="{Binding PreviewCommand}" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"/>
                        <Button Content="{Binding [topology_fix_apply], Source={StaticResource Localization}}" Margin="6,0,0,0"
                                Command="{Binding ApplyCommand}" Style="{StaticResource IRI.Maptor.Styles.Button.Primary.Small}"/>
                        <Button Content="{Binding [topology_fix_cancel], Source={StaticResource Localization}}" Margin="6,0,0,0"
                                Command="{Binding CancelCommand}" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--footer-->
        <DockPanel Grid.Row="4" Margin="10,4">
            <Button DockPanel.Dock="Right" Command="{Binding ExportCommand}"
                    ToolTip="{Binding [topology_issues_export], Source={StaticResource Localization}}"
                    Style="{StaticResource IRI.Maptor.Styles.Button.CircleDark.Flat}">
                <iconPacks:PackIconMaterial Kind="MicrosoftExcel"/>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PendingFixText}" Style="{StaticResource topologyWarning}" TextWrapping="Wrap"
                           Visibility="{Binding HasPendingFixes, Converter={StaticResource topologyVisible}}"/>
                <TextBlock Text="{Binding LimitNote}" Style="{StaticResource topologyNote}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
