<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:IRI.Maptor.Presentation.Wpf.Helpers"
                    xmlns:topology="clr-namespace:IRI.Maptor.Presentation.Wpf.Topology">

    <!--Shared by the Topology side panels (Check, Issues, Rules): white cards on the side panel's grey body, compact
        (doc 05 §1), as the other side-panel views.-->
    <ResourceDictionary.MergedDictionaries>
        <helpers:SharedResourceDictionary Source="pack://application:,,,/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.All.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="topologyVisible"/>

    <Style x:Key="topologyCard" TargetType="Border">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"/>
        <Setter Property="Margin" Value="{StaticResource IRI.Maptor.Styles.Thickness.StackGap}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource IRI.Maptor.Brushes.Surface.Border}"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
    </Style>

    <Style x:Key="topologyLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Body}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="topologyNote" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
    </Style>

    <Style x:Key="topologyWarning" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Warning}"/>
    </Style>

    <!--A severity dot: shape and colour, so it never depends on colour alone (doc 05 §10). The colours are the map
        overlay's own (TopologyOverlay), so the list and the map always match.-->
    <Style x:Key="topologySeverityDot" TargetType="Path">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="0,3,6,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Fill" Value="{x:Static topology:TopologyOverlay.InfoBrush}"/>
        <Setter Property="Data" Value="M 5,0 A 5,5 0 1 1 4.99,0 Z"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Error">
                <Setter Property="Fill" Value="{x:Static topology:TopologyOverlay.ErrorBrush}"/>
                <Setter Property="Data" Value="M 0,0 L 10,0 L 10,10 L 0,10 Z"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter Property="Fill" Value="{x:Static topology:TopologyOverlay.WarningBrush}"/>
                <Setter Property="Data" Value="M 5,0 L 10,10 L 0,10 Z"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
