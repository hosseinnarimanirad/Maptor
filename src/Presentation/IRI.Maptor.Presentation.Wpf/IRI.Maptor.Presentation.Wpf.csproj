<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- This project sets both UseWPF and UseWindowsForms, so the implicit usings enabled by the
         Presentation tier props would import System.Drawing and System.Windows.Media together and
         make Brush/Color/Point/Button/Cursor ambiguous (659 CS0104 errors). Keep it opted out. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageTags>GIS;spatial;WPF;map;MapViewer;symbology;cartography;tiles</PackageTags>
    <Description>The WPF map UI library: the central MapViewer control, MVVM building blocks, layer types (feature, raster, grid, group), cartographic rendering and symbology, tile-service providers, map markers, converters/behaviors, and Excel/Word export helpers.</Description>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

