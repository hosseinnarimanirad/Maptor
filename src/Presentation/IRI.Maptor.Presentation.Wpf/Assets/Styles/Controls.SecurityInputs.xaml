<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
                    xmlns:behaviors="clr-namespace:IRI.Maptor.Presentation.Wpf.Behaviors">

    <!--Replaces SecurityInputStyles.xaml (Step 4).

        That file was a second, ungoverned design system: it owned generic icon and input styles
        under non-conventional key names, and six views with nothing to do with security merged it
        purely to reach two icon styles. What remains here is only what is genuinely specific to
        the Security and auth screens, under the normal IRI.Maptor.Styles.* convention.

        The generic parts went to their proper homes:
          - securityIconPhosphor / securityIconMaterial are gone; use
            IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment and
            IRI.Maptor.Styles.PackIconMaterial.FieldAdornment in Controls.Misc.xaml.
          - myErrorTemplate is gone; it had zero references anywhere in the repository.

        This dictionary is deliberately NOT merged into Controls.All.xaml. FieldGroup below binds
        to an ancestor named "root", so it is only usable by views that expose those properties.
        Merge it explicitly where you need it.-->

    <ResourceDictionary.MergedDictionaries>
        <!--MahApps.Styles.PasswordBox, used as the BasedOn below-->
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml"/>
        <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
        <!--iranSans-->
        <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/IRI.Maptor.Fonts.xaml"/>
        <!--FieldAdornment icon styles, the BasedOn for the confirm-row variant-->
        <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Controls.Misc.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--Declared in this file on purpose. A StaticResource resolves only within its own dictionary
        and that dictionary's merges, never across sibling dictionaries in one MergedDictionaries
        list. The old file happened to reach a provider through Controls.TextBox.xaml; relying on
        that is how Controls.ComboBox.xaml and Controls.RadioButton.xaml silently failed to load
        before Step 3.-->
    <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

    <!--Password entry on the auth screens. Kept setter-for-setter as it was, because these screens
        are signed off visually. Note this does NOT derive from IRI.Maptor.Styles.PasswordBoxBase:
        that one carries the IsPersian font trigger, which would change the typeface here.-->
    <Style x:Key="IRI.Maptor.Styles.Security.PasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MahApps.Styles.PasswordBox}">
        <Setter Property="FontFamily" Value="{StaticResource iranSans}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="35"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Input}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu FlowDirection="{Binding CurrentFlowDirection, Source={StaticResource Localization}}">
                    <!--no Cut/Copy: lifting a password out of the box is not an affordance we offer-->
                    <MenuItem Header="{Binding [cmd_contextMenu_paste], Source={StaticResource Localization}}" Command="ApplicationCommands.Paste"/>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <!--Show-password toggle and Caps Lock warning (2026-11-05). MahApps' own template offers neither as
            wanted: its reveal button exists only in MahApps.Styles.PasswordBox.Button.Revealed and shows the
            password only while held down, and its Caps Lock hint is a small icon with a tooltip. So this style
            has its own template: the base's frame, content host and watermark (the only MahApps feature these
            screens use), plus the eye toggle and a warning line under the field, driven by PasswordBoxAssist.-->
        <Setter Property="behaviors:PasswordBoxAssist.IsEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid x:Name="root">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="Base" Grid.Row="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding mahApp:ControlsHelper.CornerRadius}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                        <Grid Grid.Row="0" Margin="{TemplateBinding BorderThickness}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="0"
                                          BorderThickness="0" Background="{x:Null}" IsTabStop="False"
                                          Padding="{TemplateBinding Padding}" VerticalAlignment="Stretch"/>

                            <!--the password in plain text while revealed; PasswordBoxAssist keeps it in step with the
                                PasswordBox and empties it when hidden. Explicit null style: the theme's plain TextBox,
                                not the app's implicit MahApps one with its own frame, watermark and menu.-->
                            <TextBox x:Name="PART_RevealedText" Grid.Column="0"
                                     Style="{x:Null}"
                                     Visibility="Collapsed"
                                     FlowDirection="LeftToRight"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                     Padding="{TemplateBinding Padding}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding CaretBrush}"
                                     SelectionBrush="{TemplateBinding SelectionBrush}"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"
                                     IsUndoEnabled="False"
                                     ContextMenu="{TemplateBinding ContextMenu}"/>

                            <TextBlock x:Name="PART_Message" Grid.Column="0"
                                       Style="{DynamicResource MahApps.Styles.TextBlock.Watermark}"
                                       Text="{TemplateBinding mahApp:TextBoxHelper.Watermark}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Padding="{TemplateBinding Padding}"
                                       Margin="4,0"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>

                            <ToggleButton x:Name="PART_RevealToggle" Grid.Column="1"
                                          IsChecked="{Binding Path=(behaviors:PasswordBoxAssist.IsRevealed), RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" IsTabStop="False" Cursor="Hand"
                                          Width="30" Margin="0,0,2,0"
                                          ToolTip="{Binding [common_showPassword], Source={StaticResource Localization}}"
                                          AutomationProperties.Name="{Binding [common_showPassword], Source={StaticResource Localization}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <iconPacks:PackIconMaterial x:Name="revealIcon" Kind="EyeOutline" Width="16" Height="16"
                                                            Foreground="{DynamicResource IRI.Maptor.Brushes.Muted}"/>
                            </ToggleButton>
                        </Grid>

                        <!--below the field, inside its frame: an icon-only hint in the corner is easy to miss-->
                        <StackPanel x:Name="PART_CapsLockWarning" Grid.Row="1"
                                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,0,4,4"
                                    Visibility="Collapsed">
                            <iconPacks:PackIconMaterial Kind="AppleKeyboardCaps" Width="12" Height="12" VerticalAlignment="Center"
                                                        Margin="0,0,4,0" Foreground="{DynamicResource IRI.Maptor.Brushes.Warning}"/>
                            <TextBlock Text="{Binding [common_capsLockWarning], Source={StaticResource Localization}}"
                                       FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"
                                       Foreground="{DynamicResource IRI.Maptor.Brushes.Warning}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="mahApp:TextBoxHelper.HasText" Value="False">
                            <Setter TargetName="PART_Message" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!--empty and focused: the watermark steps back, as in MahApps' template-->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="mahApp:TextBoxHelper.HasText" Value="False"/>
                                <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Message" Property="Opacity" Value="0.2"/>
                        </MultiTrigger>
                        <Trigger Property="behaviors:PasswordBoxAssist.IsRevealed" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_RevealedText" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="revealIcon" Property="Kind" Value="EyeOffOutline"/>
                            <Setter TargetName="PART_RevealToggle" Property="ToolTip" Value="{Binding [common_hidePassword], Source={StaticResource Localization}}"/>
                            <Setter TargetName="PART_RevealToggle" Property="AutomationProperties.Name" Value="{Binding [common_hidePassword], Source={StaticResource Localization}}"/>
                        </Trigger>
                        <Trigger SourceName="PART_RevealToggle" Property="IsMouseOver" Value="True">
                            <Setter TargetName="revealIcon" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                        </Trigger>
                        <Trigger Property="behaviors:PasswordBoxAssist.IsCapsLockWarningVisible" Value="True">
                            <Setter TargetName="PART_CapsLockWarning" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--The framed row that wraps an icon plus its input on the auth screens.
        Was x:Key="borderGroup". The two Binding setters require an ancestor element named "root"
        exposing InputBorderBrush / InputBorderThickness; on a view without one they resolve to
        nothing and the border simply does not paint.-->
    <Style x:Key="IRI.Maptor.Styles.Security.FieldGroup" TargetType="Border">
        <Setter Property="BorderBrush" Value="{Binding ElementName=root, Path=InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{Binding ElementName=root, Path=InputBorderThickness}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Width" Value="300"/>
        <!--was Background="White": the field text follows the theme, so in dark mode this
            produced near-white text on a white slab across all seven Security views-->
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}"/>
        <!--MinHeight, not Height: a fixed height clips the field when a validation message
            or a taller adornment appears-->
        <Setter Property="MinHeight" Value="39"/>
    </Style>

    <!--Supporting caption under a field on the auth screens. Was x:Key="securityPathText".-->
    <Style x:Key="IRI.Maptor.Styles.Security.PathText" TargetType="TextBlock">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.BodyLarge}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="FontFamily" Value="{StaticResource iranSans}"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
    </Style>

    <!--Adornment icon on a confirm row, which sits tighter to the field above it.
        Was x:Key="securityIconPhosphorConfirmRow".-->
    <Style x:Key="IRI.Maptor.Styles.Security.IconConfirmRow" TargetType="iconPacks:PackIconPhosphorIcons"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.FieldAdornment}">
        <Setter Property="Margin" Value="4,4,4,0"/>
    </Style>

</ResourceDictionary>
