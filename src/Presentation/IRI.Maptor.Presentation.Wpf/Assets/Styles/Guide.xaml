<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Styles for guide pages: FlowDocuments shown by GuideWindow. A guide merges this dictionary in its own
        Resources, so the implicit styles (paragraph, list, table) apply without a key and the keyed ones resolve
        with StaticResource while the document is loaded on its own.

        Colours are DynamicResource only, so a page follows the light and dark themes. The font, base size, page
        width and padding are set by GuideWindow, not here: the font follows the UI language as in every window.-->

    <!--body text-->
    <Style TargetType="{x:Type Paragraph}">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>

    <Style TargetType="{x:Type List}">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Padding" Value="24,0,0,0"/>
        <Setter Property="MarkerStyle" Value="Disc"/>
    </Style>

    <Style TargetType="{x:Type ListItem}">
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!--list items hold paragraphs; inside a list they sit closer together-->
    <Style x:Key="IRI.Maptor.Styles.Guide.ListParagraph" TargetType="{x:Type Paragraph}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>

    <!--headings-->
    <Style x:Key="IRI.Maptor.Styles.Guide.Title" TargetType="{x:Type Paragraph}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
    </Style>

    <!--the one-sentence answer under the title: what the tool is for-->
    <Style x:Key="IRI.Maptor.Styles.Guide.Lead" TargetType="{x:Type Paragraph}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Guide.Heading" TargetType="{x:Type Paragraph}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,22,0,8"/>
        <Setter Property="Padding" Value="0,0,0,4"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Guide.Subheading" TargetType="{x:Type Paragraph}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,12,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
    </Style>

    <!--a formula on its own line: always left to right, in a face with the maths symbols-->
    <Style x:Key="IRI.Maptor.Styles.Guide.Formula" TargetType="{x:Type Paragraph}">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Cambria Math, Segoe UI"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="0,4,0,12"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
    </Style>

    <!--Latin text (a formula, a value with units) inside a sentence in the UI language: its own left-to-right
        span, so bidi cannot reorder it inside a Persian sentence-->
    <Style x:Key="IRI.Maptor.Styles.Guide.Latin" TargetType="{x:Type Span}">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!--the caption under a figure-->
    <Style x:Key="IRI.Maptor.Styles.Guide.Caption" TargetType="{x:Type Paragraph}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Guide.Figure" TargetType="{x:Type BlockUIContainer}">
        <Setter Property="Margin" Value="0,8,0,6"/>
    </Style>

    <!--a boxed note: a tip, an assumption, a limit. Note = neutral accent, Warning = what can go wrong-->
    <Style x:Key="IRI.Maptor.Styles.Guide.Note" TargetType="{x:Type Section}">
        <Setter Property="Margin" Value="0,4,0,14"/>
        <Setter Property="Padding" Value="14,10,14,2"/>
        <Setter Property="BorderThickness" Value="4,0,0,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Guide.Warning" TargetType="{x:Type Section}" BasedOn="{StaticResource IRI.Maptor.Styles.Guide.Note}">
        <Setter Property="BorderBrush" Value="{DynamicResource IRI.Maptor.Brushes.Warning}"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
    </Style>

    <!--tables: header row group with Guide.TableHeader, rows separated by a hairline-->
    <Style TargetType="{x:Type Table}">
        <Setter Property="CellSpacing" Value="0"/>
        <Setter Property="Margin" Value="0,4,0,14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
    </Style>

    <Style TargetType="{x:Type TableCell}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray9}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Guide.TableHeader" TargetType="{x:Type TableRowGroup}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
    </Style>

    <!--a number in a table column: left to right, so units and minus signs stay in place; right-aligned
        so the digits line up-->
    <Style x:Key="IRI.Maptor.Styles.Guide.Number" TargetType="{x:Type Paragraph}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Guide.Cell" TargetType="{x:Type Paragraph}">
        <Setter Property="Margin" Value="0"/>
    </Style>

</ResourceDictionary>
