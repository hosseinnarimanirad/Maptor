<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core">

    <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

    <Style x:Key="IRI.Maptor.Styles.TextBlock"
           TargetType="TextBlock"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource Localization}, Path=IsPersian}" Value="True">
                <Setter Property="FontFamily" Value="{DynamicResource iranSans}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--Headers-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.WindowTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="8 0 8 0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!--sits on the accent-filled GroupBox/Expander header-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.HeaderTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!--groups the card rows of a dialog into labelled sections-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.SectionHeader"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="8,10,8,2"/>
    </Style>

    <!--Form-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.Normal"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBlock.Normal.Bold"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!--Dialog-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.ButtonContent"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FontSize" Value="13"/>

    </Style>

    <!--caption for IRI.Maptor.Styles.Button.*.Small-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.ButtonContent.Small"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}">
        <Setter Property="FontSize" Value="11"/>
    </Style>


    <Style x:Key="IRI.Maptor.Styles.TextBlock.Title"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!--"nothing here yet" caption centred in an empty list. Without one an empty queue reads
        as a broken screen.-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.EmptyState"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Muted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="16"/>
    </Style>

    <!--secondary caption inside a toolbar (timestamps, counts)-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.Caption"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Muted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBlock.Hint"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
    