<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Shared elevation. Since 2026-10-25 every static shadow in the library uses one of these;
        their strengths are the values those hand-written shadows already had, so moving onto the
        tokens made nothing heavier. Light comes from straight above (Direction 270).

        Deliberately NOT tokens: the map markers' shadows (named and animated on hover and
        selection, so each marker needs its own mutable instance), the round buttons' hover and
        checked glows, and ActiveExtentView's accent glow. Those show state, not depth.

        Effects are Freezable, so referencing one resource from many elements is safe and cheaper
        than constructing a new effect per element.-->

    <!--a resting surface barely lifted off its parent: a legend swatch, a pressed-in chip-->
    <DropShadowEffect x:Key="IRI.Maptor.Effects.Elevation1"
                      BlurRadius="2" ShadowDepth="1" Direction="270"
                      Opacity="0.25" Color="Black" RenderingBias="Performance" po:Freeze="True"/>

    <!--a floating panel: a filter popup, a flyout, a legend card over the map. Black at 25% renders
        as dark as the Gray-at-50% these pop-ups used before on a white background, and stays a
        shadow on a dark one, where grey would glow.-->
    <DropShadowEffect x:Key="IRI.Maptor.Effects.Elevation2"
                      BlurRadius="8" ShadowDepth="2" Direction="270"
                      Opacity="0.25" Color="Black" RenderingBias="Performance" po:Freeze="True"/>

    <!--a modal-ish overlay that must read as clearly above everything else-->
    <DropShadowEffect x:Key="IRI.Maptor.Effects.Elevation3"
                      BlurRadius="12" ShadowDepth="3" Direction="270"
                      Opacity="0.4" Color="Black" RenderingBias="Performance" po:Freeze="True"/>

</ResourceDictionary>
