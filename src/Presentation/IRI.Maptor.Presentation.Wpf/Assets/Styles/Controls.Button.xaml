<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

    <!--base button style-->
    <Style x:Key="IRI.Maptor.Styles.ButtonBase"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource MahApps.Styles.Button.Flat}">
        <Setter Property="Height" Value="{StaticResource IRI.Maptor.Styles.Size.Control.Default}"/>
        <Setter Property="MinHeight" Value="{StaticResource IRI.Maptor.Styles.Size.Control.Default}"/>
        <Setter Property="MinWidth" Value="100" />

        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"/>
        <Setter Property="mahApp:ControlsHelper.ContentCharacterCasing" Value="Normal" />

        <Setter Property="BorderThickness" Value="{StaticResource IRI.Maptor.Styles.Thickness.Border}"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource Localization}, Path=IsPersian}" Value="True">
                <Setter Property="FontFamily" Value="{DynamicResource iranSans}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--normal button styles-->
    <Style x:Key="IRI.Maptor.Styles.Button.Primary"     
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IRI.Maptor.Styles.ButtonBase}">

        <!--Filled with the theme's darker accent shade (Highlight), not Accent. Accent is the base
            colour at 80% opacity, and white text on it measured 1.8:1 on Amber (Saba) and 2.3:1
            on Green (Gas); on Highlight it is 3.8:1 and 5.0:1, 9.3:1 on Cobalt. Every app keeps its
            own colour, one shade deeper. (Step 3 of the 2026-10-24 review.)-->
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>

        <!--<Setter Property="FocusVisualStyle" Value="{StaticResource IRI.Maptor.Styles.Button.Primary.FocusVisual}"/>-->
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Border>
                                    <!--white dashes inside the button: a Highlight stroke vanished
                                        into the Highlight fill. Same geometry as Button.Secondary's
                                        focus marker, so focus looks the same on both.-->
                                    <Rectangle Margin="2"
                                                StrokeThickness="2"
                                                RadiusX="6"
                                                RadiusY="6"
                                                Stroke="{DynamicResource MahApps.Brushes.IdealForeground}"
                                                StrokeDashArray="2 2"
                                                SnapsToDevicePixels="True"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!--Hover keeps the fill and fades it slightly (95%: at 90% white-on-Amber fell to 2.9:1),
                as Windows 11 accent buttons do; pressed
                returns to the full shade, so a click reads as a press back in. Fading further when
                pressed would lighten the fill again and drop white-on-Amber below 3:1 (measured
                2.3:1 at 80%). The old pressed state inverted to a white fill with accent text,
                which read as a flicker. The fill and text colours are
                restated here because MahApps.Styles.Button.Flat's own triggers would otherwise
                paint its grey hover and pressed fills.-->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                <Setter Property="Opacity" Value="0.95"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
            <!--Disabled: the same quiet surface as Button.Secondary's disabled state. Half-opacity
                accent with white text measured 1.2:1 in every light theme.-->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Button.Secondary"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IRI.Maptor.Styles.ButtonBase}">

        <!--Neutral: a grey outline, so the accent is reserved for the one primary action and the
            primary button stands out next to it, as in Windows 11 dialogs.-->
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Control.Border}"/>
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Border>
                                    <Rectangle Margin="2"
                                         StrokeThickness="2"
                                         RadiusX="6"
                                         RadiusY="6"
                                         Stroke="{DynamicResource MahApps.Brushes.Highlight}"
                                         StrokeDashArray="2 2"
                                         SnapsToDevicePixels="True"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Hover: a light grey wash, darker outline. Gray9 is semi-transparent, so it reads in both themes. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border.MouseOver}"/>
            </Trigger>

            <!-- Pressed: a deeper grey with the theme's text colour. It used to fill with the dark
                 accent, which turned a quiet button into a primary one for the length of a click. -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border.MouseOver}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
            </Trigger>

            <!-- Disabled: a muted surface with readable secondary text, in both themes. Gray7 under the
                 MahApps disabled text was #7E7E7E behind #7F7F7F in the dark theme (1.4:1, the label
                 vanished) and 1.9:1 in the light one. Subtle fill + secondary text + quiet border instead,
                 at full opacity so nothing is composited onto the page. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
            </Trigger>

            <!-- Focus: optional, keep consistent -->
            <!--<Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>-->
        </Style.Triggers>
    </Style>

    <!--large button styles-->
    <Style x:Key="IRI.Maptor.Styles.Button.Primary.Large"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IRI.Maptor.Styles.Button.Primary}">

        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Action}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Button.Secondary.Large"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IRI.Maptor.Styles.Button.Secondary}">

        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Action}"/>
    </Style>

    <!--compact button styles: inline actions inside dense forms/lists, where a 32px button dominates the row-->
    <Style x:Key="IRI.Maptor.Styles.Button.Primary.Small"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IRI.Maptor.Styles.Button.Primary}">

        <Setter Property="Height" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Button.Secondary.Small"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IRI.Maptor.Styles.Button.Secondary}">

        <Setter Property="Height" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!--dialog button styles-->
    <Style x:Key="IRI.Maptor.Styles.Button.Dialogs.Primary"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IRI.Maptor.Styles.Button.Primary}">

        <Setter Property="Margin" Value="0 4 8 8"/>
        <Setter Property="Padding" Value="8 3"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Button.Dialogs.Secondary"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IRI.Maptor.Styles.Button.Secondary}">

        <Setter Property="Margin" Value="0 4 8 8"/>
        <Setter Property="Padding" Value="8 3"/>
    </Style>


    <Style x:Key="IRI.Maptor.Styles.Button.Dialogs.Primary.Circle" 
       TargetType="{x:Type Button}" 
       BasedOn="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Primary}">
        <!-- Override shape: square & round -->
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="16"/>
        <!-- half of 32 -->
        <!-- Layout adjustments for circular icon button -->
        <Setter Property="Margin" Value="0 0 8 0"/>
        <!-- or adjust as needed -->
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <!-- Override hover trigger to keep circular shape -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="16"/>
                <!-- Inherits Background and BorderBrush from base trigger, but we must ensure CornerRadius stays 16 -->
            </Trigger>
            <!-- Override pressed trigger to keep circular shape -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="16"/>
            </Trigger>
            <!-- Optional: keep focus visual without changing corner radius -->
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="16"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Button.Dialogs.Secondary.Circle" 
       TargetType="{x:Type Button}" 
       BasedOn="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Secondary}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="16"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <!-- Override hover trigger to keep circular shape -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="16"/>
                <!-- Inherits Background and BorderBrush from base trigger, but we must ensure CornerRadius stays 16 -->
            </Trigger>
            <!-- Override pressed trigger to keep circular shape -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="16"/>
            </Trigger>
            <!-- Optional: keep focus visual without changing corner radius -->
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="16"/>
            </Trigger>
        </Style.Triggers>
    </Style>



    <!--close affordance inside a tab header. Deliberately quiet until hovered: it sits next to
        the tab label, so full button chrome (which is what Style="{x:Null}" leaves behind) reads
        as a second control competing with the tab itself.

        Foreground tracks the owning tab, because the pill flips to an accent fill when selected and
        a fixed grey glyph would sink into it. Inheritance cannot deliver that: both Button and
        PackIcon carry a Foreground setter in their own theme style, and a style setter outranks an
        inherited value. Hence the explicit binding below — and icon content must bind the same way
        one level down:
            Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}},
                                 Path=Foreground}"
        The hover/pressed colours still win, template triggers outranking style setters.-->
    <Style x:Key="IRI.Maptor.Styles.Button.TabClose" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground"
                Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="chrome" Background="{TemplateBinding Background}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <!--Icon content must bind its own Foreground back to this button — see the
                            note on the style below.-->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chrome" Property="Background"
                                    Value="{DynamicResource IRI.Maptor.Brushes.Invalid.Fill}"/>
                            <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Invalid}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="chrome" Property="Background"
                                    Value="{DynamicResource IRI.Maptor.Brushes.Invalid}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--Circle buttons-->

    <Style x:Key="IRI.Maptor.Styles.Button.CircleLight" TargetType="{x:Type Button}">

        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>

        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="0"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>

        <!-- Light theme colors -->
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>

        <Setter Property="Cursor" Value="Hand"/>
        <!--<Setter Property="Opacity" Value="0.9"/>-->

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Ellipse x:Name="ellipse" Margin="1"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="{TemplateBinding BorderThickness}">
                            <Ellipse.Effect>
                                <DynamicResource ResourceKey="IRI.Maptor.Effects.Elevation1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter TargetName="ellipse" Property="Fill" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                            <Setter Property="Effect" TargetName="ellipse">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1.5" Opacity="0.6" Color="Black"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ellipse" Property="Fill" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                            <Setter TargetName="ellipse" Property="Stroke" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray7}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray7}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray4}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Rectangle Margin="2" Stroke="{DynamicResource MahApps.Brushes.Highlight}"
                                       StrokeThickness="1" StrokeDashArray="2 2"
                                       RadiusX="18" RadiusY="18"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Button.CircleDark" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>

        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="0"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        
        <!-- Dark theme colors -->
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
        <Setter Property="BorderThickness" Value="0"/>

        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Opacity" Value="0.9"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Ellipse x:Name="ellipse" Margin="1" 
                              Fill="{TemplateBinding Background}"
                              Stroke="{TemplateBinding BorderBrush}"
                              StrokeThickness="{TemplateBinding BorderThickness}">
                            <Ellipse.Effect>
                                <DynamicResource ResourceKey="IRI.Maptor.Effects.Elevation1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter TargetName="ellipse" Property="Effect" >
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1.5" Opacity="0.6" Color="Black"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ellipse" Property="Fill" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                            <Setter TargetName="ellipse" Property="Stroke" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.9"/>
                            <Setter Property="Background" Value="LightGray"/>
                            <Setter Property="BorderBrush" Value="LightGray"/>
                            <Setter Property="Foreground" Value="Gray"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Rectangle Margin="2" Stroke="{DynamicResource MahApps.Brushes.Highlight}"
                                       StrokeThickness="1" StrokeDashArray="2 2"
                                       RadiusX="18" RadiusY="18"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Square command-bar button: the add/remove/move-up/move-down cluster above a list.
        Dialogs.Secondary.Circle is the round sibling; a command bar of six of these reads
        better square, and the SLD editor's rule toolbar writes Width="32" Height="32"
        Margin="2" by hand twelve times because this did not exist.-->
    <Style x:Key="IRI.Maptor.Styles.Button.IconSquare"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Secondary}">
        <Setter Property="Width" Value="{StaticResource IRI.Maptor.Styles.Size.Button.IconSquare}"/>
        <Setter Property="Height" Value="{StaticResource IRI.Maptor.Styles.Size.Button.IconSquare}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"/>
    </Style>

</ResourceDictionary>
