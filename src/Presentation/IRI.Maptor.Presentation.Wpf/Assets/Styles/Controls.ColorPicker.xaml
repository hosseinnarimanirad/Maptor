<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls">

    <!--Maptor's own colour picker (Controls/ColorPicker/MaptorColorPicker.cs). Metrics match
        IRI.Maptor.Styles.ColorPicker.Normal/Small so it can replace mahApp:ColorPicker in the same
        form rows without shifting anything.-->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
        <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Common.Effects.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--Swatch tokens. Fixed in both themes on purpose: they frame an arbitrary colour, so they must
        contrast with that colour, not with the theme. Edge: hairline round any swatch. Selection: a
        white frame with a dark hairline outside it, visible on both light and dark cells.-->
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Swatch.Edge" Color="#1F000000"/>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Swatch.SelectionInner" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Swatch.SelectionOuter" Color="#66000000"/>

    <!--light/dark-neutral checkerboard shown behind a colour so transparency is visible-->
    <DrawingBrush x:Key="IRI.Maptor.Brushes.Checkerboard" TileMode="Tile" Stretch="Fill"
                  Viewport="0,0,8,8" ViewportUnits="Absolute" Viewbox="0,0,8,8" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFE2DDD2">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,4,4"/>
                            <RectangleGeometry Rect="4,4,4,4"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="IRI.Maptor.Styles.MaptorColorPicker.Normal" TargetType="controls:MaptorColorPicker">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinHeight" Value="{StaticResource IRI.Maptor.Styles.Size.Control.Default}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="5,0,8,0"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}"/>
        <Setter Property="BorderThickness" Value="{StaticResource IRI.Maptor.Styles.Thickness.Border}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MaptorColorPicker">
                    <Grid>
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!--swatch: checkerboard, the colour over it, a hairline frame; a red
                                diagonal on white when there is no colour-->
                            <Grid x:Name="swatch" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Small}"
                                        Background="{StaticResource IRI.Maptor.Brushes.Checkerboard}"/>
                                <Border CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Small}"
                                        Background="{TemplateBinding SelectedBrush}"
                                        BorderBrush="{StaticResource IRI.Maptor.Brushes.Swatch.Edge}" BorderThickness="1"/>
                                <Line x:Name="noColor" X1="0" Y1="1" X2="1" Y2="0" Stretch="Fill" Margin="3"
                                      Stroke="{DynamicResource IRI.Maptor.Brushes.Invalid}" StrokeThickness="1.5" Visibility="Collapsed"/>
                            </Grid>

                            <!--hex and opacity always read left to right, also in RTL forms-->
                            <TextBlock Grid.Column="1" Text="{TemplateBinding HexText}" VerticalAlignment="Center"
                                       FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left"/>
                            <TextBlock x:Name="opacity" Grid.Column="2" Text="{TemplateBinding OpacityText}"
                                       VerticalAlignment="Center" FlowDirection="LeftToRight" Margin="8,0,0,0"
                                       Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>

                            <Path x:Name="chevron" Grid.Column="3" Data="M0,0 L4,4 L8,0" Width="8" Height="4"
                                  Stretch="None" Margin="10,0,0,0" VerticalAlignment="Center"
                                  Stroke="{DynamicResource MahApps.Brushes.Gray3}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  RenderTransformOrigin="0.5,0.5"/>
                        </Grid>
                    </Border>

                    <!--the pop-up. The 8/12 px margin around the card leaves room for its shadow;
                        HorizontalOffset cancels the left margin so the card lines up with the control.
                        The shadow is a separate shape behind the card so the card's text stays crisp.-->
                    <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=root}" Placement="Bottom"
                           HorizontalOffset="-8" VerticalOffset="2" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" Focusable="False"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Grid Margin="8,2,8,12">
                            <Border CornerRadius="12" Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                    Effect="{StaticResource IRI.Maptor.Effects.Elevation3}"/>
                            <Border CornerRadius="12" Padding="12" BorderThickness="1"
                                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}">
                                <controls:MaptorColorPickerPanel x:Name="PART_Panel"/>
                            </Border>
                        </Grid>
                    </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasColor" Value="False">
                            <Setter TargetName="noColor" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="opacity" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="chevron" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="swatch" Property="Width" Value="16"/>
                            <Setter TargetName="swatch" Property="Height" Value="16"/>
                            <Setter TargetName="swatch" Property="Margin" Value="0,0,5,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border.MouseOver}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                            <Setter TargetName="chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="{StaticResource IRI.Maptor.Styles.Opacity.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--narrow grid cells (e.g. the 90 px raster colour-map column): compact height, swatch + hex only-->
    <Style x:Key="IRI.Maptor.Styles.MaptorColorPicker.Small" TargetType="controls:MaptorColorPicker"
           BasedOn="{StaticResource IRI.Maptor.Styles.MaptorColorPicker.Normal}">
        <Setter Property="MinHeight" Value="{StaticResource IRI.Maptor.Styles.Size.Control.Compact}"/>
        <Setter Property="Padding" Value="3,0,4,0"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Caption}"/>
        <Setter Property="IsCompact" Value="True"/>
    </Style>

    <!--implicit: a bare <controls:MaptorColorPicker/> gets the Normal look-->
    <Style TargetType="controls:MaptorColorPicker" BasedOn="{StaticResource IRI.Maptor.Styles.MaptorColorPicker.Normal}"/>

</ResourceDictionary>
