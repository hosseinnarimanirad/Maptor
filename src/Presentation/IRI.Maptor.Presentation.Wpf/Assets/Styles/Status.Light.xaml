<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Semantic status palette, LIGHT variant. The MahApps themes carry an accent and a grey
        ramp but no valid/invalid pair, so these are deliberate literals. ThemeHelper.ApplyTheme
        swaps this dictionary for Status.Dark.xaml, which defines exactly the same keys.
        Consume with DynamicResource, never StaticResource, or the swap will not reach you.-->

    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Valid"        Color="#1B7F4B" po:Freeze="True"/>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Valid.Fill"   Color="#E4F2EA" po:Freeze="True"/>

    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Invalid"      Color="#B3261E" po:Freeze="True"/>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Invalid.Fill" Color="#FAE9E8" po:Freeze="True"/>

    <!--advisory, not failure: a stale base version, a pending overlap. Sits between Valid and
        Invalid so a warning never reads as a rejection.-->
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Warning"      Color="#8A6100" po:Freeze="True"/>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Warning.Fill" Color="#FBF0D3" po:Freeze="True"/>

    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Muted"        Color="#5F6368" po:Freeze="True"/>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Muted.Fill"   Color="#ECECEE" po:Freeze="True"/>

    <!--Surface levels of a main window (2026-11-10). Not a status, but they need the same light/dark
        swap and MahApps' grey ramp does not give it: in the dark theme its Gray10 is LIGHTER than
        the theme background, which would make the cards look sunk into the window.
          Canvas  the window behind the cards (the gaps between panels)
          Card    MahApps.Brushes.ThemeBackground, unchanged
          Subtle  bands inside a card: header row, toolbars, a tool panel's content area
          Hover   a Subtle band under the mouse
          Border  card outlines and the rules inside them-->
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Surface.Canvas" Color="#ECEEF1" po:Freeze="True"/>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Surface.Subtle" Color="#F6F7F9" po:Freeze="True"/>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Surface.Hover"  Color="#E8EBEF" po:Freeze="True"/>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Surface.Border" Color="#D5D9DF" po:Freeze="True"/>

</ResourceDictionary>
