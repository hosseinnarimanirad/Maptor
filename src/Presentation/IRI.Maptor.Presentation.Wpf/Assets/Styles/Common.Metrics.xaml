<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--Shared spacing scale for dialogs and forms. Use these instead of ad-hoc margins
        so every dialog keeps the same rhythm.-->

    <!--padding around a dialog's content area-->
    <Thickness x:Key="IRI.Maptor.Styles.Thickness.DialogContent">8</Thickness>

    <!--gap between rows inside one section. Section separation itself comes from
        IRI.Maptor.Styles.TextBlock.SectionHeader's own top margin.-->
    <Thickness x:Key="IRI.Maptor.Styles.Thickness.RowGap">0,4</Thickness>

    <!--gap above the action-button row, see IRI.Maptor.Styles.Border.DialogFooter-->
    <Thickness x:Key="IRI.Maptor.Styles.Thickness.DialogFooter">0,8,0,0</Thickness>

    <!--Shared corner rounding. Controls (buttons, tab pills) and surfaces (cards, panels)
        round by slightly different amounts, so they are two tokens rather than one.-->

    <!--buttons, tab pills, inline controls-->
    <CornerRadius x:Key="IRI.Maptor.Styles.CornerRadius.Control">6</CornerRadius>

    <!--cards and other content surfaces-->
    <CornerRadius x:Key="IRI.Maptor.Styles.CornerRadius.Surface">5</CornerRadius>

    <!--the tab strip's rounded track. Must stay equal to Control + TabTrackPadding, or the
        track's curve and the selected pill's curve will not be concentric.-->
    <CornerRadius x:Key="IRI.Maptor.Styles.CornerRadius.TabTrack">9</CornerRadius>

    <!--breathing room between the track edge and the pills inside it-->
    <Thickness x:Key="IRI.Maptor.Styles.Thickness.TabTrackPadding">3</Thickness>

    <!--Form rhythm. A form row is a label column plus an editor; these keep the label
        columns of sibling views aligned. Before these existed the SLD editor used 90, 100
        and 120 in one dialog, so labels jumped as the user changed tab.-->

    <!--width of the label column in a label+editor row-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.FieldLabelColumn">120</sys:Double>

    <!--same value as a GridLength, for ColumnDefinition.Width which will not take a Double.
        Use this one in form grids; keep the two in step.-->
    <GridLength x:Key="IRI.Maptor.Styles.GridLength.FieldLabelColumn">120</GridLength>

    <!--padding around a single editor inside its row-->
    <Thickness x:Key="IRI.Maptor.Styles.Thickness.FieldGap">4</Thickness>

    <!--gap below one form row before the next-->
    <Thickness x:Key="IRI.Maptor.Styles.Thickness.FieldRowGap">0,0,0,6</Thickness>

    <!--padding around a view's content area. Same value as DialogContent, but named for
        views so authors of non-dialog screens have a token to reach for.-->
    <Thickness x:Key="IRI.Maptor.Styles.Thickness.ViewContent">8</Thickness>

    <!--gap above a new section within a scrolling column-->
    <Thickness x:Key="IRI.Maptor.Styles.Thickness.SectionGap">0,8,0,0</Thickness>

    <!--Type scale.

        Until 2026-08-31 there was no such thing: every font size in the system was a bare number
        written into a Setter, 42 of them across 14 dictionaries, plus 37 more in views. Eleven
        distinct values were in use (7, 8, 10, 11, 12, 13, 14, 15, 16, 18, 20), which is not a
        scale, it is a continuum.

        These eight are the values the LIBRARY's own styles were already using, named by role and
        left at exactly the numbers they had. Nothing renders differently because of this block;
        the point is that the numbers now exist once instead of forty-two times, which is what a
        UI-scale or accessibility setting would have to multiply.

        Three values were deliberately NOT given a token, so that reaching for one is a decision
        rather than a reflex:
          7 and 8  only appear in PrintToPdfDialogView's preview of a printed page. That is a
                   picture of paper, not user-interface type, and it must not scale with the UI.
          18       only appears on two Security dialog titles. Those screens are signed off and a
                   token would invite someone to "tidy" them onto 20. See PROGRESS.md section 3,
                   Step 4.

        When adding a size, use an existing step. If none fits, the honest question is whether the
        design needs a ninth step or whether the element is mislabelled.-->

    <!--pill counters, map-marker badges: the smallest text the system sets-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Text.Micro">10</sys:Double>

    <!--captions, hints, field sub-labels-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Text.Caption">11</sys:Double>

    <!--secondary body: grid cells, tab labels, helper text-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Text.Small">12</sys:Double>

    <!--default body and form labels-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Text.Body">13</sys:Double>

    <!--emphasised body and section headers-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Text.BodyLarge">14</sys:Double>

    <!--text the user types into: TextBox, PasswordBox, editable ComboBox-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Text.Input">15</sys:Double>

    <!--large action buttons-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Text.Action">16</sys:Double>

    <!--dialog and screen titles-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Text.Title">20</sys:Double>

    <!--Icon sizing. Written as raw Width/Height in nearly every view audited.-->

    <!--glyph inside a form field's adornment column-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Icon.Field">24</sys:Double>

    <!--glyph beside a caption-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Icon.Small">16</sys:Double>

    <!--status dot in a list row-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Icon.Indicator">10</sys:Double>

    <!--square command-bar button, e.g. the SLD editor's rule toolbar-->
    <sys:Double x:Key="IRI.Maptor.Styles.Size.Button.IconSquare">32</sys:Double>

    <!--opacity of a disabled affordance-->
    <sys:Double x:Key="IRI.Maptor.Styles.Opacity.Disabled">0.5</sys:Double>

</ResourceDictionary>
