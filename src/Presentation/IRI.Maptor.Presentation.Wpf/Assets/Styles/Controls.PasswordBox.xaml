<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls">

    <!--The system had no PasswordBox style at all, which is why the Security views grew their
        own (SecurityInputStyles.xaml). That one pinned FontFamily to iranSans unconditionally,
        so a PasswordBox and the TextBox directly above it rendered in different typefaces under
        any non-Persian culture. These mirror the TextBox styles setter-for-setter, including the
        IsPersian trigger, so the two controls stay in step.-->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

    <Style x:Key="IRI.Maptor.Styles.PasswordBoxBase" TargetType="PasswordBox" BasedOn="{StaticResource MahApps.Styles.PasswordBox}">
        <!--no Cut/Copy: lifting a password out of the box is not an affordance we offer-->
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu FlowDirection="{Binding CurrentFlowDirection, Source={StaticResource Localization}}">
                    <MenuItem Header="{Binding [cmd_contextMenu_paste], Source={StaticResource Localization}}" Command="ApplicationCommands.Paste"/>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="mahApp:PasswordBoxHelper.RevealButtonContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <iconPacks:PackIconMaterial Kind="Eye"
                                                Width="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                                Height="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Foreground="{DynamicResource IRI.Maptor.Brushes.Muted}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.PasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource IRI.Maptor.Styles.PasswordBoxBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource Localization}, Path=IsPersian}" Value="True">
                <Setter Property="FontFamily" Value="{DynamicResource iranSans}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--matches IRI.Maptor.Styles.TextBox.Large-->
    <Style x:Key="IRI.Maptor.Styles.PasswordBox.Large" TargetType="PasswordBox" BasedOn="{StaticResource IRI.Maptor.Styles.PasswordBox}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="MinHeight" Value="35"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!--matches IRI.Maptor.Styles.TextBox.Normal-->
    <Style x:Key="IRI.Maptor.Styles.PasswordBox.Normal" TargetType="PasswordBox" BasedOn="{StaticResource IRI.Maptor.Styles.PasswordBox}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="4"/>
    </Style>

</ResourceDictionary>
