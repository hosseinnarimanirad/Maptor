<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="IRI.Maptor.Styles.Border.Card" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}"/>
        <Setter Property="Padding" Value="4,0"/>
        <!--3 all round: 6 px between two cards, stacked or side by side, like the shared panel gap
            (compact review, Step 2, 2026-11-11; was 4, i.e. 8 between cards)-->
        <Setter Property="Margin" Value="3"/>
        <Setter Property="CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}"/>
        <!--MinHeight, not Height: cards that hold more than one row (option groups,
            page setup) must be allowed to grow instead of clipping their content.-->
        <Setter Property="MinHeight" Value="{StaticResource IRI.Maptor.Styles.Size.Control.Large}"/>
    </Style>

    <!--Framed content surface: the outer shell of a list/detail view, so the content does not
        float directly on the window background. Pair with Border.PanelHeader for a title band.-->
    <Style x:Key="IRI.Maptor.Styles.Border.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource IRI.Maptor.Brushes.Surface.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource IRI.Maptor.Styles.Thickness.Border}"/>
        <!--6 (Control), like the main window's cards (2026-11-11: Surface 8 → Small 4 for the compact style, then
            6 for slightly smoother corners)-->
        <Setter Property="CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"/>
    </Style>

    <!--title band at the top of a Border.Panel; its caption is TextBlock.PanelTitle. A light accent
        tint with a tinted rule under it, the same band as the main window's card headers
        (Expander.Card, MapSidePanel). Until 2026-11-10 it was filled with the full accent and white
        text, which was too saturated: buttons on it should be Button.PanelGhost. Compact like the
        card headers (2026-11-11): 32 px; radius 5,5,0,0 is the inner curve of Border.Panel's 6 px
        corner and 1 px border.-->
    <Style x:Key="IRI.Maptor.Styles.Border.PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Accent.Tint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource IRI.Maptor.Brushes.Accent.Tint.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="5,5,0,0"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="MinHeight" Value="{StaticResource IRI.Maptor.Styles.Size.Control.Default}"/>
    </Style>

    <!--the strip that carries a view's refresh/action buttons above its content-->
    <Style x:Key="IRI.Maptor.Styles.Border.Toolbar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!--divider + spacing above a dialog's action buttons, see DialogFooterView-->
    <Style x:Key="IRI.Maptor.Styles.Border.DialogFooter" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray7}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="{StaticResource IRI.Maptor.Styles.Thickness.DialogFooter}"/>
        <Setter Property="Padding" Value="{StaticResource IRI.Maptor.Styles.Thickness.RowGap}"/>
    </Style>

</ResourceDictionary>