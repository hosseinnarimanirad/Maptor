    <!--PackIcon inside a light circle button-->
    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent" TargetType="iconPacks:PackIconMaterial">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ButtonContent"
           TargetType="iconPacks:PackIconMaterial"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}">
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!--icon for IRI.Maptor.Styles.Button.*.Small-->
    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small"
           TargetType="iconPacks:PackIconMaterial"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ChevronPrevious"
           TargetType="iconPacks:PackIconMaterial"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}">
        <Setter Property="Kind" Value="ChevronLeft"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
                         Value="RightToLeft">
                <Setter Property="Kind" Value="ChevronRight"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ChevronNext"
           TargetType="iconPacks:PackIconMaterial"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}">
        <Setter Property="Kind" Value="ChevronRight"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
                         Value="RightToLeft">
                <Setter Property="Kind" Value="ChevronLeft"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ChevronDoublePrevious"
           TargetType="iconPacks:PackIconMaterial"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}">
        <Setter Property="Kind" Value="ChevronDoubleLeft"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
                         Value="RightToLeft">
                <Setter Property="Kind" Value="ChevronDoubleRight"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ChevronDoubleNext"
           TargetType="iconPacks:PackIconMaterial"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}">
        <Setter Property="Kind" Value="ChevronDoubleRight"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
                         Value="RightToLeft">
                <Setter Property="Kind" Value="ChevronDoubleLeft"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--ChevronPrevious/ChevronNext without size, margin or foreground, for buttons that size their
        own icon (ribbon buttons, fixed-size circle buttons). Same rule: previous points to the
        reading start (left in LTR, right in RTL). FlowDirection stays LeftToRight so an RTL parent
        does not mirror the glyph a second time.-->
    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ChevronPrevious.Plain" TargetType="iconPacks:PackIconMaterial">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Kind" Value="ChevronLeft"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
                         Value="RightToLeft">
                <Setter Property="Kind" Value="ChevronRight"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ChevronNext.Plain" TargetType="iconPacks:PackIconMaterial">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Kind" Value="ChevronRight"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
                         Value="RightToLeft">
                <Setter Property="Kind" Value="ChevronLeft"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--Bold-arrow variant of ChevronPrevious.Plain/ChevronNext.Plain, for the previous/next map
        extent buttons. Same rule and same LeftToRight FlowDirection.-->
    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ArrowPrevious.Plain" TargetType="iconPacks:PackIconMaterial">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Kind" Value="ArrowLeftBold"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
                         Value="RightToLeft">
                <Setter Property="Kind" Value="ArrowRightBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ArrowNext.Plain" TargetType="iconPacks:PackIconMaterial">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Kind" Value="ArrowRightBold"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
                         Value="RightToLeft">
                <Setter Property="Kind" Value="ArrowLeftBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--PackIcon inside a light circle button-->
    <Style x:Key="IRI.Maptor.Styles.PackIconPhosphorIcons.CircleLightButtonContent"
           TargetType="iconPacks:PackIconPhosphorIcons">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--Phosphor twins of PackIconMaterial.ButtonContent(.Small), same size and spacing, so a
        Phosphor icon (e.g. MapPinPlusFill, the drawing items symbol) can replace a Material one
        in a text button without moving anything.-->
    <Style x:Key="IRI.Maptor.Styles.PackIconPhosphorIcons.ButtonContent"
           TargetType="iconPacks:PackIconPhosphorIcons"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.CircleLightButtonContent}">
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!--icon for IRI.Maptor.Styles.Button.*.Small-->
    <Style x:Key="IRI.Maptor.Styles.PackIconPhosphorIcons.ButtonContent.Small"
           TargetType="iconPacks:PackIconPhosphorIcons"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.ButtonContent}">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>


    <Style x:Key="IRI.Maptor.Styles.Path.ButtonContent" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    
    <Style x:Key="circleButtonPath" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

</ResourceDictionary>