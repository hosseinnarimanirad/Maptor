<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls">

    <!--for the IRI.Maptor.Styles.Size.Text.* type scale used below. A StaticResource
        resolves only within its own dictionary and its merges, so this line is required,
        not decorative.-->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

    <Style x:Key="IRI.Maptor.Styles.TextBoxBase" TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu FlowDirection="{Binding CurrentFlowDirection, Source={StaticResource Localization}}">
                    <MenuItem Header="{Binding [cmd_contextMenu_cut], Source={StaticResource Localization}}" Command="ApplicationCommands.Cut"/>
                    <MenuItem Header="{Binding [cmd_contextMenu_copy], Source={StaticResource Localization}}" Command="ApplicationCommands.Copy"/>
                    <MenuItem Header="{Binding [cmd_contextMenu_paste], Source={StaticResource Localization}}" Command="ApplicationCommands.Paste"/>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBox" TargetType="TextBox" BasedOn="{StaticResource IRI.Maptor.Styles.TextBoxBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource Localization}, Path=IsPersian}" Value="True">
                <Setter Property="FontFamily" Value="{DynamicResource iranSans}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBox.Large" TargetType="TextBox" BasedOn="{StaticResource IRI.Maptor.Styles.TextBox}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="MinHeight" Value="35"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Input}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBox.Large.En" TargetType="TextBox" BasedOn="{StaticResource IRI.Maptor.Styles.TextBox.Large}">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource Localization}, Path=IsPersian}" Value="True">
                <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.TextBox}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBox.Normal" TargetType="TextBox" BasedOn="{StaticResource IRI.Maptor.Styles.TextBox}">
        <Setter Property="Height" Value="{StaticResource IRI.Maptor.Styles.Size.Control.Default}"/>

        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        
        <!--A visible 1 px frame: grey at rest, darker on hover, accent when focused. Until
            2026-10-25 Normal inputs were borderless, so on a white surface only their text showed.-->
        <Setter Property="BorderThickness" Value="{StaticResource IRI.Maptor.Styles.Thickness.Border}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border}"/>
        <Setter Property="mahApp:ControlsHelper.MouseOverBorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border.MouseOver}"/>
        <Setter Property="mahApp:ControlsHelper.FocusBorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}"/>

        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"/>
        <Setter Property="mahApp:TextBoxHelper.SelectAllOnFocus" Value="True"/>
        <!--<Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#999999"/>
                <Setter Property="Opacity" Value="0.8"/>
            </Trigger>
        </Style.Triggers>-->
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBox.Normal.En" TargetType="TextBox" BasedOn="{StaticResource IRI.Maptor.Styles.TextBox.Normal}">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.BodyLarge}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource Localization}, Path=IsPersian}" Value="True">
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBox.Small.En" TargetType="TextBox" BasedOn="{StaticResource IRI.Maptor.Styles.TextBox.Normal}">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="MinHeight" Value="{StaticResource IRI.Maptor.Styles.Size.Control.Compact}"/>
        <Setter Property="Height" Value="auto"/>
        <!--one pixel less than Normal's 8,4 top and bottom: 12 px text + 2x3 + 2x1 border = 24,
            so the box lands on Size.Control.Compact instead of growing to 26-->
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"/>
        <Setter Property="BorderThickness" Value="{StaticResource IRI.Maptor.Styles.Thickness.Border}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource Localization}, Path=IsPersian}" Value="True">
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>


</ResourceDictionary>