<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls">

    <!--ComboBox.Normal's IsPersian trigger below binds {StaticResource Localization}. A
        StaticResource resolves only inside its own dictionary and that dictionary's merges — never
        across sibling dictionaries in the same MergedDictionaries list — so without this provider
        the ComboBox.Normal entry failed to load and the key was silently absent at runtime.
        Every other dictionary that uses the trigger (TextBox, TextBlock, Button, CheckBox,
        TabItem, ToggleSwitch, MetroWindow) declares its own copy; this one was the odd one out.-->
    <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

    <Style x:Key="IRI.Maptor.Styles.ComboBox.Base" TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="6"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.ComboBox.Normal" TargetType="ComboBox" BasedOn="{StaticResource IRI.Maptor.Styles.ComboBox.Base}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource Localization}, Path=IsPersian}" Value="True">
                <Setter Property="FontFamily" Value="{DynamicResource iranSans}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.ComboBox.Large" TargetType="ComboBox" BasedOn="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinHeight" Value="35"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.ComboBox.Normal.Latin" TargetType="ComboBox" BasedOn="{StaticResource IRI.Maptor.Styles.ComboBox.Base}">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.ComboBox.Small.Latin" TargetType="ComboBox" BasedOn="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="24"/>
    </Style>
    
    <Style x:Key="IRI.Maptor.Styles.ComboBox.Large.Latin" TargetType="ComboBox" BasedOn="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinHeight" Value="35"/>
    </Style>
</ResourceDictionary> 