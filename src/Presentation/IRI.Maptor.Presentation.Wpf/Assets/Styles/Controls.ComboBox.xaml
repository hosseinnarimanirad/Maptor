<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls">


    <!--for the IRI.Maptor.Styles.Size.Text.* type scale used below. A StaticResource
        resolves only within its own dictionary and its merges, so this line is required,
        not decorative.-->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/IRI.Maptor.Presentation.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!--ComboBox.Normal's IsPersian trigger below binds {StaticResource Localization}. A
        StaticResource resolves only inside its own dictionary and that dictionary's merges — never
        across sibling dictionaries in the same MergedDictionaries list — so without this provider
        the ComboBox.Normal entry failed to load and the key was silently absent at runtime.
        Every other dictionary that uses the trigger (TextBox, TextBlock, Button, CheckBox,
        TabItem, ToggleSwitch, MetroWindow) declares its own copy; this one was the odd one out.-->
    <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

    <Style x:Key="IRI.Maptor.Styles.ComboBox.Base" TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.BodyLarge}"/>
        <Setter Property="MinHeight" Value="{StaticResource IRI.Maptor.Styles.Size.Control.Default}"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}"/>
        <!--A visible 1 px frame: grey at rest, darker on hover, accent when focused. Until
            2026-10-25 Normal inputs were borderless, so on a white surface only their text showed.-->
        <Setter Property="BorderThickness" Value="{StaticResource IRI.Maptor.Styles.Thickness.Border}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border}"/>
        <Setter Property="mahApp:ControlsHelper.MouseOverBorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border.MouseOver}"/>
        <Setter Property="mahApp:ControlsHelper.FocusBorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.ComboBox.Normal" TargetType="ComboBox" BasedOn="{StaticResource IRI.Maptor.Styles.ComboBox.Base}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource Localization}, Path=IsPersian}" Value="True">
                <Setter Property="FontFamily" Value="{DynamicResource iranSans}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.ComboBox.Large" TargetType="ComboBox" BasedOn="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}">
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Input}"/>
        <Setter Property="MinHeight" Value="35"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.ComboBox.Normal.Latin" TargetType="ComboBox" BasedOn="{StaticResource IRI.Maptor.Styles.ComboBox.Base}">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.ComboBox.Small.Latin" TargetType="ComboBox" BasedOn="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}">
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"/>
        <Setter Property="MinHeight" Value="{StaticResource IRI.Maptor.Styles.Size.Control.Compact}"/>
        <!--MahApps pads 4 all round; 3 top and bottom lands 12 px text on Size.Control.Compact (24)-->
        <Setter Property="Padding" Value="4,3"/>
    </Style>
    
    <Style x:Key="IRI.Maptor.Styles.ComboBox.Large.Latin" TargetType="ComboBox" BasedOn="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}">
        <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Input}"/>
        <Setter Property="MinHeight" Value="35"/>
    </Style>
</ResourceDictionary> 