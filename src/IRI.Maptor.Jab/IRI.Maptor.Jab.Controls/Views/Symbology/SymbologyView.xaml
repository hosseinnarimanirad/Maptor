<local:LocalizedMetroWindow x:Class="IRI.Maptor.Jab.Controls.Views.Symbology.SymbologyView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" 
                    xmlns:local="clr-namespace:IRI.Maptor.Jab.Controls.Views" 
                    xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    x:Name="root"
                    ResizeMode="NoResize" 
                    WindowStyle="ToolWindow" 
                    SizeToContent="WidthAndHeight"
                    WindowTransitionsEnabled="False" 
                    ShowMinButton="False"
                    ShowInTaskbar="False"
                    ShowIconOnTitleBar="False" 
                    ShowMaxRestoreButton="False" 
                    FlowDirection="{Binding ElementName=mainGrid, Path=FlowDirection, Mode=OneWay}"
                    FontFamily="{StaticResource iranSans}"
                    GlowBrush="{DynamicResource MahApps.Brushes.Accent}" 
                    Title="{Binding ElementName=root, Path=Ltxt_dialog_symbology_title}">                      
    <local:LocalizedMetroWindow.Resources>
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
    </local:LocalizedMetroWindow.Resources>
    <Grid x:Name="mainGrid" FlowDirection="{Binding Path=CurrentFlowDirection, Source={StaticResource Localization}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="30"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="Auto" MinWidth="30"/>
            <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>
        <mahApp:ColorPicker Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Margin="4" FlowDirection="LeftToRight" Width="230"
                            SelectedColor="{Binding Symbology.Fill, Mode=TwoWay, Converter={StaticResource solidColorBrushToColorConverter}}"
                            mahApp:TextBoxHelper.ClearTextButton="True"
                            mahApp:TextBoxHelper.Watermark="{Binding [dialog_symbology_fill], Source={StaticResource Localization}}"
                            mahApp:TextBoxHelper.UseFloatingWatermark="True"                            
                            mahApp:TextBoxHelper.WatermarkAlignment="Center"/> 
 
        <mahApp:ColorPicker Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="0" Margin="4" FlowDirection="LeftToRight" Width="230"
                            SelectedColor="{Binding Symbology.Stroke, Mode=TwoWay, Converter={StaticResource solidColorBrushToColorConverter}}"
                            mahApp:TextBoxHelper.Watermark="{Binding [dialog_symbology_stroke], Source={StaticResource Localization}}"
                            mahApp:TextBoxHelper.ClearTextButton="True" 
                            mahApp:TextBoxHelper.UseFloatingWatermark="True" 
                            mahApp:TextBoxHelper.WatermarkAlignment="Center"/> 

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="4"
                   Text="{Binding [dialog_symbology_strokeWidth], Source={StaticResource Localization}}"/>
         
        <mahApp:NumericUpDown Grid.Row="1" Grid.Column="1" HideUpDownButtons="True" Width="80" Margin="4" Minimum="0" 
                                mahApp:TextBoxHelper.SelectAllOnFocus="True" Value="{Binding Symbology.StrokeThickness, Mode=TwoWay}"/>
 
        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Height="32" Width="32" Margin="4" Cursor="Hand" HorizontalAlignment="Right" Command="{Binding CloseCommand}">
                <iconPacks:PackIconModern Kind="Close" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
            </Button>
            <Button Height="32" Width="32" Margin="4" Cursor="Hand" HorizontalAlignment="Right" Command="{Binding ApplyCommand}">
                <iconPacks:PackIconModern Kind="Check" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
            </Button>
        </StackPanel>
    </Grid>
</local:LocalizedMetroWindow>
