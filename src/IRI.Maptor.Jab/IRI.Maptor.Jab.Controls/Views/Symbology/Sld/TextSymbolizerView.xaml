<UserControl x:Class="IRI.Maptor.Jab.Controls.Views.Symbology.Sld.TextSymbolizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:sld="clr-namespace:IRI.Maptor.Sta.Ogc.SLD;assembly=IRI.Maptor.Sta.Ogc"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="350">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Label Property:" VerticalAlignment="Center" Margin="4"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="4" 
                     Text="{Binding LabelPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Font Family:" VerticalAlignment="Center" Margin="4"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="4" 
                      IsEditable="True"
                      Text="{Binding FontFamily, Mode=TwoWay}">
                <ComboBoxItem>Arial</ComboBoxItem>
                <ComboBoxItem>Times New Roman</ComboBoxItem>
                <ComboBoxItem>Courier New</ComboBoxItem>
                <ComboBoxItem>Verdana</ComboBoxItem>
                <ComboBoxItem>Georgia</ComboBoxItem>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Font Size:" VerticalAlignment="Center" Margin="4"/>
            <mahApp:NumericUpDown Grid.Row="2" Grid.Column="1" Margin="4" 
                                  Value="{Binding FontSize, Mode=TwoWay}" 
                                  Minimum="1" Maximum="100" Interval="1"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Font Style:" VerticalAlignment="Center" Margin="4"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="4" SelectedItem="{Binding FontStyle}">
                <ComboBox.ItemsSource>
                    <x:Array Type="{x:Type sld:Sld_FontStyle}">
                        <sld:Sld_FontStyle>Normal</sld:Sld_FontStyle>
                        <sld:Sld_FontStyle>Italic</sld:Sld_FontStyle>
                        <sld:Sld_FontStyle>Oblique</sld:Sld_FontStyle>
                    </x:Array>
                </ComboBox.ItemsSource>
            </ComboBox>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Font Weight:" VerticalAlignment="Center" Margin="4"/>
            <ComboBox Grid.Row="4" Grid.Column="1" Margin="4" SelectedItem="{Binding FontWeight}">
                <ComboBox.ItemsSource>
                    <x:Array Type="{x:Type sld:Sld_FontWeight}">
                        <sld:Sld_FontWeight>Normal</sld:Sld_FontWeight>
                        <sld:Sld_FontWeight>Bold</sld:Sld_FontWeight>
                    </x:Array>
                </ComboBox.ItemsSource>
            </ComboBox>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Font Color:" VerticalAlignment="Center" Margin="4"/>
            <mahApp:ColorPicker Grid.Row="5" Grid.Column="1" Margin="4" 
                                SelectedColor="{Binding FontColor, Mode=TwoWay}"/>

            <Separator Grid.Row="6" Grid.ColumnSpan="2" Margin="4,10"/>

            <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Margin="4" 
                      Content="Enable Halo (Text Outline)" 
                      IsChecked="{Binding EnableHalo, Mode=TwoWay}"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Halo Radius:" VerticalAlignment="Center" Margin="4"
                       IsEnabled="{Binding EnableHalo}"/>
            <mahApp:NumericUpDown Grid.Row="8" Grid.Column="1" Margin="4" 
                                  Value="{Binding HaloRadius, Mode=TwoWay}" 
                                  Minimum="0" Maximum="10" Interval="0.5"
                                  IsEnabled="{Binding EnableHalo}"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Halo Color:" VerticalAlignment="Center" Margin="4"
                       IsEnabled="{Binding EnableHalo}"/>
            <mahApp:ColorPicker Grid.Row="9" Grid.Column="1" Margin="4" 
                                SelectedColor="{Binding HaloColor, Mode=TwoWay}"
                                IsEnabled="{Binding EnableHalo}"/>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Geometry Property:" VerticalAlignment="Center" Margin="4"/>
            <TextBox Grid.Row="10" Grid.Column="1" Margin="4" 
                     Text="{Binding GeometryPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
    </ScrollViewer>
</UserControl>

