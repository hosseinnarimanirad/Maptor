<Window x:Class="IRI.Maptor.Jab.Controls.Views.Symbology.Sld.SldEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IRI.Maptor.Jab.Controls.Views.Symbology.Sld"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="SLD Style Editor" Height="750" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Command="{Binding ImportSldCommand}" ToolTip="Import SLD from File">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconModern Kind="FolderOpen" Margin="0,0,5,0"/>
                    <TextBlock Text="Import"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportSldCommand}" ToolTip="Export SLD to File">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconModern Kind="Save" Margin="0,0,5,0"/>
                    <TextBlock Text="Export"/>
                </StackPanel>
            </Button>
            <Separator/>
            <TextBlock Text="OGC SLD 1.0.0 Editor" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
        </ToolBar>

        <!-- Main Editor -->
        <local:SldEditorView Grid.Row="1" DataContext="{Binding}"/>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Rules: "/>
                    <Run Text="{Binding Rules.Count, Mode=OneWay}"/>
                    <Run Text=" | "/>
                    <Run Text="Selected: "/>
                    <Run Text="{Binding SelectedRule.Name, Mode=OneWay, FallbackValue='None'}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

