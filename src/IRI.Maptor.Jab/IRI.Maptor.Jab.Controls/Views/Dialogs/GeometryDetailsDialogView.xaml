<mahApp:MetroWindow x:Class="IRI.Maptor.Jab.Controls.Views.Dialogs.GeometryDetailsDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:views="clr-namespace:IRI.Maptor.Jab.Controls.Views"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:editors="clr-namespace:IRI.Maptor.Jab.Controls.Views"
        xmlns:presenters="clr-namespace:IRI.Maptor.Jab.Common.ViewModels.CoordinateEditor;assembly=IRI.Maptor.Jab.Common" 
        xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"
        Title="{Binding DialogTitle, RelativeSource={RelativeSource AncestorType=mahApp:MetroWindow}}"          
        ShowInTaskbar="False"
        SizeToContent="Height"
        GlowBrush="{DynamicResource MahApps.Brushes.Highlight}"                    
        MaxWidth="750"
        FlowDirection="{Binding Path=CurrentFlowDirection, Source={StaticResource Localization}}"
        WindowStartupLocation="CenterOwner"
        ShowMaxRestoreButton="True" 
        ShowCloseButton="True" 
        ShowMinButton="False"
        ShowTitleBar="True">
    <mahApp:MetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{TemplateBinding Content}"
               TextTrimming="CharacterEllipsis"
               VerticalAlignment="Center"
               Margin="8 0 8 0"
               FontWeight="Bold" />
        </DataTemplate>
    </mahApp:MetroWindow.TitleTemplate>
    <mahApp:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/IRI.Maptor.Jab.Common;component/Assets/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <Style TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource circleButtonPackIconMaterial}"/>
            <Style TargetType="iconPacks:PackIconModern" BasedOn="{StaticResource circleButtonPackIconModern}"/>

            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="mahApp:HeaderedControlHelper.HeaderFontSize" Value="12" />
            </Style>
            <Style x:Key="item" TargetType="TextBlock" >
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="FontFamily" Value="{StaticResource iranSans}"/>
            </Style>
        </ResourceDictionary>
    </mahApp:MetroWindow.Resources>

    <StackPanel Margin="4">

        <!-- Basic Information Section -->
        <GroupBox Grid.Row="0" Margin="0,0,0,2" Padding="4">
            <GroupBox.Header>
                <TextBlock Text="{Binding [dialog_geometryDetails_basicInfo], Source={StaticResource Localization}}" Foreground="White"
                           Style="{StaticResource item}" Margin="0"/>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource item}"
                           Text="{Binding [dialog_geometryDetails_geometryType], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" 
                           Text="{Binding GeometryType}" 
                           FontWeight="Bold" Margin="4" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource item}"
                           Text="{Binding [dialog_geometryDetails_dimension], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Dimension}" 
                           FontWeight="Bold" Margin="4" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource item}"
                           Text="{Binding [dialog_geometryDetails_numberOfPoints], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NumberOfPoints, Converter={StaticResource localizedNumberConverter}}" 
                           Margin="4" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource item}" 
                           Text="{Binding [dialog_geometryDetails_numberOfGeometries], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding NumberOfGeometries, Converter={StaticResource localizedNumberConverter}}" 
                           Margin="4" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource item}"
                           Text="{Binding [dialog_geometryDetails_utmZone], Source={StaticResource Localization}, StringFormat='{}{0}:'}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="4">
                    <TextBlock Text="{Binding UtmZone, TargetNullValue='N/A'}" 
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MahApps.Brushes.Accent}"
                               Visibility="{Binding SpansMultipleUtmZones, Converter={StaticResource boolToVisibilityConverter}}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="(همچنین: {0})">
                                <Binding Path="UtmZones" Converter="{StaticResource collectionToStringConverter}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Geometry Editor Section -->
        <Expander Grid.Row="1" Margin="0,0,0,8" Padding="8"
                      IsExpanded="True">
            <Expander.Header>
                <TextBlock Text="{Binding [dialog_geometryDetails_editCoordinates], Source={StaticResource Localization}}" Foreground="White"
               Style="{StaticResource item}" Margin="0" Cursor="Hand"/>
            </Expander.Header>
            <ContentControl Content="{Binding GeometryEditor}">
                <ContentControl.Resources>
                    <!--<DataTemplate DataType="{x:Type presenters:PointEditorViewModel}">
                            <editors:PointEditorView/>
                        </DataTemplate>-->
                    <DataTemplate DataType="{x:Type presenters:GeometryEditorViewModel}">
                        <editors:GeometryEditorView/>
                    </DataTemplate>
                    <!--<DataTemplate DataType="{x:Type presenters:PolygonEditorViewModel}">
                            <editors:PolygonEditorView/>
                        </DataTemplate>-->
                    <!--<DataTemplate DataType="{x:Type presenters:MultiPointEditorPresenter}">
                            <editors:MultiPointEditorView/>
                        </DataTemplate>-->
                    <!-- COMMENTED OUT: MultiLineStringEditorPresenter functionality merged into LineStringEditorPresenter -->
                    <!--<DataTemplate DataType="{x:Type presenters:MultiLineStringEditorPresenter}">
                        <editors:MultiLineStringEditorView/>
                    </DataTemplate>-->
                    <!--<DataTemplate DataType="{x:Type presenters:MultiPolygonEditorPresenter}">
                            <editors:MultiPolygonEditorView/>
                        </DataTemplate>-->
                </ContentControl.Resources>
            </ContentControl>
        </Expander>

        <!-- Format Display Section -->
        <Expander Grid.Row="2" Margin="0,0,0,8" Padding="8" IsExpanded="False">
            <Expander.Header>
                <TextBlock Text="{Binding [dialog_geometryDetails_format], Source={StaticResource Localization}}" Foreground="White"
                            Style="{StaticResource item}" Margin="0" Cursor="Hand"/>
            </Expander.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [dialog_geometryDetails_format], Source={StaticResource Localization}, StringFormat='{}{0}:'}" 
                           Margin="4" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableFormats}" FlowDirection="LeftToRight"
                          SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" 
                          Margin="4" HorizontalAlignment="Stretch"/>
                <Button Grid.Row="0" Grid.Column="2" 
                        ToolTip="{Binding [dialog_geometryDetails_export], Source={StaticResource Localization}}"  
                        Style="{StaticResource circleButtonLight}"
                        Visibility="Collapsed">
                    <iconPacks:PackIconModern Kind="Save"/>
                </Button>
                <Button Grid.Row="0" Grid.Column="3" Command="{Binding CopySelectedFormat}"
                         ToolTip="{Binding [dialog_geometryDetails_copy], Source={StaticResource Localization}}"  
                         Style="{StaticResource circleButtonLight}">
                    <iconPacks:PackIconModern Kind="PageCopy"/>
                </Button>
                <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" FlowDirection="LeftToRight" 
                              VerticalScrollBarVisibility="Auto" MaxHeight="150" Margin="0" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding StringRepresentation}" HorizontalAlignment="Stretch" Background="#EEEEEE"
                               TextWrapping="Wrap" Padding="4" MaxWidth="700"
                               FontFamily="Consolas" FontSize="11"/>
                </ScrollViewer>
            </Grid>
        </Expander>

        <!-- Save/Cancel Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button ToolTip="{Binding [dialog_common_cancel], Source={StaticResource Localization}}" 
                        Command="{Binding CancelEditingCommand}" Margin="4" 
                        Style="{StaticResource circleButtonLight}">
                <iconPacks:PackIconModern Kind="Close"/>
            </Button>
            <Button ToolTip="{Binding [dialog_common_save], Source={StaticResource Localization}}" 
                        Command="{Binding SaveGeometryCommand}" Margin="4"  
                        Style="{StaticResource circleButtonLight}">
                <iconPacks:PackIconModern Kind="Check"/>
            </Button>
        </StackPanel>


    </StackPanel>

</mahApp:MetroWindow>

