<mahApp:MetroWindow x:Class="IRI.Maptor.Jab.Controls.Views.Dialogs.GeometryDetailsDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:views="clr-namespace:IRI.Maptor.Jab.Controls.Views"
        Title="{Binding DialogTitle, RelativeSource={RelativeSource AncestorType=mahApp:MetroWindow}}" 
        FlowDirection="RightToLeft" 
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" 
        MinWidth="600" 
        MinHeight="400"
        MaxWidth="1200"
        MaxHeight="800"
        WindowStartupLocation="CenterOwner"
        ShowMaxRestoreButton="True" 
        ShowCloseButton="True" 
        ShowMinButton="False"
        ShowTitleBar="True">
    <Grid>
        <views:GeometryDetailsView x:Name="GeometryDetailsViewControl"
                                   RequestZoomToPoint="GeometryDetailsView_RequestZoomToPoint"/>
    </Grid>
</mahApp:MetroWindow>

