<mahApp:MetroWindow x:Class="IRI.Maptor.Jab.Controls.Views.Dialogs.ThemeSelectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"
             mc:Ignorable="d" 
             FlowDirection="{Binding CurrentFlowDirection, Source={StaticResource Localization}}"
             FontFamily="{StaticResource iranSans}"
             Title="{Binding [dialog_themeSelection_windowTitle], Source={StaticResource Localization}}"
             ShowInTaskbar="False"
             ResizeMode="NoResize"
             SizeToContent="WidthAndHeight"
             WindowStartupLocation="CenterOwner"
             WindowStyle="ToolWindow"
             Height="Auto" Width="600" Padding="0">
    <mahApp:MetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{TemplateBinding Content}"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center"
                 Margin="8,0"
                 FontWeight="Light" />
        </DataTemplate>
    </mahApp:MetroWindow.TitleTemplate>
    <mahApp:MetroWindow.Resources>
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="4,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- DataTemplate for theme items -->
        <DataTemplate x:Key="ThemeItemTemplate">
            <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=mahApp:MetroWindow}}"
                    CommandParameter="{Binding}"
                    VerticalAlignment="Center"
                    Width="50" Height="50"
                    Margin="0"
                    Padding="0"
                    Cursor="Hand"
                    BorderThickness="0"
                    Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ThemeBorder" Background="{Binding AccentColor}" CornerRadius="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                            <Setter Property="BorderThickness" Value="5"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                            <Setter Property="BorderThickness" Value="5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ToolTip>
                                <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                            </Border.ToolTip>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </mahApp:MetroWindow.Resources>

    <Grid Margin="0" MinWidth="550">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Separator Margin="0"/>

        <GroupBox Grid.Row="1" Margin="0">
            <GroupBox.Header>
                <TextBlock Text="{Binding [dialog_themeSelection_title], Source={StaticResource Localization}}" FontSize="14" Margin="4" Foreground="White"/>
            </GroupBox.Header>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400" Grid.Row="1" Margin="4">
                <ItemsControl x:Name="ThemesItemsControl" FlowDirection="LeftToRight"
                              ItemsSource="{Binding AvailableThemes}"
                              ItemTemplate="{StaticResource ThemeItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="11" Rows="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="8">
            <Button x:Name="CancelButton" Command="{Binding CancelCommand}" Cursor="Hand"
                     Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs}"
                     MinWidth="100">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CloseThick" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [dialog_common_cancel], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="2,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="SaveButton" Command="{Binding SaveCommand}"
                    Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Accent}"
                    MinWidth="100" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CheckBold" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="{Binding [dialog_common_save], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="2,0" />
                </StackPanel>
            </Button>
            
          
        </StackPanel>
    </Grid>
</mahApp:MetroWindow>
