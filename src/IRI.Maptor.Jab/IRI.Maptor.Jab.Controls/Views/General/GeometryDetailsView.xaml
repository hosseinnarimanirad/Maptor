<UserControl x:Class="IRI.Maptor.Jab.Controls.Views.GeometryDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IRI.Maptor.Jab.Controls.Views.General"
             xmlns:editors="clr-namespace:IRI.Maptor.Jab.Controls.Views.General.CoordinateEditors"
             xmlns:presenters="clr-namespace:IRI.Maptor.Jab.Controls.Presenters.CoordinateEditors"
             xmlns:converters="clr-namespace:IRI.Maptor.Jab.Controls.Views.General.Converters"
             xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"
             FlowDirection="RightToLeft"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/IRI.Maptor.Jab.Common;component/Assets/IRI.Converters.xaml"/>
                <ResourceDictionary Source="/IRI.Maptor.Jab.Common;component/Assets/IRI.Fonts.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <converters:CollectionToStringConverter x:Key="collectionToStringConverter"/>
            <converters:CoordinateDimensionToZVisibilityConverter x:Key="coordinateDimensionToZVisibilityConverter"/>
            <converters:CoordinateDimensionToMVisibilityConverter x:Key="coordinateDimensionToMVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Basic Information Section -->
            <GroupBox Grid.Row="0" Header="{Binding LBasicInfo, FallbackValue='اطلاعات پایه'}" Margin="0,0,0,8" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LGeometryType, StringFormat='{}{0}:'}" Margin="4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GeometryType}" 
                               FontWeight="Bold" Margin="4" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LDimension, StringFormat='{}{0}:'}" Margin="4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Dimension}" 
                               FontWeight="Bold" Margin="4" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LNumberOfPoints, StringFormat='{}{0}:'}" Margin="4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NumberOfPoints}" 
                               Margin="4" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LNumberOfGeometries, StringFormat='{}{0}:'}" Margin="4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding NumberOfGeometries}" 
                               Margin="4" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LUtmZone, StringFormat='{}{0}:'}" Margin="4" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="4">
                        <TextBlock Text="{Binding UtmZone, TargetNullValue='N/A'}" 
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                   Visibility="{Binding SpansMultipleUtmZones, Converter={StaticResource boolToVisibilityConverter}}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="(همچنین: {0})">
                                    <Binding Path="UtmZones" Converter="{StaticResource collectionToStringConverter}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Points Section -->
            <GroupBox Grid.Row="1" Header="{Binding LPoints, StringFormat='{}{0} (WGS84 Geodetic)', FallbackValue='نقاط (طول و عرض جغرافیایی WGS84)'}" Margin="0,0,0,8" Padding="8">
                <DataGrid ItemsSource="{Binding Points}" AutoGenerateColumns="False" 
                          IsReadOnly="True" CanUserSortColumns="False" 
                          AlternatingRowBackground="LightBlue" GridLinesVisibility="All"
                          HeadersVisibility="Column" MaxHeight="300">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="X (طول جغرافیایی)" Binding="{Binding X, StringFormat=F8}" 
                                            Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Y (عرض جغرافیایی)" Binding="{Binding Y, StringFormat=F8}" 
                                            Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat=F4}" 
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.Visibility>
                                <Binding Path="DataContext.Dimension" RelativeSource="{RelativeSource AncestorType=UserControl}" 
                                         Converter="{StaticResource coordinateDimensionToZVisibilityConverter}"/>
                            </DataGridTextColumn.Visibility>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="M" Binding="{Binding M, StringFormat=F4}" 
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.Visibility>
                                <Binding Path="DataContext.Dimension" RelativeSource="{RelativeSource AncestorType=UserControl}" 
                                         Converter="{StaticResource coordinateDimensionToMVisibilityConverter}"/>
                            </DataGridTextColumn.Visibility>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Format Display Section -->
            <Expander Grid.Row="2" Header="{Binding LFormats, FallbackValue='فرمت‌های هندسه'}" Margin="0,0,0,8" IsExpanded="False">
                <TabControl>
                    <TabItem Header="WKT">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="{Binding LExport, FallbackValue='Export'}" Command="{Binding ExportWktCommand}" 
                                    HorizontalAlignment="Right" Margin="4"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Text="{Binding Wkt}" IsReadOnly="True" TextWrapping="Wrap" 
                                         FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="WKB">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="{Binding LExport, FallbackValue='Export'}" Command="{Binding ExportWkbCommand}" 
                                    HorizontalAlignment="Right" Margin="4"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Text="{Binding Wkb}" IsReadOnly="True" TextWrapping="Wrap" 
                                         FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="SQL Server WKT">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="Export" Command="{Binding ExportSqlServerWktCommand}" 
                                    HorizontalAlignment="Right" Margin="4"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Text="{Binding SqlServerWkt}" IsReadOnly="True" TextWrapping="Wrap" 
                                         FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="SQL Server Native Binary">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="Export" Command="{Binding ExportSqlServerNativeBinaryCommand}" 
                                    HorizontalAlignment="Right" Margin="4"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Text="{Binding SqlServerNativeBinary}" IsReadOnly="True" TextWrapping="Wrap" 
                                         FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="GeoJSON">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="Export" Command="{Binding ExportGeoJsonCommand}" 
                                    HorizontalAlignment="Right" Margin="4"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Text="{Binding GeoJson}" IsReadOnly="True" TextWrapping="Wrap" 
                                         FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="GML 2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="Export" Command="{Binding ExportGml2Command}" 
                                    HorizontalAlignment="Right" Margin="4"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Text="{Binding Gml2}" IsReadOnly="True" TextWrapping="Wrap" 
                                         FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="GML 3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="Export" Command="{Binding ExportGml3Command}" 
                                    HorizontalAlignment="Right" Margin="4"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Text="{Binding Gml3}" IsReadOnly="True" TextWrapping="Wrap" 
                                         FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="KML">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="Export" Command="{Binding ExportKmlCommand}" 
                                    HorizontalAlignment="Right" Margin="4"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Text="{Binding Kml}" IsReadOnly="True" TextWrapping="Wrap" 
                                         FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Esri JSON Geometry">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="Export" Command="{Binding ExportEsriJsonGeometryCommand}" 
                                    HorizontalAlignment="Right" Margin="4"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Text="{Binding EsriJsonGeometry}" IsReadOnly="True" TextWrapping="Wrap" 
                                         FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="TopoJSON">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="Export" Command="{Binding ExportTopoJsonCommand}" 
                                    HorizontalAlignment="Right" Margin="4"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Text="{Binding TopoJson}" IsReadOnly="True" TextWrapping="Wrap" 
                                         FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="DXF">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="Export" Command="{Binding ExportDxfCommand}" 
                                    HorizontalAlignment="Right" Margin="4"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Text="{Binding Dxf}" IsReadOnly="True" TextWrapping="Wrap" 
                                         FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Expander>

            <!-- Geometry Editor Section -->
            <GroupBox Grid.Row="3" Header="{Binding LEditCoordinates, FallbackValue='ویرایش مختصات'}" Margin="0,0,0,8" Padding="8">
                <ContentControl Content="{Binding GeometryEditor}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type presenters:PointEditorPresenter}">
                            <editors:PointEditorView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type presenters:LineStringEditorPresenter}">
                            <editors:LineStringEditorView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type presenters:PolygonEditorPresenter}">
                            <editors:PolygonEditorView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type presenters:MultiPointEditorPresenter}">
                            <editors:MultiPointEditorView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type presenters:MultiLineStringEditorPresenter}">
                            <editors:MultiLineStringEditorView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type presenters:MultiPolygonEditorPresenter}">
                            <editors:MultiPolygonEditorView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </GroupBox>

            <!-- Save/Cancel Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{Binding LSave, FallbackValue='Save'}" Command="{Binding SaveGeometryCommand}" Margin="4" 
                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                        Visibility="{Binding IsEditing, Converter={StaticResource boolToVisibilityConverter}}"/>
                <Button Content="{Binding LCancel, FallbackValue='Cancel'}" Command="{Binding CancelEditingCommand}" Margin="4" 
                        Style="{DynamicResource MahApps.Styles.Button.Square}"
                        Visibility="{Binding IsEditing, Converter={StaticResource boolToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

