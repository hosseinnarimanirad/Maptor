<UserControl x:Class="IRI.Maptor.Jab.Controls.Views.GeometryDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" 
             xmlns:editors="clr-namespace:IRI.Maptor.Jab.Controls.Views.General.CoordinateEditors"
             xmlns:presenters="clr-namespace:IRI.Maptor.Jab.Controls.Presenters.CoordinateEditors"
             xmlns:converters="clr-namespace:IRI.Maptor.Jab.Controls.Views.General.Converters"
             xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"
             FlowDirection="RightToLeft" MinWidth="700"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/IRI.Maptor.Jab.Common;component/Assets/IRI.Converters.xaml"/>
                <ResourceDictionary Source="/IRI.Maptor.Jab.Common;component/Assets/IRI.Fonts.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <converters:CollectionToStringConverter x:Key="collectionToStringConverter"/>
            <converters:CoordinateDimensionToZVisibilityConverter x:Key="coordinateDimensionToZVisibilityConverter"/>
            <converters:CoordinateDimensionToMVisibilityConverter x:Key="coordinateDimensionToMVisibilityConverter"/>
            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="mahApp:HeaderedControlHelper.HeaderFontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8"> 

            <!-- Basic Information Section -->
            <GroupBox Grid.Row="0" Header="{Binding [dialog_geometryDetails_basicInfo], Source={StaticResource Localization}}" Margin="0,0,0,8" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [dialog_geometryDetails_geometryType], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GeometryType}" 
                               FontWeight="Bold" Margin="4" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding [dialog_geometryDetails_dimension], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Dimension}" 
                               FontWeight="Bold" Margin="4" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [dialog_geometryDetails_numberOfPoints], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NumberOfPoints}" 
                               Margin="4" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding [dialog_geometryDetails_numberOfGeometries], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding NumberOfGeometries}" 
                               Margin="4" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [dialog_geometryDetails_utmZone], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="4" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="4">
                        <TextBlock Text="{Binding UtmZone, TargetNullValue='N/A'}" 
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                   Visibility="{Binding SpansMultipleUtmZones, Converter={StaticResource boolToVisibilityConverter}}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="(همچنین: {0})">
                                    <Binding Path="UtmZones" Converter="{StaticResource collectionToStringConverter}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </GroupBox>
 
            <!-- Geometry Editor Section -->
            <GroupBox Grid.Row="1" Header="{Binding [dialog_geometryDetails_editCoordinates], Source={StaticResource Localization}}" Margin="0,0,0,8" Padding="8">
                <ContentControl Content="{Binding GeometryEditor}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type presenters:PointEditorPresenter}">
                            <editors:PointEditorView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type presenters:LineStringEditorPresenter}">
                            <editors:LineStringEditorView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type presenters:PolygonEditorPresenter}">
                            <editors:PolygonEditorView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type presenters:MultiPointEditorPresenter}">
                            <editors:MultiPointEditorView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type presenters:MultiLineStringEditorPresenter}">
                            <editors:MultiLineStringEditorView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type presenters:MultiPolygonEditorPresenter}">
                            <editors:MultiPolygonEditorView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </GroupBox>

            <!-- Format Display Section -->
            <GroupBox Grid.Row="2" Header="{Binding [dialog_geometryDetails_format], Source={StaticResource Localization}}" Margin="0,0,0,8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [dialog_geometryDetails_format], Source={StaticResource Localization}, StringFormat='{}{0}:'}" 
                               Margin="4" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableFormats}" FlowDirection="LeftToRight"
                              SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" 
                              Margin="4" HorizontalAlignment="Stretch"/>
                    <Button Grid.Row="0" Grid.Column="2" 
                            Content="{Binding [dialog_geometryDetails_export], Source={StaticResource Localization}}" 
                            Command="{Binding ExportCommand}" 
                            Margin="4"
                            Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>

                    <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" FlowDirection="LeftToRight" 
                                  VerticalScrollBarVisibility="Auto" MaxHeight="200" Margin="0" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding StringRepresentation}" HorizontalAlignment="Stretch" Background="LightGray"
                                   TextWrapping="Wrap"   Padding="4"
                                   FontFamily="Consolas" FontSize="11"/>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <!-- Save/Cancel Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{Binding [dialog_geometryDetails_save], Source={StaticResource Localization}}" 
                        Command="{Binding SaveGeometryCommand}" Margin="4" 
                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                <Button Content="{Binding [dialog_geometryDetails_cancel], Source={StaticResource Localization}}" 
                        Command="{Binding CancelEditingCommand}" Margin="4" 
                        Style="{DynamicResource MahApps.Styles.Button.Square}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

