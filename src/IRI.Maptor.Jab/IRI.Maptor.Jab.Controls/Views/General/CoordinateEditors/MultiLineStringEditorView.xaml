<UserControl x:Class="IRI.Maptor.Jab.Controls.Views.General.CoordinateEditors.MultiLineStringEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:IRI.Maptor.Jab.Controls.Views.General.CoordinateEditors"
             FlowDirection="RightToLeft"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <Button Content="Add Part" Command="{Binding AddPartCommand}" 
                    Margin="4" HorizontalAlignment="Right"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
            <ItemsControl ItemsSource="{Binding Parts}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,4,0,0">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Header, StringFormat='Part {0}'}"/>
                                    <Button Grid.Column="1" Command="{Binding DataContext.DeletePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Margin="4,0,0,0" Padding="4">
                                        <iconPacks:PackIconModern Kind="Delete" Width="16" Height="16" 
                                                                  Foreground="{StaticResource MahApps.Brushes.Accent}"/>
                                    </Button>
                                </Grid>
                            </Expander.Header>
                            <local:LineStringEditorView DataContext="{Binding}"/>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

