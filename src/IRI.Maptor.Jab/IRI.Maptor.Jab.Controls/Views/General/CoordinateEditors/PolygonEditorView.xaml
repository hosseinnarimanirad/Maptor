<UserControl x:Class="IRI.Maptor.Jab.Controls.Views.General.CoordinateEditors.PolygonEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:IRI.Maptor.Jab.Controls.Views.General.CoordinateEditors"
             xmlns:presenters="clr-namespace:IRI.Maptor.Jab.Controls.Presenters.CoordinateEditors"
             FlowDirection="RightToLeft"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Exterior Ring -->
            <Expander Header="Exterior Ring" IsExpanded="True" Margin="0,0,0,8">
                <local:LineStringEditorView x:Name="ExteriorRingEditor"/>
            </Expander>

            <!-- Interior Rings -->
            <Expander Header="Interior Rings" IsExpanded="False" Margin="0,0,0,8">
                <StackPanel>
                    <Button Content="Add Interior Ring" Command="{Binding AddInteriorRingCommand}" 
                            Margin="4" HorizontalAlignment="Right"
                            Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                    <ItemsControl ItemsSource="{Binding InteriorRings}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,4,0,0">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Header, StringFormat='Interior Ring {0}'}"/>
                                            <Button Grid.Column="1" Command="{Binding DataContext.DeleteRingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Margin="4,0,0,0" Padding="4">
                                                <iconPacks:PackIconModern Kind="Delete" Width="16" Height="16" 
                                                                          Foreground="{StaticResource MahApps.Brushes.Accent}"/>
                                            </Button>
                                        </Grid>
                                    </Expander.Header>
                                    <local:LineStringEditorView>
                                        <local:LineStringEditorView.DataContext>
                                            <presenters:LineStringEditorPresenter Points="{Binding Points}"/>
                                        </local:LineStringEditorView.DataContext>
                                    </local:LineStringEditorView>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>

