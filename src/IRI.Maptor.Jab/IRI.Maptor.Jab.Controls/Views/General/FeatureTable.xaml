<UserControl x:Class="IRI.Maptor.Jab.Controls.Views.FeatureTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:model="clr-namespace:IRI.Maptor.Jab.Common.Models;assembly=IRI.Maptor.Jab.Common"
             xmlns:local ="clr-namespace:IRI.Maptor.Jab.Controls.Common.Behaviors" 
             xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             x:Name="root" Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type model:FeatureTableToggleCommand}">
                <ToggleButton Focusable="False" ToolTip="{Binding ToolTip}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                Style="{StaticResource circleToggleButtonLight}"
                                Visibility="{Binding IsCommandVisible, Converter={StaticResource boolToVisibilityConverter}}">
                    <!--<ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                            <Setter Property="Width" Value="24"/>
                            <Setter Property="Height" Value="24"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Grid>
                                            <Ellipse Margin="1" Fill="{TemplateBinding Property=Background}"/>
                                            <ContentPresenter/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="LightGray"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>-->
                    <Path Stretch="Uniform" Width="18" Height="18" FlowDirection="LeftToRight" Margin="0"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton, Mode=FindAncestor}}" >
                        <Path.Style>
                            <Style TargetType="{x:Type Path}" >
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton, Mode=FindAncestor}}" Value="True">
                                        <Setter Property="Data" Value="{Binding PathMarkup}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton, Mode=FindAncestor}}" Value="False">
                                        <Setter Property="Data" Value="{Binding NotCheckedPathMarkup}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </ToggleButton>
            </DataTemplate>
            <DataTemplate DataType="{x:Type model:FeatureTableCommand}">
                <Button Style="{StaticResource circleButtonLight}" 
                        Command="{Binding Command}" IsEnabled="{Binding IsEnabled}" 
                        CommandParameter="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor} }" 
                        ToolTip="{Binding ToolTip}"
                        Visibility="{Binding IsCommandVisible, Converter={StaticResource boolToVisibilityConverter}}">
                        <Path Data="{Binding PathMarkup}" Fill="White" Stretch="Uniform" FlowDirection="LeftToRight" Margin="0"
                              Width="18" Height="18" />
                </Button> 
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--<DataGrid ItemsSource="{Binding Features}" AutoGenerateColumns="True" AutoGeneratingColumn="RadGridView_AutoGeneratingColumn"
                                ShowGroupPanel="False" IsReadOnly="{Binding ElementName=root, Path=CanUserEditAttribute, Converter={StaticResource notConverter}}" 
                             x:Name="grid" telerik:StyleManager.Theme="Office2019" SelectionMode="Extended" SelectionChanged="grid_SelectionChanged"
                                RowEditEnded="grid_RowEditEnded" MouseDoubleClick="grid_MouseDoubleClick">-->
        <DataGrid x:Name="grid" BorderThickness="1" ItemsSource="{Binding Features}" AutoGenerateColumns="False" SelectionMode="Extended" 
                    IsReadOnly="{Binding ElementName=root, Path=CanUserEditAttribute, Converter={StaticResource notConverter}}" 
                    SelectionChanged="grid_SelectionChanged" CellEditEnding="grid_CellEditEnding" EnableColumnVirtualization="False"
                    AddingNewItem="grid_AddingNewItem" MouseDoubleClick="grid_MouseDoubleClick" DataContextChanged="grid_DataContextChanged"
                    dgx:DataGridFilter.IsAutoFilterEnabled="True" SelectionUnit="FullRow" Background="Transparent"
                    local:DataGridDictionaryBehavior.GenerateColumnsFromDictionary="True" RowHeight="10">  
        </DataGrid>
        <DockPanel Grid.Row="1" HorizontalAlignment="Stretch" LastChildFill="False"
            Visibility="{Binding ElementName=root, Path=IsMouseOver, Converter={StaticResource boolToVisibilityConverter}}">
              
            <!--<telerik:RadDataPager DisplayMode="FirstLastPreviousNextNumeric,Text" IsTotalItemCountFixed="True"
                              Source="{Binding ElementName=grid, Path=Items}" PageSize="50" PageIndex="0" 
                              telerik:StyleManager.Theme="Office2016" BorderThickness="0" DockPanel.Dock="Right">
            </telerik:RadDataPager>-->
            <TextBlock MinWidth="50"
                       VerticalAlignment="Center" FontFamily="{StaticResource iranSans}"
                       DockPanel.Dock="Left" Margin="4">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{1} - {0}">
                        <Binding ElementName="grid" Path="Items.Count" Converter="{StaticResource localizedNumberConverter}"/>
                        <Binding ElementName="grid" Path="SelectedItems.Count" Converter="{StaticResource localizedNumberConverter}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Button Command="{Binding EditCommand}"
                    Style="{StaticResource circleButtonLight}"
                    IsEnabled="{Binding IsSingleValueHighlighted}"
                    Visibility="{Binding ElementName=root, Path=CanUserEditGeometry, Converter={StaticResource boolToVisibilityConverter}}"  >
                <iconPacks:PackIconModern Kind="Edit" Foreground="White" FlowDirection="LeftToRight"/>
            </Button>
            <Button Command="{Binding SaveCommand}"
                    Style="{StaticResource circleButtonLight}" 
                    Visibility="{Binding ElementName=root, Path=CanUserEditGeometry, Converter={StaticResource boolToVisibilityConverter}}">
                <iconPacks:PackIconModern Kind="Save" Foreground="White" FlowDirection="LeftToRight"/>
            </Button>
            <ItemsControl ItemsSource="{Binding AssociatedLayer.FeatureTableCommands}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>
    </Grid>
</UserControl>