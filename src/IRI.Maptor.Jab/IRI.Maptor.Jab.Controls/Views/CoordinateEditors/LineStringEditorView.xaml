<UserControl x:Class="IRI.Maptor.Jab.Controls.Views.General.CoordinateEditors.LineStringEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:converters="clr-namespace:IRI.Maptor.Jab.Common.Assets.Converters;assembly=IRI.Maptor.Jab.Common"
             xmlns:views="clr-namespace:IRI.Maptor.Jab.Controls.Views"
             FlowDirection="RightToLeft"
             mc:Ignorable="d" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="2">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/IRI.Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:CoordinateDisplayConverter x:Key="coordinateDisplayConverter"/>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <Style TargetType="{x:Type Button}" x:Key="circleButton">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Opacity" Value="0.9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Ellipse x:Name="ellipse" 
                                         Margin="1" 
                                         Fill="{TemplateBinding Property=Background}"
                                         Stroke="{TemplateBinding Property=BorderBrush}"
                                         StrokeThickness="{TemplateBinding Property=BorderThickness}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.2" Color="Black"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"> 
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Effect" TargetName="ellipse">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1.5" Opacity="0.6" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger> 
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="iconPacks:PackIconModern">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="Opacity" Value="0.9"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="LightGray"/> 
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="iconPacks:PackIconMaterial">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="Opacity" Value="0.9"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="LightGray"/> 
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type ToggleButton}" x:Key="circleToggleButton">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Opacity" Value="0.9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Grid>
                                <Ellipse x:Name="ellipse" 
                                         Margin="1" 
                                         Fill="{TemplateBinding Property=Background}"
                                         Stroke="{TemplateBinding Property=BorderBrush}"
                                         StrokeThickness="{TemplateBinding Property=BorderThickness}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.2" Color="Black"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent4}" TargetName="ellipse"/>
                                    <Setter Property="Stroke" Value="{DynamicResource MahApps.Brushes.Highlight}" TargetName="ellipse"/>
                                    <Setter Property="Effect" TargetName="ellipse">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1.5" Opacity="0.4" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Fill" Value="#D0D0D0" TargetName="ellipse"/>
                                    <Setter Property="Effect" TargetName="ellipse">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="1" ShadowDepth="0.5" Opacity="0.1" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Fill" Value="#F0F0F0" TargetName="ellipse"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Effect" TargetName="ellipse">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1.5" Opacity="0.3" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent2}" TargetName="ellipse"/>
                                    <Setter Property="Stroke" Value="{DynamicResource MahApps.Brushes.Accent2}" TargetName="ellipse"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Fill" Value="#CCCCCC" TargetName="ellipse"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
            <TextBlock Text="Geometry Parts" VerticalAlignment="Center" FontWeight="Bold" Margin="0,4,10,4"/>
            <Button Style="{StaticResource circleButton}" 
                            Command="{Binding GoToPreviousPartCommand}"
                            IsEnabled="{Binding IsPreviousPartAvailable}">
                <iconPacks:PackIconMaterial Kind="ChevronLeft"/>
            </Button>
            <Button Style="{StaticResource circleButton}" 
                            Command="{Binding GoToNextPartCommand}"
                            IsEnabled="{Binding IsNextPartAvailable}">
                <iconPacks:PackIconMaterial Kind="ChevronRight"/>
            </Button>
            <Button Style="{StaticResource circleButton}" 
                            Command="{Binding AddPartCommand}">
                <iconPacks:PackIconMaterial Kind="ShapePolygonPlus"/>
            </Button>
            <Button Style="{StaticResource circleButton}" 
                            Command="{Binding DeletePartCommand}"
                            CommandParameter="{Binding CurrentPart}"
                            IsEnabled="{Binding CurrentPart, Converter={StaticResource notNullToBoolConverter}}">
                <iconPacks:PackIconModern Kind="Delete"/>
            </Button>
            <Button Style="{StaticResource circleButton}" 
                            Command="{Binding ZoomToCurrentPartCommand}"
                            IsEnabled="{Binding CurrentPart, Converter={StaticResource notNullToBoolConverter}}">
                <iconPacks:PackIconModern Kind="MagnifyAdd"/>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" 
                                    TextBlock.TextAlignment="Right" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text">
                                <Setter.Value>
                                    <MultiBinding StringFormat="Part {0} of {1}">
                                        <Binding Path="CurrentPartNumber"/>
                                        <Binding Path="TotalPartCount"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalPartCount}" Value="0">
                                    <Setter Property="Text" Value="No parts"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" FontStyle="Italic" Margin="0,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value=""/>
                            <Setter Property="Foreground" Value="Green"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPartIsValid}" Value="True">
                                    <Setter Property="Text" Value="✓ Valid"/>
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPartIsValid}" Value="False">
                                    <Setter Property="Text" Value="✗ Invalid"/>
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- SRS Selection and Current Point Editor Section -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="0,1,0,0" Padding="4" Margin="0,0,0,4">
            <Grid>
                <StackPanel>
                    <!-- Current Point Editor -->
                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                        <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,4,0" Width="20"/>
                        <!-- DMS Mode: Use DegreeMinuteSecondView -->
                        <views:DegreeMinuteSecondView x:Name="dmsXView" DataContext="{Binding CurrentPointEditor.DmsX}" 
                                                      MaxDegreeValue="180" MinDegreeValue="-180" 
                                                      HideUpDownButtons="False" Margin="0,0,8,0"
                                                      Visibility="{Binding DataContext.CurrentPointEditor.IsDmsMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource boolToVisibilityConverter}}"/>
                        <!-- Non-DMS Mode: Use TextBox -->
                        <TextBox Text="{Binding CurrentPointEditor.CoordinateX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                 Visibility="{Binding CurrentPointEditor.IsDmsMode, Converter={StaticResource boolToInverseVisibilityConverter}}"
                                 Width="150" Margin="0,0,8,0" FlowDirection="LeftToRight" VerticalAlignment="Center"
                                 mahApp:TextBoxHelper.SelectAllOnFocus="True"/>
                        <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0" Width="20"/>
                        <!-- DMS Mode: Use DegreeMinuteSecondView -->
                        <views:DegreeMinuteSecondView DataContext="{Binding CurrentPointEditor.DmsY}" 
                                                      MaxDegreeValue="90" MinDegreeValue="-90"
                                                      HideUpDownButtons="False" Margin="0,0,8,0"
                                                      Visibility="{Binding DataContext.CurrentPointEditor.IsDmsMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource boolToVisibilityConverter}}"/>
                        <!-- Non-DMS Mode: Use TextBox -->
                        <TextBox Text="{Binding CurrentPointEditor.CoordinateY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                 Visibility="{Binding CurrentPointEditor.IsDmsMode, Converter={StaticResource boolToInverseVisibilityConverter}}"
                                 Width="150" Margin="0,0,8,0" FlowDirection="LeftToRight" VerticalAlignment="Center"
                                 mahApp:TextBoxHelper.SelectAllOnFocus="True"/>
                        <Button Style="{StaticResource circleButton}"
                                Command="{Binding ApplyCurrentPointChangesCommand}" 
                                IsEnabled="{Binding CurrentPointEditor, Converter={StaticResource notNullToBoolConverter}}"
                                Margin="8,0,0,0">
                            <iconPacks:PackIconMaterial Kind="Check"/>
                        </Button>
                        <ToggleButton x:Name="srsConfigToggleButton" Style="{StaticResource circleToggleButton}" Margin="8,0,0,0">
                            <iconPacks:PackIconMaterial Kind="Cog"/>
                        </ToggleButton>
                    </StackPanel>
                    <!-- SRS Info TextBlock -->
                    <TextBlock VerticalAlignment="Center" Margin="4,4,0,0" FontStyle="Italic" Foreground="Gray" FontSize="11">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="SRS: {0}{1}{2}">
                                <Binding Path="SrsViewModel.SelectedSrsType"/>
                                <Binding Path="SrsViewModel.SelectedEllipsoid" Converter="{StaticResource ellipsoidNameConverter}"/>
                                <Binding Path="SrsViewModel.UtmZone" Converter="{StaticResource utmZoneConverter}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                
                <!-- SRS Configuration Popup -->
                <Popup x:Name="srsConfigPopup" 
                       IsOpen="{Binding IsChecked, ElementName=srsConfigToggleButton}"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=srsConfigToggleButton}"
                       StaysOpen="False"
                       PopupAnimation="Slide"
                       AllowsTransparency="True">
                    <Border Background="White" 
                            BorderBrush="{DynamicResource MahApps.Brushes.Accent}" 
                            BorderThickness="1" 
                            Padding="8"
                            CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="Gray" Opacity="0.5" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Vertical" FlowDirection="LeftToRight" MinWidth="200">
                            <TextBlock Text="SRS Configuration" FontWeight="Bold" Margin="0,0,0,8"/>
                            <!-- SRS Type -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="SRS:" VerticalAlignment="Center" Margin="0,0,4,0" Width="80"/>
                                <ComboBox ItemsSource="{Binding SrsViewModel.AvailableSrsTypes}" 
                                          SelectedItem="{Binding SrsViewModel.SelectedSrsType, Mode=TwoWay}" 
                                          Width="150">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial 
                                                    Kind="{Binding Converter={StaticResource srsTypeToIconConverter}}" 
                                                    Width="16" Height="16" 
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Converter={StaticResource srsTypeToDescriptionConverter}}" 
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <!-- Ellipsoid -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding SrsViewModel.IsEllipsoidVisible, Converter={StaticResource boolToVisibilityConverter}}">
                                <TextBlock Text="Ellipsoid:" VerticalAlignment="Center" Margin="0,0,4,0" Width="80"/>
                                <ComboBox ItemsSource="{Binding SrsViewModel.AvailableEllipsoids}" 
                                          SelectedItem="{Binding SrsViewModel.SelectedEllipsoid, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          Width="150"/>
                            </StackPanel>
                            <!-- UTM Zone -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding SrsViewModel.IsUtmZoneVisible, Converter={StaticResource boolToVisibilityConverter}}">
                                <TextBlock Text="UTM Zone:" VerticalAlignment="Center" Margin="0,0,4,0" Width="80"/>
                                <mahApp:NumericUpDown Value="{Binding SrsViewModel.UtmZone, Mode=TwoWay}" 
                                                     Minimum="1" Maximum="60" 
                                                     Width="150"/>
                            </StackPanel>
                            <!-- Coordinate Precision -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Lat/Long Precision:" VerticalAlignment="Center" Margin="0,0,4,0" Width="80"/>
                                <mahApp:NumericUpDown Value="{Binding SrsViewModel.LatLongPrecision, Mode=TwoWay}" 
                                                     Minimum="0" Maximum="10" 
                                                     Width="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="X/Y Precision:" VerticalAlignment="Center" Margin="0,0,4,0" Width="80"/>
                                <mahApp:NumericUpDown Value="{Binding SrsViewModel.XYPrecision, Mode=TwoWay}" 
                                                     Minimum="0" Maximum="10" 
                                                     Width="150"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>


        <DataGrid Grid.Row="2" FlowDirection="LeftToRight"  x:Name="dataGrid"
                  ItemsSource="{Binding CurrentPagePoints}" 
                  SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                  AutoGenerateColumns="False" SelectionChanged="DataGrid_SelectionChanged"
                  CanUserSortColumns="False" CanUserAddRows="False"
                  IsReadOnly="True"
                  Style="{DynamicResource MahApps.Styles.DataGrid}" CanUserReorderColumns="True"
                  HeadersVisibility="Column" AlternationCount="2000000000"
                  SelectionMode="Single" MaxHeight="200"  
                  SelectionUnit="FullRow"  >
            <DataGrid.Columns>
              
                <DataGridTemplateColumn Header="#" Width="Auto" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"  Foreground="DimGray">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource pointNumberConverter}">
                                        <Binding Path="DataContext.CurrentPageIndex" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                        <Binding Path="DataContext.MaxPointsPerPage" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                        <Binding Path="."/>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="X" Width="*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FlowDirection="LeftToRight" Margin="1" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource coordinateDisplayConverter}" ConverterParameter="X">
                                        <Binding Path="."/>
                                        <Binding Path="DataContext.SrsViewModel.SelectedSrsType" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                        <Binding Path="DataContext.SrsViewModel.SelectedEllipsoid" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                        <Binding Path="DataContext.SrsViewModel.UtmZone" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                        <Binding Path="DataContext.SrsViewModel.LatLongPrecision" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                        <Binding Path="DataContext.SrsViewModel.XYPrecision" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Y" Width="*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FlowDirection="LeftToRight" Margin="1" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource coordinateDisplayConverter}" ConverterParameter="Y">
                                        <Binding Path="."/>
                                        <Binding Path="DataContext.SrsViewModel.SelectedSrsType" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                        <Binding Path="DataContext.SrsViewModel.SelectedEllipsoid" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                        <Binding Path="DataContext.SrsViewModel.UtmZone" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                        <Binding Path="DataContext.SrsViewModel.LatLongPrecision" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                        <Binding Path="DataContext.SrsViewModel.XYPrecision" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Z" Width="*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                     FlowDirection="LeftToRight" Margin="1"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"> 
                    
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
 
        <!-- Header with point counter and navigation buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Stretch" FlowDirection="LeftToRight" Margin="0,4,0,0"
                    Background="{DynamicResource MahApps.Brushes.Accent}">
          
            <ToggleButton Style="{StaticResource circleToggleButton}" 
                         IsChecked="{Binding IsEditable, Mode=TwoWay}"
                         ToolTip="{Binding [geometryDetails_currentPoint_edit], Source={StaticResource Localization}}" Visibility="Collapsed" >
                <iconPacks:PackIconModern Kind="Edit"/>
            </ToggleButton>
            <Button Style="{StaticResource circleButton}" 
                      Command="{Binding PanToCurrentPointCommand}"
                      IsEnabled="{Binding SelectedPoint, Converter={StaticResource notNullToBoolConverter}}"
                      ToolTip="{Binding [geometryDetails_currentPoint_zoom], Source={StaticResource Localization}}">
                <iconPacks:PackIconModern Kind="CursorHand"/>
            </Button>
            <Button Style="{StaticResource circleButton}" 
                      Command="{Binding ZoomToCurrentPointCommand}"
                      IsEnabled="{Binding SelectedPoint, Converter={StaticResource notNullToBoolConverter}}"
                      ToolTip="{Binding [geometryDetails_currentPoint_zoomToPoint], Source={StaticResource Localization}}">
                <iconPacks:PackIconModern Kind="MagnifyAdd"/>
            </Button>
            <Button Style="{StaticResource circleButton}" 
                      Command="{Binding CopyCurrentPointCommand}"
                      IsEnabled="{Binding SelectedPoint, Converter={StaticResource notNullToBoolConverter}}"
                      ToolTip="{Binding [geometryDetails_currentPoint_copyCoordinate], Source={StaticResource Localization}}">
                <iconPacks:PackIconModern Kind="PageCopy"/>
            </Button>
            <Button Style="{StaticResource circleButton}" 
                    Command="{Binding InsertPointBeforeSelectedCommand}"
                    ToolTip="{Binding [geometryDetails_currentPoint_insert], Source={StaticResource Localization}}">
                <iconPacks:PackIconModern Kind="ListAdd"/>
            </Button>
            <Button Style="{StaticResource circleButton}" 
                    Command="{Binding AddPointCommand}"
                    ToolTip="{Binding [geometryDetails_currentPoint_add], Source={StaticResource Localization}}">
                <iconPacks:PackIconModern Kind="Add"/>
            </Button>
            <Button Style="{StaticResource circleButton}" 
                    Command="{Binding DeleteCurrentPointCommand}"
                    IsEnabled="{Binding SelectedPoint, Converter={StaticResource notNullToBoolConverter}}"
                    ToolTip="{Binding [geometryDetails_currentPoint_delete], Source={StaticResource Localization}}">
                <iconPacks:PackIconModern Kind="Delete"/>
            </Button>
          
            <Button Style="{StaticResource circleButton}" 
                      Command="{Binding GoToPreviousPageCommand}"  
                      ToolTip="{Binding [geometryDetails_currentPoint_goToPreviousPoint], Source={StaticResource Localization}}">
                <iconPacks:PackIconMaterial Kind="ChevronDoubleLeft" />
            </Button>

            <Button Style="{StaticResource circleButton}" 
                      Command="{Binding GoToPreviousPointCommand}"
                      ToolTip="{Binding [geometryDetails_currentPoint_goToPreviousPoint], Source={StaticResource Localization}}">
                <iconPacks:PackIconMaterial Kind="ChevronLeft"/>
            </Button>
            <ComboBox ItemsSource="{Binding AvailablePageSizes}"
             SelectedItem="{Binding MaxPointsPerPage, Mode=TwoWay}"
             Width="60" Margin="4,0" VerticalAlignment="Center"
             FlowDirection="LeftToRight"/>
            <TextBlock VerticalAlignment="Center" 
                        TextBlock.TextAlignment="Right" Margin="8,0,0,0">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Point {0} of {1} (Page {2} of {3})">
                        <Binding Path="CurrentPointNumber"/>
                        <Binding Path="TotalPointCount"/>
                        <Binding Path="CurrentPageNumber"/>
                        <Binding Path="TotalPages"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Button Style="{StaticResource circleButton}" 
          Command="{Binding GoToNextPointCommand}"
          ToolTip="{Binding [geometryDetails_currentPoint_goToNextPoint], Source={StaticResource Localization}}">
                <iconPacks:PackIconMaterial Kind="ChevronRight"/>
            </Button>
            <Button Style="{StaticResource circleButton}" 
         Command="{Binding GoToNextPageCommand}"
         ToolTip="{Binding [geometryDetails_currentPoint_goToNextPoint], Source={StaticResource Localization}}">
                <iconPacks:PackIconMaterial Kind="ChevronDoubleRight"/>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>




