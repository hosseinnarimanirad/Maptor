<userControl:NotifiableUserControl x:Class="IRI.Maptor.Jab.Controls.Views.MapExtentPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:userControl="clr-namespace:IRI.Maptor.Jab.Common;assembly=IRI.Maptor.Jab.Common" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
            Background="Transparent">
    <userControl:NotifiableUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Controls.Button.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Controls.ToggleButton.xaml"/>-->
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="filterTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource IRI.Maptor.Styles.TextBox}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="White"/>
                <!--<Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ControlBackground}"/>-->
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#F5F5F5"/>
                        <Setter Property="Foreground" Value="#999999"/>
                        <Setter Property="Opacity" Value="0.8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="sectionCard" TargetType="Border">
                <Setter Property="Padding" Value="4"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}"/>
            </Style>

            <Style x:Key="sectionLabel" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </userControl:NotifiableUserControl.Resources>
    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" CornerRadius="4" Padding="0,1"
            VerticalAlignment="Top">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource MahApps.Styles.ScrollViewer}">
            <StackPanel>
                <Border Style="{StaticResource sectionCard}">

                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                        <Button Command="{Binding Map.ZoomInAtCenterCommand}" ToolTip="{Binding [cmd_general_zoomIn], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.Button.CircleDark}">
                            <iconPacks:PackIconMaterial Kind="MagnifyPlus" />
                        </Button>
                        <Button Command="{Binding Map.ZoomOutAtCenterCommand}" ToolTip="{Binding [cmd_general_zoomOut], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.Button.CircleDark}">
                            <iconPacks:PackIconMaterial Kind="MagnifyMinus" />
                        </Button>
                        <Button Command="{Binding Map.PreviousExtentCommand}" ToolTip="{Binding [cmd_general_previousExtent], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.Button.CircleDark}" Padding="6" Margin="0,0,4,4">
                            <iconPacks:PackIconMaterial Kind="ArrowLeftBold"  FlowDirection="LeftToRight"/>
                        </Button>
                        <Button Command="{Binding Map.NextExtentCommand}" ToolTip="{Binding [cmd_general_nextExtent], Source={StaticResource Localization}}" Style="{StaticResource IRI.Maptor.Styles.Button.CircleDark}" Padding="6" Margin="0,0,4,4">
                            <iconPacks:PackIconMaterial Kind="ArrowRightBold"/>
                        </Button>
                    </WrapPanel>

                </Border>

                <!--new extent-->
                <Border Style="{StaticResource sectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding [mapExtent_new_title], Source={StaticResource Localization}}"
                                   Style="{StaticResource sectionLabel}"/>
                        <Button Grid.Column="1" Grid.Row="1" ToolTip="{Binding [mapExtent_new_addNew], Source={StaticResource Localization}}"
                                    Command="{Binding SaveBookmarkCommand}" Style="{StaticResource IRI.Maptor.Styles.Button.CircleDark}"
                                    Margin="4,0"
                                    VerticalAlignment="Bottom">
                            <iconPacks:PackIconMaterial Kind="ContentSave"/>
                        </Button>
                        <TextBox Grid.Column="0" Grid.Row="1" Margin="0"
                                     Text="{Binding NewBookmarkTitle, UpdateSourceTrigger=PropertyChanged}"
                                     mahApp:ControlsHelper.CornerRadius="4"
                                     mahApp:TextBoxHelper.Watermark="{Binding [mapExtent_new_extentTitle], Source={StaticResource Localization}}" 
                                     mahApp:TextBoxHelper.ClearTextButton="True"
                                     Style="{StaticResource filterTextBox}" HorizontalAlignment="Stretch"
                                     FontFamily="{StaticResource iranSans}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!--current extent info-->
                <Border Style="{StaticResource sectionCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding [mapExtent_currentView_title], Source={StaticResource Localization}}"
                                   Style="{StaticResource sectionLabel}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style x:Key="boldText" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                                    <Setter Property="Margin" Value="4,2"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                                <Style x:Key="normalText" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                </Style>
                            </Grid.Resources>

                            <!--nearest google zoom level-->
                            <TextBlock Grid.Row="0" Style="{StaticResource boldText}"
                                       Text="{Binding [mapExtent_currentView_nearestGoogleZoomLevel], Source={StaticResource Localization}}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource normalText}"
                                       Text="{Binding Map.NearestGoogleZoomLevel, Mode=OneWay, Converter={StaticResource localizedNumberConverter}}"/>

                            <!--nearest google scale-->
                            <TextBlock Grid.Row="1" Style="{StaticResource boldText}"
                                       Text="{Binding [mapExtent_currentView_inverseMapScaleNearestGoogleZoomLevel], Source={StaticResource Localization}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource normalText}"
                                       Text="{Binding Map.InverseMapScale_NearestGoogleZoomLevel, Mode=OneWay, Converter={StaticResource localizedNumberConverter}}"/>

                            <!--nearest google scale (current point)-->
                            <TextBlock Grid.Row="2" Style="{StaticResource boldText}"
                                       Text="{Binding [mapExtent_currentView_inverseMapScaleNearestGoogleZoomLevelCurrentPoint], Source={StaticResource Localization}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource normalText}"
                                       Text="{Binding Map.InverseMapScale_NearestGoogleZoomLevel_CurrentPoint, Mode=OneWay, Converter={StaticResource localizedNumberConverter}}"/>

                            <!--WebMercator map scale-->
                            <TextBlock Grid.Row="3" Style="{StaticResource boldText}"
                                       Text="{Binding [mapExtent_currentView_inverseMapScale], Source={StaticResource Localization}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource normalText}"
                                       Text="{Binding Map.InverseMapScale, Mode=OneWay, Converter={StaticResource localizedNumberConverter}}"/>

                            <!--current point map scale-->
                            <TextBlock Grid.Row="4" Style="{StaticResource boldText}"
                                       Text="{Binding [mapExtent_currentView_inverseMapScaleCurrentPoint], Source={StaticResource Localization}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource normalText}"
                                       Text="{Binding Map.InverseMapScale_CurrentPoint, Mode=OneWay, Converter={StaticResource localizedNumberConverter}}"/>

                            <!--Current point ground resolution-->
                            <TextBlock Grid.Row="5" Style="{StaticResource boldText}"
                                       Text="{Binding [mapExtent_currentView_currentPointGroundResolution], Source={StaticResource Localization}}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource normalText}"
                                       Text="{Binding Map.CurrentPointGroundResolution, Mode=OneWay, Converter={StaticResource localizedNumberConverter}}"/>
                        </Grid>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                            <Grid.Resources>
                                <Style x:Key="labelBorder"  TargetType="Border">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="4"/>
                                    <Setter Property="Padding" Value="1"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                                <Style x:Key="labelText" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                </Style>
                            </Grid.Resources>

                            <Border Margin="30" Height="75" Width="100" BorderBrush="White" BorderThickness="4"/>

                            <Border Style="{StaticResource labelBorder}" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="{Binding TopLabel, FallbackValue='NaN', Converter={StaticResource localizedNumberConverter}}"
                                           Style="{StaticResource labelText}"/>
                            </Border>

                            <Border Style="{StaticResource labelBorder}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border.LayoutTransform>
                                    <RotateTransform Angle="90"/>
                                </Border.LayoutTransform>
                                <TextBlock Text="{Binding RightLabel, FallbackValue='NaN', Converter={StaticResource localizedNumberConverter}}"
                                           Style="{StaticResource labelText}"/>
                            </Border>

                            <Border Style="{StaticResource labelBorder}" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding BottomLabel, FallbackValue='NaN', Converter={StaticResource localizedNumberConverter}}"
                                           Style="{StaticResource labelText}"/>
                            </Border>

                            <Border Style="{StaticResource labelBorder}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </Border.LayoutTransform>
                                <TextBlock Text="{Binding LeftLabel, FallbackValue='NaN', Converter={StaticResource localizedNumberConverter}}"
                                           Style="{StaticResource labelText}"/>
                            </Border>
                        </Grid>
                        <!--<TextBlock Text="{Binding ZoomLevelText, StringFormat='Zoom level: {0}', Mode=OneWay}"/>
                        <TextBlock Margin="0,2,0,0" Text="{Binding ScaleText, StringFormat='Map scale: {0}', Mode=OneWay}"/>
                        <TextBlock Margin="0,2,0,0" Text="{Binding GroundResolutionText, StringFormat='Ground resolution: {0}', Mode=OneWay}"/>-->
                    </StackPanel>
                </Border>

                <!--go to scale-->
                <Border Style="{StaticResource sectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/> 
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource sectionLabel}"
                                   Text="{Binding [mapExtent_gotoScale_title], Source={StaticResource Localization}}"/>
                        <mahApp:ToggleSwitch Grid.Row="1" Grid.ColumnSpan="2"
                                             FontSize="11" Cursor="Hand"
                                             FontFamily="{StaticResource iranSans}"
                                             Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"
                                             IsOn="{Binding UseGroundScaleForSandardScales}"
                                             OnContent="{Binding [mapExtent_gotoScale_useGroundScaleForSandardScales], Source={StaticResource Localization}}"
                                             OffContent="{Binding [mapExtent_gotoScale_useWebMercatorScaleForSandardScales], Source={StaticResource Localization}}"/>
                        <Border Grid.Row="2" Grid.Column="0" CornerRadius="4" Background="{DynamicResource MahApps.Brushes.ControlBackground}">
                            <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding ScaleItemsView}" SelectedItem="{Binding SelectedScaleItem, Mode=TwoWay}"
                                            DisplayMemberPath="DisplayLabel" Margin="4" MinHeight="28"
                                            BorderThickness="0"
                                            VerticalContentAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            FlowDirection="LeftToRight">
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"
                                                                   FontWeight="Bold" Margin="0,4,0,2"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>
                        </Border>
                        <Button Grid.Row="2" Grid.Column="1" Command="{Binding ApplyScaleCommand}" Style="{StaticResource IRI.Maptor.Styles.Button.CircleDark}"
                                ToolTip="{Binding [cmd_general_zoomToExtent], Source={StaticResource Localization}}">
                            <iconPacks:PackIconMaterial Kind="MagnifyExpand"/>
                        </Button>
                    </Grid>
                </Border>

                <Border Style="{StaticResource sectionCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding [mapExtent_savedExtents_title], Source={StaticResource Localization}}"
                                   Style="{StaticResource sectionLabel}"/>

                        <ItemsControl ItemsSource="{Binding Bookmarks}" Margin="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,2" Background="{DynamicResource MahApps.Brushes.Badged.Background}" Padding="2" CornerRadius="5">
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="79"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="48" Height="48"
                                                    BorderBrush="{DynamicResource MahApps.Brushes.Gray4}"
                                                    Background="White"
                                                    BorderThickness="1" Margin="0,0,4,0" CornerRadius="1">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                       Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" ToolTip="Delete"
                                                    Style="{StaticResource IRI.Maptor.Styles.Button.CircleDark}"
                                                    Command="{Binding DataContext.DeleteBookmarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="16" Height="16"/>
                                            </Button>
                                            <Button Grid.Column="3" 
                                                    Style="{StaticResource IRI.Maptor.Styles.Button.CircleDark}"
                                                    Command="{Binding DataContext.GoToBookmarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" >
                                                <iconPacks:PackIconMaterial Kind="MagnifyExpand" Width="16" Height="16"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</userControl:NotifiableUserControl>
