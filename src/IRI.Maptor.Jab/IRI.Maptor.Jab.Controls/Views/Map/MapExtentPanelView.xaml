<userControl:NotifiableUserControl x:Class="IRI.Maptor.Jab.Controls.Views.MapExtentPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:userControl="clr-namespace:IRI.Maptor.Jab.Common;assembly=IRI.Maptor.Jab.Common"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="280" MinWidth="220">
    <userControl:NotifiableUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </userControl:NotifiableUserControl.Resources>
    <Border Background="White" CornerRadius="4" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" Padding="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{DynamicResource MahApps.Brushes.Accent4}"
                        Margin="0" CornerRadius="4" Padding="4">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                        <Button Command="{Binding Map.ZoomInAtCenterCommand}" ToolTip="Zoom in (center)" Style="{StaticResource circleButtonLight}">
                            <iconPacks:PackIconMaterial Kind="MagnifyPlus" />
                        </Button>
                        <Button Command="{Binding Map.ZoomOutAtCenterCommand}" ToolTip="Zoom out (center)" Style="{StaticResource circleButtonLight}">
                            <iconPacks:PackIconMaterial Kind="MagnifyMinus" />
                        </Button>
                        <Button Command="{Binding Map.PreviousExtentCommand}" ToolTip="Previous extent" Style="{StaticResource circleButtonLight}" Padding="6" Margin="0,0,4,4">
                            <iconPacks:PackIconMaterial Kind="ArrowLeftBold"  FlowDirection="LeftToRight"/>
                        </Button>
                        <Button Command="{Binding Map.NextExtentCommand}" ToolTip="Next extent" Style="{StaticResource circleButtonLight}" Padding="6" Margin="0,0,4,4">
                            <iconPacks:PackIconMaterial Kind="ArrowRightBold"/>
                        </Button>
                    </WrapPanel>
                </Border>
                

                <Separator Margin="0,6,0,8" Background="{DynamicResource MahApps.Brushes.Accent3}"/>

                <TextBlock Text="Save extent" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewBookmarkTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                             VerticalContentAlignment="Center" MinHeight="28"/>
                    <Button Grid.Column="1" Command="{Binding SaveBookmarkCommand}" Style="{StaticResource circleButtonLight}" Padding="10,4">
                        <iconPacks:PackIconMaterial Kind="ContentSave"/>
                    </Button>
                </Grid>

                <Separator Margin="0,10,0,8"/>

                <TextBlock Text="Current view (extent center)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding ZoomLevelText, StringFormat='Zoom level: {0}', Mode=OneWay}"/>
                <TextBlock Margin="0,2,0,0" Text="{Binding ScaleText, StringFormat='Map scale: {0}', Mode=OneWay}"/>
                <TextBlock Margin="0,2,0,0" Text="{Binding GroundResolutionText, StringFormat='Ground resolution: {0}', Mode=OneWay}"/>

                <Separator Margin="0,10,0,8"/>

                <TextBlock Text="Scale at center" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding ScaleItemsView}" SelectedItem="{Binding SelectedScaleItem, Mode=TwoWay}"
                              DisplayMemberPath="DisplayLabel" Margin="0,0,4,0" MinHeight="28">
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,4,0,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                    <Button Grid.Column="1" Command="{Binding ApplyScaleCommand}" Style="{StaticResource circleButtonLight}">
                        <iconPacks:PackIconMaterial Kind="MagnifyExpand"/>
                    </Button>
                </Grid>

                <Separator Margin="0,10,0,8"/>

                <TextBlock Text="Saved extents" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Bookmarks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="79"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="48" Height="48"
                                        BorderBrush="{DynamicResource MahApps.Brushes.Gray4}"
                                        BorderThickness="1" Margin="0,0,4,0" CornerRadius="1">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" ToolTip="Delete"
                                        Style="{StaticResource circleButtonLight}"
                                        Command="{Binding DataContext.DeleteBookmarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="16" Height="16"/>
                                </Button>
                                <Button Grid.Column="3" 
                                        Style="{StaticResource circleButtonLight}"
                                        Command="{Binding DataContext.GoToBookmarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" >
                                    <iconPacks:PackIconMaterial Kind="MagnifyExpand" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</userControl:NotifiableUserControl>
