<userControl:NotifiableUserControl x:Class="IRI.Maptor.Jab.Controls.Views.MapViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:userControl="clr-namespace:IRI.Maptor.Jab.Common;assembly=IRI.Maptor.Jab.Common" 
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Border>
        <Canvas x:Name="mapView" Margin="0" ClipToBounds="True" FlowDirection="LeftToRight" Background="Transparent"
                SnapsToDevicePixels="True" UseLayoutRounding="True"/>
    </Border>
</userControl:NotifiableUserControl>
