<UserControl x:Class="IRI.Maptor.Jab.Controls.Views.MapInfoView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        
            xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" 
            xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"
            xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
            x:Name="root"
            Visibility="{Binding ShowMapInfoPanel, Converter={StaticResource boolToVisibilityConverter}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/IRI.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <Style  TargetType="{x:Type ToggleButton}" x:Key="simpleToggle">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Grid>
                                <Rectangle Margin="1" Fill="{TemplateBinding Property=Background}"/>
                                <ContentPresenter Margin="4,1"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="{x:Type iconPacks:PackIconModern}" BasedOn="{StaticResource circleButtonPackIconModern}"/>
            <Style TargetType="{x:Type iconPacks:PackIconMaterial}" BasedOn="{StaticResource circleButtonPackIconMaterial}"/>
            <Style TargetType="{x:Type Path}" BasedOn="{StaticResource circleButtonPath}"/>

            <!--<Style TargetType="iconPacks:PackIconModern">
                <Setter Property="Foreground" Value="White"/>
                -->
            <!--<Setter Property="Stretch" Value="Uniform"/>-->
            <!--
                <Setter Property="Margin" Value="8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
            </Style>
            <Style TargetType="iconPacks:PackIconMaterial">
                <Setter Property="Foreground" Value="White"/>
                -->
            <!--<Setter Property="Stretch" Value="Uniform"/>-->
            <!--
                <Setter Property="Margin" Value="8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
            </Style>-->
            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="mahApp:HeaderedControlHelper.HeaderFontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border CornerRadius="15" BorderThickness="3" MinWidth="420" VerticalAlignment="Top" HorizontalAlignment="Center" 
                    Background="White" BorderBrush="{DynamicResource MahApps.Brushes.Accent3}" Opacity=".95"
                    Margin="4" Visibility="{Binding IsDrawEditMeasureMode, Converter={StaticResource boolToVisibilityConverter}}">
        <StackPanel FlowDirection="{Binding Path=CurrentFlowDirection, Source={StaticResource Localization}}">
            <DockPanel Margin="0" >

                <TextBlock DockPanel.Dock="Left" Text="X" Margin="4"
                           Visibility="{Binding MapPanel.Options.IsManualInputAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                <TextBox DockPanel.Dock="Left" MaxWidth="90" FlowDirection="LeftToRight" MinWidth="80" Margin="2" VerticalAlignment="Center"
                         Visibility="{Binding MapPanel.Options.IsManualInputAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}"
                         mahApp:TextBoxHelper.SelectAllOnFocus="True">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Border"
                     Background="{TemplateBinding Background}"
                     BorderBrush="{TemplateBinding BorderBrush}"
                     BorderThickness="{TemplateBinding BorderThickness}"
                     CornerRadius="4">
                                            <ScrollViewer x:Name="PART_ContentHost" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=MapPanel.IsGeodeticWgs84EditingMode}" Value="True">
                                    <Setter Property="Text" Value="{Binding Path=MapPanel.CurrentEditingPoint.X, Mode=TwoWay, StringFormat={}{0:N5}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=MapPanel.IsGeodeticWgs84EditingMode}" Value="False">
                                    <Setter Property="Text" Value="{Binding Path=MapPanel.CurrentEditingPoint.X, Mode=TwoWay, StringFormat={}{0:N2}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock DockPanel.Dock="Left" Text="Y" Margin="4"
                           Visibility="{Binding MapPanel.Options.IsManualInputAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                <TextBox DockPanel.Dock="Left" 
                         MaxWidth="90" 
                         MinWidth="80" 
                         Margin="2" 
                         VerticalAlignment="Center"
                         FlowDirection="LeftToRight"
                         mahApp:TextBoxHelper.SelectAllOnFocus="True"
                         Visibility="{Binding MapPanel.Options.IsManualInputAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Border"
                     Background="{TemplateBinding Background}"
                     BorderBrush="{TemplateBinding BorderBrush}"
                     BorderThickness="{TemplateBinding BorderThickness}"
                     CornerRadius="5">
                                            <ScrollViewer x:Name="PART_ContentHost" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=MapPanel.IsGeodeticWgs84EditingMode}" Value="True">
                                    <Setter Property="Text" Value="{Binding Path=MapPanel.CurrentEditingPoint.Y, Mode=TwoWay, StringFormat={}{0:N5}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=MapPanel.IsGeodeticWgs84EditingMode}" Value="False">
                                    <Setter Property="Text" Value="{Binding Path=MapPanel.CurrentEditingPoint.Y, Mode=TwoWay, StringFormat={}{0:N2}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!--Drawing-->
                <DockPanel DockPanel.Dock="Right" LastChildFill="False"
                            Visibility="{Binding IsDrawMode, Converter={StaticResource boolToVisibilityConverter}}">
                    <Button Style="{StaticResource circleButtonLight}" DockPanel.Dock="Left" Margin="2" 
                            ToolTip="{Binding [map_draw_addPoint], Source={StaticResource Localization}}"
                            Command="{Binding AddPointToNewDrawingCommand}"
                            Visibility="{Binding MapPanel.Options.IsManualInputAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Modern Kind="Add"/>
                    </Button>
                    <Button Style="{StaticResource circleButtonLight}" DockPanel.Dock="Left" Margin="2,0,10,0" 
                            ToolTip="{Binding [map_draw_finishDrawingPart], Source={StaticResource Localization}}"
                            Command="{Binding FinishDrawingPartCommand}"
                            Visibility="{Binding MapPanel.Options.IsMultiPartSupportAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Modern Kind="Checkmark"/>
                    </Button>

                    <Button Style="{StaticResource circleButtonLight}" DockPanel.Dock="Right" Margin="2" 
                            ToolTip="{Binding [map_draw_finishDrawing], Source={StaticResource Localization}}"
                            Command="{Binding FinishNewDrawingCommand}" >
                        <iconPacks:Modern Kind="Check"/>
                    </Button>
                    <Button Style="{StaticResource circleButtonLight}" DockPanel.Dock="Right" Margin="2" 
                            ToolTip="{Binding [map_draw_cancelDrawing], Source={StaticResource Localization}}"
                            Command="{Binding CancelNewDrawingCommand}" >
                        <iconPacks:Modern Kind="Close"/>
                    </Button>
                </DockPanel>
                <!-- Drawing -->


                <!--Editing-->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" 
                            DataContext="{Binding CurrentEditingLayer}"
                            ToolTip="{Binding [mapPanel_measure_showEdgeLabels], Source={StaticResource Localization}}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource boolToVisibilityConverter}}">
                    <ToggleButton Style="{StaticResource circleToggleButtonLight}" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="2" 
                                    IsChecked="{Binding Options.IsEdgeLabelVisible, Mode=TwoWay}" 
                                    Visibility="{Binding Options.IsMeasureButtonVisible, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Modern Kind="MeasureMeter"/>
                    </ToggleButton>

                    <Button Style="{StaticResource circleButtonLight}" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="2" 
                            Command="{Binding ConvertToDrawingItemCommand}" 
                            ToolTip="{Binding [mapPanel_measure_convertToDrawing], Source={StaticResource Localization}}"
                            Visibility="{Binding Options.IsMeasureButtonVisible, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Modern Kind="VectorPenAdd"/>
                    </Button>

                    <Button Style="{StaticResource circleButtonLight}" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="2"
                            Command="{Binding ShowGeometryDetailsCommand}"
                            ToolTip=""
                            Visibility="{Binding Options.IsGeometryDetailsAvailable, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Material Kind="Tune"/>
                    </Button>

                    <Button Style="{StaticResource circleButtonLight}" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="2" 
                            Command="{Binding DeleteCommand}"
                            ToolTip="{Binding [mapPanel_edit_delete], Source={StaticResource Localization}}"
                            Visibility="{Binding Options.IsDeleteButtonVisible, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Modern Kind="Delete"/>
                    </Button>

                    <Button Style="{StaticResource circleButtonLight}" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="2" 
                            Command="{Binding CancelEditingCommand}" 
                            ToolTip="{Binding [mapPanel_edit_cancel], Source={StaticResource Localization}}"
                            Visibility="{Binding Options.IsCancelButtonVisible, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Modern Kind="Close"/>
                    </Button>
                    <Button Style="{StaticResource circleButtonLight}" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="2" 
                            Command="{Binding FinishEditingCommand}" 
                            ToolTip="{Binding [mapPanel_edit_finish], Source={StaticResource Localization}}"
                            Visibility="{Binding Options.IsFinishButtonVisible, Converter={StaticResource boolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <iconPacks:Modern Kind="Check"/>
                    </Button>
                </StackPanel>
                <!--Editing-->

            </DockPanel>

            <!--new drawing information text-->
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="Underline" Margin="8,0"
                       Text="{Binding [map_draw_newDrawing], Source={StaticResource Localization}}"
                       Foreground="{StaticResource  MahApps.Brushes.Accent2}"
                       Visibility="{Binding IsDrawMode, Converter={StaticResource boolToVisibilityConverter}}">
                <!--<TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                        <Binding Path="IsDrawMode" />
                        <Binding Path="ShowMapInfoPanel" />
                    </MultiBinding>
                </TextBlock.Visibility>-->
            </TextBlock>

            <!--tabs-->
            <TabControl SelectedIndex="2" Background="Transparent"  >
                <TabControl.Visibility>
                    <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                        <Binding Path="MapPanel.Options.IsOptionsAvailable"/>
                        <Binding Path="MapPanel.IsDetailsVisible"/>
                    </MultiBinding>
                </TabControl.Visibility>
                <TabControl.Items>

                    <!--current point-->
                    <TabItem Header="{Binding [mapPanel_header_currentPoint], Source={StaticResource Localization}}" Cursor="Hand">
                        <TabItem.Visibility>
                            <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                                <Binding Path="MapPanel.Options.IsMultiPartSupportAvailable"/>
                            </MultiBinding>
                        </TabItem.Visibility>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding CurrentEditingLayer}" FlowDirection="LeftToRight" HorizontalAlignment="Center">
                            <Button Style="{StaticResource circleButtonLight}" HorizontalAlignment="Right" Margin="2" 
                                        ToolTip="{Binding [mapPanel_currentPoint_goToPreviousPoint], Source={StaticResource Localization}}"
                                        Command="{Binding GoToPreviousPointCommand}" >
                                <iconPacks:Modern Kind="ChevronLeft" />
                            </Button>
                            <Button Style="{StaticResource circleButtonLight}" HorizontalAlignment="Right" Margin="2" 
                                        ToolTip="{Binding [mapPanel_currentPoint_delete], Source={StaticResource Localization}}"
                                        Command="{Binding DeleteCurrentPointCommand}" >
                                <iconPacks:Modern Kind="Delete"/>
                            </Button>
                            <Button Style="{StaticResource circleButtonLight}" HorizontalAlignment="Right" Margin="2" 
                                        ToolTip="{Binding [mapPanel_currentPoint_zoom], Source={StaticResource Localization}}"
                                        Command="{Binding ZoomToCurrentPointCommand}" >
                                <iconPacks:Modern Kind="MagnifyAdd"/>
                            </Button>
                            <Button Style="{StaticResource circleButtonLight}" HorizontalAlignment="Right" Margin="2" 
                                        ToolTip="{Binding [mapPanel_currentPoint_copyCoordinate], Source={StaticResource Localization}}"
                                        Command="{Binding CopyCurrentPointCommand}" 
                                        CommandParameter="{Binding DataContext.MapPanel.SpatialReference, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}">
                                <iconPacks:Modern Kind="PageCopy"/>
                            </Button>
                            <Button Style="{StaticResource circleButtonLight}" HorizontalAlignment="Right" Margin="2" 
                                        ToolTip="{Binding [mapPanel_currentPoint_goToNextPoint], Source={StaticResource Localization}}"
                                        Command="{Binding GoToNextPointCommand}" >
                                <iconPacks:Modern Kind="ChevronRight"/>
                            </Button>
                        </StackPanel>
                    </TabItem>

                    <!--multi part-->
                    <TabItem Header="{Binding [mapPanel_header_multiPart], Source={StaticResource Localization}}" Cursor="Hand" >
                        <TabItem.Visibility>
                            <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                                <Binding Path="MapPanel.Options.IsMultiPartSupportAvailable"/>
                            </MultiBinding>
                        </TabItem.Visibility>
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" DataContext="{Binding CurrentEditingLayer}" >
                            <Button Style="{StaticResource circleButtonLight}" HorizontalAlignment="Right" Margin="2" 
                                        ToolTip="{Binding [mapPanel_currentPart_delete], Source={StaticResource Localization}}"
                                        Command="{Binding DeleteCurrentPartCommand}" >
                                <iconPacks:Modern Kind="Delete"/>
                            </Button>

                            <Button Style="{StaticResource circleButtonLight}" HorizontalAlignment="Right" Margin="2" IsEnabled="False"
                                        ToolTip="{Binding [mapPanel_currentPart_add], Source={StaticResource Localization}}"
                                        Command="{Binding AddNewPartCommand}">
                                <iconPacks:Modern Kind="Add"/>
                            </Button>
                            <Button Style="{StaticResource circleButtonLight}" HorizontalAlignment="Right" Margin="2" 
                                        ToolTip="{Binding [mapPanel_currentPart_zoom], Source={StaticResource Localization}}"
                                        Command="{Binding ZoomToCurrentPartCommand}" >
                                <iconPacks:Modern Kind="MagnifyAdd"/>
                            </Button>
                        </StackPanel>
                    </TabItem>

                    <!--spatial reference system-->
                    <TabItem Header="{Binding [mapPanel_header_srs], Source={StaticResource Localization}}" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton GroupName="A" ToolTip="{Binding [srs_geodeticWgs84Title], Source={StaticResource Localization}}" Foreground="White" Margin="4,2" 
                                     IsChecked="{Binding MapPanel.IsGeodeticWgs84EditingMode, Mode=TwoWay}" Width="Auto" Height="Auto"  
                                     HorizontalContentAlignment="Center" Style="{StaticResource simpleToggle}" >
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <iconPacks:PackIconModern Kind="Globe" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                    <TextBlock Text="WGS84" Margin="2" Foreground="White"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="A" ToolTip="{Binding [srs_utmTitle], Source={StaticResource Localization}}" Foreground="White" Margin="4,2"
                                     IsChecked="{Binding MapPanel.IsUTMEditingMode, Mode=TwoWay}" Style="{StaticResource simpleToggle}" >
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <iconPacks:PackIconModern Kind="MapTreasure" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                    <TextBlock Text="UTM" Margin="2" Foreground="White"/>
                                </StackPanel>
                            </RadioButton>
                            <TextBlock DockPanel.Dock="Left" Margin="4"
                                            Visibility="{Binding MapPanel.IsUTMEditingMode, Converter={StaticResource boolToVisibilityConverter}}"
                                            Text="{Binding [srs_utmZone], Source={StaticResource Localization}}"/>
                            <TextBox DockPanel.Dock="Left" BorderThickness="1" FlowDirection="LeftToRight" MinWidth="30" Margin="2" VerticalAlignment="Center"
                                            Text="{Binding MapPanel.CurrentEditingZone, Mode=TwoWay}" MaxWidth="30"
                                            Visibility="{Binding MapPanel.IsUTMEditingMode, Converter={StaticResource boolToVisibilityConverter}}">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="3"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                    </TabItem>

                    <!--measure-->
                    <TabItem Header="{Binding [mapPanel_header_measure], Source={StaticResource Localization}}" Cursor="Hand">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <!--<Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>-->
                                </Style>
                            </StackPanel.Resources>
                            <GroupBox Header="{Binding [mapInfo_general], Source={StaticResource Localization}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapInfo_scaleFactor], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentEditingLayer.ScaleFactor, StringFormat={}{0:N5}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2"  FontWeight="Bold" Text="{Binding [mapInfo_meanHeight], Source={StaticResource Localization}}"/>
                                    <DockPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" LastChildFill="True">
                                        <TextBox Text="{Binding CurrentEditingLayer.Height, StringFormat={}{0:N0}}" DockPanel.Dock="Right" Margin="4" Width="50" VerticalAlignment="Center"/>
                                        <Slider Margin="2" Minimum="0" Maximum="5000" Value="{Binding CurrentEditingLayer.Height, UpdateSourceTrigger=PropertyChanged}" MinWidth="70"/>
                                    </DockPanel>
                                </Grid>
                            </GroupBox>
                            <Expander Header="{Binding [mapInfo_length], Source={StaticResource Localization}}" IsExpanded="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>


                                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapInfo_euclideanLengthUtm], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentEditingLayer.EuclideanLengthInUtm, StringFormat={}{0:N1}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="Bold" Text="{Binding [mapInfo_ellipsoidalLength], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding CurrentEditingLayer.EllipsoidalLength, StringFormat={}{0:N1}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapInfo_euclideanLengthUtmRefined], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentEditingLayer.EuclideanLengthInUtm_Refined, StringFormat={}{0:N1}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" FontWeight="Bold" Text="{Binding [mapInfo_sphericalLength], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CurrentEditingLayer.SphericalLength, StringFormat={}{0:N1}}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapInfo_groundLength], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentEditingLayer.GroundLength, StringFormat={}{0:N1}}"/>
                                </Grid>
                            </Expander>
                            <Expander Header="{Binding [mapInfo_area], Source={StaticResource Localization}}" IsEnabled="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapInfo_euclideanAreaUtm], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentEditingLayer.EuclideanArea, StringFormat={}{0:N1}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="Bold" Text="{Binding [mapInfo_ellipsoidalArea], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding CurrentEditingLayer.EllipsoidalArea, StringFormat={}{0:N1}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapInfo_authalicSphereArea], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentEditingLayer.AuthalicSphereArea, StringFormat={}{0:N1}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" FontWeight="Bold" Text="{Binding [mapInfo_karneyArea], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CurrentEditingLayer.KarneyArea, StringFormat={}{0:N1}}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="Bold" Text="{Binding [mapInfo_groundArea], Source={StaticResource Localization}}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentEditingLayer.GroundArea, StringFormat={}{0:N1}}"/>
                                </Grid>
                            </Expander>
                        </StackPanel>

                    </TabItem>

                </TabControl.Items>
            </TabControl>

            <!--options semi expander at the below-->
            <Border Height="Auto" Margin="0 5 0 0" CornerRadius="0 0 13 13" 
                    Cursor="Hand" Visibility="{Binding MapPanel.Options.IsOptionsAvailable, Converter={StaticResource boolToVisibilityConverter}}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding MapPanel.ToggleDetailsVisibilityCommand}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style>
                        <Setter Property="Border.Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                        <Style.Triggers>
                            <Trigger Property="Border.IsMouseOver" Value="True">
                                <Setter Property="Border.Background" Value="{DynamicResource MahApps.Brushes.Accent2}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <iconPacks:PackIconModern Margin="2" Height="8" Kind="ChevronDown"
                                              Visibility="{Binding MapPanel.IsDetailsNotVisible, Converter={StaticResource boolToVisibilityConverter}}"/>
                    <iconPacks:PackIconModern Margin="2" Height="8" Kind="ChevronUp"
                                              Visibility="{Binding MapPanel.IsDetailsVisible, Converter={StaticResource boolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
