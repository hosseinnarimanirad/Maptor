<local:SecurityInputUserControl x:Class="IRI.Maptor.Jab.Controls.Views.Security.EmailPasswordInputView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:IRI.Maptor.Jab.Controls.Views.Security"
            xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"
            xmlns:validation="clr-namespace:IRI.Maptor.Jab.Common.Assets.ValidationRules;assembly=IRI.Maptor.Jab.Common"
            xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" x:Name="root">
    <local:SecurityInputUserControl.Resources>
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        <Style x:Key="borderGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{Binding ElementName=root, Path=InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{Binding ElementName=root, Path=InputBorderThickness}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Height" Value="39"/>
        </Style>
    </local:SecurityInputUserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource borderGroup}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconModern Kind="EmailMinimal" Width="24" Foreground="Gray" Margin="4" VerticalAlignment="Center" HorizontalAlignment="Center"/> 
                <TextBox Grid.Column="1" mahApp:TextBoxHelper.Watermark="{Binding [common_email], Source={StaticResource Localization}}" FontFamily="{StaticResource iranSans}" BorderThickness="0"
                            MinHeight="35"  FontSize="15" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="2"
                            TextAlignment="Center" HorizontalContentAlignment="Center" FlowDirection="LeftToRight" TabIndex="0">
                    <TextBox.Text>
                        <Binding ElementName="root" Path="UserNameOrEmail" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validation:EmailValidation/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
               
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource borderGroup}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="67*"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconModern Kind="Lock" Width="24" Foreground="Gray" Margin="4" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <PasswordBox Grid.Column="1" mahApp:TextBoxHelper.Watermark="{Binding [common_password], Source={StaticResource Localization}}" FontFamily="{StaticResource iranSans}" BorderThickness="0"
                                MinHeight="35" x:Name="key" FontSize="15" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="2"    
                                HorizontalContentAlignment="Center" mahApp:PasswordBoxHelper.CapsLockWarningToolTip="{Binding [common_capsLockWarning], Source={StaticResource Localization}}" TabIndex="1">
                    <mahApp:PasswordBoxHelper.RevealButtonContent>
                        <Button/>
                    </mahApp:PasswordBoxHelper.RevealButtonContent>
                    <mahApp:PasswordBoxHelper.RevealButtonContentTemplate>
                        <DataTemplate>
                            <Button Background="Red" Height="30" Width="30"/>
                        </DataTemplate>
                    </mahApp:PasswordBoxHelper.RevealButtonContentTemplate>

                </PasswordBox>
            </Grid>
        </Border>

    </Grid>
</local:SecurityInputUserControl>
