<local:SecurityInputUserControl x:Class="IRI.Maptor.Jab.Controls.Views.Security.EmailSignUpView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:IRI.Maptor.Jab.Controls.Views.Security"
            xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"
            xmlns:validation="clr-namespace:IRI.Maptor.Jab.Common.Assets.ValidationRules;assembly=IRI.Maptor.Jab.Common"
            xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
            xmlns:i1="http://schemas.microsoft.com/xaml/behaviors" 
            xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" x:Name="root">
    <local:SecurityInputUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/SecurityInputStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </local:SecurityInputUserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
  
        <Border Grid.Row="1" Style="{StaticResource borderGroup}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconMaterial Kind="Email" Style="{StaticResource securityIconMaterial}"/>
                <TextBox Grid.Column="1" Style="{StaticResource securityTextBoxBase}" FlowDirection="LeftToRight"
                         mahApp:TextBoxHelper.Watermark="{Binding [common_email], Source={StaticResource Localization}}">
                    <i1:Interaction.Triggers>
                        <i1:EventTrigger EventName="LostFocus">
                            <i1:InvokeCommandAction  Command="{Binding ValidateUserNameOrEmailCommand}" CommandParameter="{Binding ElementName=root}"/>
                        </i1:EventTrigger>
                    </i1:Interaction.Triggers>
                    <TextBox.Text>
                        <Binding ElementName="root" Path="UserNameOrEmail" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validation:EmailValidation/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource borderGroup}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions> 
                <iconPacks:PackIconPhosphorIcons Kind="PasswordFill" Style="{StaticResource securityIconPhosphor}"/>
                <PasswordBox Grid.Column="1" Style="{StaticResource securityPasswordBoxBase}" x:Name="key" mahApp:TextBoxHelper.Watermark="{Binding [common_password], Source={StaticResource Localization}}"/>
            </Grid>
        </Border>


        <Border Grid.Row="4" Style="{StaticResource borderGroup}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="24" HorizontalAlignment="Center">
                    <StackPanel Grid.Column="0">
                        <iconPacks:PackIconPhosphorIcons Kind="PasswordFill" Style="{StaticResource securityIconPhosphorConfirmRow}"/>
                        <TextBlock Text="{Binding [common_confirm], Source={StaticResource Localization}}" FontSize="14" FontFamily="{StaticResource iranSans}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Margin="0,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                </Viewbox>
                <PasswordBox Grid.Column="1" Style="{StaticResource securityPasswordBoxBase}" x:Name="confirmPassword" mahApp:TextBoxHelper.Watermark="{Binding [common_confirmPassword], Source={StaticResource Localization}}"/>
            </Grid>
        </Border>

    </Grid>
</local:SecurityInputUserControl>
