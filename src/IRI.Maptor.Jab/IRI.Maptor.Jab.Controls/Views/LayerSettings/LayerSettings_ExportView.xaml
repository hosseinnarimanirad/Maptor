<UserControl x:Class="IRI.Maptor.Jab.Controls.Views.LayerSettings.LayerSettings_ExportView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:maptorDsKind="clr-namespace:IRI.Maptor.Sta.Persistence.Abstractions;assembly=IRI.Maptor.Sta.Persistence"
             xmlns:maptorCommon="clr-namespace:IRI.Maptor.Jab.Common;assembly=IRI.Maptor.Jab.Common"
            xmlns:views="clr-namespace:IRI.Maptor.Jab.Controls.Views"
            xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
            xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/SecurityInputStyles.xaml"/>
                <ResourceDictionary Source="/IRI.Maptor.Jab.Common;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <Style x:Key="cardBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="Gray"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Height" Value="39"/>
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource MahApps.Styles.RadioButton}">
                <Setter Property="Margin" Value="4,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--export format type-->
        <Border Grid.Row="0" Style="{StaticResource cardBorder}">
            <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="A" IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.Shapefile}}" Content="SHP" />
                <RadioButton GroupName="A" IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.Dxf}}" Content="DXF"/>
                <RadioButton GroupName="A" IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.Kml}}" Content="KML"/>
                <RadioButton GroupName="A" IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.Kmz}}" Content="KMZ"/>
                <RadioButton GroupName="A" IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.GeoJson}}" Content="GeoJson"/>
                <RadioButton GroupName="A" IsChecked="{Binding SelectedDataSourceKind, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorDsKind:DataSourceKind.TopoJson}}" Content="TopoJson"/>
            </StackPanel>
        </Border>

        <!--what to export-->
        <Border Grid.Row="1" Style="{StaticResource cardBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Features to export?" FontWeight="Bold" VerticalAlignment="Center" Margin="4"/>
                <RadioButton GroupName="B" IsChecked="{Binding SelectedExportMode, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorCommon:ExportFeatureMode.All}}" Content="All"/>
                <RadioButton GroupName="B" IsChecked="{Binding SelectedExportMode, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorCommon:ExportFeatureMode.Selected}}" Content="Selected"/>
                <RadioButton GroupName="B" IsChecked="{Binding SelectedExportMode, Converter={StaticResource enumToBoolConverter}, ConverterParameter={x:Static maptorCommon:ExportFeatureMode.Highlighted}}" Content="Highlighted"/>
            </StackPanel>
        </Border>
        

        <!-- Spatial Reference -->
        <Border Grid.Row="2" Style="{StaticResource cardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Margin="4" Content="Use source SRS" IsChecked="{Binding UseSourceSrs}"/>
                <iconPacks:PackIconPhosphorIcons Grid.Column="1" Kind="Globe" Style="{StaticResource securityIconPhosphor}"/>
                <ComboBox Grid.Column="2" Margin="4"
                          IsEnabled="{Binding EnableProjection}"
                        ItemsSource="{Binding AvailableSrsOptions}"
                        DisplayMemberPath="DisplayName"
                        SelectedItem="{Binding SelectedSrsOption, Mode=TwoWay}"
                        VerticalAlignment="Center" BorderThickness="0" FontSize="15" MinHeight="35"
                        VerticalContentAlignment="Center" HorizontalAlignment="Stretch" FlowDirection="LeftToRight"/>
            </Grid>
        </Border>

        <!-- UTM Zone (visible when UTM selected) -->
        <Border Grid.Row="3" Style="{StaticResource cardBorder}"
              Visibility="{Binding IsUtmSelected, Converter={StaticResource boolToVisibilityConverter}}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconPhosphorIcons Kind="MapTrifoldFill" Style="{StaticResource securityIconPhosphor}"/>
                <mahApp:NumericUpDown Grid.Column="1" Minimum="1" Maximum="60"
                                   Value="{Binding UtmZone, Mode=TwoWay}" Margin="4" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,2,4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Default (northern hemisphere) -->
                            <Setter Property="Text" 
                   Value="{Binding [srs_northernHemisphere], Source={StaticResource Localization}}"/>
                            <Style.Triggers>
                                <!-- Southern hemisphere (IsChecked = False) -->
                                <DataTrigger Binding="{Binding UtmHemisphereNorth}" Value="False">
                                    <Setter Property="Text" 
                           Value="{Binding [srs_southernHemisphere], Source={StaticResource Localization}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ToggleButton Grid.Column="3" IsChecked="{Binding UtmHemisphereNorth, Mode=TwoWay}"
                            Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}" FlowDirection="LeftToRight"
                            ToolTip="{Binding [dialog_dxfOpen_hemisphereTooltip], Source={StaticResource Localization}}">
                    <iconPacks:PackIconPhosphorIcons Kind="CircleHalfFill" RenderTransformOrigin="0.5,0.5"
                                                  Margin="0" Width="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons.Style>
                            <Style TargetType="iconPacks:PackIconPhosphorIcons" BasedOn="{StaticResource securityIconPhosphor}">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UtmHemisphereNorth}" Value="False">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="90"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconPhosphorIcons.Style>
                    </iconPacks:PackIconPhosphorIcons>
                </ToggleButton>

            </Grid>
        </Border>

        <!-- Options: X,Y vs Y,X -->
        <Border Grid.Row="4" Style="{StaticResource cardBorder}"
                Visibility="{Binding ShowXYOrderOptions, Converter={StaticResource boolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding [dialog_geoJsonTopoJsonOpen_orderCoord], Source={StaticResource Localization}}"
                         VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold"/>
                <CheckBox Content="{Binding [dialog_common_eastingFirst], Source={StaticResource Localization}}"
                          IsChecked="{Binding IsLongitudeFirst, Mode=TwoWay}" Margin="8,0,16,0" VerticalAlignment="Center"/>
                <!--<RadioButton Content="X,Y" IsChecked="{Binding IsLongitudeFirst, Mode=TwoWay}" Margin="4,0" VerticalAlignment="Center"
                       ToolTip="{Binding [dialog_geoJsonTopoJsonOpen_orderXY], Source={StaticResource Localization}}"/>
              <RadioButton Content="Y,X" IsChecked="{Binding IsLongitudeFirst, Mode=TwoWay, Converter={StaticResource notConverter}}" Margin="4,0" VerticalAlignment="Center"
                       ToolTip="{Binding [dialog_geoJsonTopoJsonOpen_orderYX], Source={StaticResource Localization}}"/>-->
            </StackPanel>
        </Border>

        <Border Grid.Row="6">

        </Border>
    </Grid>
</UserControl>
