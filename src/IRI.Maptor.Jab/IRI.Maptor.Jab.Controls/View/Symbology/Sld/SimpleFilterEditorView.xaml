<UserControl x:Class="IRI.Maptor.Jab.Controls.View.Symbology.Sld.SimpleFilterEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="400">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CheckBox Grid.Row="0" Margin="4" 
                  Content="Enable Filter" 
                  IsChecked="{Binding HasFilter, Mode=TwoWay}"/>

        <GroupBox Grid.Row="1" Header="Filter Settings" Margin="4" 
                  IsEnabled="{Binding HasFilter}">
            <StackPanel>
                <TextBlock Text="Filter Expression:" Margin="4"/>
                <TextBox Margin="4" Height="60" TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding FilterDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"/>
                <TextBlock Margin="4" FontStyle="Italic" FontSize="10" Foreground="Gray"
                           Text="Note: This is a simplified view. For complex filters, edit the XML directly or use a specialized filter builder."/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>

