<UserControl x:Class="IRI.Maptor.Jab.Controls.View.Symbology.Sld.SldEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:IRI.Maptor.Jab.Controls.View.Symbology.Sld"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- DataTemplate for PointSymbolizer -->
        <DataTemplate x:Key="PointSymbolizerTemplate">
            <local:PointSymbolizerView DataContext="{Binding}"/>
        </DataTemplate>
        
        <!-- DataTemplate for LineSymbolizer -->
        <DataTemplate x:Key="LineSymbolizerTemplate">
            <local:LineSymbolizerView DataContext="{Binding}"/>
        </DataTemplate>
        
        <!-- DataTemplate for PolygonSymbolizer -->
        <DataTemplate x:Key="PolygonSymbolizerTemplate">
            <local:PolygonSymbolizerView DataContext="{Binding}"/>
        </DataTemplate>
        
        <!-- DataTemplate for TextSymbolizer -->
        <DataTemplate x:Key="TextSymbolizerTemplate">
            <local:TextSymbolizerView DataContext="{Binding}"/>
        </DataTemplate>
        
        <!-- Symbolizer Type Selector -->
        <local:SymbolizerDataTemplateSelector x:Key="SymbolizerTemplateSelector"
            PointTemplate="{StaticResource PointSymbolizerTemplate}"
            LineTemplate="{StaticResource LineSymbolizerTemplate}"
            PolygonTemplate="{StaticResource PolygonSymbolizerTemplate}"
            TextTemplate="{StaticResource TextSymbolizerTemplate}"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Style Information -->
        <GroupBox Grid.Row="0" Header="Style Information" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Layer Name:" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="4" 
                         Text="{Binding LayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Style Name:" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="4" 
                         Text="{Binding StyleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Style Title:" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="4" 
                         Text="{Binding StyleTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Abstract:" VerticalAlignment="Top" Margin="4"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="4" Height="50" 
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Text="{Binding StyleAbstract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </GroupBox>

        <!-- Main Content with Rules and Symbolizers -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Rules List -->
            <GroupBox Grid.Column="0" Header="Rules">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                        <Button Command="{Binding AddRuleCommand}" ToolTip="Add Rule" Width="32" Height="32" Margin="2">
                            <iconPacks:PackIconModern Kind="Add" />
                        </Button>
                        <Button Command="{Binding RemoveRuleCommand}" ToolTip="Remove Rule" Width="32" Height="32" Margin="2">
                            <iconPacks:PackIconModern Kind="Delete" />
                        </Button>
                        <Button Command="{Binding MoveRuleUpCommand}" ToolTip="Move Up" Width="32" Height="32" Margin="2">
                            <iconPacks:PackIconModern Kind="Up" />
                        </Button>
                        <Button Command="{Binding MoveRuleDownCommand}" ToolTip="Move Down" Width="32" Height="32" Margin="2">
                            <iconPacks:PackIconModern Kind="Down" />
                        </Button>
                    </StackPanel>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Rules}" 
                             SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             Margin="4"/>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Rule Details -->
            <TabControl Grid.Column="2" 
                        IsEnabled="{Binding SelectedRule, Converter={StaticResource BoolToVis}}">
                
                <!-- Rule Properties Tab -->
                <TabItem Header="Rule Properties">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <GroupBox Header="General">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="4" 
                                             Text="{Binding SelectedRule.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Title:" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4" 
                                             Text="{Binding SelectedRule.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Abstract:" VerticalAlignment="Top" Margin="4"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="4" Height="50" 
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             Text="{Binding SelectedRule.Abstract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Scale Range" Margin="0,10,0,0">
                                <local:ScaleRangeEditorView DataContext="{Binding SelectedRule}"/>
                            </GroupBox>

                            <GroupBox Header="Filter" Margin="0,10,0,0">
                                <local:SimpleFilterEditorView DataContext="{Binding SelectedRule}"/>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Symbolizers Tab -->
                <TabItem Header="Symbolizers">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Symbolizer Toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                            <Button Command="{Binding SelectedRule.AddPointSymbolizerCommand}" 
                                    ToolTip="Add Point Symbolizer" Width="32" Height="32" Margin="2">
                                <iconPacks:PackIconModern Kind="LocationDot" />
                            </Button>
                            <Button Command="{Binding SelectedRule.AddLineSymbolizerCommand}" 
                                    ToolTip="Add Line Symbolizer" Width="32" Height="32" Margin="2">
                                <iconPacks:PackIconModern Kind="PathMake" />
                            </Button>
                            <Button Command="{Binding SelectedRule.AddPolygonSymbolizerCommand}" 
                                    ToolTip="Add Polygon Symbolizer" Width="32" Height="32" Margin="2">
                                <iconPacks:PackIconModern Kind="Shape" />
                            </Button>
                            <Button Command="{Binding SelectedRule.AddTextSymbolizerCommand}" 
                                    ToolTip="Add Text Symbolizer" Width="32" Height="32" Margin="2">
                                <iconPacks:PackIconModern Kind="TextBox" />
                            </Button>
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>
                            <Button Command="{Binding SelectedRule.RemoveSymbolizerCommand}" 
                                    ToolTip="Remove Symbolizer" Width="32" Height="32" Margin="2">
                                <iconPacks:PackIconModern Kind="Delete" />
                            </Button>
                        </StackPanel>

                        <!-- Symbolizers List -->
                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding SelectedRule.Symbolizers}" 
                                 SelectedItem="{Binding SelectedRule.SelectedSymbolizer, Mode=TwoWay}"
                                 DisplayMemberPath="SymbolizerType"
                                 Margin="4"/>

                        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="LightGray"/>

                        <!-- Symbolizer Editor -->
                        <GroupBox Grid.Row="3" Header="Symbolizer Properties" Margin="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ContentControl Content="{Binding SelectedRule.SelectedSymbolizer}"
                                              ContentTemplateSelector="{StaticResource SymbolizerTemplateSelector}"/>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- XML Preview Tab -->
                <TabItem Header="XML Preview">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                            <Button Content="Export to File..." Width="120" Margin="4"/>
                            <Button Content="Import from File..." Width="120" Margin="4"/>
                        </StackPanel>
                        
                        <TextBox Grid.Row="1" 
                                 Margin="4" 
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Text="XML preview will be displayed here"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>

