<UserControl x:Class="IRI.Maptor.Jab.Controls.View.Symbology.Sld.PointSymbolizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:sld="clr-namespace:IRI.Maptor.Sta.Ogc.SLD;assembly=IRI.Maptor.Sta.Ogc"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="350">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mark Type:" VerticalAlignment="Center" Margin="4"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Margin="4" SelectedItem="{Binding WellKnownMarkType}">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sld:WellKnownMark}">
                    <sld:WellKnownMark>circle</sld:WellKnownMark>
                    <sld:WellKnownMark>square</sld:WellKnownMark>
                    <sld:WellKnownMark>triangle</sld:WellKnownMark>
                    <sld:WellKnownMark>star</sld:WellKnownMark>
                    <sld:WellKnownMark>cross</sld:WellKnownMark>
                    <sld:WellKnownMark>x</sld:WellKnownMark>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Size:" VerticalAlignment="Center" Margin="4"/>
        <mahApp:NumericUpDown Grid.Row="1" Grid.Column="1" Margin="4" 
                              Value="{Binding Size, Mode=TwoWay}" 
                              Minimum="1" Maximum="100" Interval="1"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Rotation:" VerticalAlignment="Center" Margin="4"/>
        <mahApp:NumericUpDown Grid.Row="2" Grid.Column="1" Margin="4" 
                              Value="{Binding Rotation, Mode=TwoWay}" 
                              Minimum="0" Maximum="360" Interval="1"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Fill Color:" VerticalAlignment="Center" Margin="4"/>
        <mahApp:ColorPicker Grid.Row="3" Grid.Column="1" Margin="4" 
                            SelectedColor="{Binding FillColor, Mode=TwoWay}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Fill Opacity:" VerticalAlignment="Center" Margin="4"/>
        <Slider Grid.Row="4" Grid.Column="1" Margin="4" 
                Value="{Binding FillOpacity, Mode=TwoWay}" 
                Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Stroke Color:" VerticalAlignment="Center" Margin="4"/>
        <mahApp:ColorPicker Grid.Row="5" Grid.Column="1" Margin="4" 
                            SelectedColor="{Binding StrokeColor, Mode=TwoWay}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Stroke Width:" VerticalAlignment="Center" Margin="4"/>
        <mahApp:NumericUpDown Grid.Row="6" Grid.Column="1" Margin="4" 
                              Value="{Binding StrokeWidth, Mode=TwoWay}" 
                              Minimum="0" Maximum="20" Interval="0.5"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Stroke Opacity:" VerticalAlignment="Center" Margin="4"/>
        <Slider Grid.Row="7" Grid.Column="1" Margin="4" 
                Value="{Binding StrokeOpacity, Mode=TwoWay}" 
                Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Geometry Property:" VerticalAlignment="Center" Margin="4"/>
        <TextBox Grid.Row="8" Grid.Column="1" Margin="4" 
                 Text="{Binding GeometryPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>

