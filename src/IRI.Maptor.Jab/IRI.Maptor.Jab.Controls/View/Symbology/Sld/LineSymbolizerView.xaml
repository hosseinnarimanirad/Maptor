<UserControl x:Class="IRI.Maptor.Jab.Controls.View.Symbology.Sld.LineSymbolizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:sld="clr-namespace:IRI.Maptor.Sta.Ogc.SLD;assembly=IRI.Maptor.Sta.Ogc"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="350">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Stroke Color:" VerticalAlignment="Center" Margin="4"/>
        <mahApp:ColorPicker Grid.Row="0" Grid.Column="1" Margin="4" 
                            SelectedColor="{Binding StrokeColor, Mode=TwoWay}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Stroke Width:" VerticalAlignment="Center" Margin="4"/>
        <mahApp:NumericUpDown Grid.Row="1" Grid.Column="1" Margin="4" 
                              Value="{Binding StrokeWidth, Mode=TwoWay}" 
                              Minimum="0" Maximum="50" Interval="0.5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Stroke Opacity:" VerticalAlignment="Center" Margin="4"/>
        <Slider Grid.Row="2" Grid.Column="1" Margin="4" 
                Value="{Binding StrokeOpacity, Mode=TwoWay}" 
                Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Line Cap:" VerticalAlignment="Center" Margin="4"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="4" SelectedItem="{Binding LineCap}">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sld:Sld_StrokeLineCap}">
                    <sld:Sld_StrokeLineCap>Butt</sld:Sld_StrokeLineCap>
                    <sld:Sld_StrokeLineCap>Round</sld:Sld_StrokeLineCap>
                    <sld:Sld_StrokeLineCap>Square</sld:Sld_StrokeLineCap>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Line Join:" VerticalAlignment="Center" Margin="4"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Margin="4" SelectedItem="{Binding LineJoin}">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sld:Sld_StrokeLineJoin}">
                    <sld:Sld_StrokeLineJoin>Mitre</sld:Sld_StrokeLineJoin>
                    <sld:Sld_StrokeLineJoin>Round</sld:Sld_StrokeLineJoin>
                    <sld:Sld_StrokeLineJoin>Bevel</sld:Sld_StrokeLineJoin>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Dash Array:" VerticalAlignment="Center" Margin="4"/>
        <TextBox Grid.Row="5" Grid.Column="1" Margin="4" 
                 Text="{Binding DashArray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 mahApp:TextBoxHelper.Watermark="e.g., 5 5 or 10 5 3 5"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Geometry Property:" VerticalAlignment="Center" Margin="4"/>
        <TextBox Grid.Row="6" Grid.Column="1" Margin="4" 
                 Text="{Binding GeometryPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>

