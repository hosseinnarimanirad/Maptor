<userControl:NotifiableUserControl x:Class="IRI.Maptor.Jab.Controls.View.Scalebar" Name="layoutRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"
             xmlns:userControl="clr-namespace:IRI.Maptor.Jab.Common;assembly=IRI.Maptor.Jab.Common"
             Width="auto" Height="auto" Opacity="0.8" >
    <userControl:NotifiableUserControl.Resources>
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        <Storyboard x:Key="OnMouseEnter1">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="layoutRoot" To="1" Duration="0:0:.3"></DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="OnMouseLeave1">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="layoutRoot" To=".8" Duration="0:0:.3"></DoubleAnimation>
        </Storyboard>
    </userControl:NotifiableUserControl.Resources>
    <userControl:NotifiableUserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard x:Name="OnMouseEnter1_BeginStoryboard" Storyboard="{StaticResource OnMouseEnter1}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard x:Name="OnMouseLeave1_BeginStoryboard" Storyboard="{StaticResource OnMouseLeave1}"/>
        </EventTrigger>
    </userControl:NotifiableUserControl.Triggers>
    <Border Background="White" CornerRadius="5" >
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions> 
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Visibility="{Binding ElementName=layoutRoot, Path=ShowZoomLevel, Converter={StaticResource boolToVisibilityConverter}}">
                <TextBlock Text="{Binding [map_scalebar_zoomLevel], Source={StaticResource Localization}, StringFormat={}{0}:}"/>
                <TextBlock Text="{Binding ElementName=layoutRoot, Path=ZoomLevel, Converter={StaticResource localizedNumberConverter}, FallbackValue=-1}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center"
                        Visibility="{Binding ElementName=layoutRoot, Path=ShowScaleValue, Converter={StaticResource boolToVisibilityConverter}}">
                <TextBlock Text="{Binding [map_scalebar_content], Source={StaticResource Localization}, StringFormat={}{0}:}"/>
                <TextBlock Margin="0" HorizontalAlignment="Center" 
                           Text="{Binding ElementName=layoutRoot, Path=CurrentScale, StringFormat='{}1:{0:N0}', FallbackValue=1:~}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" >
                <StackPanel VerticalAlignment="Center">
                    <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="2,0,2,2" Height="6" Margin="0" CornerRadius="1" 
                            Width="{Binding ElementName=layoutRoot, Path=ScaleBarLength, FallbackValue=120}" 
                            Visibility="{Binding ElementName=layoutRoot, Path=IsGoogleStyle, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=true}"/>
                    <Border BorderBrush="{DynamicResource MahApps.Brushes.Highlight}" BorderThickness="0.5" VerticalAlignment="Center"
                            Visibility="{Binding ElementName=layoutRoot, Path=IsGoogleStyle, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=false}">
                        <Grid Width="{Binding ElementName=layoutRoot, Path=ScaleBarLength, FallbackValue=120}" Height="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource MahApps.Brushes.Highlight}" Grid.Row="0" Grid.Column="0"/>
                            <Border Background="{DynamicResource MahApps.Brushes.Highlight}" Grid.Row="1" Grid.Column="1"/>
                            <Border Background="{DynamicResource MahApps.Brushes.Highlight}" Grid.Row="0" Grid.Column="2"/>
                            <Border Background="{DynamicResource MahApps.Brushes.Highlight}" Grid.Row="1" Grid.Column="3"/>

                            <Border Background="{DynamicResource MahApps.Brushes.Highlight}" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="4"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding ElementName=layoutRoot, Path=GroundLength, FallbackValue=0, Converter={StaticResource localizedNumberConverter}}" FlowDirection="LeftToRight" Margin="2,0" />
            </StackPanel>
        </Grid>
    </Border>
</userControl:NotifiableUserControl>
