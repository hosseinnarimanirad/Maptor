<UserControl x:Class="IRI.Maptor.Jab.Controls.View.FeatureTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls.View" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization;assembly=IRI.Maptor.Jab.Common"    
             x:Name="root">
    <UserControl.Resources>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="mahApp:HeaderedControlHelper.HeaderFontSize" Value="15"></Setter>
        </Style>
        <DataTemplate x:Key="FeatureTableTemplate">
            <maptor:FeatureTable 
                DataContext="{Binding}"  
                IsZoomToGeometryEnabled="{Binding ElementName=root, Path=IsZoomToGeometryEnabled}"
                CanUserEditGeometry="{Binding ElementName=root, Path=CanUserEditGeometry}" 
                CanUserEditAttribute="{Binding ElementName=root, Path=CanUserEditAttribute}" />
        </DataTemplate>
    </UserControl.Resources>
    <TabControl ItemsSource="{Binding SelectedLayers}" VerticalAlignment="Stretch" Margin="0"
                SelectedItem="{Binding CurrentLayer, Mode=TwoWay}" Padding="0" SelectedIndex="0">
        <TabControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0">
                    <TextBlock Margin="0" VerticalAlignment="Center" FontFamily="{StaticResource iranSans}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} ({1})">
                                <Binding Path="LayerName"/>
                                <Binding Path="Features.Count" Converter="{StaticResource localizedNumberConverter}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button Command="{Binding RemoveCommand}" Style="{x:Null}"
                            Cursor="Hand" Margin="8,2,2,2" Height="15"
                            Padding="2" VerticalAlignment="Center" BorderThickness="0">
                        <Viewbox>
                            <iconPacks:PackIconModern Kind="Close" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
            <DataTemplate>
                <maptor:FeatureTable    DataContext="{Binding }"
                                        IsZoomToGeometryEnabled="{Binding ElementName=root, Path=IsZoomToGeometryEnabled}"
                                        CanUserEditGeometry="{Binding ElementName=root, Path=CanUserEditGeometry}" 
                                        CanUserEditAttribute="{Binding ElementName=root, Path=CanUserEditAttribute}" />
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>
