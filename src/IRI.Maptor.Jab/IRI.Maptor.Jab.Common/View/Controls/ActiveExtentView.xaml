<UserControl x:Class="IRI.Maptor.Jab.Common.View.Controls.ActiveExtentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IRI.Maptor.Jab.Common.View.Controls" Width="200" Height="150">
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform />
        </TransformGroup>
    </UserControl.RenderTransform>
    <Grid>
        <Grid.Resources>
            <Style TargetType="Ellipse">
                <Setter Property="Height" Value="10"/>
                <Setter Property="Width" Value="10"/>
                <Setter Property="Fill" Value="White"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="Stroke" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Stroke" Value="White"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#1E90FF" ShadowDepth="0" BlurRadius="8" Opacity="0.7"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style  TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="CornerRadius" Value="2" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#1E90FF" ShadowDepth="0" BlurRadius="10" Opacity="0.5"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <Border Margin="3"  Cursor="SizeAll" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Ellipse Cursor="SizeNS" HorizontalAlignment="Center" VerticalAlignment="Top" x:Name="topEllipse" MouseLeftButtonDown="Ellipse_MouseLeftButtonDown" />
        <Ellipse Cursor="SizeWE" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="rightEllipse" MouseLeftButtonDown="Ellipse_MouseLeftButtonDown" />
        <Ellipse Cursor="SizeNS" HorizontalAlignment="Center" VerticalAlignment="Bottom" x:Name="bottomEllipse" MouseLeftButtonDown="Ellipse_MouseLeftButtonDown" />
        <Ellipse Cursor="SizeWE" HorizontalAlignment="Left" VerticalAlignment="Center" x:Name="leftEllipse" MouseLeftButtonDown="Ellipse_MouseLeftButtonDown" />
    </Grid>
</UserControl>
