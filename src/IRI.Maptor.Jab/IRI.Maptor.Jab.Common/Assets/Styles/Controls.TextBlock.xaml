<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization">

    <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

    <Style x:Key="IRI.Maptor.Styles.TextBlock"
           TargetType="TextBlock"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource Localization}, Path=IsPersian}" Value="True">
                <Setter Property="FontFamily" Value="{DynamicResource iranSans}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--Headers-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.WindowTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="8 0 8 0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBlock.HeaderTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!--Form-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.Form"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}"> 
        <Setter Property="Margin" Value="4"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBlock.FormBold"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.Form}">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!--Dialog-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.DialogButtonContent"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FontSize" Value="13"/>

    </Style>


</ResourceDictionary>
    