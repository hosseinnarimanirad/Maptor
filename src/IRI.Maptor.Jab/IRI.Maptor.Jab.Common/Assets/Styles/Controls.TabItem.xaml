<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization">

    <Style x:Key="IRI.Maptor.Styles.TabItem"
           TargetType="{x:Type TabItem}"
           BasedOn="{StaticResource MahApps.Styles.TabItem}">
        <Setter Property="mahApp:HeaderedControlHelper.HeaderFontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,4"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!--<Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>-->
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="mahApp:HeaderedControlHelper.HeaderFontWeight" Value="Bold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TabItem.Form"
          TargetType="{x:Type TabItem}" BasedOn="{StaticResource IRI.Maptor.Styles.TabItem}">
        <Setter Property="mahApp:HeaderedControlHelper.HeaderFontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,4"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource IRI.Maptor.Styles.TextBlock}"
                               Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}, Path=Foreground}"
                               IsEnabled="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}, Path=IsEnabled}">
                        <!--<TextBlock.Style>
                            <Style TargetType="TextBlock">
                                --><!--<Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>--><!--
                                <Style.Triggers>
                                    --><!--<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}, Path=IsEnabled}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                                    </DataTrigger>--><!--
                                    <DataTrigger Binding="{Binding Source={StaticResource Localization}, Path=IsPersian}" Value="True">
                                        <Setter Property="FontFamily" Value="{DynamicResource iranSans}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>-->
                    </TextBlock>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <!--External Visual Only
        - What it does: Draws a visual outside or around the control
        (like a dashed rectangle) without altering the control's
        own appearance.
        - When it appears: Only when the control gets keyboard focus
        (Tab key, arrow keys, etc.). Not on mouse click.
        - What it cannot do: Change the control’s own Background,
        BorderBrush, Foreground, or any other internal property.-->
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Rectangle Margin="2" Stroke="{DynamicResource MahApps.Brushes.Highlight}" 
                                   StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <!--<Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>-->
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                <Setter Property="mahApp:HeaderedControlHelper.HeaderFontWeight" Value="Bold"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>

                <!--<Setter Property="Foreground" Value="{StaticResource MahApps.Brushes.Gray4}"/>-->
            </Trigger>

            <!--- Internal Property Changes when keyboard focus
            - What it does: Fires when the control has keyboard focus.
            You can change any property of the control itself –
            background, border, foreground, font weight, etc.

            - When it appears: When the control is focused via keyboard
            (Tab) or programmatically (Focus()) – not from mouse click
            (unless you also handle IsFocused, which also triggers on
            mouse click).

            - What it cannot do: Draw something outside the control’s own
            bounds without additional elements (though you could add an
            outer border by modifying the template).-->
            <!--<Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
            </Trigger>-->

        </Style.Triggers>
    </Style>
</ResourceDictionary>