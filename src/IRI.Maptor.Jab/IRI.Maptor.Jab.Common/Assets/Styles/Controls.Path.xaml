    <!--PackIcon inside a light circle button-->
    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent" TargetType="iconPacks:PackIconMaterial">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ButtonContent"
           TargetType="iconPacks:PackIconMaterial"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}">
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ChevronPrevious"
           TargetType="iconPacks:PackIconMaterial"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}">
        <Setter Property="Kind" Value="ChevronLeft"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
                         Value="{x:Static FlowDirection.RightToLeft}">
                <Setter Property="Kind" Value="ChevronRight"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.PackIconMaterial.ChevronNext"
           TargetType="iconPacks:PackIconMaterial"
           BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}">
        <Setter Property="Kind" Value="ChevronRight"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
                         Value="{x:Static FlowDirection.RightToLeft}">
                <Setter Property="Kind" Value="ChevronLeft"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--PackIcon inside a light circle button-->
    <Style x:Key="IRI.Maptor.Styles.PackIconPhosphorIcons.CircleLightButtonContent"
           TargetType="iconPacks:PackIconPhosphorIcons">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="IRI.Maptor.Styles.Path.ButtonContent" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    
    <Style x:Key="circleButtonPath" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

</ResourceDictionary>