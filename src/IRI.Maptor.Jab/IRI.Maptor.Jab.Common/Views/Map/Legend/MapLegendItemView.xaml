<UserControl x:Class="IRI.Maptor.Jab.Controls.MapLegendItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:model="clr-namespace:IRI.Maptor.Jab.Common.Models.Legend" 
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls"
             xmlns:enums="clr-namespace:IRI.Maptor.Sta.Common.Enums;assembly=IRI.Maptor.Sta.Common"
             xmlns:localization="clr-namespace:IRI.Maptor.Jab.Core.Localization;assembly=IRI.Maptor.Jab.Core"
             FontFamily="{StaticResource iranSans}"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <DataTemplate DataType="{x:Type model:LegendToggleCommand}">
                <ToggleButton Focusable="False" ToolTip="{Binding ToolTip}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                              Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"
                              Visibility="{Binding IsCommandVisible, Converter={StaticResource boolToVisibilityConverter}}">
                    <!--<ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Opacity" Value="0.9"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Grid>
                                            <Ellipse x:Name="ellipse" Margin="1" 
                                                     Fill="{TemplateBinding Property=Background}"
                                                     Stroke="{TemplateBinding Property=BorderBrush}"
                                                     StrokeThickness="{TemplateBinding Property=BorderThickness}">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.25" Color="Black"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="LightGray"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>-->

                    <Path Stretch="Uniform" Width="18" Height="18" FlowDirection="LeftToRight" Margin="0"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton, Mode=FindAncestor}}" >
                        <Path.Style>
                            <Style TargetType="{x:Type Path}" >
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton, Mode=FindAncestor}}" Value="True">
                                        <Setter Property="Data" Value="{Binding PathMarkup}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton, Mode=FindAncestor}}" Value="False">
                                        <Setter Property="Data" Value="{Binding NotSelectedPathMarkup}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </ToggleButton>
            </DataTemplate>
            <DataTemplate DataType="{x:Type model:LegendCommand}">
                <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                        Margin="1" Focusable="False"  
                        Command="{Binding Command}"
                        IsEnabled="{Binding IsEnabled}" 
                        ToolTip="{Binding ToolTip}"
                        Visibility="{Binding IsCommandVisible, Converter={StaticResource boolToVisibilityConverter}}">
                    <Path Data="{Binding PathMarkup}" Style="{StaticResource circleButtonPath}"/>
                </Button>
            </DataTemplate>

            <!--Group layer-->
            <DataTemplate x:Key="GroupLayerTemplate">

                <!--<DockPanel Visibility="{Binding IsGroupLayer, Converter={StaticResource boolToVisibilityConverter}}">-->
                <DockPanel Height="26">

                    <!--reorder layer-->
                    <StackPanel DockPanel.Dock="Right" Margin="4,0">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                                <Binding Path="IsMouseOver" ElementName="root"/>
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <StackPanel.Resources>
                            <Style x:Key="ChevronUpButton" TargetType="Button">
                                <Setter Property="Width" Value="16"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="Margin" Value="0,1,0,1"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <iconPacks:PackIconMaterial Kind="ChevronUp"
                                                                 Margin="{TemplateBinding Margin}"
                                                                 Padding="{TemplateBinding Padding}"
                                                                 Width="{TemplateBinding Width}"
                                                                 Height="{TemplateBinding Height}"
                                                                 Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="ChevronDownButton" TargetType="Button">
                                <Setter Property="Width" Value="16"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="Margin" Value="0,1,0,1"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Margin="0" Padding="0">
                                                <iconPacks:PackIconMaterial Kind="ChevronDown"
                                                                 Margin="{TemplateBinding Margin}"
                                                                 Padding="{TemplateBinding Padding}"
                                                                 Width="{TemplateBinding Width}"
                                                                 Height="{TemplateBinding Height}"
                                                                 Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                        </StackPanel.Resources>
                        <StackPanel DockPanel.Dock="Right" Background="{x:Null}" >
                            <Button Style="{StaticResource ChevronUpButton}"
                                    Command="{Binding MoveLayerUpCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource rootItemsSourceConverter}}"/>
                            <Button Style="{StaticResource ChevronDownButton}"
                                    Command="{Binding MoveLayerDownCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource rootItemsSourceConverter}}"/>
                        </StackPanel>
                    </StackPanel >

                    <!--on/off rendering [currently collapsed]-->
                    <Viewbox DockPanel.Dock="Left" Width="40" Height="24" Visibility="Collapsed">
                        <mahApp:ToggleSwitch Margin="2" VerticalAlignment="Center" 
                                            Padding="0" MinWidth="0" MinHeight="0"                                   
                                            Content="" OffContent="" OnContent=""
                                            Style="{StaticResource IRI.Maptor.Styles.ToggleSwitch.Normal}"
                                            Cursor="Hand"
                                            IsOn="{Binding Visibility, Mode=TwoWay, Converter={StaticResource visibilityToBoolConverter}}"/>
                    </Viewbox>

                    <ToggleButton DockPanel.Dock="Left" Name="GroupVisibility"
                                  ClickMode="Press"
                                  IsChecked="{Binding Visibility, Mode=TwoWay, Converter={StaticResource visibilityToBoolConverter}}"                            
                                  Margin="2,0" Padding="0" Cursor="Hand"
                                  Visibility="Collapsed">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="UIElement.Focusable" Value="false" />
                                <Setter Property="FrameworkElement.Width" Value="18" />
                                <Setter Property="FrameworkElement.Height" Value="18" />
                                <Setter Property="Control.Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <iconPacks:PackIconMaterial VerticalAlignment="Center">
                                                <iconPacks:PackIconMaterial.Style>
                                                    <Style TargetType="iconPacks:PackIconMaterial">
                                                        <Setter Property="Kind" Value="Eye" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=GroupVisibility, Path=IsChecked}" Value="True">
                                                                <Setter Property="Kind" Value="EyeOff" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconMaterial.Style>
                                            </iconPacks:PackIconMaterial>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!--all childs visible-->
                    <CheckBox DockPanel.Dock="Left"
                               Margin="2,0"
                               VerticalAlignment="Center"
                               Padding="0"
                               Cursor="Hand"
                               IsChecked="{Binding AllChildsVisible, Mode=TwoWay}"
                               IsThreeState="True">
                        <!--Visibility="{Binding IsBusy, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False}"-->
                        <CheckBox.Visibility>
                            <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                                <Binding Path="IsNotBusy"/>
                                <Binding Path="IsInScaleRange"/>
                            </MultiBinding>
                        </CheckBox.Visibility>
                    </CheckBox>

                    <!--group layer title-->
                    <TextBlock DockPanel.Dock="Left" MinWidth="30" VerticalAlignment="Center" Margin="4"  
                                Text="{Binding LayerName, Mode=TwoWay}" 
                                FontSize="{Binding ElementName=root, Path=TitleFontSize}"
                                Visibility="{Binding IsGroupLayer, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=True}"/>

                </DockPanel>

            </DataTemplate>

            <DataTemplate x:Key="NormalLayerTemplate">

                <!--Normal layer-->
                <StackPanel HorizontalAlignment="Stretch" Margin="0" MinHeight="26">
                    <!--Visibility="{Binding IsGroupLayer, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False}">-->
                    <DockPanel Margin="0" LastChildFill="False" Height="26">

                        <!--Layer Options-->
                        <Button DockPanel.Dock="Right" Width="20" Height="20" Focusable="True" Margin="4,0"
                        Command="{Binding ShowLayerSettingsCommand}" 
                         BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">

                                    <!-- Light theme colors -->
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Width" Value="26"/>
                                    <Setter Property="Height" Value="26"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <Viewbox>
                                                        <iconPacks:PackIconMaterial Kind="DotsHorizontal"
                                                                         Margin="2"
                                                                         Padding="{TemplateBinding Padding}"
                                                                         Width="{TemplateBinding Width}"
                                                                         Height="{TemplateBinding Height}"
                                                                         Foreground="{TemplateBinding Foreground}"/>
                                                    </Viewbox>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                                    <Binding Path="ShowMoreOptions" ElementName="root"/>
                                    <Binding Path="IsMouseOver" ElementName="root"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>

                        <!--reorder layer-->
                        <StackPanel DockPanel.Dock="Right" Margin="4,0">
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                                    <Binding Path="IsMouseOver" ElementName="root"/>
                                </MultiBinding>
                            </StackPanel.Visibility>
                            
                            <StackPanel.Resources>
                                <Style x:Key="ChevronUpButton" TargetType="Button">
                                    <Setter Property="Width" Value="16"/>
                                    <Setter Property="Height" Value="12"/>
                                    <Setter Property="Margin" Value="0,1,0,1"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <iconPacks:PackIconMaterial Kind="ChevronUp"
                                                                        Margin="{TemplateBinding Margin}"
                                                                        Padding="{TemplateBinding Padding}"
                                                                        Width="{TemplateBinding Width}"
                                                                        Height="{TemplateBinding Height}"
                                                                        Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style x:Key="ChevronDownButton" TargetType="Button">
                                    <Setter Property="Width" Value="16"/>
                                    <Setter Property="Height" Value="12"/>
                                    <Setter Property="Margin" Value="0,1,0,1"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" Margin="0" Padding="0">
                                                    <iconPacks:PackIconMaterial Kind="ChevronDown"
                                                                        Margin="{TemplateBinding Margin}"
                                                                        Padding="{TemplateBinding Padding}"
                                                                        Width="{TemplateBinding Width}"
                                                                        Height="{TemplateBinding Height}"
                                                                        Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>


                            </StackPanel.Resources>
                            <StackPanel DockPanel.Dock="Right" Background="{x:Null}" >
                                <Button Style="{StaticResource ChevronUpButton}"
                                        Command="{Binding MoveLayerUpCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource rootItemsSourceConverter}}"/>
                                <Button Style="{StaticResource ChevronDownButton}"
                                        Command="{Binding MoveLayerDownCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource rootItemsSourceConverter}}"/>
                            </StackPanel>
                        </StackPanel >

                        <!--source type color indicator-->
                        <Rectangle DockPanel.Dock="Left" Width="6" Height="18" Margin="1,0,0,0" VerticalAlignment="Stretch"
                           Fill="{Binding DataSource.DataSourceKind, Converter={StaticResource dataSourceKindToBrushConverter}}"
                           ToolTip="{Binding DataSource.DataSourceKind}"
                           IsEnabled="{Binding IsInScaleRange}"
                           Visibility="{Binding Path=ShowLayerColors, RelativeSource={RelativeSource AncestorType=maptor:NotifiableUserControl}, Converter={StaticResource boolToVisibilityConverter}}"/>

                        <!--layer visiblity checkbox-->
                        <CheckBox DockPanel.Dock="Left" Margin="2,0" VerticalAlignment="Center" Padding="0"
                          IsChecked="{Binding Visibility, Mode=TwoWay, Converter={StaticResource visibilityToBoolConverter}}"
                          IsEnabled="{Binding IsInScaleRange}">
                            <!--Visibility="{Binding IsBusy, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False}"-->
                            <CheckBox.Visibility>
                                <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                                    <Binding Path="IsNotBusy"/>
                                    <Binding Path="IsInScaleRange"/>
                                </MultiBinding>
                            </CheckBox.Visibility>
                        </CheckBox>

                        <!--loading layer #1-->
                        <iconPacks:PackIconPhosphorIcons DockPanel.Dock="Left" Kind="SpinnerGapBold" Spin="True" Width="18" Height="18"                    
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="2,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=True}">

                            <!--<iconPacks:PackIconPhosphorIcons.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </iconPacks:PackIconPhosphorIcons.RenderTransform>
                    <iconPacks:PackIconPhosphorIcons.Style>
                        <Style TargetType="iconPacks:PackIconPhosphorIcons">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard> 
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1"
                                                 Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
 
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                 From="0" To="360"
                                                 Duration="0:0:1.5"
                                                 RepeatBehavior="Forever">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CircleEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </iconPacks:PackIconPhosphorIcons.Style>-->
                        </iconPacks:PackIconPhosphorIcons>

                        <!--loading layer #2-->
                        <mahApp:ProgressRing DockPanel.Dock="Left" Width="18" Height="18"  IsLarge="True"
                                    VerticalAlignment="Center" Margin="2,0"
                                    Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                    Visibility="Collapsed"/>
                        <!--Visibility="{Binding IsBusy, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=True}"/>-->

                        <!--locked layer (not in scale range layer)-->
                        <iconPacks:PackIconMaterial DockPanel.Dock="Left" Kind="Lock" Width="18" Height="18"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MahApps.Brushes.Badged.Background.Disabled}" Margin="2,0"
                                                 >
                            <!--Visibility="{Binding IsInScaleRange, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False}"-->
                            <iconPacks:PackIconMaterial.Visibility>
                                <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                                    <Binding Path="IsNotBusy"/>
                                    <Binding Path="IsNotInScaleRange"/>
                                </MultiBinding>
                            </iconPacks:PackIconMaterial.Visibility>

                        </iconPacks:PackIconMaterial>

                        <!--visibility toggle button with Eye and EyeOff iconPacks-->
                        <ToggleButton Name="Expander" DockPanel.Dock="Left" ClickMode="Press" Margin="2,0" Padding="0" Cursor="Hand"
                                IsChecked="{Binding Visibility, Mode=TwoWay, Converter={StaticResource visibilityToBoolConverter}}"                            
                                IsEnabled="{Binding IsInScaleRange}"
                                Visibility="Collapsed">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="UIElement.Focusable" Value="false" />
                                    <Setter Property="FrameworkElement.Width" Value="24" />
                                    <Setter Property="FrameworkElement.Height" Value="24" />
                                    <Setter Property="Control.Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <iconPacks:PackIconMaterial VerticalAlignment="Center">
                                                    <iconPacks:PackIconMaterial.Style>
                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                            <Setter Property="Kind" Value="Eye" />
                                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=Expander, Path=IsChecked}" Value="True">
                                                                    <Setter Property="Kind" Value="EyeOff" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconMaterial.Style>
                                                </iconPacks:PackIconMaterial>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <iconPacks:PackIconMaterial DockPanel.Dock="Left" Margin="0,0,2,0" Width="18" Height="18" VerticalAlignment="Center"  
                                            Kind="FormatTitle" Padding="2"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                            Visibility="{Binding IsTextLayer, Converter={StaticResource boolToVisibilityConverter}}"/>

                        <!--light symbology preview-->
                        <Border DockPanel.Dock="Left" Margin="0,0,2,0" Cursor="Hand" CornerRadius="2" FlowDirection="LeftToRight"  
                        Visibility="{Binding IsSymbolizable, Converter={StaticResource boolToVisibilityConverter}}">
                            <!--IsEnabled="{Binding IsNotBusy, Converter={StaticResource boolToVisibilityConverter}}">-->
                            <Border.IsEnabled>
                                <MultiBinding Converter="{StaticResource multiBooleanToBooleanConverter}">
                                    <Binding Path="IsNotBusy"/>
                                    <Binding Path="IsInScaleRange" />
                                </MultiBinding>
                            </Border.IsEnabled>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Width" Value="18"/>
                                    <Setter Property="Height" Value="18"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="DarkGray"/>
                                            <!--<Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>-->
                                        </Trigger>
                                        <DataTrigger Binding="{Binding SpatialModelMode}" Value="Point">
                                            <!--<Setter Property="Width" Value="12"/>
                                    <Setter Property="Height" Value="12"/>-->
                                            <Setter Property="Padding" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeSymbologyCommand}" CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Viewbox VerticalAlignment="Center">
                                <Path x:Name="OriginalPath"
                                Margin="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Data="{Binding SpatialModelMode, Converter={StaticResource iLayerToLegendConverter}, TargetNullValue={x:Static Geometry.Empty}}"
                                Stroke="{Binding ElementName=root, Path=Symbology.Stroke}"
                                Opacity="{Binding Opacity}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{Binding ElementName=root, Path=Symbology.Fill}"/>
                                            <Setter Property="StrokeThickness" Value="3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpatialModelMode}" Value="Polyline">
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SpatialModelMode}" Value="Point">
                                                    <Setter Property="StrokeThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Viewbox>
                        </Border>

                        <!--layer opacity control-->
                        <Slider x:Name="opacitySlider" DockPanel.Dock="Left" VerticalAlignment="Center" Width="50" Minimum="0" Maximum="1" SmallChange=".1" LargeChange=".2"                         
                        TickFrequency=".2"
                        Value="{Binding Opacity, Mode=TwoWay}"                        
                        IsEnabled="{Binding IsBusy, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False}"/>

                        <!--layer title (textblock)-->
                        <TextBlock DockPanel.Dock="Left" MinWidth="30" VerticalAlignment="Center" Margin="2" 
                            Text="{Binding LayerName}" 
                            FontSize="{Binding ElementName=root, Path=TitleFontSize}"
                            Visibility="{Binding ElementName=root, Path=IsEditable, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False}"/>

                        <!--number of selected features-->
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                            Text="{Binding NumberOfSelectedFeatures, Converter={StaticResource localizedNumberConverter}, StringFormat={}({0:N0})}" 
                            FontSize="{Binding ElementName=root, Path=TitleFontSize}"
                            Visibility="{Binding NumberOfSelectedFeatures, Converter={StaticResource intGreaterThanIntParameterToVisibilityConverter}, ConverterParameter=0}"/>

                        <!--layer title (textbox)-->
                        <TextBox x:Name="layerTitle" DockPanel.Dock="Left" 
                            BorderThickness="1" Padding="0" VerticalAlignment="Center" MinWidth="70"
                            Margin="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            Text="{Binding LayerName, Mode=TwoWay}" 
                            FontSize="{Binding ElementName=root, Path=TitleFontSize}"
                            Visibility="{Binding ElementName=root, Path=IsEditable, Converter={StaticResource boolToVisibilityConverter}}"
                            mahApp:TextBoxHelper.Watermark="{Binding [legendItem_layerTitle], Source={StaticResource Localization}}"
                            mahApp:TextBoxHelper.SelectAllOnFocus="True"
                         KeyDown="layerTitle_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Margin" Value="1"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource IRI.Maptor.Styles.TextBox}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                                    <ScrollViewer x:Name="PART_ContentHost" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!--reload data-->
                        <Button DockPanel.Dock="Left" Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Width="24" Height="24" Focusable="True" Margin="0"
                                Command="{Binding ReloadDataCommand}"
                                ToolTip="{Binding [legendItem_reloadData], Source={StaticResource Localization}}"
                                Visibility="Collapsed">
                            <!--Visibility="{Binding IsMouseOver, ElementName=root, Converter={StaticResource boolToVisibilityConverter}}">-->
                            <!--<Button.Visibility>
                        <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                            <Binding Path="ShowReloadData" ElementName="root"/>
                            <Binding Path="IsMouseOver" ElementName="root"/>
                        </MultiBinding>
                    </Button.Visibility>-->
                            <Viewbox Margin="4">
                                <iconPacks:PackIconMaterial Kind="Refresh" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Viewbox>
                        </Button>

                        <!--pending changes with hover popup-->
                        <Button DockPanel.Dock="Left" Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Width="24" Height="24" Focusable="True"
                                Command="{Binding SaveChangesCommand}"
                                ToolTip="{Binding [legendItem_PendingChanges_Save], Source={StaticResource Localization}}"
                                Visibility="{Binding HasPendingChanges, Converter={StaticResource boolToVisibilityConverter}}">
                            <Viewbox Margin="4">
                                <iconPacks:PackIconMaterial Kind="ContentSave" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Viewbox>
                        </Button>

                        <Button DockPanel.Dock="Left" Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Width="24" Height="24" Focusable="True"  
                                Command="{Binding UndoAllChangesCommand}"
                                ToolTip="{Binding [legendItem_PendingChanges_Undo], Source={StaticResource Localization}}"
                                Visibility="{Binding HasPendingChanges, Converter={StaticResource boolToVisibilityConverter}}">
                            <Viewbox Margin="4">
                                <iconPacks:PackIconMaterial Kind="UndoVariant" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                            </Viewbox>
                        </Button>

                        <!--<Path Width="18" Height="18" Data="M 2,16 L 6,8 L 12,12 L 16,4" Fill="Transparent" Stroke="Black" FlowDirection="LeftToRight"/>-->
                        <iconPacks:PackIconMaterial DockPanel.Dock="Left" Kind="Pencil" Width="16" Height="16" x:Name="pendingChangesTag"
                                            Background="Transparent"
                                            Visibility="{Binding HasPendingChanges, Converter={StaticResource boolToVisibilityConverter}}">
                            <iconPacks:PackIconMaterial.Style>
                                <Style TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource {x:Type iconPacks:PackIconMaterial}}">
                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconMaterial.Style>
                        </iconPacks:PackIconMaterial>

                        <!--pending changes popup-->
                        <Popup x:Name="pendingChangesPopup" StaysOpen="True" Placement="Right" MinHeight="30" 
                            PlacementTarget="{Binding ElementName=pendingChangesTag}" HorizontalOffset="-2"
                            AllowsTransparency="True" VerticalOffset="-10">
                            <!--Loaded="pendingChangesPopup_Loaded" Opened="pendingChangesPopup_Opened">-->
                            <Popup.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="Black" Direction="270"/>
                            </Popup.Effect>
                            <Popup.Style>
                                <Style TargetType="Popup"  >
                                    <Setter Property="IsOpen" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=pendingChangesTag}" Value="True">
                                            <Setter Property="IsOpen" Value="True"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="IsOpen" Value="True"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Popup.Style>

                            <Border x:Name="pendingChangesPopupBorder" 
                                Background="White"
                                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.ColumnSpan="3" Visibility="Collapsed">
                                        <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Width="24" Height="24" Focusable="True"
                                        Command="{Binding SaveChangesCommand}"
                                        ToolTip="{Binding [legendItem_PendingChanges_Save], Source={StaticResource Localization}}">
                                            <Viewbox Margin="4">
                                                <iconPacks:PackIconMaterial Kind="ContentSave" Foreground="White" FlowDirection="LeftToRight"/>
                                            </Viewbox>
                                        </Button>
                                        <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"   
                                        Command="{Binding UndoAllChangesCommand}"
                                        ToolTip="{Binding [legendItem_PendingChanges_Undo], Source={StaticResource Localization}}">
                                            <Viewbox Margin="4">
                                                <iconPacks:PackIconMaterial Kind="UndoVariant" Foreground="White" FlowDirection="LeftToRight"/>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                    <Separator Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed"/>
                                    <!--new features-->
                                    <iconPacks:PackIconMaterial Grid.Row="2" Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                                            Foreground="{Binding Source={x:Static enums:FeatureStatus.New}, Converter={StaticResource featureStatusToBrushConverter}}"
                                                            Visibility="{Binding NumberOfAddedFeatures, Converter={StaticResource intGreaterThanIntParameterToVisibilityConverter}, ConverterParameter=0}">
                                        <iconPacks:PackIconMaterial.Kind>
                                            <Binding Source="{x:Static enums:FeatureStatus.New}" Converter="{StaticResource featureStatusToMaterialIconConverter}"/>
                                        </iconPacks:PackIconMaterial.Kind>
                                    </iconPacks:PackIconMaterial>
                                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,2,0"
                                            Text="{Binding [legendItem_PendingChanges_Added], Source={StaticResource Localization}, Mode=OneWay}"
                                            Foreground="{Binding Source={x:Static enums:FeatureStatus.New}, Converter={StaticResource featureStatusToBrushConverter}}"
                                            Visibility="{Binding NumberOfAddedFeatures, Converter={StaticResource intGreaterThanIntParameterToVisibilityConverter}, ConverterParameter=0}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            Text="{Binding NumberOfAddedFeatures, Converter={StaticResource localizedNumberConverter}, Mode=OneWay}"
                                            Foreground="{Binding Source={x:Static enums:FeatureStatus.New}, Converter={StaticResource featureStatusToBrushConverter}}"
                                            Visibility="{Binding NumberOfAddedFeatures, Converter={StaticResource intGreaterThanIntParameterToVisibilityConverter}, ConverterParameter=0}"/>

                                    <!--removed features-->
                                    <iconPacks:PackIconMaterial Grid.Row="3" Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                                            Foreground="{Binding Source={x:Static enums:FeatureStatus.Removed}, Converter={StaticResource featureStatusToBrushConverter}}"
                                                            Visibility="{Binding NumberOfDeletedFeatures, Converter={StaticResource intGreaterThanIntParameterToVisibilityConverter}, ConverterParameter=0}">
                                        <iconPacks:PackIconMaterial.Kind>
                                            <Binding Source="{x:Static enums:FeatureStatus.Removed}" Converter="{StaticResource featureStatusToMaterialIconConverter}"/>
                                        </iconPacks:PackIconMaterial.Kind>
                                    </iconPacks:PackIconMaterial>
                                    <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,2,0"
                                            Text="{Binding [legendItem_PendingChanges_Deleted], Source={StaticResource Localization}, Mode=OneWay}"
                                            Foreground="{Binding Source={x:Static enums:FeatureStatus.Removed}, Converter={StaticResource featureStatusToBrushConverter}}"
                                            Visibility="{Binding NumberOfDeletedFeatures, Converter={StaticResource intGreaterThanIntParameterToVisibilityConverter}, ConverterParameter=0}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            Text="{Binding NumberOfDeletedFeatures, Converter={StaticResource localizedNumberConverter}, Mode=OneWay}"
                                            Foreground="{Binding Source={x:Static enums:FeatureStatus.Removed}, Converter={StaticResource featureStatusToBrushConverter}}"
                                            Visibility="{Binding NumberOfDeletedFeatures, Converter={StaticResource intGreaterThanIntParameterToVisibilityConverter}, ConverterParameter=0}"/>

                                    <!--updated features-->
                                    <iconPacks:PackIconMaterial Grid.Row="4" Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                                            Foreground="{Binding Source={x:Static enums:FeatureStatus.Updated}, Converter={StaticResource featureStatusToBrushConverter}}"
                                                            Visibility="{Binding NumberOfUpdatedFeatures, Converter={StaticResource intGreaterThanIntParameterToVisibilityConverter}, ConverterParameter=0}">
                                        <iconPacks:PackIconMaterial.Kind>
                                            <Binding Source="{x:Static enums:FeatureStatus.Updated}" Converter="{StaticResource featureStatusToMaterialIconConverter}"/>
                                        </iconPacks:PackIconMaterial.Kind>
                                    </iconPacks:PackIconMaterial>
                                    <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,2,0"
                                            Text="{Binding [legendItem_PendingChanges_Updated], Source={StaticResource Localization}, Mode=OneWay}"
                                            Foreground="{Binding Source={x:Static enums:FeatureStatus.Updated}, Converter={StaticResource featureStatusToBrushConverter}}"
                                            Visibility="{Binding NumberOfUpdatedFeatures, Converter={StaticResource intGreaterThanIntParameterToVisibilityConverter}, ConverterParameter=0}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            Text="{Binding NumberOfUpdatedFeatures, Converter={StaticResource localizedNumberConverter}, Mode=OneWay}"
                                            Foreground="{Binding Source={x:Static enums:FeatureStatus.Updated}, Converter={StaticResource featureStatusToBrushConverter}}"
                                            Visibility="{Binding NumberOfUpdatedFeatures, Converter={StaticResource intGreaterThanIntParameterToVisibilityConverter}, ConverterParameter=0}"/>

                                </Grid>
                            </Border>
                        </Popup>

                        <!--palette control-->
                        <ToggleButton ClickMode="Release" DockPanel.Dock="Left" Name="palette" Margin="4 0 4 0" Padding="0" Cursor="Hand" Background="Transparent" VerticalAlignment="Center"
                              Width="16" Height="16" Visibility="{Binding HasMultiSymbolizers, Converter={StaticResource boolToVisibilityConverter}}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="UIElement.Focusable" Value="false" />
                                    <Setter Property="FrameworkElement.Width" Value="24" />
                                    <Setter Property="FrameworkElement.Height" Value="24" />
                                    <Setter Property="Control.Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <iconPacks:PackIconMaterial VerticalAlignment="Center" Margin="0">
                                                    <iconPacks:PackIconMaterial.Style>
                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                            <Setter Property="Kind" Value="PaletteOutline" />
                                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=palette, Path=IsChecked}" Value="True">
                                                                    <Setter Property="Kind" Value="Palette" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconMaterial.Style>
                                                </iconPacks:PackIconMaterial>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                    </DockPanel>

                    <ItemsControl BorderBrush="Black" BorderThickness="0,0,0,0" Margin="6,0,0,0"
                            ItemsSource="{Binding ElementName=root, Path=Commands}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource notConverter}}">
                        <ItemsControl.Visibility>
                            <MultiBinding Converter="{StaticResource multiBooleanToVisibilityConverter}">
                                <Binding Path="IsChecked" ElementName="root"/>
                                <!--<Binding Path="IsInScaleRange"/>-->
                            </MultiBinding>
                        </ItemsControl.Visibility>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

            </DataTemplate>

            <maptor:LayerTemplateSelector x:Key="LayerTemplateSelector"
                                     GroupLayerTemplate="{StaticResource GroupLayerTemplate}"
                                     NormalLayerTemplate="{StaticResource NormalLayerTemplate}"/>
            
        </ResourceDictionary>
    </UserControl.Resources>

    <ContentControl Content="{Binding}"
                    ContentTemplateSelector="{StaticResource LayerTemplateSelector}"/>
    
    <!--<Grid Margin="0" >
        --><!--<Grid.Resources>
        </Grid.Resources>--><!--


    </Grid>-->
</UserControl>
