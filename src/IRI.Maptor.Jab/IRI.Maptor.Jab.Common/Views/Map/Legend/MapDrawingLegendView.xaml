<maptor:NotifiableUserControl x:Class="IRI.Maptor.Jab.Controls.MapDrawingLegendView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls" 
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
                mc:Ignorable="d" x:Name="root" >
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <!--<ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Controls.Button.xaml"/>
                    <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Controls.ToggleButton.xaml"/>-->
                    <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Styles.xaml"/>
                </ResourceDictionary.MergedDictionaries>
                <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

                <!--<Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                    <Setter Property="Width" Value="16"/>-->
                <!--</Style>-->
                <Style TargetType="{x:Type iconPacks:PackIconMaterial}" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}">
                    <!--<Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                    <Setter Property="Width" Value="16"/>-->
                </Style>

                <!--the whole toolds toggle button-->
                <Style TargetType="ToggleButton">
                    <Setter Property="BorderThickness" Value="4,0,0,0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsChecked" Value="True">

                            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="LightGray"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="Expander" x:Key="toggleHorizontalExpander">
                    <Setter Property="ExpandDirection" Value="Right"/>
                    <Setter Property="Margin" Value="8,0,0,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Expander">
                                <Border x:Name="expanderBorder" 
                                    Background="{DynamicResource MahApps.Brushes.Accent3}"
                                    Margin="0" Padding="0" CornerRadius="18">
                                    <StackPanel Orientation="Horizontal" Margin="0">
                                        <ToggleButton x:Name="HeaderSite"
                                                      Margin="0" Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleDark}"                                   
                                                      Width="32" Height="32"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <!--<ToggleButton.Style >
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource MahApps.Styles.ToggleButton.Circle}">
                                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Width" Value="32"/>
                                                    <Setter Property="Height" Value="32"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Opacity" Value="0.9"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>-->
                                            <ContentPresenter ContentSource="Header"/>
                                        </ToggleButton>
                                        <!--<iconPacks:PackIconMaterial Kind="ChevronDoubleLeft" Width="8" Height="8" HorizontalAlignment="Center" Margin="4,0,8,0"
                                                                    Foreground="{DynamicResource MahApps.Brushes.Highlight}" Opacity="1"
                                                                    Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource boolToVisibilityConverter}}"/>
                                        <iconPacks:PackIconMaterial Kind="ChevronDoubleRight" Width="8" Height="8" HorizontalAlignment="Center" Margin="4,0,8,0"
                                                                    Foreground="{DynamicResource MahApps.Brushes.Highlight}" Opacity="1"
                                                                    Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=False}"/>-->

                                        <ContentPresenter x:Name="ExpandSite"
                                              ContentSource="Content"
                                              Margin="0"
                                              RenderTransformOrigin="0,0.5"
                                              Visibility="Collapsed">
                                        </ContentPresenter>

                                    </StackPanel>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="HeaderSite" Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight }"/>
                                    </Trigger>

                                    <Trigger Property="IsExpanded" Value="False">
                                        <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="Path" x:Key="buttonPath">
                    <Setter Property="Stretch" Value="Uniform"/>
                    <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                    <Setter Property="Width" Value="18"/>
                    <Setter Property="Height" Value="18"/>
                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                </Style>


                <Style x:Key="circleButtonDarkOverride" TargetType="{x:Type Button}" BasedOn="{StaticResource IRI.Maptor.Styles.Button.CircleDark}" >
                    <Setter Property="Margin" Value="1"/>
                </Style>

                <Style TargetType="ScrollBar" BasedOn="{StaticResource  IRI.Maptor.Styles.ScrollBar}"/>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding ElementName=root, Path=ShowTools, Converter={StaticResource boolToVisibilityConverter}}">
            <DockPanel HorizontalAlignment="Center" FlowDirection="LeftToRight">
                <Button Command="{Binding MoveDrawingItemUpCommand}"
                        Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                        ToolTip="{Binding [cmd_drawingLegend_moveUp], Source={StaticResource Localization}}" 
                        IsEnabled="{Binding CanMoveDrawingItemUp}">
                    <iconPacks:PackIconMaterial Kind="ArrangeBringForward" />
                </Button>
                <Button Command="{Binding MoveDrawingItemDownCommand}"
                        Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                        ToolTip="{Binding [cmd_drawingLegend_moveDown], Source={StaticResource Localization}}"                  
                        IsEnabled="{Binding CanMoveDrawingItemDown}">
                    <iconPacks:PackIconMaterial Kind="ArrangeSendBackward" />
                </Button>
                <Button Command="{Binding SaveDrawingItemFileCommand}"
                          Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"  
                          ToolTip="{Binding [cmd_drawingLegend_saveAll], Source={StaticResource Localization}}">
                    <iconPacks:PackIconMaterial Kind="ContentSaveAll"/>
                </Button>

                <Expander Style="{StaticResource toggleHorizontalExpander}"
                            IsExpanded="{Binding ElementName=root, Path=SelectedExpanderIndex, Converter={StaticResource indexToBoolConverter}, ConverterParameter=1}">
                    <Expander.Header>
                        <iconPacks:PackIconMaterial Kind="FilePlusOutline" Foreground="White"/>
                    </Expander.Header>
                    <StackPanel Orientation="Horizontal" Margin="0" VerticalAlignment="Center" >

                        <Button Command="{Binding OpenDrawingItemFileCommand}"
                                Style="{StaticResource circleButtonDarkOverride}"  
                                ToolTip="{Binding [cmd_drawingLegend_openAll], Source={StaticResource Localization}}">
                            <iconPacks:PackIconMaterial Kind="FileMultiple" />
                        </Button>
                      
                        <Button Command="{Binding AddGeoJsonToDrawingItemsCommand}"
                                Style="{StaticResource circleButtonDarkOverride}"                                
                                ToolTip="{Binding [cmd_general_addGeoJson], Source={StaticResource Localization}}">
                            <Path Style="{StaticResource buttonPath}" Data="{StaticResource json}"/>
                        </Button>
                        <Button Command="{Binding AddLongLatTxtToDrawingItemsCommand}"
                                Style="{StaticResource circleButtonDarkOverride}"                                
                                ToolTip="{Binding [cmd_drawingLegend_addLatLongTxt], Source={StaticResource Localization}}">
                            <Path Style="{StaticResource buttonPath}" Data="{StaticResource txt}"/>
                        </Button>
                        <Button Command="{Binding AddShapefileToDrawingItemsCommand}"
                                Style="{StaticResource circleButtonDarkOverride}"                                
                                ToolTip="{Binding [cmd_general_addShapefile], Source={StaticResource Localization}}">
                            <Path Style="{StaticResource buttonPath}" Data="{StaticResource shp}" />
                        </Button>
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource toggleHorizontalExpander}"  
                            IsExpanded="{Binding ElementName=root, Path=SelectedExpanderIndex, Converter={StaticResource indexToBoolConverter}, ConverterParameter=2}">
                    <Expander.Header>
                        <iconPacks:PackIconMaterial Kind="PencilPlus" Foreground="White"/>
                    </Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource circleButtonDarkOverride}" Command="{Binding DrawPointCommand}" 
                                ToolTip="{Binding [cmd_general_drawPoint], Source={StaticResource Localization}}"  >
                            <iconPacks:PackIconMaterial Kind="VectorPointPlus" Width="14"/>
                        </Button>
                        <Button Style="{StaticResource circleButtonDarkOverride}" Command="{Binding DrawPolylineCommand}" 
                                ToolTip="{Binding [cmd_general_drawPolyline], Source={StaticResource Localization}}">
                            <iconPacks:Material Kind="VectorPolylinePlus"/>
                        </Button>
                        <Button Style="{StaticResource circleButtonDarkOverride}" Command="{Binding DrawRectangleCommand}" 
                                ToolTip="{Binding [cmd_general_drawRectangle], Source={StaticResource Localization}}">
                            <iconPacks:Material Kind="ShapeRectanglePlus"/>
                        </Button>

                        <Button Style="{StaticResource circleButtonDarkOverride}" Command="{Binding DrawPolygonCommand}" 
                                ToolTip="{Binding [cmd_general_drawPolygon], Source={StaticResource Localization}}">
                            <iconPacks:Material Kind="ShapePolygonPlus"/>
                        </Button>
                        <Button Style="{StaticResource circleButtonDarkOverride}" Command="{Binding AddTextToMapCommand}" 
                                ToolTip="{Binding [cmd_general_addTextToMap], Source={StaticResource Localization}}">
                            <iconPacks:Material Kind="FormatAnnotationPlus"/>
                        </Button>
                    </StackPanel>
                </Expander>


            </DockPanel>
        </ScrollViewer>

        <Line Grid.Row="1" X1="0" X2="100" Stretch="Fill" Opacity="1" Margin="0,4" 
              StrokeThickness="1"
              StrokeDashArray="8 2"
              Stroke="{DynamicResource MahApps.Brushes.Highlight}" 
              Visibility="{Binding ElementName=root, Path=ShowTools, Converter={StaticResource boolToVisibilityConverter}}"/>

        <ListBox Grid.Row="2" ItemsSource="{Binding DrawingItems}" SelectionMode="Single" SelectedItem="{Binding SelectedDrawingItem, Mode=TwoWay}">
            <ListBox.ItemContainerStyle>
                <!-- Style to get rid of the selection visual -->
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="IsSelected" Value="{Binding IsSelectedInToc, Mode=TwoWay}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--GroupName="{Binding ElementName=root, Path=GroupName}"-->
                    <RadioButton Style="{StaticResource {x:Type ToggleButton}}"
                                 DataContext="{Binding }"
                                 IsChecked="{Binding IsSelectedInToc, Mode=TwoWay}">
                        <maptor:MapLegendItemView ShowReloadData="False" ShowMoreOptions="False"
                                                Title="{Binding LayerName, Mode=TwoWay}"
                                                Symbology="{Binding DefaultSymbology}"  
                                                IsEditable="True" Commands="{Binding Commands}" 
                                                IsChecked="{Binding IsSelectedInToc}"
                                                TitleFontSize="{Binding ElementName=root, Path=TitleFontSize}"/>
                    </RadioButton>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</maptor:NotifiableUserControl>
