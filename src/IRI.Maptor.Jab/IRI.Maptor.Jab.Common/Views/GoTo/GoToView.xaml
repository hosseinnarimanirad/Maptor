<UserControl x:Class="IRI.Maptor.Jab.Controls.GoToView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             x:Name="window" Height="190"
             xmlns:model="clr-namespace:IRI.Maptor.Jab.Common.Models.GoTo">
    <UserControl.Resources>
        <DataTemplate x:Key="MenuItemTemplate" DataType="{x:Type model:HamburgerGoToMenuItem}">
            <Grid Height="48" Margin="0,4,0,0" Background="Transparent" Cursor="Hand" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Path Grid.Column="0" Width="28" Data="{Binding Icon}" Fill="White" Stretch="Uniform" FlowDirection="LeftToRight"/>
                <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding SubTitle}" HorizontalAlignment="Center" FontSize="11"
                           Visibility="{Binding HasSubTitle, Converter={StaticResource boolToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="White" Text="{Binding Title}" Grid.RowSpan="2"
                           FontFamily="Seoge UI"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
 
    <mahApp:HamburgerMenu x:Name="hamburgerMenuControl" PaneBackground="{DynamicResource MahApps.Brushes.Highlight}" 
                            IsPaneOpen="False" DisplayMode="CompactInline"  
                            ItemTemplate="{StaticResource MenuItemTemplate}" CompactPaneLength="48" 
                            HamburgerHeight="48" Content="{Binding SelectedItem.Content}"
                            SelectedItem="{Binding SelectedItem, Mode=TwoWay}" ItemsSource="{Binding MenuItems}">
        <mahApp:HamburgerMenu.ContentTemplate>
            <DataTemplate DataType="{x:Type FrameworkElement}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions> 
                    <ContentControl Grid.Row="0" Content="{Binding }"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="8">
                        <Button Command="{Binding ElementName=window, Path=DataContext.PanToCommand}"
                                Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                            <iconPacks:PackIconMaterial Kind="HandBackRight" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                        </Button>
                        <Button Command="{Binding ElementName=window, Path=DataContext.ZoomToCommand}"
                                Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                            <iconPacks:PackIconMaterial Kind="MagnifyExpand" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </mahApp:HamburgerMenu.ContentTemplate>
    </mahApp:HamburgerMenu>

</UserControl>
