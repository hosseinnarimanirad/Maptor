<maptor:NotifiableUserControl x:Class="IRI.Maptor.Jab.Controls.DegreeMinuteSecondView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                x:Name="root">
    <Grid> 
        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" >
            <mahApp:NumericUpDown MinWidth="{Binding ElementName=root, Path=MinInputWidth}"
                                  mahApp:ControlsHelper.CornerRadius="4"
                                  Width="Auto"
                                  HideUpDownButtons="{Binding ElementName=root, Path=HideUpDownButtons}"
                                  Maximum="{Binding ElementName=root, Path=MaxDegreeValue}"
                                  Minimum="{Binding ElementName=root, Path=MinDegreeValue}"
                                  Margin="1,0" Height="20"
                                  NumericInputMode="Numbers"  
                                  Value="{Binding Degree, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  StringFormat="{}{0:000} °"
                                  mahApp:TextBoxHelper.SelectAllOnFocus="True"/>

            <mahApp:NumericUpDown MinWidth="0"
                                  mahApp:ControlsHelper.CornerRadius="4"
                                  Width="Auto"
                                  HideUpDownButtons="{Binding ElementName=root, Path=HideUpDownButtons}"
                                  Maximum="59"
                                  Minimum="0"
                                  Margin="1,0" Height="20"
                                  NumericInputMode="Numbers" 
                                  Value="{Binding Minute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  StringFormat="{}{0:00} ' "
                                  mahApp:TextBoxHelper.SelectAllOnFocus="True"/>

            <mahApp:NumericUpDown MinWidth="0"
                                  mahApp:ControlsHelper.CornerRadius="4"
                                  Width="Auto"
                                  HideUpDownButtons="{Binding ElementName=root, Path=HideUpDownButtons}"
                                  Maximum="59.99"
                                  Minimum="0"
                                  Margin="1,0" Height="20"
                                  NumericInputMode="Decimal"
                                  DecimalPointCorrection="Number"
                                  Speedup="True"
                                  Value="{Binding Second, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  StringFormat="{}{0:00.00} &quot;"
                                  mahApp:TextBoxHelper.SelectAllOnFocus="True"/>
        </StackPanel>
    </Grid>
</maptor:NotifiableUserControl>
