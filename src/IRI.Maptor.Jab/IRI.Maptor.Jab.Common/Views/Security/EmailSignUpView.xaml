<maptor:SecurityInputUserControl x:Class="IRI.Maptor.Jab.Controls.Security.EmailSignUpView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls.Security"
            xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization"
            xmlns:validation="clr-namespace:IRI.Maptor.Jab.Common.ValidationRules"
            xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" x:Name="root">
    <maptor:SecurityInputUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Controls.Textbox.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/SecurityInputStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </maptor:SecurityInputUserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/> 
        </Grid.RowDefinitions>
  
        <Border Grid.Row="0" Style="{StaticResource borderGroup}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconMaterial Kind="Email" Style="{StaticResource securityIconMaterial}"/>
                <TextBox Grid.Column="1"
                         Style="{StaticResource IRI.Maptor.Styles.TextBox.Large}" FlowDirection="LeftToRight"
                         mahApp:TextBoxHelper.Watermark="{Binding [common_email], Source={StaticResource Localization}}">
                    <!--<i1:Interaction.Triggers>
                        <i1:EventTrigger EventName="LostFocus">
                            <i1:InvokeCommandAction  Command="{Binding ValidateUserNameOrEmailCommand}" CommandParameter="{Binding ElementName=root}"/>
                        </i1:EventTrigger>
                    </i1:Interaction.Triggers>-->
                    <TextBox.Text>
                        <Binding ElementName="root" Path="UserNameOrEmail" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validation:EmailValidation/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource borderGroup}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions> 
                <iconPacks:PackIconPhosphorIcons Kind="PasswordFill" Style="{StaticResource securityIconPhosphor}"/>
                <PasswordBox x:Name="key" Grid.Column="1"
                             Style="{StaticResource securityPasswordBoxBase}"
                             mahApp:TextBoxHelper.Watermark="{Binding [common_password], Source={StaticResource Localization}}"/>
            </Grid>
        </Border>
 
        <Border Grid.Row="2" Style="{StaticResource borderGroup}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="32" HorizontalAlignment="Center">
                    <StackPanel Grid.Column="0">
                        <iconPacks:PackIconPhosphorIcons Kind="PasswordFill" Style="{StaticResource securityIconPhosphorConfirmRow}"/>
                        <TextBlock Style="{StaticResource securityPathText}"
                                   Text="{Binding [common_confirm], Source={StaticResource Localization}}"/>
                    </StackPanel>
                </Viewbox>
                <PasswordBox x:Name="confirmPassword" Grid.Column="1"
                             Style="{StaticResource securityPasswordBoxBase}"
                             mahApp:TextBoxHelper.Watermark="{Binding [common_confirmPassword], Source={StaticResource Localization}}"/>
            </Grid>
        </Border>

    </Grid>
</maptor:SecurityInputUserControl>
