<maptor:MapMarker x:Class="IRI.Maptor.Jab.Common.Views.MapMarkers.Circle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Common.Views"
                    Width="12" Height="12">
    <maptor:MapMarker.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/IRI.Maptor.Jab.Common;component/Assets/IRI.Animations.xaml"/>
                <ResourceDictionary Source="/IRI.Maptor.Jab.Common;component/Assets/IRI.Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </maptor:MapMarker.Resources>
    <maptor:MapMarker.RenderTransform>
        <TransformGroup>
            <ScaleTransform />
        </TransformGroup>
    </maptor:MapMarker.RenderTransform>
    <maptor:MapMarker.Triggers>
        <EventTrigger RoutedEvent="UIElement.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource mapMarkerExpandOnMouseEnter}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="UIElement.MouseLeave" >
            <BeginStoryboard Storyboard="{StaticResource mapMarkerResetOnMouseLeave}"/>
        </EventTrigger>
    </maptor:MapMarker.Triggers>
    <Ellipse Fill="White" Stroke="DarkGray" StrokeThickness="1" Cursor="Hand" x:Name="ellipse"/>
</maptor:MapMarker>
