<mahApp:MetroWindow x:Class="IRI.Maptor.Jab.Controls.Dialogs.DxfOpenDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:localization="clr-namespace:IRI.Maptor.Jab.Core.Localization;assembly=IRI.Maptor.Jab.Core"

    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
    Title="{Binding [dialog_dxfOpen_title], Source={StaticResource Localization}}"
    Width="500"              
    Height="600" 
    WindowStartupLocation="CenterOwner">

    <mahApp:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/SecurityInputStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </mahApp:MetroWindow.Resources>
    <mahApp:MetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.WindowTitle}"/>
        </DataTemplate>
    </mahApp:MetroWindow.TitleTemplate>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- File -->
        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconMaterial Kind="File" Style="{StaticResource securityIconMaterial}"/>
                <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal.En}" FlowDirection="LeftToRight"
                            mahApp:TextBoxHelper.Watermark="{Binding [dialog_common_fileWatermark], Source={StaticResource Localization}}"
                            Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" >
                </TextBox>
                <Button Grid.Column="2" ToolTip="{Binding [dialog_common_browse], Source={StaticResource Localization}}" Command="{Binding BrowseCommand}"
                        Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                    <iconPacks:PackIconPhosphorIcons Kind="FileMagnifyingGlassFill"/>
                </Button>
                <Button Grid.Column="3"
                        ToolTip="{Binding [dialog_common_removeFile], Source={StaticResource Localization}}"
                        Command="{Binding RemoveFileCommand}"
                        Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                    <iconPacks:PackIconMaterial Kind="FileRemoveOutline"/>
                </Button>
            </Grid>
        </Border>
 
        <!-- Spatial Reference -->
        <Border Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.Border.Card}" IsEnabled="{Binding CanUserChooseSrs}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconPhosphorIcons Kind="Globe" Style="{StaticResource securityIconPhosphor}"/>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding AvailableSrsOptions}"
                          DisplayMemberPath="DisplayName"                          
                          Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}"
                          SelectedItem="{Binding SelectedSrsOption, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- UTM Zone (visible when UTM selected) -->
        <Border Grid.Row="2" Style="{StaticResource IRI.Maptor.Styles.Border.Card}" IsEnabled="{Binding CanUserChooseSrs}"
                Visibility="{Binding IsUtmSelected, Converter={StaticResource boolToVisibilityConverter}}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconPhosphorIcons Kind="MapTrifoldFill" Style="{StaticResource securityIconPhosphor}"/>
                <mahApp:NumericUpDown Grid.Column="1"
                                    Minimum="1" Maximum="60"
                                    mahApp:ControlsHelper.CornerRadius="4"
                                    Value="{Binding UtmZone, Mode=TwoWay}"
                                    Style="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}"/>

                <ToggleButton Grid.Column="2" IsChecked="{Binding IsNorthHemisphere, Mode=TwoWay}"
                              Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"  FlowDirection="LeftToRight"
                              ToolTip="{Binding [dialog_dxfOpen_hemisphereTooltip], Source={StaticResource Localization}}">
                    <iconPacks:PackIconPhosphorIcons Kind="CircleHalfFill" RenderTransformOrigin="0.5,0.5" Foreground="White" >
                        <iconPacks:PackIconPhosphorIcons.Style>
                            <Style TargetType="iconPacks:PackIconPhosphorIcons" BasedOn="{StaticResource securityIconPhosphor}">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNorthHemisphere}" Value="False">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="90"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconPhosphorIcons.Style>
                    </iconPacks:PackIconPhosphorIcons>
                </ToggleButton>
            </Grid>
        </Border>


        <!-- Sample points -->
        <TextBlock Grid.Row="3" Text="{Binding [dialog_dxfOpen_samplePoints], Source={StaticResource Localization}}"
                   Margin="4,2,0,4"
                   FontSize="12" Foreground="{DynamicResource MahApps.Brushes.Gray2}"/>
        <DataGrid Grid.Row="4" Margin="0,0,0,8"
                  ItemsSource="{Binding SamplePoints}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  MaxHeight="200"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Index}" Width="40">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding [dialog_dxfOpen_columnIndex], Source={StaticResource Localization}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding X, StringFormat=N6}" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding [dialog_dxfOpen_columnX], Source={StaticResource Localization}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Y, StringFormat=N6}" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding [dialog_dxfOpen_columnY], Source={StaticResource Localization}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button IsCancel="True"
                     Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Secondary}"
                     Command="{Binding CancelCommand}" >
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CloseThick" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                Text="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"/>
                </StackPanel>
            </Button>
            
            <Button IsDefault="True"
                    Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Primary}"
                    Command="{Binding OpenCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="FolderOpen" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                        Text="{Binding [common_open], Source={StaticResource Localization}}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!--<StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button ToolTip="{Binding [dialog_common_cancel], Source={StaticResource Localization}}" 
                    Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                    Command="{Binding CancelCommand}">
                <iconPacks:PackIconMaterial Kind="CloseThick" Foreground="White"/>
            </Button>
            <Button ToolTip="{Binding [common_open], Source={StaticResource Localization}}"
                    Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                    Command="{Binding OpenCommand}">
                <iconPacks:PackIconMaterial Kind="CheckBold" Foreground="White"/>
            </Button>
        </StackPanel>-->
    </Grid>
</mahApp:MetroWindow>
