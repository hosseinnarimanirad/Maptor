<maptor:LocalizedMetroWindow x:Class="IRI.Maptor.Jab.Controls.GoToMetroWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"              
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls"
                    xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    x:Name="root" 
                    FlowDirection="{Binding ElementName=mainView, Path=FlowDirection, Mode=OneWay}"
                    WindowStyle="ToolWindow" Width="550" Height="250" ShowIconOnTitleBar="False" ShowInTaskbar="False"
                    Title="{Binding ElementName=root, Path=Ltxt_dialog_goto_title}" ShowMaxRestoreButton="False" ShowMinButton="False"
                    GlowBrush="{DynamicResource MahApps.Brushes.Accent}" >
    <maptor:LocalizedMetroWindow.Resources>
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
    </maptor:LocalizedMetroWindow.Resources>
    <maptor:GoToView x:Name="mainView" FlowDirection="{Binding Path=CurrentFlowDirection, Source={StaticResource Localization}}"/>
</maptor:LocalizedMetroWindow>
