<mahApp:MetroWindow x:Class="IRI.Maptor.Jab.Controls.Dialogs.DialogView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
                xmlns:viewModel="clr-namespace:IRI.Maptor.Jab.Common.ViewModels.Dialogs"
                xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls" 
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance Type=viewModel:DialogViewModel, IsDesignTimeCreatable=True}"
                Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
                Title="{Binding Title}"
                ShowCloseButton="False" MinWidth="400"
                WindowStartupLocation="CenterOwner">
    <Grid Margin="8" >
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Controls.All.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            <Style TargetType="iconPacks:PackIconMaterial">
                <!--<Setter Property="Foreground" Value="White"/>-->
                <!--<Setter Property="Stretch" Value="Uniform"/>-->
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="4,0"  >
            <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}" Margin="4" Height="40" Width="40" 
                    BorderThickness="3" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconMaterial Kind="InformationSymbol" Foreground="{StaticResource MahApps.Brushes.Accent}" />
            </Border>
            <TextBlock Text="{Binding Message}" Margin="8,0" VerticalAlignment="Center" MaxWidth="500" TextWrapping="Wrap" 
                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource  IRI.Maptor.Styles.Button.Dialogs.Cancel.Circle}"
                    Command="{Binding SecondOptionCommand}"
                    ToolTip="{Binding SecondOptionText}"
                    Visibility="{Binding IsTwoOptionsMode, Converter={StaticResource boolToVisibilityConverter}}">
                    <!--Background="{Binding SecondOptionColor, FallbackValue={StaticResource MahApps.Brushes.Gray10}, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"-->
                <iconPacks:PackIconMaterial Kind="CloseThick"/>
            </Button>
            <Button Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Primary.Circle}"
                    Command="{Binding FirstOptionCommand}"
                    ToolTip="{Binding FirstOptionText}"
                    >
                <!--Background="{Binding FirstOptionColor, FallbackValue={StaticResource MahApps.Brushes.Accent}, RelativeSource={RelativeSource AncestorType=Window}}"
Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"-->
                <iconPacks:PackIconMaterial Kind="CheckBold"/>
            </Button>
        </StackPanel>
    </Grid>
</mahApp:MetroWindow>
