<mahApp:MetroWindow x:Class="IRI.Maptor.Jab.Controls.Dialogs.LayerSettingsDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls.LayerSettings"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization"

    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
    Title="{Binding [dialog_layerSettings_title], Source={StaticResource Localization}}" 
    SizeToContent="Height"
    MaxWidth="700"
    MinWidth="400"
    Height="450" Width="600"
    WindowStartupLocation="CenterOwner">

    <!--GlowBrush="{DynamicResource MahApps.Brushes.Highlight}"
        FlowDirection="{Binding Path=CurrentFlowDirection, Source={StaticResource Localization}}"
        WindowStartupLocation="CenterOwner"
        ShowCloseButton="True"
        ShowMinButton="False" 
        WindowStyle="ToolWindow"   ResizeMode="NoResize">-->
    <mahApp:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{TemplateBinding Content}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        Margin="8 0 8 0"
                        FontFamily="{StaticResource iranSans}"
                        FontWeight="Bold" />
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource iranSans}" FontWeight="Bold"
                    Text="{Binding DataContext.Layer.LayerName, RelativeSource={RelativeSource AncestorType=mahApp:MetroWindow},StringFormat={}({0})}"/>
            </StackPanel>
        </DataTemplate>
    </mahApp:MetroWindow.TitleTemplate>


    <mahApp:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/IRI.Maptor.Jab.Common;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource IRI.Maptor.Styles.TabItem.Form}">
                <Setter Property="mahApp:HeaderedControlHelper.HeaderFontFamily" Value="{StaticResource iranSans}"/>
            </Style>
            <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource MahApps.Styles.Slider}"/>
            <Style TargetType="TextBlock" >
                <Setter Property="Margin" Value="4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="{StaticResource iranSans}"/>
            </Style>

        </ResourceDictionary>
    </mahApp:MetroWindow.Resources>
    <Grid>
        <Rectangle Height="30" VerticalAlignment="Top" Fill="{DynamicResource MahApps.Brushes.ThemeBackground}" />
        <TabControl Margin="1" Style="{StaticResource MahApps.Styles.TabControl}">
            <TabControl.Resources>
                <!--the whole tabheader part's color-->
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                </Style>
            </TabControl.Resources>
            <TabControl.Items>
                <TabItem Header="{Binding [layerSettings_general_title], Source={StaticResource Localization}}">
                    <maptor:LayerSettings_GeneralView DataContext="{Binding Layer}"/>
                </TabItem>
                <TabItem Header="{Binding [layerSettings_export_title], Source={StaticResource Localization}}">
                    <maptor:LayerSettings_ExportView DataContext="{Binding Export}"/>
                </TabItem>
                <TabItem IsEnabled="False" Header="{Binding [layerSettings_symbology_title], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Header="{Binding [layerSettings_trackChanges_title], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Visibility="Collapsed" Header="{Binding [layerSettings_labeling], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Visibility="Collapsed" Header="{Binding [layerSettings_fields_title], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Visibility="Collapsed" Header="{Binding [layerSettings_filters_title], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Visibility="Collapsed" Header="{Binding [layerSettings_statistics_title], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Visibility="Collapsed" Header="{Binding [layerSettings_analysis_title], Source={StaticResource Localization}}"/>
                <TabItem IsEnabled="False" Visibility="Collapsed" Header="{Binding [layerSettings_security_title], Source={StaticResource Localization}}"/>
            </TabControl.Items>
        </TabControl>
    </Grid>
</mahApp:MetroWindow>
