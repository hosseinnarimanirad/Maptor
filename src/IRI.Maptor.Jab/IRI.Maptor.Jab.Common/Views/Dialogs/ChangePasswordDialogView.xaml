<mahApp:MetroWindow x:Class="IRI.Maptor.Jab.Controls.Dialogs.ChangePasswordDialogView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"              
            xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"               
            xmlns:iriSecurity="clr-namespace:IRI.Maptor.Jab.Controls.Security"
            xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization"
            xmlns:converters="clr-namespace:IRI.Maptor.Jab.Common.Converters"
            Title="{Binding Title}" FlowDirection="RightToLeft" ShowInTaskbar="False"
            GlowBrush="{Binding Source={StaticResource MahApps.Brushes.Highlight}, TargetNullValue=Red}" ShowMaxRestoreButton="False" ShowCloseButton="False" 
            ShowMinButton="False" ShowTitleBar="True" SizeToContent="WidthAndHeight"
            MinWidth="350" MinHeight="400" FontFamily="{StaticResource iranSans}" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.Resources>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <SolidColorBrush x:Key="defaultRed">#FFEA4333</SolidColorBrush>
            <SolidColorBrush x:Key="defaultGreen">#FF81BA45</SolidColorBrush>
            <Style TargetType="Path">
                <Setter Property="Fill" Value="White"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
            </Style> 
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions> 
        <TextBlock HorizontalAlignment="Center" FontSize="18" Margin="8">
            <TextBlock.Text>
                <MultiBinding>
                    <MultiBinding.Converter>
                        <converters:FirstNonNullConverter/>
                    </MultiBinding.Converter>
                    <Binding Path="BannerText"/>
                    <Binding Path="[dialog_changePassword_title]" Source="{StaticResource Localization}"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <iriSecurity:ChangePasswordView x:Name="userNameSignUpView" Grid.Row="1" HorizontalAlignment="Stretch"
                                        InputBorderBrush="Gray" InputBorderThickness="1"/>
        <Border Grid.Row="2">
            <StackPanel Margin="8,4">
                <!--<Button Content="{Binding [app_saba_login_signIn], Source={StaticResource Localization}}"
                        Style="{StaticResource IRI.Maptor.Styles.Button.FlatPrimaryRound6}"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=userPassword}" TabIndex="2"/>-->
                
                <Button Content="{Binding [dialog_changePassword_title], Source={StaticResource Localization}}"
                        Style="{StaticResource IRI.Maptor.Styles.Button.FlatPrimaryRound6}"
                        Command="{Binding ChangePasswordCommand}"
                        CommandParameter="{Binding ElementName=userNameSignUpView}"/>
                
                <Button Content="{Binding [common_cancel], Source={StaticResource Localization}}"
                        Style="{StaticResource IRI.Maptor.Styles.Button.FlatGrayRound6}"
                        Command="{Binding CancelCommand}">

                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" MinHeight="50" Background="{DynamicResource MahApps.Brushes.Accent4}" BorderThickness="0,2,0,0" Opacity=".5"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent3}">
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding [dialog_changePassword_enterPassword], Source={StaticResource Localization}}" Foreground="Black" VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
    </Grid>
</mahApp:MetroWindow>
