<mahApp:MetroWindow x:Class="IRI.Maptor.Jab.Controls.Dialogs.GeometryDetailsDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization"
    xmlns:presenters="clr-namespace:IRI.Maptor.Jab.Common.ViewModels.CoordinateEditor" 

    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
    Title="{Binding DialogTitle, RelativeSource={RelativeSource AncestorType=mahApp:MetroWindow}}"          
    SizeToContent="Height"
    MaxWidth="750"
    ShowMaxRestoreButton="True" 
    WindowStartupLocation="CenterOwner">
    <mahApp:MetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.WindowTitle}" />
        </DataTemplate>
    </mahApp:MetroWindow.TitleTemplate>
    <mahApp:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Common;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <Style TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
        </ResourceDictionary>
    </mahApp:MetroWindow.Resources>

    <StackPanel Margin="4">

        <!-- Basic Information Section -->
        <GroupBox Grid.Row="0" Margin="0,0,0,2" Padding="4">
            <GroupBox.Header>
                <TextBlock Text="{Binding [dialog_geometryDetails_basicInfo], Source={StaticResource Localization}}"
                           Style="{StaticResource IRI.Maptor.Styles.TextBlock.HeaderTitle}"/>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                           Text="{Binding [dialog_geometryDetails_geometryType], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" 
                           Text="{Binding GeometryType}" 
                           FontWeight="Bold" Margin="4" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                           Text="{Binding [dialog_geometryDetails_dimension], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Dimension}" 
                           FontWeight="Bold" Margin="4" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                           Text="{Binding [dialog_geometryDetails_numberOfPoints], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NumberOfPoints, Converter={StaticResource localizedNumberConverter}}" 
                           Margin="4" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}" 
                           Text="{Binding [dialog_geometryDetails_numberOfGeometries], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding NumberOfGeometries, Converter={StaticResource localizedNumberConverter}}" 
                           Margin="4" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                           Text="{Binding [dialog_geometryDetails_utmZone], Source={StaticResource Localization}, StringFormat='{}{0}:'}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="4">
                    <TextBlock Text="{Binding UtmZone, TargetNullValue='N/A'}" 
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MahApps.Brushes.Accent}"
                               Visibility="{Binding SpansMultipleUtmZones, Converter={StaticResource boolToVisibilityConverter}}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="(همچنین: {0})">
                                <Binding Path="UtmZones" Converter="{StaticResource collectionToStringConverter}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Geometry Editor Section -->
        <Expander Grid.Row="1" Margin="0,0,0,8" Padding="8"
                      IsExpanded="True">
            <Expander.Header>
                <TextBlock Text="{Binding [dialog_geometryDetails_editCoordinates], Source={StaticResource Localization}}" Foreground="White"
               Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}" Margin="0" Cursor="Hand"/>
            </Expander.Header>
            <ContentControl Content="{Binding GeometryEditor}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type presenters:GeometryEditorViewModel}">
                        <maptor:GeometryEditorView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Expander>

        <!-- Format Display Section -->
        <Expander Grid.Row="2" Margin="0,0,0,8" Padding="0" IsExpanded="False">
            <Expander.Header>
                <TextBlock Text="{Binding [dialog_geometryDetails_format], Source={StaticResource Localization}}" Foreground="White"
                            Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}" Margin="0" Cursor="Hand"/>
            </Expander.Header>
            <StackPanel>
                <Border Background="{DynamicResource MahApps.Brushes.Accent4}" Margin="2" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                    Text="{Binding [dialog_geometryDetails_format], Source={StaticResource Localization}, StringFormat='{}{0}:'}" 
                                    Margin="4" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableFormats}"
                                   Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}"  
                                   SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"/>
                        <Button Grid.Row="0" Grid.Column="2" 
                                 ToolTip="{Binding [dialog_geometryDetails_export], Source={StaticResource Localization}}"  
                                 Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}"
                                 Visibility="Collapsed">
                            <iconPacks:PackIconMaterial Kind="ContentSave"/>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="3" Command="{Binding CopySelectedFormat}"
                               ToolTip="{Binding [dialog_geometryDetails_copy], Source={StaticResource Localization}}"  
                               Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                            <iconPacks:PackIconMaterial Kind="ContentCopy"/>
                        </Button>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" FlowDirection="LeftToRight" 
                              VerticalScrollBarVisibility="Auto" MaxHeight="150" Margin="0" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding StringRepresentation}" HorizontalAlignment="Stretch" Background="#EEEEEE"
                               TextWrapping="Wrap" Padding="4" MaxWidth="720" Margin="0,4"
                               FontFamily="Consolas" FontSize="11"/>
                </ScrollViewer>
            </StackPanel>
        </Expander>

        <!-- Save/Cancel Buttons -->
        <!--<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button ToolTip="{Binding [dialog_common_cancel], Source={StaticResource Localization}}" 
                        Command="{Binding CancelEditingCommand}" Margin="4" 
                        Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                <iconPacks:PackIconMaterial Kind="CloseThick"/>
            </Button>
            <Button ToolTip="{Binding [dialog_common_save], Source={StaticResource Localization}}" 
                        Command="{Binding SaveGeometryCommand}" Margin="4"  
                        Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                <iconPacks:PackIconMaterial Kind="CheckBold"/>
            </Button>
        </StackPanel>-->

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button IsCancel="True"
                    Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Secondary}"
                    Command="{Binding CancelEditingCommand}" >
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CloseThick" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                Text="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"/>
                </StackPanel>
            </Button>
            <Button IsDefault="True"
                    Style="{StaticResource IRI.Maptor.Styles.Button.Dialogs.Primary}"
                    Command="{Binding SaveGeometryCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CheckBold" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}"/>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                Text="{Binding [dialog_common_save], Source={StaticResource Localization}}"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </StackPanel>

</mahApp:MetroWindow>

