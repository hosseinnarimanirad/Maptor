<mahApp:MetroWindow x:Class="IRI.Maptor.Jab.Controls.Dialogs.FeatureChangesDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:localization="clr-namespace:IRI.Maptor.Jab.Common.Localization"

    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
    Title=""
    SizeToContent="Height"
    MaxWidth="700"
    ShowMaxRestoreButton="True"
    WindowStartupLocation="CenterOwner">
    <mahApp:MetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.WindowTitle}" />
        </DataTemplate>
    </mahApp:MetroWindow.TitleTemplate>
    <maptor:FeatureChangesView/>
</mahApp:MetroWindow>
