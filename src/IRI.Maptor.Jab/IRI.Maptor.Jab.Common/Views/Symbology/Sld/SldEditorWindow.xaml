<Window x:Class="IRI.Maptor.Jab.Controls.Symbology.Sld.SldEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls.Symbology.Sld"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:localization="clr-namespace:IRI.Maptor.Jab.Core.Localization;assembly=IRI.Maptor.Jab.Core"
        mc:Ignorable="d"
        Title="{Binding [sldEditor_common_editorTitle], Source={StaticResource Localization}}" Height="750" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Resources>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Command="{Binding ImportSldCommand}" ToolTip="{Binding [sldEditor_common_importTooltip], Source={StaticResource Localization}}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="FolderOpen" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding [sldEditor_common_import], Source={StaticResource Localization}}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportSldCommand}" ToolTip="{Binding [sldEditor_common_exportTooltip], Source={StaticResource Localization}}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ContentSave" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding [sldEditor_common_export], Source={StaticResource Localization}}"/>
                </StackPanel>
            </Button>
            <Separator/>
            <TextBlock Text="{Binding [sldEditor_common_editorBanner], Source={StaticResource Localization}}" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
        </ToolBar>

        <!-- Main Editor -->
        <maptor:SldEditorView Grid.Row="1" DataContext="{Binding}"/>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{Binding [sldEditor_common_rulesLabel], Source={StaticResource Localization}}"/>
                    <Run Text="{Binding Rules.Count, Mode=OneWay}"/>
                    <Run Text=" | "/>
                    <Run Text="{Binding [sldEditor_common_selected], Source={StaticResource Localization}}"/>
                    <Run Text="{Binding SelectedRule.Name, Mode=OneWay, FallbackValue='None'}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

