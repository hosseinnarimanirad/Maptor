<UserControl x:Class="IRI.Maptor.Jab.Controls.Symbology.Sld.RasterSymbolizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="380">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [sldEditor_raster_opacity], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
        <Slider Grid.Row="0" Grid.Column="1" Margin="4"
                Value="{Binding Opacity, Mode=TwoWay}"
                Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding [sldEditor_raster_colorMap], Source={StaticResource Localization}}"
                   FontWeight="Bold" Margin="4,10,4,4"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="4">
            <Button Command="{Binding AddEntryCommand}" ToolTip="{Binding [sldEditor_raster_addEntry], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                <iconPacks:PackIconMaterial Kind="Plus"/>
            </Button>
            <Button Command="{Binding RemoveEntryCommand}" ToolTip="{Binding [sldEditor_raster_removeEntry], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                <iconPacks:PackIconMaterial Kind="Delete"/>
            </Button>
        </StackPanel>

        <DataGrid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="4"
                  ItemsSource="{Binding ColorMap}"
                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{Binding [sldEditor_raster_color], Source={StaticResource Localization}}" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <mahApp:ColorPicker SelectedColor="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{Binding [sldEditor_raster_quantity], Source={StaticResource Localization}}"
                                    Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="70"/>
                <DataGridTextColumn Header="{Binding [sldEditor_raster_label], Source={StaticResource Localization}}"
                                    Binding="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*"/>
                <DataGridTextColumn Header="{Binding [sldEditor_raster_entryOpacity], Source={StaticResource Localization}}"
                                    Binding="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="4"
                   FontStyle="Italic" FontSize="10" Foreground="Gray"
                   Text="{Binding [sldEditor_raster_note], Source={StaticResource Localization}}"/>
    </Grid>
</UserControl>
