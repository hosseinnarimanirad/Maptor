<mahApp:MetroWindow x:Class="IRI.Maptor.Jab.Controls.Dialogs.DxfOpenDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:localization="clr-namespace:IRI.Maptor.Jab.Core.Localization;assembly=IRI.Maptor.Jab.Core"
    xmlns:dialogs="clr-namespace:IRI.Maptor.Jab.Controls.Dialogs"

    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
    Title="{Binding [dialog_dxfOpen_title], Source={StaticResource Localization}}"
    SizeToContent="Manual" ResizeMode="CanResizeWithGrip"
    Width="540" Height="600" MinWidth="500" MinHeight="440" MaxWidth="900"
    FocusManager.FocusedElement="{Binding ElementName=browseButton}"
    WindowStartupLocation="CenterOwner">

    <mahApp:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/Styles/SecurityInputStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </mahApp:MetroWindow.Resources>
    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}"
                   Text="{Binding [dialog_common_fileWatermark], Source={StaticResource Localization}}"/>

        <!-- File -->
        <Border Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.Border.Card}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconMaterial Kind="File" Style="{StaticResource securityIconMaterial}"/>
                <TextBox Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal.En}" FlowDirection="LeftToRight"
                            mahApp:TextBoxHelper.Watermark="{Binding [dialog_common_fileWatermark], Source={StaticResource Localization}}"
                            Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" >
                </TextBox>
                <Button Grid.Column="2" x:Name="browseButton"
                        ToolTip="{Binding [dialog_common_browse], Source={StaticResource Localization}}"
                        AutomationProperties.Name="{Binding [dialog_common_browse], Source={StaticResource Localization}}"
                        Command="{Binding BrowseCommand}"
                        Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                    <iconPacks:PackIconPhosphorIcons Kind="FileMagnifyingGlassFill"/>
                </Button>
                <Button Grid.Column="3"
                        ToolTip="{Binding [dialog_common_removeFile], Source={StaticResource Localization}}"
                        AutomationProperties.Name="{Binding [dialog_common_removeFile], Source={StaticResource Localization}}"
                        Command="{Binding RemoveFileCommand}"
                        Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                    <iconPacks:PackIconMaterial Kind="FileRemoveOutline"/>
                </Button>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Style="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}"
                   Text="{Binding [dialog_common_sectionCoordinateSystem], Source={StaticResource Localization}}"/>

        <!-- Spatial Reference -->
        <Border Grid.Row="3" Style="{StaticResource IRI.Maptor.Styles.Border.Card}" IsEnabled="{Binding CanUserChooseSrs}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconPhosphorIcons Kind="Globe" Style="{StaticResource securityIconPhosphor}"/>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding AvailableSrsOptions}"
                          DisplayMemberPath="DisplayName"                          
                          Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal.Latin}"
                          SelectedItem="{Binding SelectedSrsOption, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- UTM Zone (visible when UTM selected) -->
        <Border Grid.Row="4" Style="{StaticResource IRI.Maptor.Styles.Border.Card}" IsEnabled="{Binding CanUserChooseSrs}"
                Visibility="{Binding IsUtmSelected, Converter={StaticResource boolToVisibilityConverter}}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconPhosphorIcons Kind="MapTrifoldFill" Style="{StaticResource securityIconPhosphor}"/>
                <mahApp:NumericUpDown Grid.Column="1"
                                    Minimum="1" Maximum="60"
                                    mahApp:ControlsHelper.CornerRadius="4"
                                    Value="{Binding UtmZone, Mode=TwoWay}"
                                    Style="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}"/>

                <ToggleButton Grid.Column="2" IsChecked="{Binding IsNorthHemisphere, Mode=TwoWay}"
                              Style="{StaticResource IRI.Maptor.Styles.ToggleButton.CircleLight}"  FlowDirection="LeftToRight"
                              ToolTip="{Binding [dialog_dxfOpen_hemisphereTooltip], Source={StaticResource Localization}}"
                              AutomationProperties.Name="{Binding [dialog_dxfOpen_hemisphereTooltip], Source={StaticResource Localization}}">
                    <iconPacks:PackIconPhosphorIcons Kind="CircleHalfFill" RenderTransformOrigin="0.5,0.5">
                        <iconPacks:PackIconPhosphorIcons.Style>
                            <Style TargetType="iconPacks:PackIconPhosphorIcons" BasedOn="{StaticResource securityIconPhosphor}">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNorthHemisphere}" Value="False">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="90"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconPhosphorIcons.Style>
                    </iconPacks:PackIconPhosphorIcons>
                </ToggleButton>
            </Grid>
        </Border>


        <!-- Sample points -->
        <TextBlock Grid.Row="5" Style="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}"
                   Text="{Binding [dialog_dxfOpen_samplePoints], Source={StaticResource Localization}}"/>
        <DataGrid Grid.Row="6" Margin="4,0,4,8"
                  ItemsSource="{Binding SamplePoints}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                  BorderThickness="1"
                  FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Index}" Width="40">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding [dialog_dxfOpen_columnIndex], Source={StaticResource Localization}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding X, StringFormat=N6}" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding [dialog_dxfOpen_columnX], Source={StaticResource Localization}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Y, StringFormat=N6}" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding [dialog_dxfOpen_columnY], Source={StaticResource Localization}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <dialogs:DialogFooterView Grid.Row="7"
                                  StatusText="{Binding ValidationMessage}"
                                  SecondaryText="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"
                                  SecondaryCommand="{Binding CancelCommand}"
                                  PrimaryText="{Binding [common_open], Source={StaticResource Localization}}"
                                  PrimaryIconKind="FolderOpen"
                                  PrimaryCommand="{Binding OpenCommand}"/>

    </Grid>
</mahApp:MetroWindow>
