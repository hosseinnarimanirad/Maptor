<maptor:LocalizedMetroWindow x:Class="IRI.Maptor.Jab.Controls.GoToMetroWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"              
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls"
                    xmlns:localization="clr-namespace:IRI.Maptor.Jab.Core.Localization;assembly=IRI.Maptor.Jab.Core"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:dialogs="clr-namespace:IRI.Maptor.Jab.Controls.Dialogs"
                    x:Name="root" 
                    FlowDirection="{Binding ElementName=mainView, Path=FlowDirection, Mode=OneWay}"
                    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
                             
                    Title="{Binding [dialog_goto_title], Source={StaticResource Localization}}"
                    WindowStartupLocation="CenterOwner">
                    <!--Title="{Binding ElementName=root, Path=Ltxt_dialog_goto_title}"-->                    
    <maptor:LocalizedMetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.WindowTitle}"/>
        </DataTemplate>
    </maptor:LocalizedMetroWindow.TitleTemplate>
    <maptor:LocalizedMetroWindow.Resources>
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
    </maptor:LocalizedMetroWindow.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <maptor:GoToView x:Name="mainView" Grid.Row="0"
                         FlowDirection="{Binding Path=CurrentFlowDirection, Source={StaticResource Localization}}"/>

        <!--pan/zoom act on the map without dismissing, so Close is the only action-->
        <dialogs:DialogFooterView Grid.Row="1" ShowSecondary="False"
                                  PrimaryText="{Binding [dialog_common_close], Source={StaticResource Localization}}"
                                  PrimaryIconKind="Close"/>
    </Grid>
</maptor:LocalizedMetroWindow>
