<mahApp:MetroWindow x:Class="IRI.Maptor.Jab.Controls.Dialogs.ThemeSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:localization="clr-namespace:IRI.Maptor.Jab.Core.Localization;assembly=IRI.Maptor.Jab.Core"
    xmlns:dialogs="clr-namespace:IRI.Maptor.Jab.Controls.Dialogs"

    Style="{StaticResource IRI.Maptor.Styles.MetroWindow.Dialog}"
    Title="{Binding [dialog_themeSelection_windowTitle], Source={StaticResource Localization}}"
    SizeToContent="Manual" ResizeMode="NoResize"
    Width="800" Height="520"
    MinWidth="800" MaxWidth="800" MinHeight="520" MaxHeight="520"
    FocusManager.FocusedElement="{Binding ElementName=ThemesItemsControl}"
    WindowStartupLocation="CenterOwner"  >

    <mahApp:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <!-- A theme tile is a miniature of the app: accent title bar, a couple of content
                 lines, an accent button. A flat colour square told the user nothing about
                 where the colour actually lands. -->
            <DataTemplate x:Key="ThemeItemTemplate">
                <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=mahApp:MetroWindow}}"
                    CommandParameter="{Binding}"
                    Width="84" Height="98"
                    Margin="0,0,0,10"
                    Padding="0"
                    Cursor="Hand"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    ToolTip="{Binding DisplayName}"
                    AutomationProperties.Name="{Binding DisplayName}"
                    Background="Transparent"
                    FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- preview card -->
                                <Border x:Name="tile" Grid.Row="0" CornerRadius="7" Padding="2"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        Background="{DynamicResource MahApps.Brushes.Gray10}">
                                    <Border CornerRadius="4" ClipToBounds="True"
                                            Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="15"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- title bar -->
                                            <Border Grid.Row="0" Background="{Binding AccentColor}"/>

                                            <!-- body: two text lines and a primary button -->
                                            <StackPanel Grid.Row="1" Margin="7,8,7,0">
                                                <Rectangle Height="4" RadiusX="2" RadiusY="2" Margin="0,0,0,5"
                                                           Fill="{DynamicResource MahApps.Brushes.Gray7}"/>
                                                <Rectangle Height="4" RadiusX="2" RadiusY="2" Width="30"
                                                           HorizontalAlignment="Left" Margin="0,0,0,8"
                                                           Fill="{DynamicResource MahApps.Brushes.Gray8}"/>
                                                <Border Height="11" Width="28" CornerRadius="3"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding AccentColor}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <!-- tick on the applied theme. Kept fully inside the tile: a
                                     negative-margin overhang was clipped on the first row. -->
                                <Border x:Name="check" Grid.Row="0"
                                        Width="17" Height="17" CornerRadius="9"
                                        Margin="0,6,6,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="Collapsed"
                                        BorderThickness="1"
                                        BorderBrush="{Binding AccentColor}"
                                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                                    <iconPacks:PackIconMaterial Kind="Check" Width="9" Height="9"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Foreground="{Binding AccentColor}"/>
                                </Border>

                                <!-- Keyboard focus: a solid Highlight ring inset inside the tile
                                     border, so a focused-and-selected tile shows accent outside +
                                     highlight inside rather than two dashed rectangles. The WPF
                                     default focus rectangle is suppressed via FocusVisualStyle. -->
                                <Rectangle x:Name="FocusRing" Grid.Row="0" Visibility="Collapsed"
                                           RadiusX="5" RadiusY="5" Margin="4"
                                           Stroke="{DynamicResource MahApps.Brushes.Highlight}"
                                           StrokeThickness="1.5"
                                           SnapsToDevicePixels="True"/>

                                <TextBlock x:Name="label" Grid.Row="1" Text="{Binding DisplayName}"
                                           Style="{StaticResource IRI.Maptor.Styles.TextBlock}"
                                           FontSize="11" Margin="0,5,0,0"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <!-- Order matters: a later trigger wins over an earlier one for the
                                 same property. Focus first, then selection (which hides the focus
                                 ring, because the accent ring and tick already mark that tile),
                                 then hover last so a selected tile still reacts to the mouse. -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                                </Trigger>

                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="tile" Property="BorderBrush"
                                            Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                    <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="label" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tile" Property="BorderBrush"
                                            Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </mahApp:MetroWindow.Resources>

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--accent grid on the left, light/dark switch opposite-->
        <DockPanel Grid.Row="0" Margin="2,0,2,8">
            <mahApp:ToggleSwitch DockPanel.Dock="Right"
                                 IsOn="{Binding IsDarkMode, Mode=TwoWay}"
                                 Style="{StaticResource IRI.Maptor.Styles.ToggleSwitch.Normal}"
                                 ContentDirection="LeftToRight"
                                 Margin="0" Padding="0" ContentPadding="6,0,0,0"
                                 MinWidth="0" MinHeight="0" Height="26"
                                 VerticalAlignment="Center"
                                 ToolTip="{Binding [theme_mode_title], Source={StaticResource Localization}}"
                                 OnContent="{Binding [theme_mode_dark], Source={StaticResource Localization}}"
                                 OffContent="{Binding [theme_mode_light], Source={StaticResource Localization}}"/>

            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.SectionHeader}"
                       Margin="0" VerticalAlignment="Center"
                       Text="{Binding [dialog_themeSelection_title], Source={StaticResource Localization}}"/>
        </DockPanel>

        <!-- a quiet surface behind the grid, so the tiles read as a set rather than as
             loose boxes floating on the window background -->
        <Border Grid.Row="1" CornerRadius="6"
                Background="{DynamicResource MahApps.Brushes.Gray10}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="12,12,6,2">
                <!-- Tab moves into the grid once, then the arrow keys walk the tiles and Space
                     applies one; tabbing through 22 buttons one by one was not usable. -->
                <ItemsControl x:Name="ThemesItemsControl" FlowDirection="LeftToRight"
                              KeyboardNavigation.TabNavigation="Once"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              ItemsSource="{Binding AvailableThemes}"
                              ItemTemplate="{StaticResource ThemeItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!--8 across, so the 22 themes land in exactly 3 rows. Rows are not
                                fixed: adding a theme adds a row rather than clipping.-->
                            <UniformGrid Columns="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <dialogs:DialogFooterView Grid.Row="2"
                                  SecondaryText="{Binding [dialog_common_cancel], Source={StaticResource Localization}}"
                                  SecondaryCommand="{Binding CancelCommand}"
                                  PrimaryText="{Binding [dialog_common_save], Source={StaticResource Localization}}"
                                  PrimaryIconKind="ContentSave"
                                  PrimaryCommand="{Binding SaveCommand}"/>
    </Grid>
</mahApp:MetroWindow>
