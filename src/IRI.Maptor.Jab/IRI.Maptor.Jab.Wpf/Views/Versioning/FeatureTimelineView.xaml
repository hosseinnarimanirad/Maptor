<UserControl x:Class="IRI.Maptor.Jab.Controls.Versioning.FeatureTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:localization="clr-namespace:IRI.Maptor.Jab.Core.Localization;assembly=IRI.Maptor.Jab.Core"
             mc:Ignorable="d"
             FontFamily="{StaticResource iranSans}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- picker: layer + feature id + load -->
        <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                               Text="{Binding [versioning_review_colLayer], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                    <ComboBox Style="{StaticResource IRI.Maptor.Styles.ComboBox.Normal}" Width="220" Margin="4,0,12,0"
                              ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}"
                              DisplayMemberPath="DisplayName"/>

                    <!--the card's grey fill is what makes the (borderless) input read as a field-->
                    <Border Style="{StaticResource IRI.Maptor.Styles.Border.Card}" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal}"
                                       Text="{Binding [versioning_timeline_featureId], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                            <TextBox Style="{StaticResource IRI.Maptor.Styles.TextBox.Normal}" Width="110"
                                     Text="{Binding FeatureIdText, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </Border>

                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.Primary.Small}" Command="{Binding LoadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" Kind="History"/>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                       Text="{Binding [versioning_timeline_load], Source={StaticResource Localization}}"/>
                        </StackPanel>
                    </Button>

                    <mah:ProgressRing Width="16" Height="16" Margin="12,0,0,0" IsActive="{Binding IsBusy}"/>
                </StackPanel>

                <!-- result banner -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding HasResult, Converter={StaticResource boolToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal.Bold}" Text="{Binding TitleLabel}"/>
                    <Border Style="{StaticResource IRI.Maptor.Styles.Pill.Invalid}" Margin="8,0,0,0"
                            Visibility="{Binding IsDeleted, Converter={StaticResource boolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text.Invalid}"
                                   Text="{Binding [versioning_timeline_deleted], Source={StaticResource Localization}}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- timeline master-detail -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}">
                <Grid>
                    <DataGrid Style="{StaticResource IRI.Maptor.Styles.DataGrid.ReadOnly}"
                              ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Single"
                              Visibility="{Binding ShowEmpty, Converter={StaticResource boolToInverseVisibilityConverter}}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource IRI.Maptor.Styles.DataGrid.Row}">
                                <Style.Triggers>
                                    <!--the live state is the anchor row: it must read as "now"-->
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Valid.Fill}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [versioning_timeline_colUntil], Source={StaticResource Localization}}" Binding="{Binding WhenLabel}" Width="Auto"/>
                            <DataGridTextColumn Header="{Binding [versioning_approval_colType], Source={StaticResource Localization}}" Binding="{Binding ChangeTypeLabel}" Width="Auto"/>
                            <DataGridTextColumn Header="{Binding [versioning_timeline_colReplacedBy], Source={StaticResource Localization}}" Binding="{Binding ReplacedByLabel}" Width="*"/>
                            <DataGridTextColumn Header="{Binding [versioning_myPending_colSession], Source={StaticResource Localization}}" Binding="{Binding SessionLabel}" Width="*"/>
                            <DataGridTextColumn Header="{Binding [versioning_timeline_colApprover], Source={StaticResource Localization}}" Binding="{Binding ApproverLabel}" Width="Auto"/>
                            <DataGridTextColumn Header="{Binding [versioning_timeline_colBatch], Source={StaticResource Localization}}" Binding="{Binding BatchLabel}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}"
                               Text="{Binding [versioning_timeline_empty], Source={StaticResource Localization}}"
                               Visibility="{Binding ShowEmpty, Converter={StaticResource boolToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- selected state detail -->
            <Border Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}" CornerRadius="4,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal.Bold}"
                                       Text="{Binding [versioning_timeline_attributes], Source={StaticResource Localization}}"/>
                            <Button Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                                    Command="{Binding ShowOnMapCommand}" CommandParameter="{Binding SelectedRow}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" Kind="MapSearchOutline"/>
                                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                               Text="{Binding [versioning_compare_showOnMap], Source={StaticResource Localization}}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.DataGrid.ReadOnly}"
                              ItemsSource="{Binding AttributeRows}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [versioning_compare_field], Source={StaticResource Localization}}" Binding="{Binding Name}" Width="Auto"/>
                            <DataGridTextColumn Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
