<UserControl x:Class="IRI.Maptor.Jab.Controls.Versioning.ReviewQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:localization="clr-namespace:IRI.Maptor.Jab.Core.Localization;assembly=IRI.Maptor.Jab.Core"
             xmlns:versioning="clr-namespace:IRI.Maptor.Jab.Controls.Versioning"
             mc:Ignorable="d"
             FontFamily="{StaticResource iranSans}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>

            <!--row badges: stale/orphaned/queued/delete, from the shared status palette-->
            <DataTemplate x:Key="BadgesTemplate">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IRI.Maptor.Styles.Pill.Warning}"
                            Visibility="{Binding Item.IsStale, Converter={StaticResource boolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text.Warning}"
                                   Text="{Binding [versioning_review_badgeStale], Source={StaticResource Localization}}"/>
                    </Border>
                    <Border Style="{StaticResource IRI.Maptor.Styles.Pill}"
                            Visibility="{Binding Item.IsOrphaned, Converter={StaticResource boolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text}"
                                   Text="{Binding [versioning_review_badgeOrphaned], Source={StaticResource Localization}}"/>
                    </Border>
                    <Border Style="{StaticResource IRI.Maptor.Styles.Pill.Accent}"
                            Visibility="{Binding Item.IsBlockedByPredecessor, Converter={StaticResource boolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text.Accent}"
                                   Text="{Binding [versioning_review_badgeQueued], Source={StaticResource Localization}}"/>
                    </Border>
                    <Border Style="{StaticResource IRI.Maptor.Styles.Pill.Invalid}"
                            Visibility="{Binding Item.HasDelete, Converter={StaticResource boolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.Pill.Text.Invalid}"
                                   Text="{Binding [versioning_review_badgeDelete], Source={StaticResource Localization}}"/>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="CompareButtonTemplate">
                <Button Style="{StaticResource IRI.Maptor.Styles.Button.Primary.Small}"
                        Command="{Binding DataContext.OpenCompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" Kind="CompareHorizontal"/>
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                   Text="{Binding [versioning_review_compare], Source={StaticResource Localization}}"/>
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <!-- ===================== queue ===================== -->
        <Grid Visibility="{Binding IsQueueVisible, Converter={StaticResource boolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- toolbar -->
            <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}" Padding="8,6">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" Kind="Refresh"/>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent.Small}"
                                       Text="{Binding [versioning_review_refresh], Source={StaticResource Localization}}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}" Margin="12,0,4,0"
                               Text="{Binding [versioning_review_lastRefresh], Source={StaticResource Localization}, StringFormat='{}{0}:'}"/>
                    <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Caption}"
                               Text="{Binding LastRefreshedAt, StringFormat='{}{0:HH:mm:ss}', TargetNullValue='—'}"/>
                    <mah:ProgressRing Width="16" Height="16" Margin="12,0,0,0" IsActive="{Binding IsBusy}"/>
                </StackPanel>
            </Border>

            <!-- competitions -->
            <Border Grid.Row="1" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}" CornerRadius="4,4,0,0">
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal.Bold}"
                                   Text="{Binding [versioning_review_competitions], Source={StaticResource Localization}}"/>
                    </Border>

                    <Grid Grid.Row="1">
                        <DataGrid Style="{StaticResource IRI.Maptor.Styles.DataGrid.ReadOnly}"
                                  ItemsSource="{Binding Competitions}" SelectionMode="Single"
                                  Visibility="{Binding IsCompetitionsEmpty, Converter={StaticResource boolToInverseVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [versioning_review_colLayer], Source={StaticResource Localization}}" Binding="{Binding Item.EntityName}" Width="Auto"/>
                                <DataGridTextColumn Header="{Binding [versioning_review_colFeature], Source={StaticResource Localization}}" Binding="{Binding TargetLabel}" Width="Auto"/>
                                <DataGridTextColumn Header="{Binding [versioning_review_colCount], Source={StaticResource Localization}}" Binding="{Binding Item.ProposalCount}" Width="Auto"/>
                                <DataGridTextColumn Header="{Binding [versioning_review_colAuthors], Source={StaticResource Localization}}" Binding="{Binding AuthorsLabel}" Width="*"/>
                                <DataGridTextColumn Header="{Binding [versioning_review_colAge], Source={StaticResource Localization}}" Binding="{Binding AgeLabel}" Width="Auto"/>
                                <DataGridTextColumn Header="{Binding [versioning_review_colSuggestions], Source={StaticResource Localization}}" Binding="{Binding Item.UndismissedSuggestionCount}" Width="Auto"/>
                                <DataGridTemplateColumn Width="Auto" CellTemplate="{StaticResource BadgesTemplate}"/>
                                <DataGridTemplateColumn Width="Auto" CellTemplate="{StaticResource CompareButtonTemplate}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}"
                                   Text="{Binding [versioning_review_empty], Source={StaticResource Localization}}"
                                   Visibility="{Binding IsCompetitionsEmpty, Converter={StaticResource boolToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- singles -->
            <Border Grid.Row="2" Style="{StaticResource IRI.Maptor.Styles.Border.Panel}" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource IRI.Maptor.Styles.Border.Toolbar}" CornerRadius="4,4,0,0">
                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.Normal.Bold}"
                                   Text="{Binding [versioning_review_singles], Source={StaticResource Localization}}"/>
                    </Border>

                    <Grid Grid.Row="1">
                        <DataGrid Style="{StaticResource IRI.Maptor.Styles.DataGrid}"
                                  ItemsSource="{Binding Singles}" SelectionMode="Single"
                                  Visibility="{Binding IsSinglesEmpty, Converter={StaticResource boolToInverseVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource IRI.Maptor.Styles.CheckBox.Small}"
                                                      HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding [versioning_review_colLayer], Source={StaticResource Localization}}" Binding="{Binding Item.EntityName}" Width="Auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{Binding [versioning_review_colFeature], Source={StaticResource Localization}}" Binding="{Binding TargetLabel}" Width="Auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{Binding [versioning_review_colAuthors], Source={StaticResource Localization}}" Binding="{Binding AuthorsLabel}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{Binding [versioning_review_colAge], Source={StaticResource Localization}}" Binding="{Binding AgeLabel}" Width="Auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{Binding [versioning_review_colSuggestions], Source={StaticResource Localization}}" Binding="{Binding Item.UndismissedSuggestionCount}" Width="Auto" IsReadOnly="True"/>
                                <DataGridTemplateColumn Width="Auto" CellTemplate="{StaticResource BadgesTemplate}" IsReadOnly="True"/>
                                <DataGridTemplateColumn Width="Auto" CellTemplate="{StaticResource CompareButtonTemplate}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.EmptyState}"
                                   Text="{Binding [versioning_review_empty], Source={StaticResource Localization}}"
                                   Visibility="{Binding IsSinglesEmpty, Converter={StaticResource boolToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- singles actions -->
            <Border Grid.Row="3" Style="{StaticResource IRI.Maptor.Styles.Border.DialogFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.Primary}" Margin="4"
                            Command="{Binding BulkAcceptSelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}" Kind="CheckAll"/>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                       Text="{Binding [versioning_review_acceptSelected], Source={StaticResource Localization}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.Secondary}" Margin="4"
                            Command="{Binding GroupSelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent}" Kind="SetMerge"/>
                            <TextBlock Style="{StaticResource IRI.Maptor.Styles.TextBlock.ButtonContent}"
                                       Text="{Binding [versioning_review_groupSelected], Source={StaticResource Localization}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== compare detail ===================== -->
        <!-- A ContentControl instantiates its ContentTemplate even for null Content, so
             the null case must collapse explicitly or an empty compare view paints over
             the queue. -->
        <ContentControl Content="{Binding CurrentCompare}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <versioning:CompetitionCompareView/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>
