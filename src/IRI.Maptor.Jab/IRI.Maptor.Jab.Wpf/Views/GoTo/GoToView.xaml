<UserControl x:Class="IRI.Maptor.Jab.Controls.GoToView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             x:Name="window" Height="190"
             xmlns:model="clr-namespace:IRI.Maptor.Jab.Wpf.Models.GoTo">
    <UserControl.Resources>
        <DataTemplate x:Key="MenuItemTemplate" DataType="{x:Type model:HamburgerGoToMenuItem}">
            <Grid Height="48" Margin="0,4,0,0" Background="Transparent" Cursor="Hand" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--This template sits on the HamburgerMenu's PaneBackground, which is
                    MahApps.Brushes.Highlight. IdealForeground is the token that pairs with an
                    accent/highlight fill, so the icons and captions stay legible whatever
                    accent the user picks. They were literal White before.-->
                <Path Grid.Column="0" Width="28" Data="{Binding Icon}" Stretch="Uniform" FlowDirection="LeftToRight"
                      Fill="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                <!--had no Foreground at all, so it rendered in default dark text on the pane-->
                <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding SubTitle}" HorizontalAlignment="Center" FontSize="11"
                           Style="{StaticResource IRI.Maptor.Styles.TextBlock}"
                           Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"
                           Visibility="{Binding HasSubTitle, Converter={StaticResource boolToVisibilityConverter}}"/>
                <!--FontFamily="Segoe UI" was hardcoded here, overriding the Persian face in an
                    RTL app; the base TextBlock style carries the IsPersian trigger instead-->
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="{Binding Title}" Grid.RowSpan="2"
                           Style="{StaticResource IRI.Maptor.Styles.TextBlock}"
                           Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
 
    <mahApp:HamburgerMenu x:Name="hamburgerMenuControl" PaneBackground="{DynamicResource MahApps.Brushes.Highlight}" 
                            IsPaneOpen="False" DisplayMode="CompactInline"  
                            ItemTemplate="{StaticResource MenuItemTemplate}" CompactPaneLength="48" 
                            HamburgerHeight="48" Content="{Binding SelectedItem.Content}"
                            SelectedItem="{Binding SelectedItem, Mode=TwoWay}" ItemsSource="{Binding MenuItems}">
        <mahApp:HamburgerMenu.ContentTemplate>
            <DataTemplate DataType="{x:Type FrameworkElement}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions> 
                    <ContentControl Grid.Row="0" Content="{Binding }"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="8">
                        <Button Command="{Binding ElementName=window, Path=DataContext.PanToCommand}"
                                ToolTip="{Binding [dialog_goto_panTo], Source={StaticResource Localization}}"
                                AutomationProperties.Name="{Binding [dialog_goto_panTo], Source={StaticResource Localization}}"
                                Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                            <iconPacks:PackIconMaterial Kind="HandBackRight" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                        </Button>
                        <Button Command="{Binding ElementName=window, Path=DataContext.ZoomToCommand}"
                                ToolTip="{Binding [dialog_goto_zoomTo], Source={StaticResource Localization}}"
                                AutomationProperties.Name="{Binding [dialog_goto_zoomTo], Source={StaticResource Localization}}"
                                Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}">
                            <iconPacks:PackIconMaterial Kind="MagnifyExpand" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </mahApp:HamburgerMenu.ContentTemplate>
    </mahApp:HamburgerMenu>

</UserControl>
