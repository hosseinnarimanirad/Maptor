<UserControl x:Class="IRI.Maptor.Jab.Controls.FeatureChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
            xmlns:localization="clr-namespace:IRI.Maptor.Jab.Core.Localization;assembly=IRI.Maptor.Jab.Core"
             xmlns:enums="clr-namespace:IRI.Maptor.Sta.Common.Enums;assembly=IRI.Maptor.Sta.Common"
             mc:Ignorable="d"
             FontFamily="{StaticResource iranSans}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/> 
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Controls.All.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <Style TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CircleLightButtonContent}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="4">
        <!-- Header -->
        <GroupBox Margin="0,0,0,8" Padding="4">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="{Binding Status, Converter={StaticResource featureStatusToMaterialIconConverter}}"
                                                Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                                Foreground="{Binding Status, Converter={StaticResource featureStatusToBrushConverter}}"/>
                    <TextBlock Text="{Binding [featureChanges_title], Source={StaticResource Localization}}"
                               FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                </StackPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [featureChanges_status], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="0,0,8,4"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <iconPacks:PackIconMaterial Kind="{Binding Status, Converter={StaticResource featureStatusToMaterialIconConverter}}"
                                                Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"
                                                Foreground="{Binding Status, Converter={StaticResource featureStatusToBrushConverter}}"/>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding [featureChanges_lastModified], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="0,0,8,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding LastAddOrUpdateFormatted}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [featureChanges_id], Source={StaticResource Localization}}" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Id}" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Attribute changes -->
        <GroupBox Margin="0,0,0,8" Padding="4"
                  Visibility="{Binding ChangedAttributes.Count, Converter={StaticResource intGreaterThanIntParameterToVisibilityConverter}, ConverterParameter=0}">
            <GroupBox.Header>
                <TextBlock Text="{Binding [featureChanges_attributeChanges], Source={StaticResource Localization}}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"/>
            </GroupBox.Header>
            <StackPanel>
                <Border BorderBrush="LightGray" BorderThickness="0,0,0,2" Padding="4,2" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [featureChanges_attributeName], Source={StaticResource Localization}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding [featureChanges_oldValue], Source={StaticResource Localization}}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="Gray" Margin="4,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding [featureChanges_newValue], Source={StaticResource Localization}}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding ChangedAttributes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="4,2" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OldValue, TargetNullValue='-'}" VerticalAlignment="Center" Foreground="Gray" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding NewValue, TargetNullValue='-'}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </GroupBox>

        <!-- Geometry changes -->
        <GroupBox Margin="0,0,0,8" Padding="4"
                  Visibility="{Binding HasGeometryChanges, Converter={StaticResource boolToVisibilityConverter}}">
            <GroupBox.Header>
                <TextBlock Text="{Binding [featureChanges_geometryChanges], Source={StaticResource Localization}}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"/>
            </GroupBox.Header>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Command="{Binding ZoomToCurrentGeometryCommand}"
                            ToolTip="{Binding [featureChanges_zoomToCurrent], Source={StaticResource Localization}}"
                            AutomationProperties.Name="{Binding [featureChanges_zoomToCurrent], Source={StaticResource Localization}}" Margin="0,0,4,0">
                        <iconPacks:PackIconMaterial Kind="MagnifyExpand"/>
                    </Button>
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Command="{Binding ZoomToOldGeometryCommand}"
                            ToolTip="{Binding [featureChanges_zoomToOld], Source={StaticResource Localization}}"
                            AutomationProperties.Name="{Binding [featureChanges_zoomToOld], Source={StaticResource Localization}}" Margin="0,0,4,0">
                        <iconPacks:PackIconMaterial Kind="History"/>
                    </Button>
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Command="{Binding ZoomToBothGeometriesCommand}"
                            ToolTip="{Binding [featureChanges_zoomToBoth], Source={StaticResource Localization}}"
                            AutomationProperties.Name="{Binding [featureChanges_zoomToBoth], Source={StaticResource Localization}}" Margin="0,0,4,0">
                        <iconPacks:PackIconMaterial Kind="ArrowExpandAll"/>
                    </Button>
                    <Button Style="{StaticResource IRI.Maptor.Styles.Button.CircleLight}" Command="{Binding CompareGeometriesCommand}"
                            ToolTip="{Binding [featureChanges_compareOnMap], Source={StaticResource Localization}}"
                            AutomationProperties.Name="{Binding [featureChanges_compareOnMap], Source={StaticResource Localization}}">
                        <iconPacks:PackIconMaterial Kind="Compare"/>
                    </Button>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Separator Grid.Row="0" Grid.ColumnSpan="4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="Bold" Text="{Binding [featureChanges_areaOld], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GeometryOldAreaLabel, TargetNullValue='-'}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="Bold" Text="{Binding [featureChanges_areaNew], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GeometryNewAreaLabel, TargetNullValue='-'}" Margin="0,0,0,4"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="2" FontWeight="Bold" Text="{Binding [featureChanges_lengthOld], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding GeometryOldLengthLabel, TargetNullValue='-'}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" FontWeight="Bold" Text="{Binding [featureChanges_lengthNew], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding GeometryNewLengthLabel, TargetNullValue='-'}" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" FontWeight="Bold" Text="{Binding [featureChanges_areaChange], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GeometryAreaChangeLabel, TargetNullValue='-'}" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="2" FontWeight="Bold" Text="{Binding [featureChanges_lengthChange], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding GeometryLengthChangeLabel, TargetNullValue='-'}" Margin="0,0,0,4"/>

                    <Separator Grid.Row="6" Grid.ColumnSpan="4"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding [featureChanges_wktOld], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="0,0,8,4" VerticalAlignment="Top"/>
                    <ScrollViewer Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="4" FlowDirection="LeftToRight" MaxHeight="50" Margin="0" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding GeometryOldWkt, TargetNullValue='-'}" HorizontalAlignment="Stretch" Background="#EEEEEE"
                                    TextWrapping="Wrap" Padding="4" MaxWidth="700" Margin="0,0,0,4" FontFamily="Consolas" FontSize="11"/>
                    </ScrollViewer>
                    
                    <Separator Grid.Row="8" Grid.ColumnSpan="4"/>
                    
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding [featureChanges_wktNew], Source={StaticResource Localization}, StringFormat='{}{0}:'}" Margin="0,0,8,4" VerticalAlignment="Top"/>
                    <ScrollViewer Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="4" FlowDirection="LeftToRight" 
                 VerticalScrollBarVisibility="Auto" MaxHeight="50" Margin="0" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding GeometryNewWkt, TargetNullValue='-'}" HorizontalAlignment="Stretch" Background="#EEEEEE"
                 TextWrapping="Wrap" Padding="4" MaxWidth="700" Margin="0,0,0,4" FontFamily="Consolas" FontSize="11"/>
                    </ScrollViewer>

                </Grid>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
