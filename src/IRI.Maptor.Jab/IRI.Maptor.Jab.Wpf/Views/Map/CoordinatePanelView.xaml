<maptor:NotifiableUserControl x:Class="IRI.Maptor.Jab.Controls.CoordinatePanelView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                xmlns:localization="clr-namespace:IRI.Maptor.Jab.Core.Localization;assembly=IRI.Maptor.Jab.Core"
                xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"                 
                xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls" 
                x:Name="root" Height="auto" Width="auto" MouseLeave="UserControl_MouseLeave">
    <maptor:NotifiableUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
            <Style TargetType="TextBlock" x:Key="staticText">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="4,2"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="dynamicText">
                <Setter Property="Background" Value="White"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Width" Value="100"/>
                <Setter Property="Margin" Value="0 0 10 0"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="Padding" Value="4,2"/>
            </Style>
        </ResourceDictionary>
    </maptor:NotifiableUserControl.Resources>
    <Border BorderThickness="1" CornerRadius="3" Padding="8,1,1,1"
            FlowDirection="{Binding Path=CurrentFlowDirection, Source={StaticResource Localization}}"
            MinWidth="460">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                <Setter Property="Opacity" Value="0.8"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Name="optionsRow" Height="0"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Name="optionsRow2" Height="0"/>
            </Grid.RowDefinitions>
      
            <DockPanel Grid.Row="2" VerticalAlignment="Center" MouseDown="options_MouseDown" Cursor="Hand" LastChildFill="True" Background="Transparent">
                
                <!--Height-->
                <TextBlock DockPanel.Dock="Right" Margin="0"
                            Style="{StaticResource dynamicText}" 
                            Text="{Binding ElementName=root, Path=CurrentHeight, Converter={StaticResource localizedNumberConverter}}"
                            Visibility="{Binding ElementName=root, Path=IsHeightAvailable, Converter={StaticResource boolToVisibilityConverter}}"/>
                <TextBlock DockPanel.Dock="Right" 
                            Style="{StaticResource staticText}"                     
                            Text="{Binding [map_coordinatePanel_height], Source={StaticResource Localization}}" 
                            Visibility="{Binding ElementName=root, Path=IsHeightAvailable, Converter={StaticResource boolToVisibilityConverter}}"/>
                
                <!--UTM Zone-->
                <TextBlock DockPanel.Dock="Right"
                            Style="{StaticResource dynamicText}"                            
                            Text="{Binding SelectedItem.ZoneNumber}"
                            Visibility="{Binding SelectedItem.IsZoneVisible, Converter={StaticResource boolToVisibilityConverter}}"/>
                <TextBlock DockPanel.Dock="Right"
                            Style="{StaticResource staticText}"
                            Text="{Binding SelectedItem.ZoneItem}"
                            Visibility="{Binding SelectedItem.IsZoneVisible, Converter={StaticResource boolToVisibilityConverter}}"/>
                
                <!--Y-->
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource dynamicText}" Text="{Binding SelectedItem.YValue}" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource staticText}" Text="{Binding SelectedItem.YLabelItem}" />

                <!--X-->
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource dynamicText}" Text="{Binding SelectedItem.XValue}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource staticText}" Text="{Binding SelectedItem.XLabelItem}"/>

                <!--Title-->
                <TextBlock DockPanel.Dock="Left" Margin="0,0,1,0" Style="{StaticResource staticText}" Text="{Binding SelectedItem.SubTitleItem}"/>
            </DockPanel>
            <ItemsControl Grid.Row="3" ItemsSource="{Binding SpatialReferences}">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <StackPanel IsItemsHost="True"/>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="A" IsChecked="{Binding IsSelected, Mode=TwoWay}" Background="Transparent"
                                     Margin="6 2" Foreground="White" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                     Cursor="Hand">
                            <Label Content="{Binding TitleItem}" Foreground="White"/>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</maptor:NotifiableUserControl>
