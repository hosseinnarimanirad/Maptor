<UserControl x:Class="IRI.Maptor.Jab.Controls.MapOptions.MapFiveOptions"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                Width="150" Height="130" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary Source="/IRI.Maptor.Jab.Wpf;component/Assets/Styles/MapOptionStyles.xaml"/>
    </UserControl.Resources>
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform/>
        </TransformGroup>
    </UserControl.RenderTransform>

    <Grid Margin="0"> 
        <Ellipse Width="8" Height="8" Opacity=".6" Fill="{DynamicResource MahApps.Brushes.Accent}" Margin="0" Stroke="White" StrokeThickness="2"/>

        <Button Name="rightButton" Style="{StaticResource mapOptionsButton}" Command="{Binding RightCommand}" ToolTip="{Binding RightToolTip}" >
            <Path Style="{StaticResource mapOptionsPath}" Data="{Binding RightSymbol}"/>
        </Button>

        <Button Name="upperRightButton" Style="{StaticResource mapOptionsButton}" Command="{Binding UpperRightCommand}" ToolTip="{Binding UpperRightToolTip}" >
            <Path Style="{StaticResource mapOptionsPath}" Data="{Binding UpperRightSymbol}"/>
        </Button>

        <Button Name="middleButton" Style="{StaticResource mapOptionsButton}" Command="{Binding MiddleCommand}" ToolTip="{Binding MiddleToolTip}" >
            <Path Style="{StaticResource mapOptionsPath}" Data="{Binding MiddleSymbol}"/>
        </Button>

        <Button Name="upperLeftButton" Style="{StaticResource mapOptionsButton}" Command="{Binding UpperLeftCommand}" ToolTip="{Binding UpperLeftToolTip}" >
            <Path Style="{StaticResource mapOptionsPath}" Data="{Binding UpperLeftSymbol}"/>
        </Button>

        <Button Name="leftButton" Style="{StaticResource mapOptionsButton}" Command="{Binding LeftCommand}" ToolTip="{Binding LeftToolTip}" >
            <Path Style="{StaticResource mapOptionsPath}" Data="{Binding LeftSymbol}"/>
        </Button>
    </Grid>
</UserControl>