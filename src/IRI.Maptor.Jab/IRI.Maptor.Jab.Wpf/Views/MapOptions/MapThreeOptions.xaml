<UserControl x:Class="IRI.Maptor.Jab.Controls.MapOptions.MapThreeOptions"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                Width="150" Height="130" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary Source="/IRI.Maptor.Jab.Wpf;component/Assets/Styles/MapOptionStyles.xaml"/>
    </UserControl.Resources>
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform/>
        </TransformGroup>
    </UserControl.RenderTransform>

    <Grid>

        <Ellipse x:Name="pointEllipse"  Width="10" Height="10" Fill="{DynamicResource MahApps.Brushes.Highlight}"  Margin="0,0,0,0" Stroke="White" StrokeThickness="2"/>

        <Button Name="rightButton" Style="{StaticResource IRI.Maptor.Styles.Button.MapOption}" Command="{Binding RightCommand}" ToolTip="{Binding RightToolTip}" >
            <Path Style="{StaticResource IRI.Maptor.Styles.Path.MapOption}" Data="{Binding RightSymbol}"/>
        </Button>

        <Button Name="middleButton" Style="{StaticResource IRI.Maptor.Styles.Button.MapOption}" Command="{Binding MiddleCommand}" ToolTip="{Binding MiddleToolTip}" >
            <Path Style="{StaticResource IRI.Maptor.Styles.Path.MapOption}" Data="{Binding MiddleSymbol}"/>
        </Button>

        <Button Name="leftButton" Style="{StaticResource IRI.Maptor.Styles.Button.MapOption}" Command="{Binding LeftCommand}" ToolTip="{Binding LeftToolTip}" >
            <Path Style="{StaticResource IRI.Maptor.Styles.Path.MapOption}" Data="{Binding LeftSymbol}"/>
        </Button>
    </Grid>
</UserControl>
