<UserControl x:Class="IRI.Maptor.Jab.Controls.Symbology.Sld.PolygonSymbolizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:sld="clr-namespace:IRI.Maptor.Sta.Ogc.SLD;assembly=IRI.Maptor.Sta.Ogc"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="350">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [sldEditor_common_fillColor], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
        <mahApp:ColorPicker Grid.Row="0" Grid.Column="1" Margin="4" 
                            SelectedColor="{Binding FillColor, Mode=TwoWay}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [sldEditor_common_fillOpacity], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
        <Slider Grid.Row="1" Grid.Column="1" Margin="4" 
                Value="{Binding FillOpacity, Mode=TwoWay}" 
                Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [sldEditor_common_strokeColor], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
        <mahApp:ColorPicker Grid.Row="2" Grid.Column="1" Margin="4" 
                            SelectedColor="{Binding StrokeColor, Mode=TwoWay}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [sldEditor_common_strokeWidth], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
        <mahApp:NumericUpDown Grid.Row="3" Grid.Column="1" Margin="4" 
                              Value="{Binding StrokeWidth, Mode=TwoWay}" 
                              Minimum="0" Maximum="50" Interval="0.5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [sldEditor_common_strokeOpacity], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
        <Slider Grid.Row="4" Grid.Column="1" Margin="4" 
                Value="{Binding StrokeOpacity, Mode=TwoWay}" 
                Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [sldEditor_common_lineCap], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
        <ComboBox Grid.Row="5" Grid.Column="1" Margin="4" SelectedItem="{Binding LineCap}">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sld:Sld_StrokeLineCap}">
                    <sld:Sld_StrokeLineCap>Butt</sld:Sld_StrokeLineCap>
                    <sld:Sld_StrokeLineCap>Round</sld:Sld_StrokeLineCap>
                    <sld:Sld_StrokeLineCap>Square</sld:Sld_StrokeLineCap>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [sldEditor_common_lineJoin], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
        <ComboBox Grid.Row="6" Grid.Column="1" Margin="4" SelectedItem="{Binding LineJoin}">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sld:Sld_StrokeLineJoin}">
                    <sld:Sld_StrokeLineJoin>Mitre</sld:Sld_StrokeLineJoin>
                    <sld:Sld_StrokeLineJoin>Round</sld:Sld_StrokeLineJoin>
                    <sld:Sld_StrokeLineJoin>Bevel</sld:Sld_StrokeLineJoin>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding [sldEditor_common_geometryProperty], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
        <TextBox Grid.Row="7" Grid.Column="1" Margin="4" 
                 Text="{Binding GeometryPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>

