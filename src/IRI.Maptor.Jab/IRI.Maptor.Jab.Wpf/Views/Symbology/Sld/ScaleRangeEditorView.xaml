<UserControl x:Class="IRI.Maptor.Jab.Controls.Symbology.Sld.ScaleRangeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="400">

    <!--Label column uses the shared token: this editor sits on the Rule Properties tab while the
        symbolizers sit on another, and the two used 100 and 120, so labels shifted as the user
        switched tabs.-->

    <Grid Margin="{StaticResource IRI.Maptor.Styles.Thickness.ViewContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource IRI.Maptor.Styles.GridLength.FieldLabelColumn}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_scaleRange_minScale], Source={StaticResource Localization}}"/>
        <mahApp:NumericUpDown Grid.Row="0" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}"
                              Value="{Binding MinScale, Mode=TwoWay}"
                              Minimum="0"
                              HideUpDownButtons="True"
                              mahApp:TextBoxHelper.Watermark="{Binding [sldEditor_scaleRange_minWatermark], Source={StaticResource Localization}}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource IRI.Maptor.Styles.TextBlock.FieldLabel}"
                   Text="{Binding [sldEditor_scaleRange_maxScale], Source={StaticResource Localization}}"/>
        <mahApp:NumericUpDown Grid.Row="1" Grid.Column="1" Style="{StaticResource IRI.Maptor.Styles.NumericUpDown.Normal}"
                              Value="{Binding MaxScale, Mode=TwoWay}"
                              Minimum="0"
                              HideUpDownButtons="True"
                              mahApp:TextBoxHelper.Watermark="{Binding [sldEditor_scaleRange_maxWatermark], Source={StaticResource Localization}}"/>
    </Grid>
</UserControl>
