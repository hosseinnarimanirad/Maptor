<UserControl x:Class="IRI.Maptor.Jab.Controls.Symbology.Sld.SldEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls.Symbology.Sld"
             xmlns:converters="clr-namespace:IRI.Maptor.Jab.Wpf.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--this view had no shared styles in scope at all, so its tabs (and everything else)
                rendered with stock MahApps chrome instead of the Maptor design system-->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Controls.All.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IRI.Maptor.Jab.Wpf;component/Assets/IRI.Maptor.Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource IRI.Maptor.Styles.TabItem}"/>

        <converters:NotNullToBoolConverter x:Key="NotNullToBool"/>

        <!-- DataTemplate for PointSymbolizer -->
        <DataTemplate x:Key="PointSymbolizerTemplate">
            <maptor:PointSymbolizerView DataContext="{Binding}"/>
        </DataTemplate>
        
        <!-- DataTemplate for LineSymbolizer -->
        <DataTemplate x:Key="LineSymbolizerTemplate">
            <maptor:LineSymbolizerView DataContext="{Binding}"/>
        </DataTemplate>
        
        <!-- DataTemplate for PolygonSymbolizer -->
        <DataTemplate x:Key="PolygonSymbolizerTemplate">
            <maptor:PolygonSymbolizerView DataContext="{Binding}"/>
        </DataTemplate>
        
        <!-- DataTemplate for TextSymbolizer -->
        <DataTemplate x:Key="TextSymbolizerTemplate">
            <maptor:TextSymbolizerView DataContext="{Binding}"/>
        </DataTemplate>

        <!-- DataTemplate for RasterSymbolizer -->
        <DataTemplate x:Key="RasterSymbolizerTemplate">
            <maptor:RasterSymbolizerView DataContext="{Binding}"/>
        </DataTemplate>

        <!-- Symbolizer Type Selector -->
        <maptor:SymbolizerDataTemplateSelector x:Key="SymbolizerTemplateSelector"
            PointTemplate="{StaticResource PointSymbolizerTemplate}"
            LineTemplate="{StaticResource LineSymbolizerTemplate}"
            PolygonTemplate="{StaticResource PolygonSymbolizerTemplate}"
            TextTemplate="{StaticResource TextSymbolizerTemplate}"
            RasterTemplate="{StaticResource RasterSymbolizerTemplate}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Style Information -->
        <GroupBox Grid.Row="0" Header="{Binding [sldEditor_common_styleInformation], Source={StaticResource Localization}}" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [sldEditor_common_layerName], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="4" 
                         Text="{Binding LayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [sldEditor_common_styleName], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="4" 
                         Text="{Binding StyleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [sldEditor_common_styleTitle], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="4" 
                         Text="{Binding StyleTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [sldEditor_common_abstract], Source={StaticResource Localization}}" VerticalAlignment="Top" Margin="4"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="4" Height="50"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Text="{Binding StyleAbstract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!--notice: the loaded document holds styles/layers beyond the one edited
                    here; they round-trip unchanged (SldEditorViewModel.HasPreservedContent)-->
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="4,6,4,2"
                           FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"
                           Text="{Binding [sldEditor_common_preservedContentNotice], Source={StaticResource Localization}}"
                           Visibility="{Binding HasPreservedContent, Converter={StaticResource boolToVisibilityConverter}}"/>
            </Grid>
        </GroupBox>

        <!-- Main Content with Rules and Symbolizers -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Rules List -->
            <GroupBox Grid.Column="0" Header="{Binding [sldEditor_common_rules], Source={StaticResource Localization}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                        <Button Command="{Binding AddRuleCommand}" ToolTip="{Binding [sldEditor_common_addRule], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                            <iconPacks:PackIconMaterial Kind="Plus" />
                        </Button>
                        <Button Command="{Binding RemoveRuleCommand}" ToolTip="{Binding [sldEditor_common_removeRule], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                            <iconPacks:PackIconMaterial Kind="Delete" />
                        </Button>
                        <Button Command="{Binding MoveRuleUpCommand}" ToolTip="{Binding [sldEditor_common_moveUp], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                            <iconPacks:PackIconMaterial Kind="ChevronUp" />
                        </Button>
                        <Button Command="{Binding MoveRuleDownCommand}" ToolTip="{Binding [sldEditor_common_moveDown], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                            <iconPacks:PackIconMaterial Kind="ChevronDown" />
                        </Button>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Rules}"
                             SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             Margin="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel MinHeight="28">
                                    <!--live swatch preview (regenerates as the rule's symbolizers change)-->
                                    <Border DockPanel.Dock="Left" Width="36" Height="26" Margin="0,1,6,1"
                                            BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1"
                                            CornerRadius="3" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                        <Image Source="{Binding SwatchImage}" Width="32" Height="24"
                                               Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Rule Details -->
            <TabControl Grid.Column="2"
                        x:Name="RuleTabControl"
                        Style="{StaticResource IRI.Maptor.Styles.TabControl}"
                        SelectionChanged="OnTabChanged"
                        IsEnabled="{Binding SelectedRule, Converter={StaticResource NotNullToBool}}">
                
                <!-- Rule Properties Tab -->
                <TabItem Header="{Binding [sldEditor_common_ruleProperties], Source={StaticResource Localization}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <GroupBox Header="{Binding [sldEditor_common_general], Source={StaticResource Localization}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [sldEditor_common_name], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="4" 
                                             Text="{Binding SelectedRule.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [sldEditor_common_title], Source={StaticResource Localization}}" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4" 
                                             Text="{Binding SelectedRule.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [sldEditor_common_abstract], Source={StaticResource Localization}}" VerticalAlignment="Top" Margin="4"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="4" Height="50" 
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             Text="{Binding SelectedRule.Abstract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{Binding [sldEditor_common_scaleRange], Source={StaticResource Localization}}" Margin="0,10,0,0">
                                <maptor:ScaleRangeEditorView DataContext="{Binding SelectedRule}"/>
                            </GroupBox>

                            <GroupBox Header="{Binding [sldEditor_common_filter], Source={StaticResource Localization}}" Margin="0,10,0,0">
                                <maptor:SimpleFilterEditorView DataContext="{Binding SelectedRule}"/>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Symbolizers Tab -->
                <TabItem Header="{Binding [sldEditor_common_symbolizers], Source={StaticResource Localization}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Symbolizer Toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                            <Button Command="{Binding SelectedRule.AddPointSymbolizerCommand}" 
                                    ToolTip="{Binding [sldEditor_common_addPointSymbolizer], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                                <iconPacks:PackIconMaterial Kind="VectorPointPlus" />
                            </Button>
                            <Button Command="{Binding SelectedRule.AddLineSymbolizerCommand}" 
                                    ToolTip="{Binding [sldEditor_common_addLineSymbolizer], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                                <iconPacks:PackIconMaterial Kind="VectorPolylinePlus" />
                            </Button>
                            <Button Command="{Binding SelectedRule.AddPolygonSymbolizerCommand}" 
                                    ToolTip="{Binding [sldEditor_common_addPolygonSymbolizer], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                                <iconPacks:PackIconMaterial Kind="ShapePolygonPlus" />
                            </Button>
                            <Button Command="{Binding SelectedRule.AddTextSymbolizerCommand}"
                                    ToolTip="{Binding [sldEditor_common_addTextSymbolizer], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                                <iconPacks:PackIconMaterial Kind="FormatAnnotationPlus" />
                            </Button>
                            <!--hidden for vector layers: the runtime renderer skips raster
                                symbolizers, so authoring one there would silently do nothing-->
                            <Button Command="{Binding SelectedRule.AddRasterSymbolizerCommand}"
                                    Visibility="{Binding CanAddRasterSymbolizer, Converter={StaticResource boolToVisibilityConverter}}"
                                    ToolTip="{Binding [sldEditor_common_addRasterSymbolizer], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                                <iconPacks:PackIconMaterial Kind="Image" />
                            </Button>
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>
                            <Button Command="{Binding SelectedRule.RemoveSymbolizerCommand}" 
                                    ToolTip="{Binding [sldEditor_common_removeSymbolizer], Source={StaticResource Localization}}" Width="32" Height="32" Margin="2">
                                <iconPacks:PackIconMaterial Kind="Delete" />
                            </Button>
                        </StackPanel>

                        <!-- Symbolizers List -->
                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding SelectedRule.Symbolizers}" 
                                 SelectedItem="{Binding SelectedRule.SelectedSymbolizer, Mode=TwoWay}"
                                 DisplayMemberPath="SymbolizerType"
                                 Margin="4"/>

                        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="LightGray"/>

                        <!-- Symbolizer Editor -->
                        <GroupBox Grid.Row="3" Header="{Binding [sldEditor_common_symbolizerProperties], Source={StaticResource Localization}}" Margin="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ContentControl Content="{Binding SelectedRule.SelectedSymbolizer}"
                                              ContentTemplateSelector="{StaticResource SymbolizerTemplateSelector}"/>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- XML Preview Tab -->
                <TabItem x:Name="XmlPreviewTab" Header="{Binding [sldEditor_common_xmlPreview], Source={StaticResource Localization}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                            <Button Content="{Binding [sldEditor_common_refreshPreview], Source={StaticResource Localization}}" Command="{Binding RefreshPreviewCommand}" Width="120" Margin="4"/>
                            <Button Content="{Binding [sldEditor_common_exportToFile], Source={StaticResource Localization}}" Command="{Binding ExportSldCommand}" Width="120" Margin="4"/>
                            <Button Content="{Binding [sldEditor_common_importFromFile], Source={StaticResource Localization}}" Command="{Binding ImportSldCommand}" Width="120" Margin="4"/>
                        </StackPanel>

                        <!--XML is inherently LTR; without the explicit FlowDirection the RTL
                            (Persian) window mirrors the markup into unreadable text-->
                        <TextBox Grid.Row="1"
                                 Margin="4"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 FlowDirection="LeftToRight"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Text="{Binding XmlPreview, Mode=OneWay}"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>

