<UserControl x:Class="IRI.Maptor.Jab.Controls.FeatureTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:localization="clr-namespace:IRI.Maptor.Jab.Core.Localization;assembly=IRI.Maptor.Jab.Core"
             x:Name="root">
    <UserControl.Resources>
        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource IRI.Maptor.Styles.TabItem}" />
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}"/>
    </UserControl.Resources>
    <TabControl ItemsSource="{Binding SelectedLayers}" VerticalAlignment="Stretch" Margin="0"
                SelectedItem="{Binding CurrentLayer, Mode=TwoWay}" Padding="0" SelectedIndex="0">
        <!-- Pick the header layout based on FeatureTabControl.UseMultiRowTabs: default is the
             shared single-line scrolling track, True swaps in the shared wrapping one. Both
             templates live in Controls.TabControl.xaml — this control used to carry private copies,
             which is how its strip drifted away from the rest of the app in the first place.
             The template must stay a Style setter (not a local TabControl.Template value) so the
             DataTrigger can swap it. -->
        <TabControl.Style>
            <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource IRI.Maptor.Styles.TabControl.Scroll}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UseMultiRowTabs, RelativeSource={RelativeSource AncestorType=maptor:FeatureTabControl}}" Value="True">
                        <Setter Property="Template" Value="{StaticResource IRI.Maptor.Styles.TabControl.Template}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TabControl.Style>
        <TabControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0">
                    <!--Foreground follows the owning TabItem so the header picks up the shared
                        style's selected/hover/disabled colours. It used to be hard-coded to Black,
                        which pinned it to one theme; the font likewise now comes from the style's
                        IsPersian trigger rather than always being iranSans.-->
                    <TextBlock Margin="0" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}, Path=Foreground}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} ({1})">
                                <Binding Path="LayerName"/>
                                <Binding Path="Features.Count" Converter="{StaticResource localizedNumberConverter}" ConverterParameter="N0"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button Command="{Binding RemoveSelectedLayerCommand}"
                            Style="{StaticResource IRI.Maptor.Styles.Button.TabClose}">
                        <Viewbox>
                            <!--follows the button, which follows the pill: dark on an unselected
                                tab, light on the selected accent fill, red on hover-->
                            <iconPacks:PackIconMaterial Kind="CloseThick"
                                Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
            <DataTemplate>
                <maptor:FeatureTable    DataContext="{Binding }"
                                        IsZoomToGeometryEnabled="{Binding IsZoomToGeometryEnabled, RelativeSource={RelativeSource AncestorType=maptor:FeatureTabControl}}"
                                        CanUserEditGeometry="{Binding CanUserEditGeometry, RelativeSource={RelativeSource AncestorType=maptor:FeatureTabControl}}"
                                        CanUserEditAttribute="{Binding CanUserEditAttribute, RelativeSource={RelativeSource AncestorType=maptor:FeatureTabControl}}" />
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>
