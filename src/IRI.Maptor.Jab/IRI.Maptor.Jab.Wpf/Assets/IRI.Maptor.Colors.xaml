<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Fixed, non-theme-aware colours. Anything that should follow the light/dark theme belongs
        in Status.Light/Dark.xaml or on a MahApps.Brushes.* token instead.

        Step 5a removed 23 bare-name brushes from this file (red, green, blue, purple, orange,
        lime, emerald, teal, cyan, cobalt, indigo, violet, pink, magenta, crimson, amber, yellow,
        brown, olive, steel, mauve, taupe, sienna). They had zero references anywhere in the
        repository, verified across StaticResource, DynamicResource and string-based C# lookups.
        They also collided with the design system's naming convention. If a general palette is
        ever wanted again, add it under IRI.Maptor.Brushes.Palette.* rather than bare words.-->

    <!--Tehran municipality brand red. Kept because IRI.App.SanadNegar resolves
        mapTehranIrLightRedColor from this dictionary at runtime. Note IRI.Mun.RahyabTehran and
        IRI.App.GonbadNegar define their own private copies of these keys and do not reference
        this library at all, so they are unaffected by anything here.

        As of Step 5a the generic MapMarker views no longer use these: a municipal brand colour
        was the hardcoded default fill for markers shipped to every app.-->
    <Color x:Key="mapTehranIrDarkRedColor">#FF900000</Color>
    <Color x:Key="mapTehranIrLightRedColor">#FFC75050</Color>
    <Color x:Key="mapTehranIrNormalRedColor">#FFAD0000</Color>

    <SolidColorBrush x:Key="mapTehranIrDarkRedBrush" Color="{StaticResource mapTehranIrDarkRedColor}"/>
    <SolidColorBrush x:Key="mapTehranIrLightRedBrush" Color="{StaticResource mapTehranIrLightRedColor}"/>
    <SolidColorBrush x:Key="mapTehranIrNormalRedBrush" Color="{StaticResource mapTehranIrNormalRedColor}"/>

    <!--External brand colours. These are fixed by the brands themselves and must never be
        theme-swapped or tokenised into the semantic palette.-->
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Brand.LinkedIn">#0077B5</SolidColorBrush>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Brand.StackOverflow">#F48024</SolidColorBrush>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Brand.GitHub">#24292E</SolidColorBrush>
    <SolidColorBrush x:Key="IRI.Maptor.Brushes.Brand.MakanNegar">#B8D135</SolidColorBrush>

</ResourceDictionary>
