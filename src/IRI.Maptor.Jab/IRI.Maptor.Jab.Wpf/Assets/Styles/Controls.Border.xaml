<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="IRI.Maptor.Styles.Border.Card" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="CornerRadius" Value="5"/>
        <!--MinHeight, not Height: cards that hold more than one row (option groups,
            page setup) must be allowed to grow instead of clipping their content.-->
        <Setter Property="MinHeight" Value="39"/>
    </Style>

    <!--divider + spacing above a dialog's action buttons, see DialogFooterView-->
    <Style x:Key="IRI.Maptor.Styles.Border.DialogFooter" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray7}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="{StaticResource IRI.Maptor.Styles.Thickness.DialogFooter}"/>
        <Setter Property="Padding" Value="{StaticResource IRI.Maptor.Styles.Thickness.RowGap}"/>
    </Style>

</ResourceDictionary>