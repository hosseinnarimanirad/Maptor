<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Composition vocabulary: how a screen is laid out, as opposed to how one control looks.

        This layer used to exist only in the Saba app (Saba.Styles.Card/CardTitle/FieldRow/…),
        which is why views inside this library had nothing to build a form out of and hand-rolled
        their own rows. Promoted here so every consuming app gets the same screen grammar.

        A screen is: Border.Panel (outer shell)
                       > Border.PanelHeader + TextBlock.PanelTitle (title band)
                       > Border.Section     + TextBlock.CardTitle  (a titled group)
                           > Grid.FieldRow  + TextBlock.FieldLabel / .FieldValue (one row)

        Note Border.Section is NOT Border.Card. Border.Card is a field-row container
        (MinHeight 39, tight padding) used by the open/export dialogs. Border.Section is a
        content card that holds a whole titled group.-->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
        <ResourceDictionary Source="/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Controls.TextBlock.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--Surfaces-->

    <!--a titled group of rows inside a scrolling column-->
    <Style x:Key="IRI.Maptor.Styles.Border.Section" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Control}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!--1px rule between two groups of content. Several views fake this with a
        Border Height="1" and a hardcoded grey.-->
    <Style x:Key="IRI.Maptor.Styles.Border.Divider" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,6"/>
    </Style>

    <!--Full-width notice above a list or below a header. Same colour vocabulary as the
        pills, at banner scale. Pair with TextBlock.FieldValue or .Normal for the caption
        and set Background to the matching IRI.Maptor.Brushes.*.Fill.-->
    <Style x:Key="IRI.Maptor.Styles.Border.Banner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Muted.Fill}"/>
        <Setter Property="CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Border.Banner.Warning" TargetType="Border" BasedOn="{StaticResource IRI.Maptor.Styles.Border.Banner}">
        <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Warning.Fill}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Border.Banner.Invalid" TargetType="Border" BasedOn="{StaticResource IRI.Maptor.Styles.Border.Banner}">
        <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Invalid.Fill}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Border.Banner.Accent" TargetType="Border" BasedOn="{StaticResource IRI.Maptor.Styles.Border.Banner}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}"/>
    </Style>

    <!--Floating surface for a filter popup or a flyout. Distinct from Panel because it needs
        an accent edge and sits above other content rather than framing it.-->
    <Style x:Key="IRI.Maptor.Styles.Border.Popup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <!--Titles-->

    <!--caption of a panel's title band; sits on Border.PanelHeader-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.PanelTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--caption of a Border.Section or an Expander.Section header-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.CardTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!--Form rows-->

    <!--one label+editor row; pair the label column with Size.FieldLabelColumn-->
    <Style x:Key="IRI.Maptor.Styles.Grid.FieldRow" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource IRI.Maptor.Styles.Thickness.FieldRowGap}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBlock.FieldLabel"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.TextBlock.FieldValue"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!--description line under a field-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.FieldHint"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!--inline validation message. Three views invented FontStyle="Italic" Foreground="Gray"
        independently because there was no token for a note; this is the failure variant.-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.Error"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Invalid}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!--advisory note under a field, muted and italic-->
    <Style x:Key="IRI.Maptor.Styles.TextBlock.Note"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock.FieldHint}">
        <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Muted}"/>
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>

</ResourceDictionary>
