<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
        <ResourceDictionary Source="/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Controls.TextBlock.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--Status badge: a filled rounded label for a state or a warning inside a list row.
        Colours come from the semantic status palette (Status.Light/Dark.xaml) so they follow
        the theme — never hardcode a pastel here.

        The border and its caption are two styles because a Border cannot restyle its own
        child; pair them by suffix (Pill.Warning with Pill.Text.Warning).-->

    <Style x:Key="IRI.Maptor.Styles.Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Muted.Fill}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Pill.Text"
           TargetType="TextBlock"
           BasedOn="{StaticResource IRI.Maptor.Styles.TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Muted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Pill.Valid" TargetType="Border" BasedOn="{StaticResource IRI.Maptor.Styles.Pill}">
        <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Valid.Fill}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Pill.Text.Valid" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.Pill.Text}">
        <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Valid}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Pill.Invalid" TargetType="Border" BasedOn="{StaticResource IRI.Maptor.Styles.Pill}">
        <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Invalid.Fill}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Pill.Text.Invalid" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.Pill.Text}">
        <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Invalid}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Pill.Warning" TargetType="Border" BasedOn="{StaticResource IRI.Maptor.Styles.Pill}">
        <Setter Property="Background" Value="{DynamicResource IRI.Maptor.Brushes.Warning.Fill}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Pill.Text.Warning" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.Pill.Text}">
        <Setter Property="Foreground" Value="{DynamicResource IRI.Maptor.Brushes.Warning}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Pill.Accent" TargetType="Border" BasedOn="{StaticResource IRI.Maptor.Styles.Pill}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Pill.Text.Accent" TargetType="TextBlock" BasedOn="{StaticResource IRI.Maptor.Styles.Pill.Text}">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
    </Style>

</ResourceDictionary>
