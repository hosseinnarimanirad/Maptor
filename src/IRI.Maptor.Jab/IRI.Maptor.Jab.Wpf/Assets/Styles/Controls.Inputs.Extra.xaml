<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mahApp="http://metro.mahapps.com/winfx/xaml/controls">

    <!--Controls the design system never covered. The SLD editor is built almost entirely from
        Slider, ColorPicker and NumericUpDown; two of those three had no style anywhere in the
        repo, which is the mechanical reason that editor looks unfinished.

        Heights match IRI.Maptor.Styles.NumericUpDown.Normal (MinHeight 32, Margin 4) so that a
        Slider, a ColorPicker and a NumericUpDown sitting in the same form column line up.-->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/IRI.Maptor.Jab.Wpf;component/Assets/Styles/Common.Metrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--Implicit, on purpose: no x:Key, so it applies to every bare <Slider> in scope.

        MahApps publishes its slider look as a KEYED style, so a plain <Slider> renders as the
        stock Windows control unless something opts it in. Every app shell was doing that opt-in
        with its own copy of this exact line. Declaring it here once means any app that merges
        Controls.All.xaml at application level gets it for free.

        This is load-bearing, not decoration: 11 <Slider> elements across the repo carry no Style
        attribute and depend entirely on an implicit style being in scope. Deleting this without
        giving each of them an explicit style drops them all back to the stock Windows slider.

        Apps that merge Controls.All.xaml only inside individual views, rather than in App.xaml,
        are NOT covered by this and still need the line in their own shell: AlborzNegar,
        NiocExpSpatialEditor, Shahab, Bag.Geospatial.-->
    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource MahApps.Styles.Slider}"/>

    <!--Form-row variant: taller and spaced so a Slider, ColorPicker and NumericUpDown in the same
        column line up. Deliberately NOT the implicit style above, which must stay a pure
        pass-through to the MahApps look.-->
    <Style x:Key="IRI.Maptor.Styles.Slider.Normal" TargetType="Slider" BasedOn="{StaticResource MahApps.Styles.Slider}">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.Slider.Small" TargetType="Slider" BasedOn="{StaticResource IRI.Maptor.Styles.Slider.Normal}">
        <Setter Property="MinHeight" Value="26"/>
    </Style>

    <!--ColorPicker. No BasedOn: MahApps does not publish a stable keyed base for this control
        across the versions we build against, so we set metrics on top of the theme default.-->
    <Style x:Key="IRI.Maptor.Styles.ColorPicker.Normal" TargetType="mahApp:ColorPicker">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="4"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.ColorPicker.Small" TargetType="mahApp:ColorPicker" BasedOn="{StaticResource IRI.Maptor.Styles.ColorPicker.Normal}">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.DatePicker.Normal" TargetType="DatePicker">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="mahApp:ControlsHelper.CornerRadius" Value="4"/>
    </Style>

    <Style x:Key="IRI.Maptor.Styles.DatePicker.Small" TargetType="DatePicker" BasedOn="{StaticResource IRI.Maptor.Styles.DatePicker.Normal}">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!--the busy spinner that sits beside a queue view's refresh button-->
    <Style x:Key="IRI.Maptor.Styles.ProgressRing.Inline" TargetType="mahApp:ProgressRing">
        <Setter Property="Width" Value="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"/>
        <Setter Property="Height" Value="{StaticResource IRI.Maptor.Styles.Size.Icon.Small}"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
    </Style>

    <!--form caption rendered as a Label rather than a TextBlock. Prefer TextBlock.FieldLabel;
        this exists for the handful of places that already use Label and bind Content.-->
    <Style x:Key="IRI.Maptor.Styles.Label.Form" TargetType="Label">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
