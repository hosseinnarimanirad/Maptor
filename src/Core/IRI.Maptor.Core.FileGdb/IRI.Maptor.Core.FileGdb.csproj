    <PackageTags>GIS;spatial;ESRI;geodatabase;FileGdb;gdb;ArcGIS</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IRI.Maptor.Tests" />
