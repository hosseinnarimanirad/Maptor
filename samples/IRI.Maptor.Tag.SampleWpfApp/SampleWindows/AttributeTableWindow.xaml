<Window x:Class="IRI.Maptor.Tag.SampleWpfApp.SampleWindows.TableOfContentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Controls;assembly=IRI.Maptor.Jab.Wpf" 
        Loaded="Window_Loaded"
        Title="Sample Maptor App (Attribute Table)" Height="500" Width="800">
    <Window.Resources>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IRI.Maptor.Styles.Button.Primary.Large}">
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="200"/> 
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <maptor:MapViewer Margin="0" Grid.Column="2"  x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}"/>
        
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="LightGray" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>
        <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="5" HorizontalAlignment="Stretch" Background="LightGray" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>
        
        <GroupBox Header="Layer Legend" HorizontalAlignment="Stretch" BorderThickness="1" BorderBrush="LightGray" Margin="0,5" Padding="5" Grid.Column="0"
            Background="{DynamicResource MahApps.Brushes.Accent}" 
            Visibility="{Binding IsTocShown, Converter={StaticResource boolToVisibilityConverter}}" >
            <maptor:MapLegendView LegendViewModel="{Binding LegendViewModel}" />
        </GroupBox>

        <GroupBox Grid.Row="2" Grid.ColumnSpan="3" Header="Attribute table">
            <maptor:FeatureTabControl CanUserEditGeometry="False" IsZoomToGeometryEnabled="True"/>
        </GroupBox>
    </Grid>
</Window>
