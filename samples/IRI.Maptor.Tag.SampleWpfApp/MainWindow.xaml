<Window x:Class="IRI.Maptor.Tag.SampleWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Loaded="Window_Loaded" 
        xmlns:mahApp="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"  
        xmlns:iriJabControls="clr-namespace:IRI.Maptor.Jab.Controls.View;assembly=IRI.Maptor.Jab.Controls"
        Title="MainWindow" Height="600" Width="900" x:Name="root" FlowDirection="{Binding CurrentFlowDirection}">
    <Window.Resources>
       
    </Window.Resources>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <iriJabControls:LanguageCombo/>
        <!--<ComboBox ItemsSource="{Binding AvailableLanguages}"
              SelectedItem="{Binding SelectedLanguage}"
              HorizontalContentAlignment="Center" VerticalAlignment="Center">
            <ComboBox.DataContext>
                <localization:LanguageSelectorViewModel/>
            </ComboBox.DataContext>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <Image Source="{Binding FlagUri}" Stretch="Uniform" Width="34" Height="24" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding NativeName}" VerticalAlignment="Center" FlowDirection="{Binding TextFlowDirection}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>-->
        
        <StackPanel Grid.Column="1">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource flatButtonPrimary}">
                    <Setter Property="Margin" Value="4"/>
                </Style>
            </StackPanel.Resources>
            <Border BorderBrush="Black" BorderThickness="1" Margin="2">
                <StackPanel Orientation="Horizontal" >
                    <Button Content="{Binding Ltxt_cmd_general_clearAll}" Command="{Binding ClearAllCommand}"/>
                    <Button Content="{Binding Ltxt_cmd_general_fullExtent}" Command="{Binding FullExtentCommand}"/>
                    <Button Content="{Binding Ltxt_cmd_general_AddShapefile}" Command="{Binding AddShapefileCommand}"/>
                    <Button Content="{Binding Ltxt_cmd_general_measureLength}" Command="{Binding MeasureLengthCommand}"/>
                    <Button Content="{Binding Ltxt_cmd_general_measureArea}" Command="{Binding MeasureAreaCommand}"/>
                    <Button Content="{Binding Ltxt_cmd_general_drawPoint}" Command="{Binding DrawPointCommand}"/>
                    <Button Content="{Binding Ltxt_cmd_general_drawPolyline}" Command="{Binding DrawPolylineCommand}"/>
                    <Button Content="{Binding Ltxt_cmd_general_drawPolygon}" Command="{Binding DrawPolygonCommand}"/>
                    <Button Content="{Binding Ltxt_cmd_general_addTextToMap}" Command="{Binding AddTextToMapCommand}"/>
                    <Button Content="{Binding Ltxt_cmd_general_goTo}" Command="{Binding GoToCommand}"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1" Margin="2">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add Marker Sample" Command="{Binding ShowSpecialPointLayerSampleCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <iriJabControls:MapViewer Grid.Row="1" Grid.Column="1" x:Name="map" BorderBrush="Black" BorderThickness="1"/>

        <iriJabControls:MapInfoView Grid.Row="1" Grid.Column="1" DataContext="{Binding }"/>

        <iriJabControls:CoordinatePanelView 
            Grid.Column="1" 
            Grid.Row="1" 
            Margin="10"  
            HorizontalAlignment="Right" 
            VerticalAlignment="Bottom"
            DataContext="{Binding CoordinatePanel}" 
            Position="{Binding CurrentPoint, ElementName=map}"/>
        
        <StackPanel Grid.Row="1">
            <Expander Header="{Binding Ltxt_header_BaseMaps}" DockPanel.Dock="Top" IsExpanded="True"  Margin="0,1,0,0" Cursor="Hand">
                <ComboBox ItemsSource="{Binding MapProviders}" SelectedItem="{Binding SelectedMapProvider, Mode=TwoWay}" VerticalAlignment="Center" DisplayMemberPath="Title"/>
            </Expander>
            <Expander Header="{Binding Ltxt_header_DrawingLegend}" DockPanel.Dock="Top" IsExpanded="True"  Margin="0,1,0,0" Cursor="Hand">
                <iriJabControls:MapDrawingLegendView MinHeight="90"/>
            </Expander>
            <Expander Header="{Binding Ltxt_header_LayerLegend}" IsExpanded="True" Margin="0,1,0,0" Cursor="Hand">
                <iriJabControls:MapLegendWithOptionsView EnableFilterMode="True"  DataContext="{Binding Layers}" GroupName="B"/>
            </Expander>
        </StackPanel>
    </Grid>
</Window>
