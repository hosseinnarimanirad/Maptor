<Window x:Class="IRI.Maptor.Samples.Wpf.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:IRI.Maptor.Samples.Wpf.Gallery.Shell"
        Title="Maptor WPF gallery" Width="1360" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
        TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
    <!--Both of these are load-bearing, and neither is obvious.

        Several Maptor text styles (TextBlock.WindowTitle, .Title, .PanelTitle, .CardTitle, .Hint)
        set no Foreground of their own: they inherit TextElement.Foreground, which MahApps sets on
        MetroWindow. A plain Window does not, so the inherited value falls back to the WPF default
        of BLACK and those five render black on #252525 in the dark theme. Measured, in this
        gallery, before this line existed.

        The Background matters for the same reason in reverse: a window that paints nothing lets
        dark cards float on a white sheet, and then every contrast judgement made from it is wrong.-->
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnFind" />
    </Window.CommandBindings>

    <Window.Resources>
        <!-- One row of the navigation: icon and title, an accent bar and tint when selected -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="bar" Width="3" Height="18" CornerRadius="1.5" Margin="-10,0,0,0"
                                        HorizontalAlignment="Left" Background="{DynamicResource MahApps.Brushes.Accent}" Visibility="Hidden" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial x:Name="icon" Kind="{Binding Icon}" Width="16" Height="16"
                                                                VerticalAlignment="Center" Margin="2,0,12,0"
                                                                Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Body}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter TargetName="row" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Navigation ================= -->
        <Border Background="{DynamicResource MahApps.Brushes.Gray10}" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,16">
                    <!-- The Maptor mark (brand/social/maptor-mark.svg) -->
                    <Viewbox Width="30" Height="30" VerticalAlignment="Center">
                        <Canvas Width="40" Height="40">
                            <Path Data="M20,2.86 L30.3,8.24 L31.87,18.77 L20,37.14 L8.13,18.77 L9.7,8.24 Z" Fill="#2E5236" StrokeLineJoin="Round" />
                            <Ellipse Canvas.Left="15" Canvas.Top="9.51" Width="10" Height="10" Fill="#F4F1EA" />
                            <Ellipse Canvas.Left="16.9" Canvas.Top="11.41" Width="6.2" Height="6.2" Fill="#B15B34" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Maptor" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="WPF sample gallery" Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                   FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
                    </StackPanel>
                </StackPanel>

                <!-- Search -->
                <TextBox x:Name="searchBox" DockPanel.Dock="Top" Margin="16,0,16,12" Height="34"
                         VerticalContentAlignment="Center"
                         mah:TextBoxHelper.Watermark="Search samples   (Ctrl+F)"
                         mah:TextBoxHelper.ClearTextButton="True"
                         AutomationProperties.Name="Search samples"
                         TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />

                <!-- Theme -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="0,1,0,0"
                        Padding="20,10">
                    <DockPanel>
                        <iconPacks:PackIconMaterial Kind="ThemeLightDark" Width="16" Height="16" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                        <mah:ToggleSwitch x:Name="darkSwitch" DockPanel.Dock="Right" OnContent="" OffContent="" MinWidth="0"
                                          HorizontalAlignment="Right" Toggled="OnDarkToggled" AutomationProperties.Name="Dark theme" />
                        <TextBlock Text="Dark theme" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
                    </DockPanel>
                </Border>

                <Grid>
                    <ListBox x:Name="samplesList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource NavItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSampleSelected" AutomationProperties.Name="Samples">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name, Converter={x:Static shell:UpperCaseConverter.Instance}}"
                                                   FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Micro}" FontWeight="SemiBold"
                                                   Margin="20,14,8,6" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <StackPanel x:Name="noResults" VerticalAlignment="Top" Margin="20,24" Visibility="Collapsed">
                        <iconPacks:PackIconMaterial Kind="MagnifyClose" Width="22" Height="22" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        <TextBlock Text="No samples match your search." Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ================= Selected sample ================= -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Padding="28,18,24,16" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0"
                            Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                            Click="OnOpenSource" ToolTip="Open this sample's code and README on GitHub">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Github" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" />
                            <TextBlock Text="View source" VerticalAlignment="Center" />
                            <iconPacks:PackIconMaterial Kind="OpenInNew" Width="11" Height="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial x:Name="sampleIcon" Width="15" Height="15" VerticalAlignment="Center"
                                                        Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,8,0" />
                            <TextBlock x:Name="sampleCategory" VerticalAlignment="Center" FontWeight="SemiBold"
                                       FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"
                                       Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                        </StackPanel>
                        <TextBlock x:Name="sampleTitle" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock x:Name="sampleDescription" TextWrapping="Wrap" MaxWidth="920" HorizontalAlignment="Left"
                                   Margin="0,4,0,0" LineHeight="20" Foreground="{DynamicResource MahApps.Brushes.Gray1}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl x:Name="sampleHost" Focusable="False" />
        </DockPanel>
    </Grid>
</Window>
