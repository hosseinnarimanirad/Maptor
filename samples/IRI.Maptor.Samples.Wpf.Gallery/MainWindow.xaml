<Window x:Class="IRI.Maptor.Samples.Wpf.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maptor WPF gallery" Width="1280" Height="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Background="{DynamicResource MahApps.Brushes.Gray10}">
            <TextBlock DockPanel.Dock="Top" Text="Maptor samples" FontSize="20" FontWeight="SemiBold" Margin="12,12,12,4" />
            <TextBlock DockPanel.Dock="Top" Text="IRI.Maptor.Presentation.Wpf" Margin="12,0,12,8"
                       Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
            <ListBox x:Name="samplesList" DisplayMemberPath="Title" BorderThickness="0" Background="Transparent"
                     SelectionChanged="OnSampleSelected">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,12,8,4"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
        </DockPanel>

        <!-- Selected sample -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}">
                <StackPanel>
                    <TextBlock x:Name="sampleTitle" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="sampleDescription" TextWrapping="Wrap" Margin="0,2,0,4" />
                    <TextBlock>
                        <Hyperlink x:Name="sampleSource" RequestNavigate="OnNavigate">Source and README on GitHub</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
            <ContentControl x:Name="sampleHost" />
        </DockPanel>
    </Grid>
</Window>
