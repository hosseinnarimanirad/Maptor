<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>IRI.Maptor.Samples.Wpf.Gallery</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Presentation\IRI.Maptor.Presentation.Wpf\IRI.Maptor.Presentation.Wpf.csproj" />
    <!-- TLE/OMM reading and SGP4, for the satellite samples -->
    <ProjectReference Include="..\..\src\Core\IRI.Maptor.Core.Satellite\IRI.Maptor.Core.Satellite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml merges the MahApps styles that the Maptor controls are built on -->
    <PackageReference Include="MahApps.Metro" />
  </ItemGroup>

  <ItemGroup>
    <!-- READMEs live next to the samples they describe; keep them out of the build -->
    <None Remove="Samples\**\README.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public TLEs from CelesTrak, downloaded on the date in the name; they age, which the sample shows -->
    <EmbeddedResource Include="Samples\SatellitePosition\sample-2026-10-28.tle" LogicalName="SatellitePosition.sample.tle" />
  </ItemGroup>

</Project>
