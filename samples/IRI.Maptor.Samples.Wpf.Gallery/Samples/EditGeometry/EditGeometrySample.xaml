<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.EditGeometry.EditGeometrySample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
             Loaded="OnLoaded">

    <!-- The Maptor screen grammar: light cards on the grey canvas, 6 px apart; each card a 32 px accent-tint header
         (icon, title, count) over its content. The toolbar is a card of compact icon-and-label tools in groups. -->
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================== tools ============================== -->
            <Border Grid.ColumnSpan="3" Margin="0,0,0,6" Style="{StaticResource SampleToolCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Draw" Style="{StaticResource SampleToolGroupLabel}" />
                    <Button Command="{Binding DrawPolylineCommand}" Tag="{Binding IsDrawPolylineMode}" Style="{StaticResource SampleToolButton}"
                            ToolTip="Draw a line: click to place points; Enter, a double click or a click on the last point finishes">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="VectorPolyline" Style="{StaticResource SampleToolIcon}" />
                            <TextBlock Text="Line" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DrawPolygonCommand}" Tag="{Binding IsDrawPolygonMode}" Style="{StaticResource SampleToolButton}"
                            ToolTip="Draw a polygon: click to place its corners; Enter, a double click or a click on a placed corner finishes">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="VectorPolygon" Style="{StaticResource SampleToolIcon}" />
                            <TextBlock Text="Polygon" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DrawRectangleCommand}" Tag="{Binding IsDrawRectangleMode}" Style="{StaticResource SampleToolButton}"
                            ToolTip="Draw a rectangle: press, drag, release">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="VectorRectangle" Style="{StaticResource SampleToolIcon}" />
                            <TextBlock Text="Rectangle" />
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource SampleToolSeparator}" />

                    <TextBlock Text="Measure" Style="{StaticResource SampleToolGroupLabel}" />
                    <Button Command="{Binding MeasureLengthCommand}" Style="{StaticResource SampleToolButton}" ToolTip="Measure a length; edge lengths are shown on the map">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Ruler" Style="{StaticResource SampleToolIcon}" />
                            <TextBlock Text="Length" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding MeasureAreaCommand}" Style="{StaticResource SampleToolButton}" ToolTip="Measure an area">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="RulerSquare" Style="{StaticResource SampleToolIcon}" />
                            <TextBlock Text="Area" />
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource SampleToolSeparator}" />

                    <Button Command="{Binding PanCommand}" Style="{StaticResource SampleToolButton}" ToolTip="Leave the drawing tool and move the map">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="HandBackRight" Style="{StaticResource SampleToolIcon}" />
                            <TextBlock Text="Pan" />
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource SampleToolSeparator}" />

                    <TextBlock Text="Sample" Style="{StaticResource SampleToolGroupLabel}" />
                    <Button Click="OnAddLongLine" Style="{StaticResource SampleToolButton}"
                            ToolTip="Adds a drawing of 2,500 vertices: edit it to see a big geometry. With all of it in view its handles are hidden (more than 2,000); zoom in to edit it">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="VectorPolylinePlus" Style="{StaticResource SampleToolIcon}" />
                            <TextBlock Text="Long line" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveAllDrawingItemsCommand}" Style="{StaticResource SampleToolButton}" ToolTip="Remove all drawings">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Style="{StaticResource SampleToolIcon}" />
                            <TextBlock Text="Clear drawings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============================== the legend column ============================== -->
            <DockPanel Grid.Row="1">

                <!-- how to use the page: open at first, folds away -->
                <Expander DockPanel.Dock="Top" IsExpanded="True" Margin="{StaticResource IRI.Maptor.Styles.Thickness.StackGap}"
                          Style="{StaticResource IRI.Maptor.Styles.Expander.Card}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="InformationOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CardHeader}" />
                            <TextBlock Text="How to use" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderTitle}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="10,8,10,10">
                        <TextBlock Style="{StaticResource SampleHowTo}">
                            <Run FontWeight="SemiBold" Text="Draw" /><Run Text=" with a tool above. Points snap to the parcels and the road. Enter or a double click finishes, Backspace takes the last point back, Ctrl+Z undoes." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SampleHowTo}">
                            <Run FontWeight="SemiBold" Text="Edit a parcel or the road:" /><Run Text=" in Layers, open the layer's table (the table button on its row), select a row and press Edit. Save in the table keeps the change." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SampleHowTo}">
                            <Run FontWeight="SemiBold" Text="Edit a drawing:" /><Run Text=" Edit in its menu in Drawings." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SampleHowTo}" Margin="0">
                            <Run FontWeight="SemiBold" Text="While editing:" /><Run Text=" drag a vertex; point at a line and click to add one; Delete removes the selected one; Enter finishes. Type L, A or B while placing a point for a length, a turn or a bearing." />
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <!-- the drawings: each one can be edited, restyled or removed from its menu -->
                <Expander DockPanel.Dock="Top" IsExpanded="{Binding IsDrawingLegendExpanded}" Margin="{StaticResource IRI.Maptor.Styles.Thickness.StackGap}"
                          Style="{StaticResource IRI.Maptor.Styles.Expander.Card}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="MapPinPlusFill" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.CardHeader}" />
                            <TextBlock Text="Drawings" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderTitle}" />
                            <TextBlock Text="{Binding DrawingItems.Count, StringFormat='({0})'}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" />
                        </StackPanel>
                    </Expander.Header>
                    <DockPanel>
                        <maptor:VerticalResizeGrip DockPanel.Dock="Bottom" Target="{Binding ElementName=drawingLegendView}"
                                                   MinTargetHeight="60" MaxTargetHeight="800" />
                        <maptor:MapDrawingLegendView x:Name="drawingLegendView" MaxHeight="260" />
                    </DockPanel>
                </Expander>

                <!-- the layers, which are snapped to: fills the rest of the column -->
                <Expander IsExpanded="True" Style="{StaticResource IRI.Maptor.Styles.Expander.Card}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="StackFill" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.CardHeader}" />
                            <TextBlock Text="Layers" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderTitle}" />
                            <TextBlock Text="{Binding LegendViewModel.TotalLayerCount, StringFormat='({0})'}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" />
                        </StackPanel>
                    </Expander.Header>
                    <maptor:MapLegendView Margin="0" LegendViewModel="{Binding LegendViewModel}" />
                </Expander>
            </DockPanel>

            <!-- ============================== the map and the feature table ============================== -->
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource SampleMapFrame}">
                    <Grid>
                        <maptor:MapViewer x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}" />
                        <!-- finish / cancel, snapping, guides and the measures while drawing or editing -->
                        <maptor:SketchBarView DataContext="{Binding}" />
                        <maptor:Scalebar HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                         CurrentScale="{Binding MapScale_CurrentPoint}"
                                         ZoomLevel="{Binding NearestGoogleZoomLevel}"
                                         ShowScaleValue="True" ShowZoomLevel="True" />
                    </Grid>
                </Border>

                <!-- a layer's features, opened from its row in Layers; Edit on a selected row edits its geometry -->
                <Expander Grid.Row="1" Margin="0,6,0,0" ExpandDirection="Up" IsExpanded="{Binding ShowAttributeTable, Mode=TwoWay}"
                          Style="{StaticResource IRI.Maptor.Styles.Expander.Card}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Table" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CardHeader}" />
                            <TextBlock Text="Features" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderTitle}" />
                            <TextBlock Text="  open a layer's table from Layers; select a row and press Edit to edit its geometry"
                                       Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" />
                        </StackPanel>
                    </Expander.Header>
                    <maptor:FeatureTabControl Height="220"
                                              CanUserEditGeometry="True"
                                              CanUserEditAttribute="True"
                                              IsZoomToGeometryEnabled="True" />
                </Expander>
            </Grid>
        </Grid>
    </Border>
</UserControl>
