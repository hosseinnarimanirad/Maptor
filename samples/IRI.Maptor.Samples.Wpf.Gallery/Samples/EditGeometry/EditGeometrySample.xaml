<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.EditGeometry.EditGeometrySample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
             Loaded="OnLoaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource SampleToolbarHost}">
            <StackPanel Style="{StaticResource SampleToolbar}">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource SampleToolbarButton}" />
                </StackPanel.Resources>
                <Button Content="Draw polyline" Command="{Binding DrawPolylineCommand}" />
                <Button Content="Draw polygon" Command="{Binding DrawPolygonCommand}" />
                <Button Content="Draw rectangle" Command="{Binding DrawRectangleCommand}" />
                <Button Content="Measure length" Command="{Binding MeasureLengthCommand}" />
                <Button Content="Measure area" Command="{Binding MeasureAreaCommand}" />
                <Button Content="Pan" Command="{Binding PanCommand}" />
                <Button Content="Add a long line" Click="OnAddLongLine"
                        ToolTip="A drawing of 2,000 vertices along the road: edit it to feel how dragging behaves on a big geometry" />
                <Button Content="Remove drawings" Command="{Binding RemoveAllDrawingItemsCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Left" Style="{StaticResource SampleSidePanel}" Width="340">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SampleHint}" TextWrapping="Wrap"
                           Text="Draw on the parcels and the road: points snap to them. Edit a drawing from its menu in the drawings list below: drag a vertex, click a mid-vertex to add one, drag the length labels. The sketch bar has snapping, the guides and the cursor box (type L, A or B while placing a point)." />

                <!-- the layers: what is snapped to -->
                <maptor:MapLegendView Grid.Row="1" Margin="0,8,0,0" LegendViewModel="{Binding LegendViewModel}" />

                <!-- the drawings: each one can be edited, restyled or removed -->
                <maptor:MapDrawingLegendView Grid.Row="2" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <Grid>
            <maptor:MapViewer x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}" />
            <!-- finish / cancel, snapping, guides and the measures while drawing or editing -->
            <maptor:SketchBarView DataContext="{Binding}" />
            <maptor:Scalebar HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                             CurrentScale="{Binding MapScale_CurrentPoint}"
                             ZoomLevel="{Binding NearestGoogleZoomLevel}"
                             ShowScaleValue="True" ShowZoomLevel="True" />
        </Grid>
    </DockPanel>
</UserControl>
