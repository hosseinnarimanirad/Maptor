<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.Localization.LocalizationSample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
             xmlns:localization="clr-namespace:IRI.Maptor.Presentation.Core.Localization;assembly=IRI.Maptor.Presentation.Core"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <!-- LocalizationManager is a singleton; its indexer returns the string for the current culture
             and raises a change notification when the language changes, so bindings refresh themselves. -->
        <ObjectDataProvider x:Key="Localization" ObjectInstance="{x:Static localization:LocalizationManager.Instance}" />
    </UserControl.Resources>

    <!-- Bind FlowDirection once at the root; right-to-left cultures flip the whole layout. -->
    <DockPanel FlowDirection="{Binding CurrentFlowDirection, Source={StaticResource Localization}}">
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource SampleToolbar}">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource SampleToolbarButton}" />
            </StackPanel.Resources>
            <!-- Language picker with flags and native names; switching applies to the whole process -->
            <maptor:LanguageCombo x:Name="languageCombo" MinWidth="180" Margin="2,2,12,2" VerticalAlignment="Center" />

            <!-- Resource keys come from IRI.Maptor.Presentation.Core/Properties/Resources.resx -->
            <Button Content="{Binding [cmd_general_fullExtent], Source={StaticResource Localization}}" Command="{Binding FullExtentCommand}" />
            <Button Content="{Binding [cmd_general_goTo], Source={StaticResource Localization}}" Command="{Binding GoToCommand}" />
            <Button Content="{Binding [cmd_general_measureLength], Source={StaticResource Localization}}" Command="{Binding MeasureLengthCommand}" />
            <Button Content="{Binding [cmd_general_measureArea], Source={StaticResource Localization}}" Command="{Binding MeasureAreaCommand}" />
            <Button Content="{Binding [cmd_general_drawPolygon], Source={StaticResource Localization}}" Command="{Binding DrawPolygonCommand}" />
        </StackPanel>

        <Border DockPanel.Dock="Left" Style="{StaticResource SampleSidePanel}" Width="360">
            <StackPanel>
                <Expander Header="{Binding [ui_header_baseMaps], Source={StaticResource Localization}}" IsExpanded="True">
                    <ComboBox ItemsSource="{Binding MapProviders}" SelectedItem="{Binding SelectedMapProvider, Mode=TwoWay}" DisplayMemberPath="Title" Margin="4" />
                </Expander>
                <Expander Header="{Binding [ui_header_drawingLegend], Source={StaticResource Localization}}" IsExpanded="True">
                    <maptor:MapDrawingLegendView MinHeight="90" />
                </Expander>
                <Expander Header="{Binding [ui_header_layerLegend], Source={StaticResource Localization}}" IsExpanded="True">
                    <maptor:MapLegendView LegendViewModel="{Binding LegendViewModel}" />
                </Expander>
            </StackPanel>
        </Border>

        <Grid>
            <maptor:MapViewer x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}" />
            <maptor:SketchBarView DataContext="{Binding}" />
            <maptor:Scalebar HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                             CurrentScale="{Binding MapScale_CurrentPoint}"
                             ZoomLevel="{Binding NearestGoogleZoomLevel}"
                             ShowScaleValue="True" ShowZoomLevel="True" />
            <maptor:CoordinatePanelView HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                        DataContext="{Binding CoordinatePanel}"
                                        Position="{Binding CurrentPoint, ElementName=map}" />
        </Grid>
    </DockPanel>
</UserControl>
