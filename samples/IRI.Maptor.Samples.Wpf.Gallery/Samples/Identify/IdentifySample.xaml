<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.Identify.IdentifySample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
             Loaded="OnLoaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource SampleToolbarHost}">
            <StackPanel Style="{StaticResource SampleToolbar}">
                <!-- IdentifyModeCommand toggles MapAction between Identify and Pan -->
                <ToggleButton Content="Identify" MinWidth="110" Margin="2"
                              Command="{Binding IdentifyModeCommand}"
                              IsChecked="{Binding IsIdentifyMode, Mode=OneWay}" />
                <Button Content="Pan" Command="{Binding PanCommand}" Style="{StaticResource SampleToolbarButton}" />
                <TextBlock Style="{StaticResource SampleHint}" VerticalAlignment="Center"
                           Text="Turn Identify on and click a coloured area. Every hit layer and feature appears in the Identify results window, with its attributes." />
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Left" Width="260" Margin="0,0,6,0">
            <Expander IsExpanded="True" Style="{StaticResource IRI.Maptor.Styles.Expander.Card}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="StackFill" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.CardHeader}" />
                        <TextBlock Text="Layers" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderTitle}" />
                        <TextBlock Text="{Binding LegendViewModel.TotalLayerCount, StringFormat='({0})'}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" />
                    </StackPanel>
                </Expander.Header>
                <maptor:MapLegendView LegendViewModel="{Binding LegendViewModel}" />
            </Expander>
        </DockPanel>

        <maptor:MapViewer x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}" />
    </DockPanel>
</UserControl>
