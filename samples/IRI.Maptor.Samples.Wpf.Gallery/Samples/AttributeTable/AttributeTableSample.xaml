<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.AttributeTable.AttributeTableSample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
             Loaded="OnLoaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource SampleToolbarHost}">
            <StackPanel Style="{StaticResource SampleToolbar}">
                <Button Content="Add shapefile…" Command="{Binding AddShapefileCommand}" Style="{StaticResource SampleToolbarButton}" />
                <TextBlock Style="{StaticResource SampleHint}" VerticalAlignment="Center"
                           Text="Right-click a layer in the legend and choose its attribute table; a tab opens below. Select a row to highlight the feature; double-click to zoom to it." />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,6,0">
                <Expander IsExpanded="True" Style="{StaticResource IRI.Maptor.Styles.Expander.Card}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="StackFill" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.CardHeader}" />
                        <TextBlock Text="Layers" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderTitle}" />
                        <TextBlock Text="{Binding LegendViewModel.TotalLayerCount, StringFormat='({0})'}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" />
                    </StackPanel>
                </Expander.Header>
                <maptor:MapLegendView LegendViewModel="{Binding LegendViewModel}" />
            </Expander>
            </DockPanel>

            <maptor:MapViewer x:Name="map" Grid.Column="1" MapAction="{Binding MapAction, Mode=OneWay}" />

            <!-- the gap between the map and the table; drag it to give either more room -->
            <GridSplitter Grid.Row="1" Grid.ColumnSpan="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- One tab per entry in the view model's SelectedLayers collection -->
            <Expander IsExpanded="True" Style="{StaticResource IRI.Maptor.Styles.Expander.Card}" Grid.Row="2" Grid.ColumnSpan="2">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Table" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.CardHeader}" />
                        <TextBlock Text="Features" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderTitle}" />
                    </StackPanel>
                </Expander.Header>
                <maptor:FeatureTabControl CanUserEditGeometry="False"
                                          CanUserEditAttribute="True"
                                          IsZoomToGeometryEnabled="True" />
            </Expander>
        </Grid>
    </DockPanel>
</UserControl>
