<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.GoTo.GoToSample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
             Loaded="OnLoaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource SampleToolbar}">
            <!-- GoToCommand opens GoToMetroWindow (the default action wired by MapInitializationHelper) -->
            <Button Content="Go to… (dialog)" Command="{Binding GoToCommand}" Style="{StaticResource SampleToolbarButton}" />
            <Button Content="Full extent" Command="{Binding FullExtentCommand}" Style="{StaticResource SampleToolbarButton}" />
        </StackPanel>

        <!-- The same view the dialog hosts, embedded in the page. Its view model is created in code-behind. -->
        <Border DockPanel.Dock="Right" Style="{StaticResource SampleSidePanel}" Width="540" BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SampleHint}"
                           Text="GoToView hosted inline. Type a position in any supported system (geographic, UTM, ...) and pan or zoom the map to it." />
                <maptor:GoToView x:Name="inlineGoTo" VerticalAlignment="Top" />
            </DockPanel>
        </Border>

        <Grid>
            <maptor:MapViewer x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}" />
            <maptor:CoordinatePanelView HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                        DataContext="{Binding CoordinatePanel}"
                                        Position="{Binding CurrentPoint, ElementName=map}" />
        </Grid>
    </DockPanel>
</UserControl>
