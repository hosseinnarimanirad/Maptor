<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.DrawingLegend.DrawingLegendSample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
             Loaded="OnLoaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource SampleToolbarHost}">
            <StackPanel Style="{StaticResource SampleToolbar}">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource SampleToolbarButton}" />
                </StackPanel.Resources>
                <Button Content="Draw point" Command="{Binding DrawPointCommand}" />
                <Button Content="Draw polyline" Command="{Binding DrawPolylineCommand}" />
                <Button Content="Draw polygon" Command="{Binding DrawPolygonCommand}" />
                <Button Content="Draw rectangle" Command="{Binding DrawRectangleCommand}" />
                <Button Content="Add text" Command="{Binding AddTextToMapCommand}" />
                <Button Content="Remove all" Command="{Binding RemoveAllDrawingItemsCommand}" />
            </StackPanel>
        </Border>

        <!-- the drawings in a card of the Maptor screen grammar: header with icon, title and count -->
        <DockPanel DockPanel.Dock="Left" Width="360" Margin="0,0,6,0">
            <Expander IsExpanded="True" Style="{StaticResource IRI.Maptor.Styles.Expander.Card}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="MapPinPlusFill" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.CardHeader}" />
                        <TextBlock Text="Drawings" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderTitle}" />
                        <TextBlock Text="{Binding DrawingItems.Count, StringFormat='({0})'}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" />
                    </StackPanel>
                </Expander.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SampleHint}"
                               Text="Each finished sketch becomes a drawing item: toggle, restyle, reorder, export or remove it here." />
                    <maptor:MapDrawingLegendView />
                </DockPanel>
            </Expander>
        </DockPanel>

        <Grid>
            <maptor:MapViewer x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}" />
            <!-- Finish / finish part / cancel while a sketch is in progress -->
            <maptor:SketchBarView DataContext="{Binding}" />
        </Grid>
    </DockPanel>
</UserControl>
