<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.MapLegend.MapLegendSample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
             Loaded="OnLoaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource SampleToolbarHost}">
            <StackPanel Style="{StaticResource SampleToolbar}">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource SampleToolbarButton}" />
                </StackPanel.Resources>
                <Button Content="Add shapefile…" Command="{Binding AddShapefileCommand}" />
                <Button Content="Add GeoJSON…" Command="{Binding AddGeoJSONfileCommand}" />
                <Button Content="Add sample layer" Click="OnAddSampleLayer" />
                <Button Content="Clear all" Command="{Binding ClearAllCommand}" />
            </StackPanel>
        </Border>

        <!-- the layers in a card of the Maptor screen grammar: header with icon, title and count -->
        <DockPanel DockPanel.Dock="Left" Width="300" Margin="0,0,6,0">
            <Expander IsExpanded="True" Style="{StaticResource IRI.Maptor.Styles.Expander.Card}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="StackFill" Style="{StaticResource IRI.Maptor.Styles.PackIconPhosphorIcons.CardHeader}" />
                        <TextBlock Text="Layers" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderTitle}" />
                        <TextBlock Text="{Binding LegendViewModel.TotalLayerCount, StringFormat='({0})'}" Style="{StaticResource IRI.Maptor.Styles.TextBlock.CardHeaderCount}" />
                    </StackPanel>
                </Expander.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SampleHint}"
                               Text="Right-click a layer for its commands (zoom to, attribute table, symbology, settings, remove). Drag to reorder." />
                    <!-- The table of contents. LegendViewModel is owned by the map view model. -->
                    <maptor:MapLegendView LegendViewModel="{Binding LegendViewModel}" />
                </DockPanel>
            </Expander>
        </DockPanel>

        <maptor:MapViewer x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}" />
    </DockPanel>
</UserControl>
