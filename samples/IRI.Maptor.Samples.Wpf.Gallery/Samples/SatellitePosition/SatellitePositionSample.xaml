<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.SatellitePosition.SatellitePositionSample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
             xmlns:shell="clr-namespace:IRI.Maptor.Samples.Wpf.Gallery.Shell"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Micro}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="ShowOption" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
        </Style>

        <!-- Segmented switch: Satellites | Passes, Visible | Imaged -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="segment" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Margin="2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="segment" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="segment" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="segment" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Read-out rows: label left, value right, on the on-map palette -->
        <Style x:Key="ReadoutLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,2,16,2" />
        </Style>
        <Style x:Key="ReadoutValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Body}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <!-- One satellite in the list; a deep-space one is shown but cannot be chosen yet -->
        <Style x:Key="SatelliteRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="IsEnabled" Value="{Binding IsSupported}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="row" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ============ Satellites / Passes over a region ============ -->
        <!-- Docked beside the map like the other samples' panels: the map stays clear, and the list takes the height that is left -->
        <Border DockPanel.Dock="Left" Style="{StaticResource SampleSidePanel}" Width="330">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="countText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                    <iconPacks:PackIconMaterial Kind="SatelliteVariant" Width="16" Height="16" VerticalAlignment="Center"
                                                Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,8,0" />
                    <TextBlock Text="Satellites" FontWeight="SemiBold" VerticalAlignment="Center"
                               FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Body}" />
                </DockPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource SegmentHost}" Margin="0,10,0,0">
                    <UniformGrid Rows="1">
                        <RadioButton x:Name="satellitesTab" Content="Satellites" GroupName="view" IsChecked="True" Style="{StaticResource Segment}"
                                     Checked="OnViewChanged" />
                        <RadioButton x:Name="passesTab" Content="Passes over a region" GroupName="view" Style="{StaticResource Segment}"
                                     Checked="OnViewChanged" />
                    </UniformGrid>
                </Border>

                <!-- The two views share the space below the switch; one is shown at a time -->
                <Grid>
                    <DockPanel x:Name="satellitesPanel">
                        <StackPanel DockPanel.Dock="Top">
                            <WrapPanel Margin="0,10,0,0">
                                <Button Margin="0,0,6,6" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}" Click="OnOpenFile"
                                        ToolTip="Open a TLE file (2- or 3-line sets) or CelesTrak OMM JSON">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" />
                                        <TextBlock Text="Open file…" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,6,6" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}" Click="OnShowPaste"
                                        ToolTip="Paste TLEs copied from CelesTrak or Space-Track">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ContentPaste" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" />
                                        <TextBlock Text="Paste…" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <!-- Only when asked, and at most once every 2 hours per satellite, as CelesTrak asks -->
                                <Button x:Name="celestrakButton" Margin="0,0,6,6" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                                        Click="OnUpdateFromCelesTrak"
                                        ToolTip="Download current elements for the listed satellites from celestrak.org. A copy is kept for offline use; CelesTrak asks for at most one download of the same data every 2 hours.">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="CloudDownloadOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" />
                                        <TextBlock Text="Update from CelesTrak" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <!-- A whole group from CelesTrak, kept for offline use like the updates -->
                                <Button x:Name="groupButton" Margin="0,0,6,6" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                                        Click="OnShowGroups"
                                        ToolTip="Replace the list with a whole group of satellites from celestrak.org (or the local copy)">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="SatelliteUplink" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" />
                                        <TextBlock Text="Load a group" VerticalAlignment="Center" />
                                        <iconPacks:PackIconMaterial Kind="ChevronDown" Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="groupMenu">
                                            <MenuItem Header="GPS (operational)" Tag="gps" Click="OnLoadGroup" />
                                            <MenuItem Header="Galileo" Tag="galileo" Click="OnLoadGroup" />
                                            <MenuItem Header="Geostationary weather" Tag="geo-weather" Click="OnLoadGroup" />
                                            <MenuItem Header="Earth resources" Tag="resource" Click="OnLoadGroup" />
                                            <MenuItem Header="Space stations" Tag="stations" Click="OnLoadGroup" />
                                            <Separator />
                                            <MenuItem Header="The sample satellites" Tag="sample" Click="OnLoadGroup" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </WrapPanel>
                            <TextBlock x:Name="sourceText" TextWrapping="Wrap" Style="{StaticResource Caption}" />

                            <!-- Paste area -->
                            <StackPanel x:Name="pastePanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBox x:Name="pasteBox" Height="120" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"
                                         AutomationProperties.Name="TLE text" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <Button Content="Cancel" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}" Click="OnCancelPaste" />
                                    <Button Content="Load" Margin="6,0,0,0" Style="{StaticResource IRI.Maptor.Styles.Button.Primary.Small}" Click="OnLoadPaste" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Sets that could not be read -->
                            <Border x:Name="errorBanner" Style="{StaticResource IRI.Maptor.Styles.Border.Banner.Warning}" Margin="0,10,0,0" Visibility="Collapsed">
                                <DockPanel>
                                    <iconPacks:PackIconMaterial Kind="AlertOutline" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" />
                                    <TextBlock x:Name="errorText" TextWrapping="Wrap" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- The options sit under the list, whatever its height -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                       Text="Or click a satellite on the map. Esc clears the choice." />

                            <!-- What to draw for the chosen satellite -->
                            <TextBlock Text="SHOW FOR THE CHOSEN SATELLITE" Style="{StaticResource SectionLabel}" />
                            <DockPanel>
                                <ComboBox x:Name="orbitsCombo" DockPanel.Dock="Right" Width="120" SelectedIndex="1"
                                          Style="{StaticResource IRI.Maptor.Styles.ComboBox.Small.Latin}"
                                          SelectionChanged="OnOverlayOptionChanged" AutomationProperties.Name="Orbits ahead"
                                          ToolTip="How far ahead the track runs; one orbit behind is always shown">
                                    <ComboBoxItem Content="1 orbit ahead" Tag="1" />
                                    <ComboBoxItem Content="2 orbits ahead" Tag="2" />
                                    <ComboBoxItem Content="3 orbits ahead" Tag="3" />
                                </ComboBox>
                                <CheckBox x:Name="trackCheck" Content="Ground track" IsChecked="True" Style="{StaticResource ShowOption}"
                                          Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged"
                                          ToolTip="Where the point beneath the satellite has been (faint) and is going (bright)" />
                            </DockPanel>
                            <CheckBox x:Name="footprintCheck" Content="Area that sees it above 10°" IsChecked="True" Style="{StaticResource ShowOption}"
                                      Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged"
                                      ToolTip="Everywhere the satellite is at least 10° above the horizon right now" />
                            <CheckBox x:Name="swathCheck" Content="Imaging swath" IsChecked="True" Style="{StaticResource ShowOption}"
                                      Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged"
                                      ToolTipService.ShowOnDisabled="True" />

                            <Border Height="1" Margin="0,8" Background="{DynamicResource MahApps.Brushes.Gray8}" />

                            <DockPanel Margin="0,0,0,6">
                                <ComboBox x:Name="labelsCombo" DockPanel.Dock="Right" Width="120" SelectedIndex="0"
                                          Style="{StaticResource IRI.Maptor.Styles.ComboBox.Small.Latin}"
                                          SelectionChanged="OnOverlayOptionChanged" AutomationProperties.Name="Names on the map"
                                          ToolTip="Auto names every satellite up to 50, and only the chosen one above that">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="All" Tag="All" />
                                    <ComboBoxItem Content="Chosen only" Tag="SelectedOnly" />
                                </ComboBox>
                                <iconPacks:PackIconMaterial Kind="LabelOutline" Width="14" Height="14" VerticalAlignment="Center"
                                                            Foreground="{DynamicResource MahApps.Brushes.Gray2}" Margin="0,0,8,0" />
                                <TextBlock Text="Names on the map" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                            </DockPanel>

                            <DockPanel>
                                <ComboBox x:Name="intervalCombo" DockPanel.Dock="Right" Width="90" SelectedIndex="0"
                                          Style="{StaticResource IRI.Maptor.Styles.ComboBox.Small.Latin}"
                                          SelectionChanged="OnIntervalChanged" AutomationProperties.Name="Update interval">
                                    <ComboBoxItem Content="1 s" Tag="1" />
                                    <ComboBoxItem Content="5 s" Tag="5" />
                                    <ComboBoxItem Content="10 s" Tag="10" />
                                    <ComboBoxItem Content="30 s" Tag="30" />
                                </ComboBox>
                                <iconPacks:PackIconMaterial Kind="TimerOutline" Width="14" Height="14" VerticalAlignment="Center"
                                                            Foreground="{DynamicResource MahApps.Brushes.Gray2}" Margin="0,0,8,0" />
                                <TextBlock Text="Live positions update every" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                            </DockPanel>
                        </StackPanel>

                        <!-- Fills what is left between the buttons and the options; scrolls on its own when a group is long -->
                        <ListBox x:Name="satelliteList" Margin="-8,8,-8,0" MinHeight="120" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource SatelliteRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnSatelliteSelected" AutomationProperties.Name="Satellites">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top"
                                                 Fill="{Binding AgeBrush}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Body}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"
                                                       Foreground="{DynamicResource MahApps.Brushes.Gray2}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- ============ Passes over a region ============ -->
                    <DockPanel x:Name="passesPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="REGION" Style="{StaticResource SectionLabel}" />
                            <WrapPanel>
                                <Button Margin="0,0,6,6" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}" Click="OnPickPoint"
                                        ToolTip="Click one place on the map">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="MapMarkerOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" />
                                        <TextBlock Text="Point" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,6,6" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}" Click="OnPickRectangle"
                                        ToolTip="Drag a rectangle on the map">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="VectorRectangle" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" />
                                        <TextBlock Text="Rectangle" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,6,6" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}" Click="OnPickPolygon"
                                        ToolTip="Click the corners of an area on the map; double-click to finish">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="VectorPolygon" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" />
                                        <TextBlock Text="Polygon" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="clearRegionButton" Margin="0,0,6,6" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                                        Click="OnClearRegion" IsEnabled="False" ToolTip="Remove the region and its passes" AutomationProperties.Name="Clear region">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="10" Height="10" />
                                </Button>
                            </WrapPanel>
                            <TextBlock x:Name="regionText" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                       Text="No region yet: pick a point, or draw an area on the map." />

                            <TextBlock Text="FIND" Style="{StaticResource SectionLabel}" />
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="visibleRadio" GroupName="passKind" IsChecked="True" Style="{StaticResource Segment}"
                                                 Checked="OnPassKindChanged"
                                                 ToolTip="When the satellite is above the minimum elevation from somewhere in the region">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="EyeOutline" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Visible" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="imagedRadio" GroupName="passKind" Style="{StaticResource Segment}"
                                                 Checked="OnPassKindChanged"
                                                 ToolTip="When the imager's swath reaches the region (satellites with a known sensor)">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="CameraOutline" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Imaged" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </Border>

                            <DockPanel Margin="0,8,0,0">
                                <ComboBox x:Name="windowCombo" DockPanel.Dock="Right" Width="110" SelectedIndex="2"
                                          Style="{StaticResource IRI.Maptor.Styles.ComboBox.Small.Latin}" AutomationProperties.Name="Search window">
                                    <ComboBoxItem Content="24 hours" Tag="24" />
                                    <ComboBoxItem Content="3 days" Tag="72" />
                                    <ComboBoxItem Content="7 days" Tag="168" />
                                    <ComboBoxItem Content="14 days" Tag="336" />
                                </ComboBox>
                                <TextBlock Text="From the time bar, for" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                            </DockPanel>
                            <DockPanel x:Name="elevationRow" Margin="0,6,0,0">
                                <ComboBox x:Name="elevationCombo" DockPanel.Dock="Right" Width="110" SelectedIndex="1"
                                          Style="{StaticResource IRI.Maptor.Styles.ComboBox.Small.Latin}" AutomationProperties.Name="Minimum elevation">
                                    <ComboBoxItem Content="0° (horizon)" Tag="0" />
                                    <ComboBoxItem Content="10°" Tag="10" />
                                    <ComboBoxItem Content="20°" Tag="20" />
                                    <ComboBoxItem Content="30°" Tag="30" />
                                </ComboBox>
                                <TextBlock Text="Minimum elevation" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                            </DockPanel>
                            <TextBlock x:Name="imagedHint" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}" Visibility="Collapsed"
                                       Text="Only satellites with a known imager are searched: Landsat 8/9, Sentinel-2 and Terra." />

                            <DockPanel Margin="0,10,0,0">
                                <Button x:Name="cancelPassesButton" DockPanel.Dock="Right" Content="Cancel" Margin="6,0,0,0" Visibility="Collapsed"
                                        Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}" Click="OnCancelPasses" />
                                <Button x:Name="findPassesButton" Style="{StaticResource IRI.Maptor.Styles.Button.Primary.Small}" Click="OnFindPasses"
                                        IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Magnify" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" />
                                        <TextBlock Text="Find passes" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <ProgressBar x:Name="passesProgress" Height="3" Margin="0,6,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
                            <TextBlock x:Name="passesSummary" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                        </StackPanel>

                        <!-- Fills the rest of the panel -->
                        <ListBox x:Name="passesList" Margin="-8,6,-8,0" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource SatelliteRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnPassSelected" AutomationProperties.Name="Passes">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                       FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Body}" Typography.NumeralAlignment="Tabular" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                <iconPacks:PackIconMaterial Kind="Eye" Width="12" Height="12" Margin="0,0,6,0"
                                                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                                            Visibility="{Binding NakedEyeVisibility}"
                                                                            ToolTip="Visible to the naked eye: lit by the Sun against a dark sky" />
                                                <iconPacks:PackIconMaterial Kind="{Binding SunIcon}" Width="12" Height="12"
                                                                            Foreground="{DynamicResource MahApps.Brushes.Gray2}" ToolTip="{Binding SunText}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Body}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"
                                                       Foreground="{DynamicResource MahApps.Brushes.Gray2}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Grid>
            <!-- A click (not a drag) on a satellite chooses it; the cursor shows a hand over one -->
            <maptor:MapViewer x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}"
                              PreviewMouseLeftButtonDown="OnMapMouseDown" PreviewMouseLeftButtonUp="OnMapMouseUp"
                              PreviewMouseMove="OnMapMouseMove" />

            <!-- ============ The chosen satellite ============ -->
            <Border x:Name="readout" Style="{StaticResource SampleMapReadout}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="16" Width="290" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="readoutName" FontWeight="SemiBold" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Body}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="readoutId" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" Opacity="0.7" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource ReadoutLabel}" Text="Time (UTC)" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="timeValue" Style="{StaticResource ReadoutValue}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource ReadoutLabel}" Text="Latitude" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="latitudeValue" Style="{StaticResource ReadoutValue}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource ReadoutLabel}" Text="Longitude" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="longitudeValue" Style="{StaticResource ReadoutValue}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource ReadoutLabel}" Text="Altitude" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="altitudeValue" Style="{StaticResource ReadoutValue}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource ReadoutLabel}" Text="Speed" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="speedValue" Style="{StaticResource ReadoutValue}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource ReadoutLabel}" Text="Over the ground" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="groundSpeedValue" Style="{StaticResource ReadoutValue}" />
                        <TextBlock Grid.Row="6" Style="{StaticResource ReadoutLabel}" Text="One orbit" />
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="periodValue" Style="{StaticResource ReadoutValue}" />
                        <TextBlock Grid.Row="7" Style="{StaticResource ReadoutLabel}" Text="Seen within (10°)" />
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="footprintValue" Style="{StaticResource ReadoutValue}" />
                        <TextBlock Grid.Row="8" Style="{StaticResource ReadoutLabel}" Text="Imaging swath" />
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="sensorValue" Style="{StaticResource ReadoutValue}" />
                    </Grid>

                    <Border x:Name="agePill" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,3" CornerRadius="11">
                        <TextBlock x:Name="ageText" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ Time ============ -->
            <shell:MapTimeBar x:Name="timeBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,16,16,40" />
        </Grid>
    </DockPanel>
</UserControl>
