<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.Measurement.MeasurementSample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
             Loaded="OnLoaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource SampleToolbar}">
            <Button Content="Measure length" Command="{Binding MeasureLengthCommand}" Style="{StaticResource SampleToolbarButton}" />
            <Button Content="Measure area" Command="{Binding MeasureAreaCommand}" Style="{StaticResource SampleToolbarButton}" />
            <Button Content="Pan" Command="{Binding PanCommand}" Style="{StaticResource SampleToolbarButton}" />
            <TextBlock Style="{StaticResource SampleHint}" VerticalAlignment="Center"
                       Text="Click to add vertices; the running length or area is drawn on the map. Double-click or use the sketch bar to finish." />
        </StackPanel>

        <Grid>
            <maptor:MapViewer x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}" />
            <maptor:SketchBarView DataContext="{Binding}" />
            <maptor:Scalebar HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                             CurrentScale="{Binding MapScale_CurrentPoint}"
                             ZoomLevel="{Binding NearestGoogleZoomLevel}"
                             ShowScaleValue="True" ShowZoomLevel="True" />
        </Grid>
    </DockPanel>
</UserControl>
