<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.DayNight.SunInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Width="316">
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}" />
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Body}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource RowValue}">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="MinWidth" Value="64" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Micro}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="ChartLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Micro}" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
        </Style>
    </UserControl.Resources>

    <Border Padding="16,12,16,14"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1"
            CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}"
            Effect="{StaticResource IRI.Maptor.Effects.Elevation3}"
            TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
        <StackPanel>

            <!-- Header -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IRI.Maptor.Styles.Button.IconSquare}"
                        Click="OnClose" ToolTip="Close (Esc)" AutomationProperties.Name="Close">
                    <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12" />
                </Button>
                <iconPacks:PackIconMaterial Kind="MapMarkerOutline" Width="16" Height="16" VerticalAlignment="Center"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,8,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sun at this place" FontWeight="SemiBold"
                               FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Body}" />
                    <TextBlock x:Name="placeText" FontFamily="Consolas" Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                               FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
                </StackPanel>
            </DockPanel>

            <!-- Right now -->
            <Border x:Name="phaseChip" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,3" CornerRadius="11">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial x:Name="phaseIcon" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="phaseText" FontWeight="SemiBold" VerticalAlignment="Center"
                               FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="nowText" Margin="0,4,0,0" Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                       FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />

            <!-- The Sun's height through the local day -->
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="84" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border CornerRadius="4" ClipToBounds="True" Background="{DynamicResource MahApps.Brushes.Gray10}">
                    <Canvas x:Name="chart" SizeChanged="OnChartSizeChanged" ClipToBounds="True">
                        <Rectangle x:Name="nightShade" Fill="#330B1A3A" />
                        <Line x:Name="horizonLine" Stroke="{DynamicResource MahApps.Brushes.Gray5}" StrokeThickness="1" StrokeDashArray="3 3" />
                        <Polyline x:Name="elevationCurve" Stroke="#F59E0B" StrokeThickness="2" StrokeLineJoin="Round" />
                        <Line x:Name="nowLine" Stroke="{DynamicResource MahApps.Brushes.Accent}" StrokeThickness="1" />
                        <Ellipse x:Name="nowDot" Width="10" Height="10" Fill="#FFC107" Stroke="#7A4E00" StrokeThickness="1.5" />
                    </Canvas>
                </Border>
                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ChartLabel}" HorizontalAlignment="Left" Text="00" />
                    <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ChartLabel}" HorizontalAlignment="Center" Text="06" />
                    <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource ChartLabel}" HorizontalAlignment="Center" Text="12" />
                    <TextBlock Grid.Column="5" Grid.ColumnSpan="2" Style="{StaticResource ChartLabel}" HorizontalAlignment="Center" Text="18" />
                    <TextBlock Grid.Column="7" Style="{StaticResource ChartLabel}" HorizontalAlignment="Right" Text="24" />
                </Grid>
            </Grid>

            <!-- Polar day / night -->
            <Border x:Name="polarBanner" Style="{StaticResource IRI.Maptor.Styles.Border.Banner.Accent}" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="polarText" TextWrapping="Wrap" FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
            </Border>

            <!-- The day -->
            <TextBlock x:Name="dayHeader" Style="{StaticResource SectionLabel}" />
            <Grid x:Name="dayGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource RowLabel}" Text="Sunrise" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="sunriseText" Style="{StaticResource RowValue}" />
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="sunriseNote" Style="{StaticResource RowNote}" />

                <TextBlock Grid.Row="1" Style="{StaticResource RowLabel}" Text="Solar noon" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="noonText" Style="{StaticResource RowValue}" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="noonNote" Style="{StaticResource RowNote}" />

                <TextBlock Grid.Row="2" Style="{StaticResource RowLabel}" Text="Sunset" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="sunsetText" Style="{StaticResource RowValue}" />
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="sunsetNote" Style="{StaticResource RowNote}" />

                <TextBlock Grid.Row="3" Style="{StaticResource RowLabel}" Text="Day length" />
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="dayLengthText" Style="{StaticResource RowValue}" />
            </Grid>

            <TextBlock Style="{StaticResource SectionLabel}" Text="TWILIGHT · DAWN – DUSK" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource RowLabel}" Text="Civil" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="civilText" Style="{StaticResource RowValue}" />
                <TextBlock Grid.Row="1" Style="{StaticResource RowLabel}" Text="Nautical" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="nauticalText" Style="{StaticResource RowValue}" />
                <TextBlock Grid.Row="2" Style="{StaticResource RowLabel}" Text="Astronomical" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="astronomicalText" Style="{StaticResource RowValue}" />
            </Grid>

            <!-- Time zone -->
            <Border Height="1" Margin="0,10,0,8" Background="{DynamicResource MahApps.Brushes.Gray8}" />
            <DockPanel>
                <TextBlock Text="Times in" Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                <ComboBox x:Name="zoneCombo" Style="{StaticResource IRI.Maptor.Styles.ComboBox.Small.Latin}"
                          SelectionChanged="OnZoneChanged" AutomationProperties.Name="Time zone" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
