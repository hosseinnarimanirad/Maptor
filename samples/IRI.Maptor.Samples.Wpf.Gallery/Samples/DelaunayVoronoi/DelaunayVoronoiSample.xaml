<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Samples.DelaunayVoronoi.DelaunayVoronoiSample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
             Loaded="OnLoaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource SampleToolbar}">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource SampleToolbarButton}" />
                <Style TargetType="CheckBox">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="10,0,0,0" />
                </Style>
            </StackPanel.Resources>

            <TextBlock Text="Points" VerticalAlignment="Center" Margin="4,0,6,0" />

            <mah:NumericUpDown x:Name="pointCount" Value="60" Minimum="3" Maximum="5000" Interval="10"
                               Width="90" VerticalAlignment="Center" />

            <Button Content="Generate" Click="OnGenerate" />

            <CheckBox x:Name="showDelaunay" Content="Delaunay triangulation" IsChecked="True"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />

            <CheckBox x:Name="showVoronoi" Content="Voronoi diagram" IsChecked="True"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />

            <TextBlock x:Name="status" Style="{StaticResource SampleHint}" VerticalAlignment="Center" />
        </StackPanel>

        <maptor:MapViewer x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}" />
    </DockPanel>
</UserControl>
