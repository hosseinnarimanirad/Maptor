<UserControl x:Class="IRI.Maptor.Samples.Wpf.Gallery.Shell.MapTimeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <!-- The time controls of a MapClock: readout, date, months, Now / Live / Play, speed and a 24-hour
         timeline. Shared by the samples that show time-dependent layers (day and night, satellites). -->
    <UserControl.Resources>
        <!-- A rounded on/off chip for the clock modes: neutral when off, accent when on -->
        <Style x:Key="ModeToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray7}" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter TargetName="chip" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipIcon" TargetType="iconPacks:PackIconMaterial">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- One month in the season strip: a compact segment, accent when it is the month shown -->
        <Style x:Key="MonthChip" TargetType="RadioButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="month" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chip" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TickLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource IRI.Maptor.Styles.Size.Text.Micro}" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
        </Style>

    </UserControl.Resources>

    <Border Padding="18,12,18,10"
            MinWidth="640" MaxWidth="820"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1"
            CornerRadius="{StaticResource IRI.Maptor.Styles.CornerRadius.Surface}"
            Effect="{StaticResource IRI.Maptor.Effects.Elevation3}"
            TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Time readout -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="timeText" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Semibold"
                               Typography.NumeralAlignment="Tabular" Text="00:00:00" />
                    <TextBlock Text="UTC" Margin="6,0,0,4" VerticalAlignment="Bottom"
                               FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                </StackPanel>
                <TextBlock x:Name="dateText" Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                           FontSize="{StaticResource IRI.Maptor.Styles.Size.Text.Small}" />
            </StackPanel>

            <!-- Date and clock modes -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <DatePicker x:Name="datePicker" Width="130" VerticalAlignment="Center"
                            Style="{StaticResource IRI.Maptor.Styles.DatePicker.Small}"
                            ToolTip="Date (UTC)" SelectedDateChanged="OnDateChanged" />

                <Button Margin="8,0,0,0" Style="{StaticResource IRI.Maptor.Styles.Button.Secondary.Small}"
                        Click="OnNow" ToolTip="Jump to the current time" AutomationProperties.Name="Now">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ClockTimeFourOutline" Style="{StaticResource IRI.Maptor.Styles.PackIconMaterial.ButtonContent.Small}" />
                        <TextBlock Text="Now" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <ToggleButton x:Name="liveToggle" Style="{StaticResource ModeToggle}" Margin="8,0,0,0"
                              Checked="OnLiveChanged" Unchecked="OnLiveChanged"
                              ToolTip="Follow the clock" AutomationProperties.Name="Live">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Broadcast" Style="{StaticResource ChipIcon}" />
                        <TextBlock Text="Live" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="playToggle" Style="{StaticResource ModeToggle}"
                              Checked="OnPlayChanged" Unchecked="OnPlayChanged"
                              ToolTip="Run time forward at the chosen speed (Space)" AutomationProperties.Name="Play">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial x:Name="playIcon" Kind="PlayCircleOutline" Style="{StaticResource ChipIcon}" />
                        <TextBlock x:Name="playText" Text="Play" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <ComboBox x:Name="speedCombo" Width="100" Margin="8,0,0,0" VerticalAlignment="Center"
                          Style="{StaticResource IRI.Maptor.Styles.ComboBox.Small.Latin}"
                          ToolTip="Playback speed" SelectedIndex="1" SelectionChanged="OnSpeedChanged">
                    <ComboBoxItem Content="1 min / s" Tag="60" />
                    <ComboBoxItem Content="10 min / s" Tag="600" />
                    <ComboBoxItem Content="1 h / s" Tag="3600" />
                    <ComboBoxItem Content="1 day / s" Tag="86400" />
                    <ComboBoxItem Content="1 week / s" Tag="604800" />
                </ComboBox>
            </StackPanel>

            <!-- Seasons: jump to any month, keeping the day and the time of day -->
            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="2"
                    Background="{DynamicResource MahApps.Brushes.Gray10}" CornerRadius="15">
                <UniformGrid x:Name="monthsPanel" Rows="1" Columns="12"
                             KeyboardNavigation.DirectionalNavigation="Cycle"
                             AutomationProperties.Name="Month" />
            </Border>

            <!-- Timeline: the 24 hours of the selected UTC day -->
            <Slider x:Name="timeSlider" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0"
                    Style="{StaticResource IRI.Maptor.Styles.Slider.Normal}"
                    Minimum="0" Maximum="1440" SmallChange="1" LargeChange="60"
                    TickFrequency="60" TickPlacement="BottomRight"
                    ToolTip="Time of day (UTC); arrow keys move a minute, Page Up/Down an hour"
                    AutomationProperties.Name="Time of day" ValueChanged="OnTimeOfDayChanged" />

            <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource TickLabel}" HorizontalAlignment="Left" Text="00:00" />
                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource TickLabel}" HorizontalAlignment="Center" Text="06:00" />
                <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource TickLabel}" HorizontalAlignment="Center" Text="12:00" />
                <TextBlock Grid.Column="5" Grid.ColumnSpan="2" Style="{StaticResource TickLabel}" HorizontalAlignment="Center" Text="18:00" />
                <TextBlock Grid.Column="7" Style="{StaticResource TickLabel}" HorizontalAlignment="Right" Text="24:00" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
