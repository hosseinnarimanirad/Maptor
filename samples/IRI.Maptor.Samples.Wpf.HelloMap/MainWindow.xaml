<Window x:Class="IRI.Maptor.Samples.Wpf.HelloMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:maptor="clr-namespace:IRI.Maptor.Presentation.Wpf.Controls;assembly=IRI.Maptor.Presentation.Wpf"
        Title="Maptor — Hello Map" Width="1000" Height="650" Loaded="OnLoaded">
    <Grid>
        <!-- The map. MapAction tells the control what the mouse does (pan, zoom, draw, identify...) -->
        <maptor:MapViewer x:Name="map" MapAction="{Binding MapAction, Mode=OneWay}" />

        <!-- Base map picker (Google, OSM, Bing, ... from TileMapProviderFactory) -->
        <ComboBox HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" MinWidth="180"
                  ItemsSource="{Binding MapProviders}"
                  SelectedItem="{Binding SelectedMapProvider, Mode=TwoWay}"
                  DisplayMemberPath="Title" />

        <!-- Scale bar with the numeric scale and the nearest tile zoom level -->
        <maptor:Scalebar HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                         CurrentScale="{Binding MapScale_CurrentPoint}"
                         ZoomLevel="{Binding NearestGoogleZoomLevel}"
                         ShowScaleValue="True" ShowZoomLevel="True" />

        <!-- Mouse position in the selected coordinate system -->
        <maptor:CoordinatePanelView HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                    DataContext="{Binding CoordinatePanel}"
                                    Position="{Binding CurrentPoint, ElementName=map}" />
    </Grid>
</Window>
