<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maptor="clr-namespace:IRI.Maptor.Jab.Maui.Controls;assembly=IRI.Maptor.Jab.Maui"
             x:Class="IRI.Maptor.SampleMauiApp.MainPage"
             Title="Maptor MAUI Map">

    <Grid>

        <!-- The map fills the page -->
        <maptor:MapViewer x:Name="Map"
                          Latitude="{Binding Latitude}"
                          Longitude="{Binding Longitude}"
                          ZoomLevel="{Binding ZoomLevel}"
                          BaseMap="{Binding SelectedBaseMap}"
                          MarkerLatitude="{Binding MarkerLatitude}"
                          MarkerLongitude="{Binding MarkerLongitude}"
                          Layers="{Binding Layers}" />

        <!-- Top controls: go-to coordinates, my-location, basemap, layers -->
        <VerticalStackLayout Margin="12"
                             Spacing="6"
                             HorizontalOptions="Fill"
                             VerticalOptions="Start">

            <Border Padding="6"
                    BackgroundColor="#E6FFFFFF"
                    StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="6">

                    <Entry Grid.Column="0"
                           Text="{Binding LocationText}"
                           Placeholder="Paste lat, lon  (e.g. 35.6892, 51.3890)"
                           Keyboard="Text"
                           ReturnCommand="{Binding GoToCommand}" />

                    <Button Grid.Column="1"
                            Text="Go"
                            Command="{Binding GoToCommand}" />

                    <Button Grid.Column="2"
                            Text="📍 My Location"
                            Command="{Binding MyLocationCommand}" />
                </Grid>
            </Border>

            <!-- Basemap switcher + layer actions (compact row) -->
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Start">
                <Border Padding="6,0"
                        BackgroundColor="#E6FFFFFF"
                        StrokeShape="RoundRectangle 8">
                    <Picker ItemsSource="{Binding BaseMaps}"
                            SelectedItem="{Binding SelectedBaseMap}"
                            WidthRequest="160"
                            Title="Basemap" />
                </Border>

                <Button Text="＋ GeoJSON" Command="{Binding AddGeoJsonCommand}" />
                <Button Text="Sample" Command="{Binding LoadSampleCommand}" />
                <Button Text="Layers" Command="{Binding ToggleLegendCommand}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsBusy}">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   Color="White" />
            </HorizontalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   TextColor="White"
                   BackgroundColor="#CC000000"
                   Padding="6,2"
                   FontSize="12"
                   HorizontalOptions="Start" />

        </VerticalStackLayout>

        <!-- Coordinate readout (bottom-left) -->
        <Border Margin="12"
                Padding="8,4"
                HorizontalOptions="Start"
                VerticalOptions="End"
                BackgroundColor="#CC000000"
                StrokeShape="RoundRectangle 8">
            <Label Text="{Binding Coordinates}"
                   TextColor="White"
                   FontSize="12" />
        </Border>

        <!-- Zoom buttons (bottom-right) -->
        <VerticalStackLayout Margin="12"
                             Spacing="8"
                             HorizontalOptions="End"
                             VerticalOptions="End">
            <Button Text="+"
                    Command="{Binding ZoomInCommand}"
                    WidthRequest="48"
                    HeightRequest="48"
                    FontSize="22"
                    Padding="0"
                    CornerRadius="24" />
            <Button Text="−"
                    Command="{Binding ZoomOutCommand}"
                    WidthRequest="48"
                    HeightRequest="48"
                    FontSize="22"
                    Padding="0"
                    CornerRadius="24" />
        </VerticalStackLayout>

        <!-- Legend / layer list (collapsible, top-right) -->
        <maptor:MapLegendView ItemsSource="{Binding Layers}"
                              Map="{x:Reference Map}"
                              IsVisible="{Binding IsLegendVisible}"
                              WidthRequest="300"
                              MaximumHeightRequest="320"
                              HorizontalOptions="End"
                              VerticalOptions="Start"
                              Margin="12,96,12,12" />

    </Grid>

</ContentPage>
